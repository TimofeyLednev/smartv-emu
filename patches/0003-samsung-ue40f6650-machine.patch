+static void samsung_mstar_class_init(ObjectClass *object_class,
+                                     const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(object_class);
+    static const char * const cpu_types[] = {
+        ARM_CPU_TYPE_NAME("cortex-a9"), NULL,
+    };
+
+    mc->desc = "Samsung UE40F6650 / MStar Edison experimental kernel bring-up";
+    mc->init = samsung_mstar_init;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a9");
+    mc->valid_cpu_types = cpu_types;
+    /* Owner-reported model capacity; physical bank layout is unverified. */
+    mc->default_ram_size = 512 * MiB;
+    mc->default_ram_id = "mst12.ram";
+    mc->min_cpus = 1;
+    mc->max_cpus = 2;
+    mc->default_cpus = 1;
+    mc->no_cdrom = true;
+    object_class_property_add_bool(object_class, "panel-rotate-180",
+                                   mst_get_panel_rotation,
+                                   mst_set_panel_rotation);
+    object_class_property_set_description(object_class, "panel-rotate-180",
+                                          "Panel mounting orientation: "
+                                          "rotate final scanout 180 degrees "
+                                          "(default off; board unmeasured)");
+    object_class_property_add_bool(object_class, "panel-gpio43-high",
+                                   mst_get_panel_gpio43, mst_set_panel_gpio43);
+    object_class_property_set_description(object_class, "panel-gpio43-high",
+                                          "External GPIO43 panel strap: "
+                                          "high selects LCD (default), "
+                                          "low selects PDP");
+    object_class_property_add_bool(object_class, "panel-gpio10-high",
+                                   mst_get_panel_gpio10, mst_set_panel_gpio10);
+    object_class_property_set_description(object_class, "panel-gpio10-high",
+                                          "External GPIO10 panel strap: "
+                                          "high selects Full HD (default) "
+                                          "for the recovered MST12 platform");
+    object_class_property_add_bool(object_class, "micom-enabled",
+                                   mst_get_micom, mst_set_micom);
+    object_class_property_set_description(object_class, "micom-enabled",
+                                          "Enable verified MICOM UART1 "
+                                          "exchanges (default off); serial1 "
+                                          "becomes a TX observer");
+    object_class_property_add_bool(object_class, "native-scanout",
+                                   mst_get_native_scanout,
+                                   mst_set_native_scanout);
+    object_class_property_set_description(object_class, "native-scanout",
+                                          "Diagnostic view of the first "
+                                          "framebuffer instead of the "
+                                          "1920x1080 panel");
+    object_class_property_add_str(object_class, "secure-monitor",
+                                  mst_get_secure_monitor,
+                                  mst_set_secure_monitor);
+    object_class_property_set_description(object_class, "secure-monitor",
+                                          "Experimental SMC monitor: off "
+                                          "(default), zero (all r0=0), "
+                                          "or bootstrap (minimal WSM ABI)");
+}
+
+static const TypeInfo samsung_mstar_type = {
+    .name = TYPE_SAMSUNG_MSTAR_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(SamsungMStarState),
+    .instance_init = samsung_mstar_instance_init,
+    .class_init = samsung_mstar_class_init,
+};
+
+static void samsung_mstar_register_types(void)
+{
+    type_register_static(&samsung_mstar_type);
+}
