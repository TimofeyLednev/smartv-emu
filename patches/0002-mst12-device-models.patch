diff --git a/hw/sd/mst12_fcie.c b/hw/sd/mst12_fcie.c
new file mode 100644
index 0000000000000000000000000000000000000000..09085b6df223473fef20274091ba2124baa2df34
--- /dev/null
+++ b/hw/sd/mst12_fcie.c
@@ -0,0 +1,300 @@
+/*
+ * Experimental MStar Edison FCIE host for the T-MST12DEUC Linux BSP.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register access, CIFC packing and MIU addresses come from the extracted
+ * Linux 3.0.33 driver's code. This is a functional boot subset, not a
+ * cycle-accurate model of the physical TV's storage controller.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/irq.h"
+#include "hw/sd/mst12_fcie.h"
+#include "hw/sd/sd.h"
+#include "hw/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/units.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(MST12FCIEState, MST12_FCIE)
+
+/* 16-bit RIU registers occupy four bytes each. */
+#define FCIE_MMIO_SIZE       0x400
+#define FCIE_REG_COUNT       (FCIE_MMIO_SIZE / 4)
+#define R_MIE_EVENT          0x00
+#define R_MIE_INT_ENABLE     0x01
+#define R_MMA_PRIORITY       0x02
+#define R_MIU_DMA_SELECT     0x03
+#define R_JOB_BLOCK_COUNT    0x0b
+#define R_TRANSFER_COUNT     0x0c
+#define R_RESPONSE_SIZE      0x0d
+#define R_SD_MODE            0x10
+#define R_SD_CONTROL         0x11
+#define R_SD_STATUS          0x12
+#define R_SDIO_CONTROL       0x1b
+#define R_DMA_ADDR_LOW       0x1c
+#define R_DMA_ADDR_HIGH      0x1d
+#define R_TEST_MODE          0x30
+#define R_CIFC               0x60
+#define CIFC_WORDS           32
+
+#define EVENT_DMA_END        0x0001
+#define EVENT_COMMAND_END    0x0002
+#define EVENT_DATA_END       0x0004
+#define EVENT_BUSY_END       0x0010
+#define EVENT_CARD_DMA_END   0x0800
+#define EVENT_MIU_LAST_DONE  0x4000
+#define STATUS_DATA_TIMEOUT  0x0002
+#define STATUS_RSP_TIMEOUT   0x0008
+#define STATUS_DAT0_HIGH     0x0100
+#define MMA_FIFO_CLK_READY   0x0020
+#define MMA_FIFO_READY       0x8000
+#define CONTROL_RESPONSE    0x0002
+#define CONTROL_COMMAND     0x0004
+#define CONTROL_DATA        0x0008
+#define CONTROL_WRITE       0x0010
+#define CONTROL_BUSY_CHECK  0x0020
+
+struct MST12FCIEState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SDBus sdbus;
+    qemu_irq irq;
+    uint16_t regs[FCIE_REG_COUNT];
+    unsigned log_budget;
+};
+
+static void mst12_fcie_update_irq(MST12FCIEState *s)
+{
+    qemu_set_irq(s->irq, (s->regs[R_MIE_EVENT] &
+                         s->regs[R_MIE_INT_ENABLE]) != 0);
+}
+
+static uint8_t mst12_fcie_fifo_byte(MST12FCIEState *s, unsigned index)
+{
+    return s->regs[R_CIFC + index / 2] >> ((index & 1) * 8);
+}
+
+static void mst12_fcie_set_fifo_byte(MST12FCIEState *s, unsigned index,
+                                    uint8_t value)
+{
+    unsigned shift = (index & 1) * 8;
+    uint16_t *word = &s->regs[R_CIFC + index / 2];
+
+    *word = (*word & ~(0xff << shift)) | (value << shift);
+}
+
+static void mst12_fcie_transfer(MST12FCIEState *s, uint16_t control)
+{
+    uint32_t blocks = s->regs[R_JOB_BLOCK_COUNT] & 0x7fff;
+    uint32_t block_size = s->regs[R_SDIO_CONTROL] & 0x0fff;
+    uint64_t address = s->regs[R_DMA_ADDR_LOW] |
+                       ((uint32_t)s->regs[R_DMA_ADDR_HIGH] << 16);
+    uint64_t length;
+    g_autofree uint8_t *buffer = NULL;
+    MemTxResult result;
+
+    if (!block_size) {
+        block_size = 512;
+    }
+    length = (uint64_t)blocks * block_size;
+    address += (s->regs[R_MIU_DMA_SELECT] & 0x8000) ?
+               0xa0000000ULL : 0x40000000ULL;
+    if (!length || length > 16 * MiB) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 FCIE invalid DMA length: %" PRIu64 "\n", length);
+        s->regs[R_SD_STATUS] |= STATUS_DATA_TIMEOUT;
+        return;
+    }
+
+    buffer = g_malloc(length);
+    if (control & CONTROL_WRITE) {
+        result = dma_memory_read(&address_space_memory, address, buffer,
+                                 length, MEMTXATTRS_UNSPECIFIED);
+        if (result == MEMTX_OK && sdbus_receive_ready(&s->sdbus)) {
+            sdbus_write_data(&s->sdbus, buffer, length);
+        } else {
+            s->regs[R_SD_STATUS] |= STATUS_DATA_TIMEOUT;
+        }
+    } else if (sdbus_data_ready(&s->sdbus)) {
+        sdbus_read_data(&s->sdbus, buffer, length);
+        result = dma_memory_write(&address_space_memory, address, buffer,
+                                  length, MEMTXATTRS_UNSPECIFIED);
+        if (result != MEMTX_OK) {
+            s->regs[R_SD_STATUS] |= STATUS_DATA_TIMEOUT;
+        }
+    } else {
+        s->regs[R_SD_STATUS] |= STATUS_DATA_TIMEOUT;
+    }
+    if (s->log_budget) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 FCIE DMA %s: phys=0x%" PRIx64
+                      " bytes=%" PRIu64 " status=0x%x\n",
+                      (control & CONTROL_WRITE) ? "write" : "read",
+                      address, length, s->regs[R_SD_STATUS]);
+        s->log_budget--;
+    }
+    s->regs[R_TRANSFER_COUNT] = blocks;
+    s->regs[R_MIE_EVENT] |= EVENT_DMA_END | EVENT_DATA_END |
+                            EVENT_CARD_DMA_END | EVENT_MIU_LAST_DONE;
+}
+
+static void mst12_fcie_command(MST12FCIEState *s, uint16_t control)
+{
+    SDRequest request = {
+        .cmd = mst12_fcie_fifo_byte(s, 0) & 0x3f,
+        .arg = ((uint32_t)mst12_fcie_fifo_byte(s, 1) << 24) |
+               ((uint32_t)mst12_fcie_fifo_byte(s, 2) << 16) |
+               ((uint32_t)mst12_fcie_fifo_byte(s, 3) << 8) |
+               mst12_fcie_fifo_byte(s, 4),
+        .crc = 0,
+    };
+    uint8_t response[16] = { 0 };
+    size_t length = 0;
+    unsigned i;
+
+    if (sdbus_get_inserted(&s->sdbus)) {
+        length = sdbus_do_command(&s->sdbus, &request, response,
+                                  sizeof(response));
+        if (!length && (control & CONTROL_RESPONSE)) {
+            s->regs[R_SD_STATUS] |= STATUS_RSP_TIMEOUT;
+        }
+    }
+    memset(s->regs + R_CIFC, 0, CIFC_WORDS * sizeof(uint16_t));
+    /* The vendor driver skips the response's first (command-header) byte. */
+    mst12_fcie_set_fifo_byte(s, 0, length > 4 ? 0x3f : request.cmd);
+    for (i = 0; i < length; i++) {
+        mst12_fcie_set_fifo_byte(s, i + 1, response[i]);
+    }
+    if (s->log_budget) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 FCIE CMD%u arg=0x%08x response=%zu"
+                      " control=0x%x status=0x%x\n",
+                      request.cmd, request.arg, length, control,
+                      s->regs[R_SD_STATUS]);
+        s->log_budget--;
+    }
+    s->regs[R_MIE_EVENT] |= EVENT_COMMAND_END;
+}
+
+static uint64_t mst12_fcie_read(void *opaque, hwaddr address, unsigned size)
+{
+    MST12FCIEState *s = opaque;
+    unsigned index = address / 4;
+    uint16_t value = s->regs[index];
+
+    if (index == R_MMA_PRIORITY) {
+        /*
+         * The BSP's second eMMC path at kernel VA 0xc01ac620 samples
+         * bit 5 three times after checking the DMA direction in bit 2.
+         * Our synchronous FIFO is already clocked and ready to transfer.
+         */
+        value |= MMA_FIFO_READY | MMA_FIFO_CLK_READY;
+    } else if (index == R_SD_STATUS) {
+        value |= STATUS_DAT0_HIGH;
+    }
+    return (uint64_t)value >> ((address & 3) * 8);
+}
+
+static void mst12_fcie_write(void *opaque, hwaddr address, uint64_t value,
+                             unsigned size)
+{
+    MST12FCIEState *s = opaque;
+    unsigned index = address / 4;
+    unsigned shift = (address & 3) * 8;
+    uint16_t mask = (size == 1 ? 0xff : 0xffff) << shift;
+    uint16_t data = value << shift;
+
+    if (index == R_MIE_EVENT || index == R_SD_STATUS) {
+        s->regs[index] &= ~(data & mask);
+    } else {
+        s->regs[index] = (s->regs[index] & ~mask) | (data & mask);
+    }
+    if (index == R_TEST_MODE && !(s->regs[index] & 0x1000)) {
+        memset(s->regs + R_CIFC, 0, CIFC_WORDS * sizeof(uint16_t));
+    }
+    if (index == R_SD_CONTROL) {
+        uint16_t control = s->regs[index];
+
+        if (control & CONTROL_COMMAND) {
+            mst12_fcie_command(s, control);
+        }
+        if (control & CONTROL_DATA) {
+            mst12_fcie_transfer(s, control);
+        }
+        if (control & CONTROL_BUSY_CHECK) {
+            s->regs[R_MIE_EVENT] |= EVENT_BUSY_END;
+        }
+        s->regs[index] &= ~(CONTROL_COMMAND | CONTROL_DATA |
+                            CONTROL_BUSY_CHECK);
+    }
+    mst12_fcie_update_irq(s);
+}
+
+static const MemoryRegionOps mst12_fcie_ops = {
+    .read = mst12_fcie_read,
+    .write = mst12_fcie_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void mst12_fcie_reset(DeviceState *dev)
+{
+    MST12FCIEState *s = MST12_FCIE(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[R_TEST_MODE] = 0x1000;
+    s->log_budget = 128;
+    mst12_fcie_update_irq(s);
+}
+
+static const VMStateDescription mst12_fcie_vmstate = {
+    .name = TYPE_MST12_FCIE,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(regs, MST12FCIEState, FCIE_REG_COUNT),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mst12_fcie_init(Object *obj)
+{
+    MST12FCIEState *s = MST12_FCIE(obj);
+    SysBusDevice *busdev = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &mst12_fcie_ops, s,
+                          TYPE_MST12_FCIE, FCIE_MMIO_SIZE);
+    sysbus_init_mmio(busdev, &s->iomem);
+    sysbus_init_irq(busdev, &s->irq);
+    qbus_init(&s->sdbus, sizeof(s->sdbus), TYPE_SD_BUS, DEVICE(obj), "sd-bus");
+}
+
+static void mst12_fcie_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "MStar Edison experimental FCIE eMMC host";
+    dc->vmsd = &mst12_fcie_vmstate;
+    device_class_set_legacy_reset(dc, mst12_fcie_reset);
+    dc->user_creatable = false;
+}
+
+static const TypeInfo mst12_fcie_type = {
+    .name = TYPE_MST12_FCIE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12FCIEState),
+    .instance_init = mst12_fcie_init,
+    .class_init = mst12_fcie_class_init,
+};
+
+static void mst12_fcie_register_types(void)
+{
+    type_register_static(&mst12_fcie_type);
+}
+
+type_init(mst12_fcie_register_types)
