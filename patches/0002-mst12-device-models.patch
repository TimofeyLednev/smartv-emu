+type_init(mst12_mali_register_types)
diff --git a/hw/display/mst12_mali_render.c b/hw/display/mst12_mali_render.c
new file mode 100644
index 0000000000000000000000000000000000000000..b2bfe34718a59d4a120ce3655daf6a6c869ef51a
--- /dev/null
+++ b/hw/display/mst12_mali_render.c
@@ -0,0 +1,1343 @@
+/*
+ * Functional Utgard PP tile rasterization and DMA writeback.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Packet and pixel layouts follow public Lima definitions. Polygon batches
+ * come from the GP command decoder, without inventing the undocumented raw
+ * polygon-block records. Rasterization currently evaluates pixel centers.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qemu/bswap.h"
+#include "qemu/host-utils.h"
+#include "qemu/log.h"
+#include "fpu/softfloat.h"
+#include "hw/display/mst12_mali_render.h"
+#include "hw/display/mst12_mali_shader.h"
+
+#define MALI_MAX_IMAGE_BYTES (64 * 1024 * 1024)
+#define MALI_MAX_PP_TILES    65536
+
+typedef struct MALITexture {
+    uint8_t *data;
+    uint32_t descriptor[16];
+    unsigned width;
+    unsigned height;
+    unsigned stride;
+    unsigned format;
+    unsigned layout;
+    unsigned size;
+    bool sample_traced;
+} MALITexture;
+
+typedef struct MALIRenderDraw {
+    const MALIRenderIO *io;
+    const MALIDraw *command;
+    MALIPPProgram *program;
+    uint32_t state[16];
+    MALITexture texture[16];
+    unsigned textures;
+    unsigned varyings;
+    uint8_t varying_component[64];
+    float constant_color[4];
+    bool constant_discard;
+    bool constant_valid;
+    bool fragment_traced;
+} MALIRenderDraw;
+
+typedef struct MALIRenderVertex {
+    float position[4];
+    float varying[64];
+} MALIRenderVertex;
+
+typedef struct MALIRenderTriangle {
+    MALIRenderVertex vertex[3];
+    MALIRenderDraw *draw;
+    float area;
+    bool frontface;
+} MALIRenderTriangle;
+
+typedef struct MALIPPTile {
+    unsigned x;
+    unsigned y;
+} MALIPPTile;
+
+static uint32_t render_bits(const uint32_t *data, unsigned start, unsigned size)
+{
+    uint64_t value = data[start / 32] >> (start % 32);
+
+    if (start % 32 && start % 32 + size > 32) {
+        value |= (uint64_t)data[start / 32 + 1] << (32 - start % 32);
+    }
+    return value & ((1ULL << size) - 1);
+}
+
+static float render_float(uint32_t bits)
+{
+    float value;
+
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+static float render_half(uint16_t half)
+{
+    float_status status = { 0 };
+
+    return render_float(float16_to_float32(half, true, &status));
+}
+
+static bool render_read_words(const MALIRenderIO *io, uint32_t address,
+                               uint32_t *words, unsigned count)
+{
+    unsigned i;
+
+    if (!io->read(io->opaque, address, words, count * 4)) {
+        return false;
+    }
+    for (i = 0; i < count; i++) {
+        words[i] = le32_to_cpu(words[i]);
+    }
+    return true;
+}
+
+static bool render_load_shader(MALIRenderDraw *draw, uint32_t address)
+{
+    uint8_t code[MALI_PP_MAX_WORDS * 4];
+    unsigned words = 0, fault;
+
+    draw->program = g_new0(MALIPPProgram, 1);
+    while (words < MALI_PP_MAX_WORDS) {
+        uint32_t control;
+        unsigned count;
+        uint64_t pointer = (uint64_t)address + words * 4;
+
+        if (pointer + 4 > (1ULL << 32) ||
+            !render_read_words(draw->io, pointer, &control, 1)) {
+            return false;
+        }
+        count = control & 31;
+        if (!count || words + count > MALI_PP_MAX_WORDS ||
+            pointer + count * 4 > (1ULL << 32) ||
+            !draw->io->read(draw->io->opaque, pointer, code + words * 4,
+                            count * 4)) {
+            return false;
+        }
+        words += count;
+        if (control & 32) {
+            bool valid = mst12_mali_pp_decode(code, words, draw->program,
+                                               &fault);
+
+            if (!valid) {
+                qemu_log_mask(LOG_UNIMP,
+                    "MST12 Mali fragment decode unsupported: "
+                    "shader=0x%08x word=%u\n", address, fault);
+            } else {
+                mst12_mali_pp_prepare(draw->program,
+                                      (draw->state[8] >> 16) & 15);
+            }
+            return valid;
+        }
+    }
+    return false;
+}
+
+/* Utgard's 16x16 U-interleaved layout, used by textures and writeback. */
+static unsigned render_tile_index(unsigned x, unsigned y)
+{
+    unsigned value = 0, i;
+
+    for (i = 0; i < 4; i++) {
+        value |= (((x ^ y) >> i) & 1) << (i * 2);
+        value |= ((y >> i) & 1) << (i * 2 + 1);
+    }
+    return value;
+}
+
+static unsigned render_texel_size(unsigned format)
+{
+    switch (format) {
+    case 9:
+    case 10:
+    case 11:
+        return 1;
+    case 14:
+    case 15:
+    case 16:
+    case 17:
+        return 2;
+    case 21:
+        return 3;
+    case 22:
+    case 23:
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static bool render_load_texture(MALIRenderDraw *draw, unsigned index)
+{
+    MALITexture *texture = &draw->texture[index];
+    const MALIRenderIO *io = draw->io;
+    uint32_t pointer;
+    uint64_t size;
+    unsigned pixel_size;
+
+    if (!render_read_words(io, (draw->state[12] & ~15u) + index * 4,
+                            &pointer, 1) ||
+        !render_read_words(io, pointer, texture->descriptor, 16)) {
+        return false;
+    }
+    texture->width = render_bits(texture->descriptor, 86, 13);
+    texture->height = render_bits(texture->descriptor, 99, 13);
+    texture->layout = render_bits(texture->descriptor, 205, 2);
+    texture->format = texture->descriptor[0] & 63;
+    texture->stride = (texture->descriptor[0] >> 16) & 32767;
+    pixel_size = render_texel_size(texture->format);
+    if (!pixel_size || !texture->width || !texture->height ||
+        render_bits(texture->descriptor, 112, 13) != 1 ||
+        render_bits(texture->descriptor, 42, 2) != 1 ||
+        render_bits(texture->descriptor, 41, 1) ||
+        render_bits(texture->descriptor, 52, 8) ||
+        (texture->descriptor[0] & 0x740) ||
+        (texture->layout != 0 && texture->layout != 3)) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali texture unsupported: descriptor=0x%08x "
+            "format=0x%x layout=%u dimensions=%ux%u\n", pointer,
+            texture->format, texture->layout, texture->width, texture->height);
+        return false;
+    }
+    if (texture->layout == 3) {
+        texture->stride = (texture->width + 15) / 16;
+        size = (uint64_t)texture->stride * ((texture->height + 15) / 16) *
+               256 * pixel_size;
+    } else {
+        if (!render_bits(texture->descriptor, 72, 1)) {
+            texture->stride = texture->width * pixel_size;
+        }
+        if (texture->stride < texture->width * pixel_size) {
+            return false;
+        }
+        size = (uint64_t)texture->stride * (texture->height - 1) +
+               texture->width * pixel_size;
+    }
+    pointer = render_bits(texture->descriptor, 222, 26) << 6;
+    if (size > MALI_MAX_IMAGE_BYTES ||
+        (uint64_t)pointer + size > (1ULL << 32)) {
+        return false;
+    }
+    texture->size = size;
+    texture->data = g_malloc(size);
+    if (!io->read(io->opaque, pointer, texture->data, size)) {
+        return false;
+    }
+    if (io->trace) {
+        unsigned i, nonzero = 0;
+
+        for (i = 0; i < size; i++) {
+            nonzero += texture->data[i] != 0;
+        }
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali texture data: table=0x%08x data=0x%08x "
+            "width=%u height=%u format=%u stride=%u layout=%u "
+            "bytes=%" PRIu64 " nonzero=%u descriptor0=0x%x\n",
+            draw->state[11], pointer, texture->width, texture->height,
+            texture->format, texture->stride, texture->layout, size,
+            nonzero, texture->descriptor[0]);
+    }
+    return true;
+}
+
+static int render_wrap(int coordinate, unsigned size, unsigned mode,
+                        bool *border)
+{
+    switch (mode) {
+    case 0:
+        coordinate %= (int)size;
+        return coordinate < 0 ? coordinate + size : coordinate;
+    case 4:
+        coordinate %= (int)(size * 2);
+        if (coordinate < 0) {
+            coordinate += size * 2;
+        }
+        return coordinate >= size ? size * 2 - 1 - coordinate : coordinate;
+    case 2:
+    case 3:
+    case 6:
+    case 7:
+        if (coordinate < 0 || coordinate >= size) {
+            *border = true;
+        }
+        return CLAMP(coordinate, 0, size - 1);
+    default:
+        return CLAMP(coordinate, 0, size - 1);
+    }
+}
+
+static void render_texel(const MALITexture *texture, int x, int y,
+                         float color[4])
+{
+    unsigned pixel_size = render_texel_size(texture->format);
+    unsigned offset;
+    uint16_t packed;
+    const uint8_t *data;
+    bool border = false;
+
+    x = render_wrap(x, texture->width, (texture->descriptor[2] >> 13) & 7,
+                    &border);
+    y = render_wrap(y, texture->height, (texture->descriptor[2] >> 16) & 7,
+                    &border);
+    if (border) {
+        unsigned i;
+
+        for (i = 0; i < 4; i++) {
+            color[i] = render_bits(texture->descriptor, 125 + i * 16, 16) /
+                       65535.0f;
+        }
+        return;
+    }
+    offset = texture->layout == 3 ?
+        (((y >> 4) * texture->stride + (x >> 4)) * 256 +
+         render_tile_index(x & 15, y & 15)) * pixel_size :
+        y * texture->stride + x * pixel_size;
+    data = texture->data + offset;
+    color[3] = 1;
+    switch (texture->format) {
+    case 9:
+        color[0] = color[1] = color[2] = data[0] / 255.0f;
+        break;
+    case 10:
+        color[0] = color[1] = color[2] = 1;
+        color[3] = data[0] / 255.0f;
+        break;
+    case 11:
+        color[0] = color[1] = color[2] = color[3] = data[0] / 255.0f;
+        break;
+    case 14:
+        packed = lduw_le_p(data);
+        color[0] = (packed >> 11) / 31.0f;
+        color[1] = ((packed >> 5) & 63) / 63.0f;
+        color[2] = (packed & 31) / 31.0f;
+        break;
+    case 15:
+        packed = lduw_le_p(data);
+        color[0] = (packed >> 11) / 31.0f;
+        color[1] = ((packed >> 6) & 31) / 31.0f;
+        color[2] = ((packed >> 1) & 31) / 31.0f;
+        color[3] = packed & 1;
+        break;
+    case 16:
+        packed = lduw_le_p(data);
+        color[0] = (packed >> 12) / 15.0f;
+        color[1] = ((packed >> 8) & 15) / 15.0f;
+        color[2] = ((packed >> 4) & 15) / 15.0f;
+        color[3] = (packed & 15) / 15.0f;
+        break;
+    case 17:
+        color[0] = color[1] = color[2] = data[0] / 255.0f;
+        color[3] = data[1] / 255.0f;
+        break;
+    default:
+        color[0] = data[2] / 255.0f;
+        color[1] = data[1] / 255.0f;
+        color[2] = data[0] / 255.0f;
+        if (texture->format == 22) {
+            color[3] = data[3] / 255.0f;
+        }
+        break;
+    }
+    if (texture->descriptor[0] & 128) {
+        float temporary = color[0];
+
+        color[0] = color[2];
+        color[2] = temporary;
+    }
+}
+
+static bool render_sample(void *opaque, unsigned index,
+                           const float coordinates[4], float color[4])
+{
+    MALIRenderDraw *draw = opaque;
+    MALITexture *texture;
+    float x, y;
+
+    if (index >= draw->textures || !isfinite(coordinates[0]) ||
+        !isfinite(coordinates[1])) {
+        return false;
+    }
+    texture = &draw->texture[index];
+    x = coordinates[0];
+    y = coordinates[1];
+    if (!(texture->descriptor[1] & 128)) {
+        x *= texture->width;
+        y *= texture->height;
+    }
+    if (fabsf(x) > INT_MAX / 2 || fabsf(y) > INT_MAX / 2) {
+        return false;
+    }
+    if (texture->descriptor[2] & 4096) {
+        render_texel(texture, floorf(x), floorf(y), color);
+    } else {
+        float sample[4][4], fx, fy;
+        int ix, iy;
+        unsigned component;
+
+        x -= 0.5f;
+        y -= 0.5f;
+        ix = floorf(x);
+        iy = floorf(y);
+        fx = x - ix;
+        fy = y - iy;
+        render_texel(texture, ix, iy, sample[0]);
+        render_texel(texture, ix + 1, iy, sample[1]);
+        render_texel(texture, ix, iy + 1, sample[2]);
+        render_texel(texture, ix + 1, iy + 1, sample[3]);
+        for (component = 0; component < 4; component++) {
+            color[component] =
+                (sample[0][component] * (1 - fx) + sample[1][component] * fx) *
+                (1 - fy) +
+                (sample[2][component] * (1 - fx) +
+                 sample[3][component] * fx) * fy;
+        }
+    }
+    if (draw->io->trace && !texture->sample_traced) {
+        texture->sample_traced = true;
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali texture sample: index=%u uv=%g,%g xy=%g,%g "
+            "rgba=%g,%g,%g,%g\n",
+            index, coordinates[0], coordinates[1], x, y,
+            color[0], color[1], color[2], color[3]);
+    }
+    return true;
+}
+
+static bool render_uniform(void *opaque, unsigned alignment, int index,
+                            float result[4])
+{
+    MALIRenderDraw *draw = opaque;
+    uint32_t pointer;
+    uint8_t data[8];
+    unsigned count = 1u << MIN(alignment, 2), i;
+
+    if (index < 0 || (uint64_t)index * count >= 512 ||
+        !render_read_words(draw->io, draw->state[11] & ~15u, &pointer, 1) ||
+        (uint64_t)pointer + (index + 1) * count * 2 > (1ULL << 32) ||
+        !draw->io->read(draw->io->opaque, pointer + index * count * 2,
+                         data, count * 2)) {
+        return false;
+    }
+    for (i = 0; i < 4; i++) {
+        result[i] = i < count ? render_half(lduw_le_p(data + i * 2)) : 0;
+    }
+    return true;
+}
+
+static bool render_load_state(MALIRenderDraw *draw, uint32_t address,
+                               const MALIRenderIO *io)
+{
+    unsigned i;
+    uint64_t mask;
+
+    draw->io = io;
+    if (!render_read_words(io, address, draw->state, 16) ||
+        !render_load_shader(draw, draw->state[9] & ~31u)) {
+        return false;
+    }
+    draw->varyings = 0;
+    draw->constant_valid = false;
+    for (mask = draw->program->varying_mask; mask; mask &= mask - 1) {
+        draw->varying_component[draw->varyings++] = ctz64(mask);
+    }
+    if (draw->state[3] & 0xfffffc00) {
+        /* Depth/stencil shader outputs and polygon offset are unsupported. */
+        return false;
+    }
+    draw->textures = (draw->state[13] >> 14) & 0x3fff;
+    if (draw->textures > 16) {
+        return false;
+    }
+    for (i = 0; i < draw->textures; i++) {
+        if (!render_load_texture(draw, i)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void render_free_draw(MALIRenderDraw *draw)
+{
+    unsigned i;
+
+    g_free(draw->program);
+    for (i = 0; i < 16; i++) {
+        g_free(draw->texture[i].data);
+    }
+}
+
+static bool render_batch_tile(const MALITileBatch *batch, unsigned x,
+                              unsigned y, uint32_t block)
+{
+    unsigned index;
+
+    if (x >= batch->tiles_x || y >= batch->tiles_y) {
+        return false;
+    }
+    index = (y >> batch->shift_y) * batch->stride + (x >> batch->shift_x);
+    return index < batch->count && batch->blocks[index] == block;
+}
+
+static bool render_parse_tiles(const MALITileBatch batches[MALI_TILE_BATCHES],
+                               unsigned next_batch, uint32_t directory,
+                               bool paging, const MALIRenderIO *io,
+                               MALIRenderResult *result, GArray *tiles,
+                               const MALITileBatch **selected)
+{
+    uint64_t address = result->list;
+    uint8_t seen[MALI_MAX_PP_TILES / 8] = { 0 };
+    unsigned i;
+
+    if (address & 7) {
+        return false;
+    }
+    while (tiles->len <= MALI_MAX_PP_TILES) {
+        uint32_t words[4], block, index;
+        MALIPPTile tile;
+
+        result->list = address;
+        if (address + 8 > (1ULL << 32) ||
+            !render_read_words(io, address, words, 2) || words[0]) {
+            return false;
+        }
+        if (words[1] == 0xbc000000) {
+            result->list = address + 8;
+            return true;
+        }
+        if (tiles->len == MALI_MAX_PP_TILES ||
+            (words[1] & 0xffff0000) != 0xb8000000 ||
+            address + 16 > (1ULL << 32) ||
+            !render_read_words(io, address + 8, words + 2, 2) ||
+            (words[2] & 0xe0000003) != 0xe0000002 ||
+            words[3] != 0xb0000000) {
+            return false;
+        }
+        tile.x = words[1] & 255;
+        tile.y = (words[1] >> 8) & 255;
+        block = (words[2] & 0x1ffffffc) << 3;
+        index = tile.y * 256 + tile.x;
+        if (seen[index / 8] & (1u << (index % 8))) {
+            return false;
+        }
+        seen[index / 8] |= 1u << (index % 8);
+        if (!*selected) {
+            for (i = 0; i < MALI_TILE_BATCHES; i++) {
+                const MALITileBatch *batch =
+                    &batches[(next_batch - i - 1) % MALI_TILE_BATCHES];
+
+                if (batch->valid && batch->directory == directory &&
+                    batch->paging == paging &&
+                    render_batch_tile(batch, tile.x, tile.y, block)) {
+                    *selected = batch;
+                    break;
+                }
+            }
+        }
+        if (!*selected ||
+            !render_batch_tile(*selected, tile.x, tile.y, block) ||
+            !io->validate(io->opaque, block, 512, false)) {
+            return false;
+        }
+        g_array_append_val(tiles, tile);
+        address += 16;
+    }
+    return false;
+}
+
+static bool render_read_vertex(MALIRenderDraw *draw, unsigned index,
+                               MALIRenderVertex *vertex)
+{
+    const MALIDraw *command = draw->command;
+    unsigned stride = (draw->state[13] & 31) * 8;
+    uint64_t address = (uint64_t)command->positions + index * 16;
+    uint8_t data[248];
+    uint32_t words[4];
+    unsigned i, offset = 0;
+
+    memset(vertex, 0, sizeof(*vertex));
+    if (index >= MALI_MAX_VERTICES || address + 16 > (1ULL << 32) ||
+        !render_read_words(draw->io, address, words, 4)) {
+        return false;
+    }
+    for (i = 0; i < 4; i++) {
+        vertex->position[i] = render_float(words[i]);
+        if (!isfinite(vertex->position[i])) {
+            return false;
+        }
+    }
+    if (fabsf(vertex->position[0]) > 1048576 ||
+        fabsf(vertex->position[1]) > 1048576) {
+        return false;
+    }
+    address = (uint64_t)(draw->state[15] & ~15u) + index * stride;
+    if (address + stride > (1ULL << 32) ||
+        (stride && !draw->io->read(draw->io->opaque, address, data, stride))) {
+        return false;
+    }
+    for (i = 0; i < 12; i++) {
+        unsigned type = i < 10 ? (draw->state[10] >> (i * 3)) & 7 :
+                        i == 10 ? (draw->state[10] >> 30) |
+                                  ((draw->state[15] & 1) << 2) :
+                                  (draw->state[15] >> 1) & 7;
+        unsigned count = type == 1 || (type >= 3 && type <= 5) ? 2 : 4;
+        unsigned size = type < 2 ? 4 : type < 6 ? 2 : 1;
+        unsigned component;
+
+        if (offset + size * count > stride) {
+            break;
+        }
+        if (type == 6) {
+            return false;
+        }
+        for (component = 0; component < count; component++) {
+            const uint8_t *source = data + offset + component * size;
+            float value;
+
+            if (type < 2) {
+                value = render_float(ldl_le_p(source));
+            } else if (type < 4) {
+                value = render_half(lduw_le_p(source));
+            } else if (type == 4) {
+                value = MAX(-1.0f, (int16_t)lduw_le_p(source) / 32767.0f);
+            } else if (type == 5) {
+                value = lduw_le_p(source) / 65535.0f;
+            } else {
+                value = source[0] / 255.0f;
+            }
+            vertex->varying[i * 4 + component] = value;
+        }
+        offset += size * count;
+    }
+    return true;
+}
+
+static float render_edge(const MALIRenderVertex *a, const MALIRenderVertex *b,
+                          float x, float y)
+{
+    return (b->position[0] - a->position[0]) * (y - a->position[1]) -
+           (b->position[1] - a->position[1]) * (x - a->position[0]);
+}
+
+static bool render_prepare_triangles(MALIRenderDraw *draw, GArray *triangles)
+{
+    const MALIDraw *command = draw->command;
+    g_autofree MALIRenderVertex *vertices =
+        g_new0(MALIRenderVertex, command->count);
+    g_autofree uint8_t *indices = NULL;
+    unsigned i, count;
+
+    if (command->index_size) {
+        uint64_t address = (uint64_t)command->indices +
+                           command->first * command->index_size;
+        unsigned bytes = command->count * command->index_size;
+
+        indices = g_malloc(bytes);
+        if (address + bytes > (1ULL << 32) ||
+            !draw->io->read(draw->io->opaque, address, indices, bytes)) {
+            return false;
+        }
+    }
+    for (i = 0; i < command->count; i++) {
+        unsigned index = !indices ? command->first + i :
+                         command->index_size == 1 ? indices[i] :
+                         command->index_size == 2 ? lduw_le_p(indices + i * 2) :
+                                                   ldl_le_p(indices + i * 4);
+
+        if (!render_read_vertex(draw, index, &vertices[i])) {
+            return false;
+        }
+    }
+    if (draw->io->trace && command->count >= 3) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali triangle input: state=0x%08x count=%u mode=%u "
+            "cull=%u clip=%u,%u..%u,%u mask=0x%x depth=0x%x "
+            "v0=%g,%g,%g,%g v1=%g,%g,%g,%g v2=%g,%g,%g,%g\n",
+            command->render_state, command->count, command->mode,
+            command->cull, command->clip[0], command->clip[1],
+            command->clip[2], command->clip[3], draw->state[2] >> 28,
+            draw->state[3],
+            vertices[0].position[0], vertices[0].position[1],
+            vertices[0].position[2], vertices[0].position[3],
+            vertices[1].position[0], vertices[1].position[1],
+            vertices[1].position[2], vertices[1].position[3],
+            vertices[2].position[0], vertices[2].position[1],
+            vertices[2].position[2], vertices[2].position[3]);
+    }
+    count = command->mode == 4 ? command->count / 3 :
+            command->count >= 3 ? command->count - 2 : 0;
+    if (triangles->len + count > MALI_MAX_PP_TILES) {
+        return false;
+    }
+    for (i = 0; i < count; i++) {
+        MALIRenderTriangle triangle = { .draw = draw };
+        unsigned a = command->mode == 4 ? i * 3 : command->mode == 5 ? i : 0;
+        unsigned b = command->mode == 4 ? a + 1 : i + 1;
+        unsigned c = command->mode == 4 ? a + 2 : i + 2;
+
+        if (command->mode == 5 && (i & 1)) {
+            unsigned temporary = a;
+
+            a = b;
+            b = temporary;
+        }
+        triangle.vertex[0] = vertices[a];
+        triangle.vertex[1] = vertices[b];
+        triangle.vertex[2] = vertices[c];
+        triangle.area = render_edge(&vertices[a], &vertices[b],
+                                    vertices[c].position[0],
+                                    vertices[c].position[1]);
+        if (!isfinite(triangle.area)) {
+            return false;
+        }
+        if (triangle.area == 0 ||
+            (triangle.area > 0 && (command->cull & 2)) ||
+            (triangle.area < 0 && (command->cull & 1))) {
+            continue;
+        }
+        triangle.frontface = (triangle.area > 0) ==
+                              !!(draw->state[14] & 4096);
+        if (triangle.area < 0) {
+            triangle.vertex[1] = vertices[c];
+            triangle.vertex[2] = vertices[b];
+            triangle.area = -triangle.area;
+        }
+        g_array_append_val(triangles, triangle);
+    }
+    return true;
+}
+
+static bool render_compare(unsigned function, float a, float b)
+{
+    switch (function) {
+    case 0:
+        return false;
+    case 1:
+        return a < b;
+    case 2:
+        return a == b;
+    case 3:
+        return a <= b;
+    case 4:
+        return a > b;
+    case 5:
+        return a != b;
+    case 6:
+        return a >= b;
+    default:
+        return true;
+    }
+}
+
+static uint8_t render_stencil(unsigned op, unsigned reference, uint8_t value)
+{
+    switch (op) {
+    case 1:
+        return reference;
+    case 2:
+        return 0;
+    case 3:
+        return ~value;
+    case 4:
+        return value + 1;
+    case 5:
+        return value - 1;
+    case 6:
+        return MIN(value + 1, 255);
+    case 7:
+        return MAX(value - 1, 0);
+    default:
+        return value;
+    }
+}
+
+static float render_factor(unsigned factor, unsigned component,
+                            const float source[4], const float dest[4],
+                            const float constant[4])
+{
+    unsigned index = factor & 16 ? 3 : component;
+    float value;
+
+    switch (factor & 7) {
+    case 0:
+        value = source[index];
+        break;
+    case 1:
+        value = dest[index];
+        break;
+    case 2:
+        value = constant[index];
+        break;
+    case 3:
+        value = 0;
+        break;
+    case 4:
+        value = component == 3 ? 1 : MIN(source[3], 1 - dest[3]);
+        break;
+    default:
+        value = 0;
+        break;
+    }
+    return factor & 8 ? 1 - value : value;
+}
+
+static unsigned render_unorm(float value, unsigned maximum)
+{
+    if (isnan(value)) {
+        return 0;
+    }
+    return floorf(CLAMP(value, 0, 1) * maximum + 0.5f);
+}
+
+static unsigned render_logic(unsigned op, unsigned a, unsigned b)
+{
+    switch (op) {
+    case 0: return 0;
+    case 1: return ~(a | b);
+    case 2: return ~a & b;
+    case 3: return ~a;
+    case 4: return a & ~b;
+    case 5: return ~b;
+    case 6: return a ^ b;
+    case 7: return ~(a & b);
+    case 8: return a & b;
+    case 9: return ~(a ^ b);
+    case 10: return b;
+    case 11: return ~a | b;
+    case 12: return a;
+    case 13: return a | ~b;
+    case 14: return a | b;
+    default: return 255;
+    }
+}
+
+static bool render_blend(const uint32_t state[16], const float source[4],
+                          float dest[4])
+{
+    float constant[4] = {
+        (state[1] & 255) / 255.0f, ((state[0] >> 16) & 255) / 255.0f,
+        (state[0] & 255) / 255.0f, ((state[1] >> 16) & 255) / 255.0f,
+    };
+    float output[4];
+    unsigned mask = state[2] >> 28, i;
+
+    for (i = 0; i < 4; i++) {
+        unsigned function = (state[2] >> (i == 3 ? 3 : 0)) & 7;
+        unsigned src = (state[2] >> (i == 3 ? 16 : 6)) & (i == 3 ? 15 : 31);
+        unsigned dst = (state[2] >> (i == 3 ? 20 : 11)) & (i == 3 ? 15 : 31);
+        float a, b;
+
+        output[i] = dest[i];
+        if (!(mask & (1u << i))) {
+            continue;
+        }
+        if (function == 3) {
+            output[i] = (render_logic(src & 15,
+                                      render_unorm(source[i], 255),
+                                      render_unorm(dest[i], 255)) & 255) /
+                        255.0f;
+            continue;
+        }
+        if (function == 4 || function == 5) {
+            output[i] = function == 4 ? fminf(source[i], dest[i]) :
+                                        fmaxf(source[i], dest[i]);
+            continue;
+        }
+        if (function > 5 || (src & 7) > 4 || (dst & 7) > 4) {
+            return false;
+        }
+        a = source[i] * render_factor(src, i, source, dest, constant);
+        b = dest[i] * render_factor(dst, i, source, dest, constant);
+        output[i] = function == 0 ? a - b : function == 1 ? b - a : a + b;
+    }
+    for (i = 0; i < 4; i++) {
+        dest[i] = CLAMP(output[i], 0, 1);
+    }
+    return true;
+}
+
+static bool render_top_left(const MALIRenderVertex *a,
+                             const MALIRenderVertex *b)
+{
+    return b->position[1] < a->position[1] ||
+           (b->position[1] == a->position[1] &&
+            b->position[0] > a->position[0]);
+}
+
+static bool render_shader(MALIRenderDraw *draw, MALIPPEnvironment *environment,
+                           float color[4], bool *discard)
+{
+    unsigned fault;
+
+    if (draw->constant_valid) {
+        memcpy(color, draw->constant_color, sizeof(draw->constant_color));
+        *discard = draw->constant_discard;
+        return true;
+    }
+    environment->opaque = draw;
+    environment->sample = render_sample;
+    environment->uniform = render_uniform;
+    environment->color_register = (draw->state[8] >> 16) & 15;
+    if (!mst12_mali_pp_execute(draw->program, environment, color, discard,
+                               &fault)) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali fragment execution unsupported: shader=0x%08x "
+            "word=%u pixel=%g,%g\n", draw->state[9] & ~31u, fault,
+            environment->fragcoord[0], environment->fragcoord[1]);
+        return false;
+    }
+    if (draw->program->constant_only) {
+        memcpy(draw->constant_color, color, sizeof(draw->constant_color));
+        draw->constant_discard = *discard;
+        draw->constant_valid = true;
+    }
+    return true;
+}
+
+static bool render_triangle(const MALIRenderTriangle *triangle,
+                             const MALIPPTile *tile, unsigned width,
+                             unsigned height, const uint32_t frame[24],
+                             float colors[256][4], float depths[256],
+                             uint8_t stencils[256], MALIRenderResult *result)
+{
+    MALIRenderDraw *draw = triangle->draw;
+    const uint32_t *state = draw->state;
+    const MALIDraw *command = draw->command;
+    const MALIRenderVertex *v = triangle->vertex;
+    unsigned xmin = MAX(tile->x * 16, command->clip[0]);
+    unsigned ymin = MAX(tile->y * 16, command->clip[1]);
+    unsigned xmax = MIN(MIN((tile->x + 1) * 16, width), command->clip[2]);
+    unsigned ymax = MIN(MIN((tile->y + 1) * 16, height), command->clip[3]);
+    uint32_t stencil = state[triangle->frontface ? 5 : 6];
+    unsigned reference = (stencil >> 16) & 255, readmask = stencil >> 24;
+    unsigned writemask = (state[7] >> (triangle->frontface ? 0 : 8)) & 255;
+    unsigned x, y;
+
+    xmin = MAX(xmin, MAX(0, (int)ceilf(MIN(MIN(v[0].position[0],
+                                               v[1].position[0]),
+                                           v[2].position[0]) - 0.5f)));
+    ymin = MAX(ymin, MAX(0, (int)ceilf(MIN(MIN(v[0].position[1],
+                                               v[1].position[1]),
+                                           v[2].position[1]) - 0.5f)));
+    xmax = MIN(xmax, MAX(0, (int)ceilf(MAX(MAX(v[0].position[0],
+                                               v[1].position[0]),
+                                           v[2].position[0]) - 0.5f)));
+    ymax = MIN(ymax, MAX(0, (int)ceilf(MAX(MAX(v[0].position[1],
+                                               v[1].position[1]),
+                                           v[2].position[1]) - 0.5f)));
+
+    if (!(state[8] & 0xf000)) {
+        return true;
+    }
+    for (y = ymin; y < ymax; y++) {
+        for (x = xmin; x < xmax; x++) {
+            float weight[3], reciprocal, depth, color[4];
+            unsigned index = (y & 15) * 16 + (x & 15), i, component, op;
+            bool inside = true, discard, stencil_pass, depth_pass;
+            MALIPPEnvironment environment = {
+                .frontface = triangle->frontface,
+            };
+
+            for (i = 0; i < 3; i++) {
+                const MALIRenderVertex *a = &v[(i + 1) % 3];
+                const MALIRenderVertex *b = &v[(i + 2) % 3];
+                float edge = render_edge(a, b, x + 0.5f, y + 0.5f);
+
+                if (edge < 0 || (edge == 0 && !render_top_left(a, b))) {
+                    inside = false;
+                    break;
+                }
+                weight[i] = edge / triangle->area;
+            }
+            if (!inside) {
+                continue;
+            }
+            depth = weight[0] * v[0].position[2] +
+                    weight[1] * v[1].position[2] + weight[2] * v[2].position[2];
+            reciprocal = weight[0] * v[0].position[3] +
+                         weight[1] * v[1].position[3] +
+                         weight[2] * v[2].position[3];
+            if (!isfinite(reciprocal) || reciprocal == 0) {
+                return false;
+            }
+            if ((!((state[3] >> 4) & 1) && depth < 0) ||
+                (!((state[3] >> 5) & 1) && depth > 1)) {
+                continue;
+            }
+            environment.fragcoord[0] = x + 0.5f;
+            environment.fragcoord[1] = frame[21] & 1024 ?
+                                        height - y - 0.5f : y + 0.5f;
+            environment.fragcoord[2] = depth;
+            environment.fragcoord[3] = reciprocal;
+            environment.depth = depths[index];
+            memcpy(environment.framebuffer, colors[index], sizeof(color));
+            for (i = 0; i < draw->varyings; i++) {
+                component = draw->varying_component[i];
+                environment.varying[component] =
+                    (weight[0] * v[0].varying[component] * v[0].position[3] +
+                     weight[1] * v[1].varying[component] * v[1].position[3] +
+                     weight[2] * v[2].varying[component] * v[2].position[3]) /
+                    reciprocal;
+            }
+            if (!render_shader(draw, &environment, color, &discard)) {
+                return false;
+            }
+            result->fragments++;
+            if (draw->io->trace && !draw->fragment_traced) {
+                draw->fragment_traced = true;
+                qemu_log_mask(LOG_UNIMP,
+                    "MST12 Mali fragment sample: state=0x%08x "
+                    "pixel=%u,%u rgba=%g,%g,%g,%g discard=%u "
+                    "blend=0x%08x depth=0x%08x stencil=0x%08x "
+                    "alpha=0x%08x varying=%g,%g,%g,%g\n",
+                    command->render_state, x, y,
+                    color[0], color[1], color[2], color[3], discard,
+                    state[2], state[3], stencil, state[8],
+                    environment.varying[0], environment.varying[1],
+                    environment.varying[2], environment.varying[3]);
+            }
+            if (discard ||
+                !render_compare(state[8] & 7, color[3],
+                                  ((state[7] >> 16) & 255) / 255.0f)) {
+                continue;
+            }
+            stencil_pass = render_compare(stencil & 7, reference & readmask,
+                                           stencils[index] & readmask);
+            depth_pass = render_compare((state[3] >> 1) & 7,
+                                         depth, depths[index]);
+            op = !stencil_pass ? (stencil >> 3) & 7 :
+                 !depth_pass ? (stencil >> 6) & 7 : (stencil >> 9) & 7;
+            stencils[index] = (stencils[index] & ~writemask) |
+                (render_stencil(op, reference, stencils[index]) & writemask);
+            if (!stencil_pass || !depth_pass) {
+                continue;
+            }
+            if (state[3] & 1) {
+                depths[index] = CLAMP(depth, 0, 1);
+            }
+            if (state[8] & 256) {
+                color[3] = 1;
+            }
+            if (!render_blend(state, color, colors[index])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static unsigned render_pixel_size(unsigned type, unsigned format)
+{
+    if (type == 2) {
+        return format <= 2 ? 2 : format == 3 ? 4 : 0;
+    }
+    return type == 1 ? format == 14 ? 2 : format == 15 ? 4 : 0 : 0;
+}
+
+static uint64_t render_pixel_offset(const uint32_t wb[12], unsigned x,
+                                    unsigned y, unsigned size)
+{
+    return wb[4] == 2 ?
+        ((uint64_t)(y >> 4) * wb[5] + (x >> 4)) * 256 * size +
+         render_tile_index(x & 15, y & 15) * size :
+        (uint64_t)y * wb[5] * 8 + x * size;
+}
+
+static bool render_validate_target(const uint32_t wb[12], GArray *tiles,
+                                    unsigned width, unsigned height,
+                                    const MALIRenderIO *io)
+{
+    unsigned size = render_pixel_size(wb[0], wb[2]), i;
+
+    if (!wb[0]) {
+        return true;
+    }
+    if (!size || wb[3] || (wb[4] != 0 && wb[4] != 2) ||
+        wb[6] || wb[7] || (wb[8] & ~4u) ||
+        (wb[4] == 0 ? (uint64_t)wb[5] * 8 < width * size :
+                      wb[5] < (width + 15) / 16)) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali writeback unsupported: type=%u format=%u "
+            "layout=%u pitch=%u flags=0x%x\n",
+            wb[0], wb[2], wb[4], wb[5], wb[8]);
+        return false;
+    }
+    for (i = 0; i < tiles->len; i++) {
+        const MALIPPTile *tile = &g_array_index(tiles, MALIPPTile, i);
+        unsigned x = tile->x * 16, y = tile->y * 16;
+        unsigned rows = MIN(16, height - y), columns = MIN(16, width - x), j;
+
+        if (wb[4] == 2) {
+            uint64_t address = wb[1] + render_pixel_offset(wb, x, y, size);
+
+            if (address + size * 256 > (1ULL << 32) ||
+                !io->validate(io->opaque, address, size * 256, true)) {
+                return false;
+            }
+        } else {
+            for (j = 0; j < rows; j++) {
+                uint64_t address = wb[1] +
+                    render_pixel_offset(wb, x, y + j, size);
+
+                if (address + columns * size > (1ULL << 32) ||
+                    !io->validate(io->opaque, address, columns * size, true)) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static void render_pack_pixel(const uint32_t wb[12], const float color[4],
+                              float depth, uint8_t stencil, uint8_t *data)
+{
+    float r = color[wb[8] & 4 ? 2 : 0], g = color[1];
+    float b = color[wb[8] & 4 ? 0 : 2], a = color[3];
+    unsigned value;
+
+    if (wb[0] == 1) {
+        if (wb[2] == 14) {
+            stw_le_p(data, render_unorm(depth, 65535));
+        } else {
+            stl_le_p(data, render_unorm(depth, 0xffffff) | (stencil << 24));
+        }
+        return;
+    }
+    switch (wb[2]) {
+    case 0:
+        value = (render_unorm(r, 31) << 11) |
+                (render_unorm(g, 63) << 5) | render_unorm(b, 31);
+        break;
+    case 1:
+        value = (render_unorm(r, 31) << 11) | (render_unorm(g, 31) << 6) |
+                (render_unorm(b, 31) << 1) | render_unorm(a, 1);
+        break;
+    case 2:
+        value = (render_unorm(r, 15) << 12) | (render_unorm(g, 15) << 8) |
+                (render_unorm(b, 15) << 4) | render_unorm(a, 15);
+        break;
+    default:
+        data[0] = render_unorm(b, 255);
+        data[1] = render_unorm(g, 255);
+        data[2] = render_unorm(r, 255);
+        data[3] = render_unorm(a, 255);
+        return;
+    }
+    stw_le_p(data, value);
+}
+
+static bool render_write_tile(const uint32_t wb[12], const MALIPPTile *tile,
+                               unsigned width, unsigned height,
+                               const MALIRenderIO *io, float colors[256][4],
+                               float depths[256], uint8_t stencils[256])
+{
+    uint8_t data[1024];
+    unsigned size = render_pixel_size(wb[0], wb[2]);
+    unsigned columns = MIN(16, width - tile->x * 16);
+    unsigned rows = MIN(16, height - tile->y * 16), x, y;
+
+    if (!wb[0]) {
+        return true;
+    }
+    for (y = 0; y < rows; y++) {
+        for (x = 0; x < columns; x++) {
+            unsigned index = y * 16 + x;
+            unsigned offset =
+                (wb[4] == 2 ? render_tile_index(x, y) : index) * size;
+
+            render_pack_pixel(wb, colors[index], depths[index], stencils[index],
+                               data + offset);
+        }
+    }
+    if (wb[4] == 2 && rows == 16 && columns == 16) {
+        uint32_t address = wb[1] +
+            render_pixel_offset(wb, tile->x * 16, tile->y * 16, size);
+
+        return io->write(io->opaque, address, data, 256 * size);
+    }
+    for (y = 0; y < rows; y++) {
+        if (wb[4] == 0) {
+            uint32_t address = wb[1] +
+                render_pixel_offset(wb, tile->x * 16, tile->y * 16 + y, size);
+
+            if (!io->write(io->opaque, address, data + y * 16 * size,
+                            columns * size)) {
+                return false;
+            }
+        } else {
+            for (x = 0; x < columns; x++) {
+                uint32_t address = wb[1] + render_pixel_offset(wb,
+                    tile->x * 16 + x, tile->y * 16 + y, size);
+
+                if (!io->write(io->opaque, address,
+                    data + render_tile_index(x, y) * size, size)) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+bool mst12_mali_pp_render(const MALITileBatch batches[MALI_TILE_BATCHES],
+                          unsigned next_batch, uint32_t directory, bool paging,
+                          const uint32_t frame[24],
+                          const uint32_t writeback[3][12],
+                          const MALIRenderIO *io, MALIRenderResult *result)
+{
+    const MALITileBatch *batch = NULL;
+    g_autoptr(GArray) tiles = g_array_new(false, false, sizeof(MALIPPTile));
+    g_autoptr(GArray) triangles =
+        g_array_new(false, false, sizeof(MALIRenderTriangle));
+    g_autofree MALIRenderDraw *draws = NULL;
+    float colors[256][4], depths[256], clear[4], background[4] = { 0 };
+    uint8_t stencils[256];
+    unsigned width, height, i, j, component, initialized = 0;
+    bool success = false, constant_background, output = false, discard;
+
+    memset(result, 0, sizeof(*result));
+    result->list = frame[0];
+    if (!render_parse_tiles(batches, next_batch, directory, paging, io,
+                              result, tiles, &batch)) {
+        return false;
+    }
+    if (!tiles->len) {
+        return true;
+    }
+    width = frame[10] & 0x3fff ? (frame[10] & 0x3fff) + 1 : batch->tiles_x * 16;
+    height = frame[11] & 0x3fff ?
+               (frame[11] & 0x3fff) + 1 : batch->tiles_y * 16;
+    if (!width || !height || width > batch->tiles_x * 16 ||
+        height > batch->tiles_y * 16 || (frame[3] & 1) ||
+        (frame[21] & 0x770000) || (frame[22] && frame[22] != 0x8888)) {
+        return false;
+    }
+    for (i = 0; i < tiles->len; i++) {
+        const MALIPPTile *tile = &g_array_index(tiles, MALIPPTile, i);
+
+        if (tile->x * 16 >= width || tile->y * 16 >= height) {
+            return false;
+        }
+    }
+    for (i = 0; i < 3; i++) {
+        output |= writeback[i][0] != 0;
+        if (!render_validate_target(writeback[i], tiles, width, height, io)) {
+            return false;
+        }
+    }
+    draws = g_new0(MALIRenderDraw, batch->draw_count + 1);
+    initialized = 1;
+    if (!render_load_state(&draws[0], frame[1], io)) {
+        goto done;
+    }
+    constant_background = draws[0].program->constant_only;
+    for (component = 0; component < 4; component++) {
+        clear[component] = ((frame[6] >> (component * 8)) & 255) / 255.0f;
+    }
+    if (constant_background && (draws[0].state[2] >> 28)) {
+        MALIPPEnvironment environment = { 0 };
+
+        memcpy(environment.framebuffer, clear, sizeof(clear));
+        environment.depth = (frame[4] & 0xffffff) / 16777215.0f;
+        if (!render_shader(&draws[0], &environment, background, &discard)) {
+            goto done;
+        }
+        if (discard) {
+            memcpy(background, clear, sizeof(clear));
+        }
+    }
+    for (i = 0; i < batch->draw_count; i++) {
+        MALIRenderDraw *draw = &draws[i + 1];
+
+        initialized++;
+        draw->command = &batch->draws[i];
+        if (!render_load_state(draw, draw->command->render_state, io) ||
+            !render_prepare_triangles(draw, triangles)) {
+            goto done;
+        }
+    }
+    result->triangles = triangles->len;
+    for (i = 0; i < tiles->len; i++) {
+        const MALIPPTile *tile = &g_array_index(tiles, MALIPPTile, i);
+
+        for (j = 0; j < 256; j++) {
+            unsigned mask = draws[0].state[2] >> 28;
+
+            memcpy(colors[j], clear, sizeof(clear));
+            depths[j] = (frame[4] & 0xffffff) / 16777215.0f;
+            stencils[j] = frame[5];
+            if (mask) {
+                float color[4];
+
+                if (constant_background) {
+                    memcpy(color, background, sizeof(color));
+                } else {
+                    MALIPPEnvironment environment = { 0 };
+
+                    environment.fragcoord[0] = tile->x * 16 + (j & 15) + 0.5f;
+                    environment.fragcoord[1] = tile->y * 16 + (j >> 4) + 0.5f;
+                    environment.fragcoord[2] = depths[j];
+                    environment.fragcoord[3] = 1;
+                    environment.depth = depths[j];
+                    memcpy(environment.framebuffer, clear, sizeof(clear));
+                    if (!render_shader(&draws[0], &environment,
+                                         color, &discard)) {
+                        goto done;
+                    }
+                    if (discard) {
+                        continue;
+                    }
+                }
+                for (component = 0; component < 4; component++) {
+                    if (mask & (1u << component)) {
+                        colors[j][component] = color[component];
+                    }
+                }
+            }
+        }
+        for (j = 0; j < triangles->len; j++) {
+            const MALIRenderTriangle *triangle =
+                &g_array_index(triangles, MALIRenderTriangle, j);
+
+            if (!render_triangle(triangle,
+                                   tile, width, height, frame,
+                                   colors, depths, stencils, result)) {
+                goto done;
+            }
+        }
+        if (io->trace) {
+            for (j = 0; j < 256; j++) {
+                result->colored_pixels += colors[j][0] > 0 ||
+                                           colors[j][1] > 0 ||
+                                           colors[j][2] > 0;
+            }
+        }
+        for (j = 0; j < 3; j++) {
+            if (!render_write_tile(writeback[j], tile, width, height, io,
+                                    colors, depths, stencils)) {
+                goto done;
+            }
+        }
+        result->tiles++;
+        if (output) {
+            result->pixels += MIN(16, width - tile->x * 16) *
+                               MIN(16, height - tile->y * 16);
+        }
+    }
+    success = true;
+done:
+    for (i = 0; i < initialized; i++) {
+        render_free_draw(&draws[i]);
+    }
+    return success;
+}
diff --git a/hw/display/mst12_mali_shader.c b/hw/display/mst12_mali_shader.c
new file mode 100644
index 0000000000000000000000000000000000000000..cc689452c80f505cb770ae0d4f8a5561d1f1285d
--- /dev/null
+++ b/hw/display/mst12_mali_shader.c
@@ -0,0 +1,1272 @@
+/*
+ * Functional ARM Utgard shader execution.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Instruction fields are documented by Mesa's Lima GP/PP codegen headers.
+ * The complex2/complex/complex1 lowering sequence is evaluated as a complete
+ * mathematical operation, rather than a model of the hardware lookup table.
+ * Unknown encodings fail; no shader is replaced by a guessed result.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "hw/display/mst12_mali_shader.h"
+
+typedef struct MALIValue {
+    float value;
+    float input;
+    unsigned special;
+} MALIValue;
+
+typedef struct MALIGPExecution {
+    MALIValue registers[MALI_SHADER_REGISTERS][4];
+    MALIValue previous[2][7];
+    MALIValue previous_attribute[4];
+    float temporary[MALI_GP_MAX_UNIFORMS * 4];
+    int address[4];
+    bool valid;
+} MALIGPExecution;
+
+/* Explicit little-endian bit extraction avoids host C bitfield layouts. */
+static uint32_t shader_bits(const uint8_t *code, unsigned start, unsigned size)
+{
+    uint32_t value = 0;
+    unsigned i;
+
+    for (i = 0; i < size; i++) {
+        value |= ((code[(start + i) / 8] >> ((start + i) % 8)) & 1u) << i;
+    }
+    return value;
+}
+
+static MALIValue shader_value(float value)
+{
+    return (MALIValue) { .value = value };
+}
+
+static MALIValue gp_source(MALIGPExecution *e, unsigned source,
+                           unsigned unit, unsigned operand,
+                           const MALIValue attribute[4], unsigned register1,
+                           unsigned load, unsigned offset)
+{
+    int index;
+
+    if (source < 4) {
+        return attribute[source];
+    }
+    if (source < 8) {
+        return e->registers[register1][source - 4];
+    }
+    if (source >= 12 && source < 16) {
+        index = load;
+        if (offset >= 1 && offset <= 3) {
+            index += e->address[offset];
+        } else if (offset != 7) {
+            e->valid = false;
+        }
+        if (index < 0 || index >= MALI_GP_MAX_UNIFORMS) {
+            e->valid = false;
+            return shader_value(0);
+        }
+        return shader_value(e->temporary[index * 4 + source - 12]);
+    }
+    switch (source) {
+    case 16:
+    case 17:
+    case 18:
+    case 19:
+    case 20:
+        return e->previous[0][source - 16];
+    case 21: /* Unused execution unit input. */
+        return shader_value(0);
+    case 22:
+        if (operand == 1 && unit < 4) {
+            return shader_value(unit >= 2 ? 1 : 0);
+        }
+        return e->previous[0][6];
+    case 23:
+        return e->previous[1][4];
+    case 24:
+    case 25:
+    case 26:
+    case 27:
+        return e->previous[1][source - 24];
+    case 28:
+    case 29:
+    case 30:
+    case 31:
+        return e->previous_attribute[source - 28];
+    default:
+        e->valid = false;
+        return shader_value(0);
+    }
+}
+
+static MALIValue gp_accumulate(MALIGPExecution *e, unsigned op,
+                               MALIValue a, MALIValue b,
+                               bool negate_a, bool negate_b)
+{
+    float x = negate_a ? -a.value : a.value;
+    float y = negate_b ? -b.value : b.value;
+
+    switch (op) {
+    case 0:
+        if (y == 0 && !negate_a) {
+            return a;
+        }
+        return shader_value(x + y);
+    case 1:
+        return shader_value(floorf(x));
+    case 2:
+        return shader_value(x > 0 ? 1 : x < 0 ? -1 : 0);
+    case 4:
+        return shader_value(x >= y);
+    case 5:
+        return shader_value(x < y);
+    case 6:
+        return shader_value(fminf(x, y));
+    case 7:
+        return shader_value(fmaxf(x, y));
+    default:
+        e->valid = false;
+        return shader_value(0);
+    }
+}
+
+static void gp_store(MALIGPExecution *e, MALIGPOutput *output,
+                     MALIValue value, unsigned address, unsigned component,
+                     bool varying, bool temporary)
+{
+    if (temporary) {
+        if (e->address[0] < 0 || e->address[0] >= MALI_GP_MAX_UNIFORMS) {
+            e->valid = false;
+            return;
+        }
+        e->temporary[e->address[0] * 4 + component] = value.value;
+    } else if (varying) {
+        /* Intermediate lookup-table encodings are not vertex outputs. */
+        if (value.special) {
+            e->valid = false;
+            return;
+        }
+        output->value[address][component] = value.value;
+        output->mask[address] |= 1u << component;
+    } else {
+        e->registers[address][component] = value;
+    }
+}
+
+bool mst12_mali_gp_execute(const uint8_t *code, unsigned instructions,
+                           const float attributes[MALI_SHADER_REGISTERS][4],
+                           const float *uniforms, unsigned uniform_count,
+                           MALIGPOutput *output, unsigned *fault_instruction)
+{
+    MALIGPExecution e = { .valid = true };
+    unsigned pc = 0, steps = 0;
+
+    if (!instructions || instructions > MALI_GP_MAX_INSTRUCTIONS ||
+        uniform_count > MALI_GP_MAX_UNIFORMS * 4) {
+        *fault_instruction = 0;
+        return false;
+    }
+    memcpy(e.temporary, uniforms, uniform_count * sizeof(float));
+    memset(output, 0, sizeof(*output));
+    while (pc < instructions && steps++ < 16384) {
+        const uint8_t *instruction = code + pc * 16;
+        MALIValue result[7] = { 0 }, attribute[4], input[4][2];
+        unsigned load = shader_bits(instruction, 46, 9);
+        unsigned offset = shader_bits(instruction, 55, 3);
+        unsigned register0 = shader_bits(instruction, 58, 4);
+        unsigned register1 = shader_bits(instruction, 63, 4);
+        unsigned mul_op = shader_bits(instruction, 100, 3);
+        unsigned complex_op = shader_bits(instruction, 86, 4);
+        unsigned i, next = pc + 1;
+
+        for (i = 0; i < 4; i++) {
+            attribute[i] = shader_bits(instruction, 62, 1) ?
+                           shader_value(attributes[register0][i]) :
+                           e.registers[register0][i];
+        }
+        for (i = 0; i < 4; i++) {
+            unsigned base = i < 2 ? 22 + i * 10 : (i - 2) * 10;
+
+            input[i][0] = gp_source(&e, shader_bits(instruction, base, 5),
+                                    i, 0, attribute, register1, load, offset);
+            input[i][1] = gp_source(&e, shader_bits(instruction, base + 5, 5),
+                                    i, 1, attribute, register1, load, offset);
+        }
+        for (i = 0; i < 2; i++) {
+            if (shader_bits(instruction, 22 + i * 10, 5) != 21) {
+                result[i] = gp_accumulate(&e, shader_bits(instruction, 83, 3),
+                    input[i][0], input[i][1],
+                    shader_bits(instruction, 42 + i * 2, 1),
+                    shader_bits(instruction, 43 + i * 2, 1));
+            }
+        }
+        if (mul_op == 1) {
+            MALIValue a = input[2][0], b = input[2][1];
+
+            /* The verified Mesa lowering repeats the estimate and input. */
+            if (a.special < 18 || a.special > 21 || b.special != 1 ||
+                a.input != b.input || input[3][0].special != a.special ||
+                input[3][0].value != a.value ||
+                input[3][1].value != a.input) {
+                e.valid = false;
+            }
+            result[2] = shader_value(a.value);
+        } else if (mul_op == 4) {
+            result[2] = input[2][1].value != 0 ? input[2][0] : input[3][0];
+        } else if (mul_op == 0 || mul_op == 3) {
+            for (i = 2; i < 4; i++) {
+                unsigned source0 = shader_bits(instruction, (i - 2) * 10, 5);
+                unsigned source1 = shader_bits(instruction,
+                                                (i - 2) * 10 + 5, 5);
+
+                if (source0 == 21 || source1 == 21) {
+                    continue;
+                }
+                if (i == 2 && mul_op == 3 && source1 != 22) {
+                    if (input[i][0].value != input[i][1].value) {
+                        e.valid = false;
+                    }
+                    result[i] = (MALIValue) {
+                        .value = input[i][0].value,
+                        .input = input[i][0].value,
+                        .special = 1,
+                    };
+                } else if (source1 == 22 &&
+                           !shader_bits(instruction, 18 + i, 1)) {
+                    result[i] = input[i][0];
+                } else {
+                    float value = input[i][0].value * input[i][1].value;
+
+                    result[i] = shader_value(
+                        shader_bits(instruction, 18 + i, 1) ? -value : value);
+                }
+            }
+        } else {
+            e.valid = false;
+        }
+        if (shader_bits(instruction, 106, 5) != 21 && complex_op) {
+            MALIValue a = gp_source(&e, shader_bits(instruction, 106, 5),
+                                    6, 0, attribute, register1, load, offset);
+            float value = a.value;
+
+            switch (complex_op) {
+            case 2:
+                value = exp2f(value);
+                break;
+            case 3:
+                value = log2f(value);
+                break;
+            case 4:
+                value = 1 / sqrtf(value);
+                break;
+            case 5:
+                value = 1 / value;
+                break;
+            case 9:
+                result[6] = a;
+                break;
+            case 12:
+            case 13:
+            case 14:
+            case 15:
+                if (!isfinite(value) || value < INT_MIN || value >= INT_MAX) {
+                    e.valid = false;
+                } else {
+                    e.address[complex_op - 12] = (int)value;
+                }
+                result[6] = a;
+                break;
+            default:
+                e.valid = false;
+                break;
+            }
+            if (complex_op >= 2 && complex_op <= 5) {
+                result[6] = (MALIValue) {
+                    .value = value, .input = a.value,
+                    .special = complex_op + 16,
+                };
+            }
+        }
+        if (shader_bits(instruction, 111, 5) != 21) {
+            result[4] = gp_source(&e, shader_bits(instruction, 111, 5),
+                                  4, 0, attribute, register1, load, offset);
+            switch (shader_bits(instruction, 103, 3)) {
+            case 2:
+                break;
+            case 4: /* Exact functional exp2/log2, without LUT range packing. */
+            case 5:
+                result[4].special = 0;
+                break;
+            case 6: {
+                MALIValue low = gp_source(&e, 12, 4, 1, attribute,
+                                          register1, load, offset);
+                MALIValue high = gp_source(&e, 13, 4, 2, attribute,
+                                           register1, load, offset);
+
+                result[4] = shader_value(fminf(high.value,
+                    fmaxf(low.value, result[4].value)));
+                break;
+            }
+            default:
+                e.valid = false;
+                break;
+            }
+        }
+        for (i = 0; i < 4; i++) {
+            unsigned source = shader_bits(instruction, 71 + i * 3, 3);
+            unsigned address = shader_bits(instruction, i < 2 ? 90 : 95, 4);
+            bool varying = shader_bits(instruction, i < 2 ? 94 : 99, 1);
+            bool temporary = shader_bits(instruction, i < 2 ? 67 : 68, 1);
+
+            if (source != 7) {
+                if (source == 5) {
+                    e.valid = false;
+                } else {
+                    gp_store(&e, output, result[source], address, i,
+                              varying, temporary);
+                }
+            }
+        }
+        if (shader_bits(instruction, 69, 1) && result[4].value != 0) {
+            next = shader_bits(instruction, 120, 8) +
+                   (shader_bits(instruction, 70, 1) ? 0 : 256);
+            if (next >= instructions) {
+                e.valid = false;
+            }
+        }
+        if (!e.valid) {
+            *fault_instruction = pc;
+            return false;
+        }
+        memcpy(e.previous[1], e.previous[0], sizeof(e.previous[0]));
+        memcpy(e.previous[0], result, sizeof(result));
+        memcpy(e.previous_attribute, attribute, sizeof(attribute));
+        pc = next;
+    }
+    *fault_instruction = pc;
+    return pc == instructions;
+}
+
+static uint64_t shader_bits64(const uint8_t *code, unsigned start,
+                              unsigned size)
+{
+    uint64_t value = 0;
+    unsigned i;
+
+    for (i = 0; i < size; i++) {
+        value |= (uint64_t)((code[(start + i) / 8] >>
+                            ((start + i) % 8)) & 1u) << i;
+    }
+    return value;
+}
+
+static float pp_half(unsigned value)
+{
+    unsigned exponent = (value >> 10) & 31;
+    unsigned fraction = value & 1023;
+    float result;
+
+    if (exponent == 31) {
+        result = fraction ? NAN : INFINITY;
+    } else if (exponent) {
+        result = ldexpf(1 + fraction / 1024.0f, (int)exponent - 15);
+    } else {
+        result = ldexpf(fraction, -24);
+    }
+    return value & 0x8000 ? -result : result;
+}
+
+bool mst12_mali_pp_decode(const uint8_t *code, unsigned words,
+                          MALIPPProgram *program, unsigned *fault_instruction)
+{
+    static const unsigned field_size[12] = {
+        34, 62, 41, 43, 30, 44, 31, 30, 41, 73, 64, 64,
+    };
+    unsigned offset = 0;
+
+    memset(program, 0, sizeof(*program));
+    program->constant_only = true;
+    while (offset < words && program->count < MALI_PP_MAX_INSTRUCTIONS) {
+        const uint8_t *data = code + offset * 4;
+        unsigned count = shader_bits(data, 0, 5);
+        unsigned fields = shader_bits(data, 7, 12);
+        unsigned bits = 32, i;
+        unsigned alu = fields & 0xf8;
+        MALIPPInstruction *instruction =
+            &program->instruction[program->count++];
+
+        *fault_instruction = offset;
+        if (!count || offset + count > words) {
+            return false;
+        }
+        instruction->fields = fields;
+        instruction->offset = offset;
+        instruction->stop = shader_bits(data, 5, 1);
+        instruction->parallel_alu = (alu & (alu - 1)) ||
+                                    (alu && (fields & 512));
+        for (i = 0; i < 12; i++) {
+            if (!(fields & (1u << i))) {
+                continue;
+            }
+            if (bits + field_size[i] > count * 32) {
+                return false;
+            }
+            instruction->field[i] = shader_bits64(data, bits,
+                                                   MIN(field_size[i], 64));
+            if (i >= 10) {
+                unsigned component;
+
+                for (component = 0; component < 4; component++) {
+                    instruction->constant[i - 10][component] =
+                        pp_half(instruction->field[i] >> (component * 16));
+                }
+            }
+            if (i == 9) {
+                instruction->branch_target =
+                    (int32_t)(shader_bits(data, bits + 41, 27) << 5) >> 5;
+                instruction->branch_target += offset;
+                instruction->discard =
+                    shader_bits(data, bits, 32) == 0x007f0003 &&
+                    shader_bits(data, bits + 32, 32) == 0 &&
+                    shader_bits(data, bits + 64, 9) == 0;
+            }
+            bits += field_size[i];
+        }
+        if ((bits + 31) / 32 != count) {
+            return false;
+        }
+        if (fields & 0x307) {
+            program->constant_only = false;
+        }
+        if ((fields & 1) && ((instruction->field[0] >> 2) & 3) == 0) {
+            uint64_t field = instruction->field[0];
+            unsigned alignment = (field >> 5) & 3;
+            unsigned scalar = ((field >> 18) & 63) <<
+                              (alignment == 3 ? 2 : alignment);
+            unsigned component = 0, load_count = 1u << MIN(alignment, 2);
+
+            if (((field >> 10) & 15) != 15) {
+                /* Register-relative loads can address any varying. */
+                program->varying_mask = UINT64_MAX;
+            } else {
+                for (i = 0; i < 4; i++) {
+                    unsigned source;
+
+                    if (!(field & (1ULL << (28 + i)))) {
+                        continue;
+                    }
+                    source = alignment >= 2 ? i : component++;
+                    if (source < load_count && scalar + source < 64) {
+                        program->varying_mask |= 1ULL << (scalar + source);
+                    }
+                }
+            }
+        }
+        offset += count;
+        if (instruction->stop) {
+            break;
+        }
+    }
+    return program->count &&
+           program->instruction[program->count - 1].stop;
+}
+
+static float pp_modify_source(float value, bool absolute, bool negative)
+{
+    if (absolute) {
+        value = fabsf(value);
+    }
+    return negative ? -value : value;
+}
+
+static float pp_modify_dest(float value, unsigned modifier)
+{
+    switch (modifier) {
+    case 1:
+        return fminf(1, fmaxf(0, value));
+    case 2:
+        return fmaxf(0, value);
+    case 3:
+        return roundf(value);
+    default:
+        return value;
+    }
+}
+
+static bool pp_multiply(unsigned op, float a, float b, float *result)
+{
+    if (op < 8) {
+        float product = a * b;
+
+        *result = op ? ldexpf(product, op >= 4 ? (int)op - 8 : op) : product;
+        return true;
+    }
+    switch (op) {
+    case 8:
+        *result = a == 0;
+        break;
+    case 9:
+        *result = a != 0 && b != 0;
+        break;
+    case 10:
+        *result = a != 0 || b != 0;
+        break;
+    case 11:
+        *result = (a != 0) != (b != 0);
+        break;
+    case 12:
+        *result = a != b;
+        break;
+    case 13:
+        *result = a > b;
+        break;
+    case 14:
+        *result = a >= b;
+        break;
+    case 15:
+        *result = a == b;
+        break;
+    case 16:
+        *result = fminf(a, b);
+        break;
+    case 17:
+        *result = fmaxf(a, b);
+        break;
+    case 31:
+        *result = a;
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static bool pp_accumulate(unsigned op, float a, float b, float condition,
+                          float *result)
+{
+    switch (op) {
+    case 0:
+        *result = a + b;
+        break;
+    case 4:
+        *result = a - floorf(a);
+        break;
+    case 8:
+        *result = a != b;
+        break;
+    case 9:
+        *result = a > b;
+        break;
+    case 10:
+        *result = a >= b;
+        break;
+    case 11:
+        *result = a == b;
+        break;
+    case 12:
+        *result = floorf(a);
+        break;
+    case 13:
+        *result = ceilf(a);
+        break;
+    case 14:
+        *result = fminf(a, b);
+        break;
+    case 15:
+        *result = fmaxf(a, b);
+        break;
+    case 23:
+        *result = condition != 0 ? a : b;
+        break;
+    case 31:
+        *result = a;
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+static void pp_vector_source(const float registers[64], unsigned source,
+                              unsigned swizzle, bool absolute, bool negative,
+                              float value[4])
+{
+    unsigned i;
+
+    for (i = 0; i < 4; i++) {
+        value[i] = pp_modify_source(registers[source * 4 +
+                                               ((swizzle >> (i * 2)) & 3)],
+                                     absolute, negative);
+    }
+}
+
+static void pp_vector_dest(float registers[64], unsigned dest,
+                            unsigned mask, unsigned modifier,
+                            const float value[4])
+{
+    unsigned i;
+
+    for (i = 0; i < 4; i++) {
+        if (mask & (1u << i)) {
+            registers[dest * 4 + i] = pp_modify_dest(value[i], modifier);
+        }
+    }
+}
+
+static uint16_t pp_emit(MALIPPProgram *program, unsigned *count,
+                         MALIPPNode node)
+{
+    unsigned index = (*count)++;
+
+    if (index >= MALI_PP_MAX_NODES) {
+        return 0;
+    }
+    program->node[index] = node;
+    return index;
+}
+
+static uint16_t pp_source_node(MALIPPProgram *program, unsigned *count,
+                                uint16_t source, bool absolute, bool negative)
+{
+    if (absolute) {
+        source = pp_emit(program, count, (MALIPPNode) {
+            .op = MALI_PP_ABSOLUTE, .input = { source },
+        });
+    }
+    if (negative) {
+        source = pp_emit(program, count, (MALIPPNode) {
+            .op = MALI_PP_NEGATE, .input = { source },
+        });
+    }
+    return source;
+}
+
+static void pp_compact_nodes(MALIPPProgram *program, unsigned count)
+{
+    bool needed[MALI_PP_MAX_NODES] = { false };
+    uint16_t remap[MALI_PP_MAX_NODES];
+    unsigned i, j, output = 0;
+
+    for (i = 0; i < 4; i++) {
+        needed[program->output[i]] = true;
+    }
+    /* Samples remain observable even when their values are overwritten. */
+    for (i = 0; i < count; i++) {
+        if (program->node[i].op == MALI_PP_SAMPLE) {
+            for (j = 0; j < 4; j++) {
+                needed[i + j] = true;
+            }
+        }
+    }
+    for (i = count; i-- > 0;) {
+        MALIPPNode *node = &program->node[i];
+
+        if (!needed[i]) {
+            continue;
+        }
+        if (node->op == MALI_PP_SAMPLE) {
+            for (j = 0; j < 4; j++) {
+                needed[node->input[j]] = true;
+            }
+        } else if (node->op == MALI_PP_MULTIPLY ||
+                   node->op == MALI_PP_ADD) {
+            needed[node->input[0]] = needed[node->input[1]] = true;
+        } else if (node->op == MALI_PP_ABSOLUTE ||
+                   node->op == MALI_PP_NEGATE ||
+                   node->op == MALI_PP_SAMPLE_RESULT) {
+            needed[node->input[0]] = true;
+        }
+    }
+    for (i = 0; i < count; i++) {
+        MALIPPNode node = program->node[i];
+
+        if (!needed[i]) {
+            continue;
+        }
+        remap[i] = output;
+        if (node.op == MALI_PP_SAMPLE) {
+            for (j = 0; j < 4; j++) {
+                node.input[j] = remap[node.input[j]];
+            }
+        } else if (node.op == MALI_PP_MULTIPLY || node.op == MALI_PP_ADD) {
+            node.input[0] = remap[node.input[0]];
+            node.input[1] = remap[node.input[1]];
+        } else if (node.op == MALI_PP_ABSOLUTE ||
+                   node.op == MALI_PP_NEGATE ||
+                   node.op == MALI_PP_SAMPLE_RESULT) {
+            node.input[0] = remap[node.input[0]];
+        }
+        program->node[output++] = node;
+    }
+    for (i = 0; i < 4; i++) {
+        program->output[i] = remap[program->output[i]];
+    }
+    program->lowered_count = output;
+}
+
+bool mst12_mali_pp_prepare(MALIPPProgram *program, unsigned color_register)
+{
+    uint16_t registers[64] = { 0 }, coordinates[4] = { 0 };
+    unsigned count = 1, pc;
+
+    program->lowered_count = 0;
+    program->node[0] = (MALIPPNode) { .op = MALI_PP_CONSTANT };
+    if (color_register >= 16) {
+        return false;
+    }
+    for (pc = 0; pc < program->count; pc++) {
+        const MALIPPInstruction *instruction = &program->instruction[pc];
+        unsigned fields = instruction->fields, i, component;
+        uint16_t dest[64], vector_mul[4] = { 0 }, scalar_mul = 0;
+        uint64_t field;
+
+        /* Branches, indirect loads and other math retain general execution. */
+        if (fields & ~0xcfb) {
+            return false;
+        }
+        for (i = 10; i < 12; i++) {
+            if (fields & (1u << i)) {
+                for (component = 0; component < 4; component++) {
+                    float constant = instruction->constant[i - 10][component];
+
+                    registers[(i + 2) * 4 + component] =
+                        pp_emit(program, &count, (MALIPPNode) {
+                            .op = MALI_PP_CONSTANT,
+                            .constant = constant,
+                        });
+                }
+            }
+        }
+        if (fields & 1) {
+            unsigned alignment, scalar, mask, source_component = 0;
+
+            field = instruction->field[0];
+            alignment = (field >> 5) & 3;
+            scalar = ((field >> 18) & 63) <<
+                     (alignment == 3 ? 2 : alignment);
+            mask = (field >> 28) & 15;
+            if (((field >> 2) & 3) || (field & 3) >= 2 ||
+                ((field >> 10) & 15) != 15) {
+                return false;
+            }
+            memset(coordinates, 0, sizeof(coordinates));
+            for (component = 0; component < 4; component++) {
+                unsigned source;
+
+                if (!(mask & (1u << component))) {
+                    continue;
+                }
+                source = alignment >= 2 ? component : source_component++;
+                if (scalar + source >= 64) {
+                    return false;
+                }
+                if (source < (1u << MIN(alignment, 2))) {
+                    coordinates[component] = pp_emit(program, &count,
+                        (MALIPPNode) {
+                            .op = MALI_PP_VARYING, .index = scalar + source,
+                        });
+                }
+                if (((field >> 24) & 15) != 15) {
+                    registers[((field >> 24) & 15) * 4 + component] =
+                        coordinates[component];
+                }
+            }
+        }
+        if (fields & 2) {
+            uint16_t sample;
+
+            field = instruction->field[1];
+            if (((field >> 24) & 31) || ((field >> 17) & 3) ||
+                ((field >> 29) & 1)) {
+                return false;
+            }
+            sample = pp_emit(program, &count, (MALIPPNode) {
+                .op = MALI_PP_SAMPLE, .index = (field >> 30) & 4095,
+                .offset = instruction->offset,
+                .input = { coordinates[0], coordinates[1],
+                           coordinates[2], coordinates[3] },
+            });
+            registers[56] = sample;
+            for (component = 1; component < 4; component++) {
+                registers[56 + component] = pp_emit(program, &count,
+                    (MALIPPNode) {
+                        .op = MALI_PP_SAMPLE_RESULT, .input = { sample },
+                    });
+            }
+        }
+        memcpy(dest, registers, sizeof(dest));
+        for (i = 3; i < 8; i++) {
+            unsigned op;
+
+            if (!(fields & (1u << i))) {
+                continue;
+            }
+            field = instruction->field[i];
+            if (i == 3 || i == 5) {
+                op = (field >> 38) & 31;
+                if ((op != 0 && op != 31) || ((field >> 36) & 3)) {
+                    return false;
+                }
+                for (component = 0; component < 4; component++) {
+                    unsigned swizzle = (field >> (4 + component * 2)) & 3;
+                    unsigned swizzle_b =
+                        (field >> (18 + component * 2)) & 3;
+                    uint16_t a = i == 5 && ((field >> 43) & 1) ?
+                        vector_mul[swizzle] :
+                        registers[(field & 15) * 4 + swizzle];
+                    uint16_t b =
+                        registers[((field >> 14) & 15) * 4 + swizzle_b];
+                    uint16_t value;
+
+                    a = pp_source_node(program, &count, a,
+                                        (field >> 12) & 1, (field >> 13) & 1);
+                    b = pp_source_node(program, &count, b,
+                                        (field >> 26) & 1, (field >> 27) & 1);
+                    value = op == 31 ? a : pp_emit(program, &count,
+                        (MALIPPNode) {
+                            .op = i == 3 ? MALI_PP_MULTIPLY : MALI_PP_ADD,
+                            .input = { a, b },
+                        });
+                    if (i == 3) {
+                        vector_mul[component] = value;
+                    }
+                    if (field & (1ULL << (32 + component))) {
+                        dest[((field >> 28) & 15) * 4 + component] = value;
+                    }
+                }
+            } else if (i == 4 || i == 6) {
+                uint16_t a = i == 6 && ((field >> 30) & 1) ? scalar_mul :
+                             registers[field & 63];
+                uint16_t b = registers[(field >> 8) & 63], value;
+
+                op = (field >> 25) & 31;
+                if ((op != 0 && op != 31) || ((field >> 23) & 3)) {
+                    return false;
+                }
+                a = pp_source_node(program, &count, a,
+                                    (field >> 6) & 1, (field >> 7) & 1);
+                b = pp_source_node(program, &count, b,
+                                    (field >> 14) & 1, (field >> 15) & 1);
+                value = op == 31 ? a : pp_emit(program, &count,
+                    (MALIPPNode) {
+                        .op = i == 4 ? MALI_PP_MULTIPLY : MALI_PP_ADD,
+                        .input = { a, b },
+                    });
+                if (i == 4) {
+                    scalar_mul = value;
+                }
+                if ((field >> 22) & 1) {
+                    dest[(field >> 16) & 63] = value;
+                }
+            } else {
+                uint16_t a = registers[(field >> 16) & 63];
+
+                if ((field & 3) != 3) {
+                    return false;
+                }
+                a = pp_source_node(program, &count, a,
+                                    (field >> 14) & 1, (field >> 15) & 1);
+                for (component = 0; component < 4; component++) {
+                    uint16_t b = registers[((field >> 10) & 15) * 4 +
+                                          ((field >> (2 + component * 2)) & 3)];
+                    uint16_t value = pp_emit(program, &count, (MALIPPNode) {
+                        .op = MALI_PP_MULTIPLY, .input = { a, b },
+                    });
+
+                    if (field & (1ULL << (22 + component))) {
+                        dest[((field >> 26) & 15) * 4 + component] = value;
+                    }
+                }
+            }
+        }
+        if (count > MALI_PP_MAX_NODES) {
+            return false;
+        }
+        memcpy(registers, dest, sizeof(registers));
+        if (instruction->stop) {
+            memcpy(program->output, registers + color_register * 4,
+                   sizeof(program->output));
+            program->lowered_register = color_register;
+            pp_compact_nodes(program, count);
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool pp_execute_lowered(const MALIPPProgram *program,
+                                const MALIPPEnvironment *environment,
+                                float color[4], bool *discard,
+                                unsigned *fault_instruction)
+{
+    float value[MALI_PP_MAX_NODES];
+    unsigned i;
+
+    *discard = false;
+    for (i = 0; i < program->lowered_count; i++) {
+        const MALIPPNode *node = &program->node[i];
+
+        switch (node->op) {
+        case MALI_PP_CONSTANT:
+            value[i] = node->constant;
+            break;
+        case MALI_PP_VARYING:
+            value[i] = environment->varying[node->index];
+            break;
+        case MALI_PP_MULTIPLY:
+            value[i] = value[node->input[0]] * value[node->input[1]];
+            break;
+        case MALI_PP_ADD:
+            value[i] = value[node->input[0]] + value[node->input[1]];
+            break;
+        case MALI_PP_ABSOLUTE:
+            value[i] = fabsf(value[node->input[0]]);
+            break;
+        case MALI_PP_NEGATE:
+            value[i] = -value[node->input[0]];
+            break;
+        case MALI_PP_SAMPLE: {
+            float coordinates[4];
+            unsigned component;
+
+            *fault_instruction = node->offset;
+            for (component = 0; component < 4; component++) {
+                coordinates[component] = value[node->input[component]];
+            }
+            if (i + 3 >= program->lowered_count || !environment->sample ||
+                !environment->sample(environment->opaque, node->index,
+                                       coordinates, value + i)) {
+                return false;
+            }
+            i += 3;
+            break;
+        }
+        default:
+            return false;
+        }
+    }
+    for (i = 0; i < 4; i++) {
+        color[i] = value[program->output[i]];
+    }
+    *fault_instruction = program->instruction[program->count - 1].offset;
+    return true;
+}
+
+bool mst12_mali_pp_execute(const MALIPPProgram *program,
+                           const MALIPPEnvironment *environment,
+                           float color[4], bool *discard,
+                           unsigned *fault_instruction)
+{
+    float registers[64] = { 0 }, coordinates[4] = { 0 };
+    unsigned pc = 0, steps = 0;
+
+    if (program->lowered_count &&
+        environment->color_register == program->lowered_register) {
+        return pp_execute_lowered(program, environment, color, discard,
+                                   fault_instruction);
+    }
+    *discard = false;
+    while (pc < program->count && steps++ < 1024) {
+        const MALIPPInstruction *instruction = &program->instruction[pc];
+        unsigned fields = instruction->fields, i, next = pc + 1;
+        float snapshot[64], *dest = registers;
+        float vector_mul[4] = { 0 }, scalar_mul = 0;
+        uint64_t field;
+
+        *fault_instruction = instruction->offset;
+        for (i = 10; i < 12; i++) {
+            if (fields & (1u << i)) {
+                memcpy(&registers[(i + 2) * 4], instruction->constant[i - 10],
+                       sizeof(instruction->constant[i - 10]));
+            }
+        }
+        if (fields & 1) {
+            unsigned perspective, type, alignment, index, offset, mask;
+            float value[4] = { 0 };
+
+            field = instruction->field[0];
+            perspective = field & 3;
+            type = (field >> 2) & 3;
+            alignment = (field >> 5) & 3;
+            index = (field >> 18) & 63;
+            offset = (field >> 10) & 15;
+            mask = (field >> 28) & 15;
+            if (type == 1) {
+                pp_vector_source(registers, offset, (field >> 16) & 255,
+                    (field >> 15) & 1, (field >> 14) & 1, value);
+            } else if (type == 2 && perspective == 3) {
+                memcpy(value, environment->fragcoord, sizeof(value));
+            } else if (type == 3 && perspective) {
+                value[0] = environment->frontface ? 1 : -1;
+            } else if (type == 0) {
+                int scalar = index << (alignment == 3 ? 2 : alignment);
+                unsigned count = 1u << MIN(alignment, 2);
+                unsigned component = 0;
+
+                if (offset != 15) {
+                    float value_offset = registers[offset * 4 +
+                                                     ((field >> 16) & 3)];
+
+                    if (!isfinite(value_offset) || fabsf(value_offset) > 63) {
+                        return false;
+                    }
+                    scalar += (int)value_offset;
+                }
+                for (i = 0; i < 4; i++) {
+                    if (mask & (1u << i)) {
+                        unsigned source_component = alignment >= 2 ? i :
+                                                    component++;
+
+                        if (scalar + source_component >= 64 || scalar < 0) {
+                            return false;
+                        }
+                        if (source_component < count) {
+                            value[i] = environment->varying[
+                                scalar + source_component];
+                        }
+                    }
+                }
+            } else {
+                return false;
+            }
+            if (type < 2 && perspective >= 2) {
+                float divisor = value[perspective == 2 ? 2 : 3];
+
+                for (i = 0; i < 3; i++) {
+                    value[i] /= divisor;
+                }
+            }
+            memcpy(coordinates, value, sizeof(value));
+            if (((field >> 24) & 15) != 15) {
+                pp_vector_dest(registers, (field >> 24) & 15, mask, 0, value);
+            }
+        }
+        if (fields & 4) {
+            int index;
+            float value[4];
+
+            field = instruction->field[2];
+            index = (int16_t)(field >> 25);
+            if ((field >> 24) & 1) {
+                float offset = registers[(field >> 18) & 63];
+
+                if (!isfinite(offset) || fabsf(offset) > 16384) {
+                    return false;
+                }
+                index += (int)offset;
+            }
+            if ((field & 3) != 0 || !environment->uniform ||
+                !environment->uniform(environment->opaque,
+                    (field >> 10) & 3, index, value)) {
+                return false;
+            }
+            memcpy(registers + 60, value, sizeof(value));
+        }
+        if (fields & 2) {
+            unsigned index;
+
+            field = instruction->field[1];
+            index = (field >> 30) & 4095;
+            if ((field >> 29) & 1) {
+                float offset = registers[(field >> 6) & 63];
+
+                if (!isfinite(offset) || offset < 0 || offset > 4095) {
+                    return false;
+                }
+                index += (unsigned)offset;
+            }
+            if (((field >> 24) & 31) || ((field >> 17) & 3) ||
+                !environment->sample ||
+                !environment->sample(environment->opaque, index, coordinates,
+                                       registers + 56)) {
+                return false;
+            }
+        }
+        if (fields & 256) {
+            field = instruction->field[8];
+            if (((field >> 1) & 31) != 7 || (field >> 10) != 2) {
+                return false;
+            }
+            if (field & 1) {
+                memcpy(registers + ((field >> 6) & 15) * 4,
+                       environment->framebuffer, 4 * sizeof(float));
+            } else {
+                registers[((field >> 6) & 15) * 4] = environment->depth;
+            }
+        }
+        /*
+         * A single ALU captures its operands before writing its destination.
+         * Multiple units and branch predicates require the old register bank.
+         */
+        if (instruction->parallel_alu) {
+            memcpy(snapshot, registers, sizeof(snapshot));
+            dest = snapshot;
+        }
+        for (i = 3; i < 8; i++) {
+            unsigned op, component;
+            float a[4], b[4], result[4];
+
+            if (!(fields & (1u << i))) {
+                continue;
+            }
+            field = instruction->field[i];
+            if (i == 3 || i == 5) {
+                pp_vector_source(registers, field & 15, (field >> 4) & 255,
+                    (field >> 12) & 1, (field >> 13) & 1, a);
+                pp_vector_source(registers, (field >> 14) & 15,
+                    (field >> 18) & 255, (field >> 26) & 1,
+                    (field >> 27) & 1, b);
+                op = (field >> 38) & 31;
+                if (i == 5 && (field >> 43) & 1) {
+                    for (component = 0; component < 4; component++) {
+                        a[component] = pp_modify_source(
+                            vector_mul[((field >> (4 + component * 2)) & 3)],
+                            (field >> 12) & 1, (field >> 13) & 1);
+                    }
+                }
+                if (op == 31) {
+                    memcpy(result, a, sizeof(result));
+                } else if (op == 0) {
+                    for (component = 0; component < 4; component++) {
+                        result[component] = i == 3 ?
+                            a[component] * b[component] :
+                            a[component] + b[component];
+                    }
+                } else {
+                    for (component = 0; component < 4; component++) {
+                        if (i == 3) {
+                            if (!pp_multiply(op, a[component], b[component],
+                                              &result[component])) {
+                                return false;
+                            }
+                        } else if (op == 16 || op == 17) {
+                            result[component] = a[0] + a[1] + a[2] +
+                                                (op == 17 ? a[3] : 0);
+                        } else if (!pp_accumulate(op, a[component],
+                                                   b[component], scalar_mul,
+                                                   &result[component])) {
+                            return false;
+                        }
+                    }
+                }
+                if (i == 3) {
+                    memcpy(vector_mul, result, sizeof(result));
+                }
+                pp_vector_dest(dest, (field >> 28) & 15,
+                                 (field >> 32) & 15, (field >> 36) & 3, result);
+            } else if (i == 4 || i == 6) {
+                float x = registers[field & 63];
+                float y = registers[(field >> 8) & 63], value;
+
+                if (i == 6 && (field >> 30) & 1) {
+                    x = scalar_mul;
+                }
+                x = pp_modify_source(x, (field >> 6) & 1, (field >> 7) & 1);
+                y = pp_modify_source(y, (field >> 14) & 1, (field >> 15) & 1);
+                op = (field >> 25) & 31;
+                if (!(i == 4 ? pp_multiply(op, x, y, &value) :
+                               pp_accumulate(op, x, y, scalar_mul, &value))) {
+                    return false;
+                }
+                if (i == 4) {
+                    scalar_mul = value;
+                }
+                if ((field >> 22) & 1) {
+                    dest[(field >> 16) & 63] =
+                        pp_modify_dest(value, (field >> 23) & 3);
+                }
+            } else {
+                float value = pp_modify_source(registers[(field >> 16) & 63],
+                    (field >> 14) & 1, (field >> 15) & 1);
+
+                if ((field & 3) == 3) {
+                    pp_vector_source(registers, (field >> 10) & 15,
+                                      (field >> 2) & 255, false, false, a);
+                    for (component = 0; component < 4; component++) {
+                        result[component] = value * a[component];
+                    }
+                    pp_vector_dest(dest, (field >> 26) & 15,
+                                     (field >> 22) & 15, 0, result);
+                    continue;
+                }
+                if (field & 2) {
+                    return false;
+                }
+                switch ((field >> 2) & 15) {
+                case 0:
+                    value = 1 / value;
+                    break;
+                case 1:
+                    break;
+                case 2:
+                    value = sqrtf(value);
+                    break;
+                case 3:
+                    value = 1 / sqrtf(value);
+                    break;
+                case 4:
+                    value = exp2f(value);
+                    break;
+                case 5:
+                    value = log2f(value);
+                    break;
+                default:
+                    return false;
+                }
+                if (field & 1) {
+                    for (component = 0; component < 4; component++) {
+                        result[component] = value;
+                    }
+                    pp_vector_dest(dest, (field >> 26) & 15,
+                                     (field >> 22) & 15, 0, result);
+                } else {
+                    dest[(field >> 24) & 63] =
+                        pp_modify_dest(value, (field >> 22) & 3);
+                }
+            }
+        }
+        if (fields & 512) {
+            float a, b;
+            bool taken;
+
+            if (instruction->discard) {
+                *discard = true;
+                return true;
+            }
+            field = instruction->field[9];
+            a = registers[(field >> 10) & 63];
+            b = registers[(field >> 4) & 63];
+            taken = ((field >> 16) & 7) == 7 ||
+                    ((field >> 16) & 1 && a > b) ||
+                    ((field >> 17) & 1 && a == b) ||
+                    ((field >> 18) & 1 && a < b);
+            if (taken) {
+                for (next = 0; next < program->count; next++) {
+                    if (program->instruction[next].offset ==
+                        instruction->branch_target) {
+                        break;
+                    }
+                }
+                if (next == program->count) {
+                    return false;
+                }
+            }
+        }
+        if (instruction->parallel_alu) {
+            memcpy(registers, dest, sizeof(registers));
+        }
+        if (instruction->stop) {
+            if (environment->color_register >= 16) {
+                return false;
+            }
+            memcpy(color, registers + environment->color_register * 4,
+                   4 * sizeof(float));
+            return true;
+        }
+        pc = next;
+    }
+    return false;
+}
diff --git a/hw/display/mst12_mload.c b/hw/display/mst12_mload.c
new file mode 100644
index 0000000000000000000000000000000000000000..8c7cfa995d2791279a07540309de7821aac08adf
--- /dev/null
+++ b/hw/display/mst12_mload.c
@@ -0,0 +1,391 @@
+/*
+ * MStar MST12 scaler menu-load DMA.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2's MDrv_XC_MLoad_Trigger/AddCmd/KickOff and
+ * Hal_XC_MLoad_* establish the spaced registers, MIU selection, 32-byte
+ * command slots and the final 0x1f020004 register write. Commands contain
+ * an 8-bit scaler bank, 7-bit register index and 16-bit replacement value.
+ * Software performs masked read/modify/write before enqueuing each command.
+ *
+ * This executes actual guest RAM commands in the observed RIU mode, with
+ * burst length 4 and trigger selection 3. The configurable virtual delay
+ * is an emulator assumption. Panel clocks, vblank synchronization, external
+ * triggers and display interrupts are not implemented here. Unsupported
+ * jobs retain busy and report a fault; they do not advertise completion.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/display/mst12_mload.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "system/address-spaces.h"
+
+#define ML_REGS                 256
+#define ML_BANK_BASE            0x1f263e00
+#define ML_SCALER_BASE          0x1f260000
+#define ML_DEPTH                1
+#define ML_CONTROL              2
+#define ML_BASE_LOW             3
+#define ML_BASE_HIGH            4
+#define ML_MODE                 16
+#define ML_TRIGGER              (128 + 25)
+#define ML_BUSY                 0x8000
+#define ML_RIU                  0x1000
+#define ML_MIU1                 0x2000
+#define ML_SLOT_BYTES           32
+#define ML_NULL                 0xff010000
+#define ML_STOP                 0x1f020004
+#define ML_MIU_BYTES            0x20000000ULL
+
+enum {
+    ML_FAULT_CONFIG = 1,
+    ML_FAULT_SOURCE,
+    ML_FAULT_COMMAND,
+    ML_FAULT_DMA,
+    ML_FAULT_TERMINATOR,
+};
+
+struct MST12MLoadState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[ML_REGS];
+    uint64_t miu0_base;
+    uint64_t miu1_base;
+    uint64_t command_ns;
+    uint64_t dma_address;
+    uint64_t writes;
+    uint64_t loads;
+    uint64_t commands;
+    uint64_t register_commands;
+    uint64_t dma_bytes;
+    uint64_t fault_address;
+    uint32_t depth;
+    uint32_t fault;
+    uint32_t fault_value;
+    uint32_t last_command;
+    bool active;
+    bool trace;
+};
+
+static void mload_fault(MST12MLoadState *s, unsigned fault,
+                        uint64_t address, uint32_t value)
+{
+    s->fault = fault;
+    s->fault_address = address;
+    s->fault_value = value;
+    timer_del(s->timer);
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 MLoad fault=%u address=0x%" PRIx64
+                  " value=0x%08x depth=%u\n",
+                  fault, address, value, s->depth);
+}
+
+static hwaddr mload_destination(uint32_t command)
+{
+    return ML_SCALER_BASE + (command >> 24) * 0x200 +
+           ((command >> 16) & 0x7f) * 4;
+}
+
+static bool mload_ram(uint64_t address, uint64_t size)
+{
+    MemoryRegionSection section = memory_region_find(get_system_memory(),
+                                                      address, size);
+    bool valid = section.mr && memory_region_is_ram(section.mr) &&
+                 int128_get64(section.size) >= size;
+
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static void mload_execute(void *opaque)
+{
+    MST12MLoadState *s = opaque;
+    g_autofree uint32_t *commands = NULL;
+    unsigned i;
+
+    if (!s->active || s->fault) {
+        return;
+    }
+    if (!mload_ram(s->dma_address,
+                   (uint64_t)(s->depth - 1) * ML_SLOT_BYTES + 4)) {
+        mload_fault(s, ML_FAULT_SOURCE, s->dma_address, s->depth);
+        return;
+    }
+    commands = g_new(uint32_t, s->depth);
+    /* Validate a complete batch before changing scaler registers. */
+    for (i = 0; i < s->depth; i++) {
+        uint8_t bytes[4];
+        uint64_t address = s->dma_address + (uint64_t)i * ML_SLOT_BYTES;
+        uint32_t command;
+
+        if (address_space_read(&address_space_memory, address,
+                               MEMTXATTRS_UNSPECIFIED, bytes, sizeof(bytes)) !=
+            MEMTX_OK) {
+            mload_fault(s, ML_FAULT_DMA, address, 0);
+            return;
+        }
+        command = commands[i] = ldl_le_p(bytes);
+        if (command == ML_STOP) {
+            if (i + 1 != s->depth) {
+                mload_fault(s, ML_FAULT_TERMINATOR, address, command);
+                return;
+            }
+        } else if (command != ML_NULL &&
+                   ((command & 0x00800000) || command >> 24 == 0xff ||
+                    mload_destination(command) == ML_BANK_BASE + 8)) {
+            mload_fault(s, ML_FAULT_COMMAND, address, command);
+            return;
+        }
+    }
+    if (commands[s->depth - 1] != ML_STOP) {
+        mload_fault(s, ML_FAULT_TERMINATOR,
+                    s->dma_address + (uint64_t)(s->depth - 1) * ML_SLOT_BYTES,
+                    commands[s->depth - 1]);
+        return;
+    }
+    for (i = 0; i < s->depth; i++) {
+        uint32_t command = commands[i];
+        hwaddr destination = mload_destination(command);
+        uint8_t bytes[2];
+
+        s->last_command = command;
+        if (command == ML_STOP) {
+            /* The original final command writes 4, clearing busy bit 15. */
+            s->registers[ML_CONTROL] = command;
+            s->active = false;
+        } else if (command != ML_NULL) {
+            stw_le_p(bytes, command);
+            if (address_space_write(&address_space_memory, destination,
+                                    MEMTXATTRS_UNSPECIFIED, bytes,
+                                    sizeof(bytes)) != MEMTX_OK) {
+                mload_fault(s, ML_FAULT_DMA, destination, command);
+                return;
+            }
+            s->register_commands++;
+        }
+        s->commands++;
+        s->dma_bytes += sizeof(command);
+        if (s->trace) {
+            qemu_log("MST12 MLoad command: slot=%u value=0x%08x "
+                     "destination=0x%" HWADDR_PRIx "\n",
+                     i, command, destination);
+        }
+    }
+    s->loads++;
+}
+
+static void mload_start(MST12MLoadState *s)
+{
+    uint64_t offset = ((uint32_t)s->registers[ML_BASE_LOW] |
+                       (s->registers[ML_BASE_HIGH] & 0xff) << 16) * 32ULL;
+    uint64_t miu = s->registers[ML_MODE] & ML_MIU1 ?
+                   s->miu1_base : s->miu0_base;
+
+    s->active = true;
+    s->fault = 0;
+    s->fault_value = 0;
+    s->fault_address = 0;
+    s->dma_address = miu + offset;
+    s->depth = s->registers[ML_DEPTH];
+    if (!s->depth || (s->registers[ML_CONTROL] & 0x7ff) != 4 ||
+        !(s->registers[ML_MODE] & ML_RIU) ||
+        ((s->registers[ML_TRIGGER] >> 12) & 3) != 3) {
+        mload_fault(s, ML_FAULT_CONFIG, ML_BANK_BASE + 8,
+                    s->registers[ML_CONTROL]);
+        return;
+    }
+    if (offset + (uint64_t)(s->depth - 1) * ML_SLOT_BYTES + 4 > ML_MIU_BYTES) {
+        mload_fault(s, ML_FAULT_SOURCE, s->dma_address, s->depth);
+        return;
+    }
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                         s->command_ns * s->depth);
+    if (s->trace) {
+        qemu_log("MST12 MLoad start: address=0x%" PRIx64
+                 " depth=%u mode=0x%04x\n", s->dma_address,
+                 s->depth, s->registers[ML_MODE]);
+    }
+}
+
+static uint64_t mload_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12MLoadState *s = opaque;
+
+    if (offset & 2) {
+        return 0;
+    }
+    return extract32(s->registers[offset / 4], (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void mload_write(void *opaque, hwaddr offset,
+                        uint64_t value, unsigned size)
+{
+    MST12MLoadState *s = opaque;
+    unsigned index = offset / 4;
+    uint16_t previous;
+
+    if (offset & 2) {
+        return;
+    }
+    previous = s->registers[index];
+    s->registers[index] = deposit32(previous, (offset & 1) * 8,
+                                   MIN(size * 8, 16 - (offset & 1) * 8),
+                                   value);
+    s->writes++;
+    if (s->trace) {
+        qemu_log("MST12 MLoad write: offset=0x%03" HWADDR_PRIx
+                 " size=%u value=0x%04x\n", offset, size,
+                 s->registers[index]);
+    }
+    if (index == ML_CONTROL) {
+        if (!(s->registers[index] & ML_BUSY)) {
+            s->active = false;
+            timer_del(s->timer);
+        } else if (!(previous & ML_BUSY)) {
+            mload_start(s);
+        }
+    }
+}
+
+static const MemoryRegionOps mload_ops = {
+    .read = mload_read,
+    .write = mload_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void mload_reset(DeviceState *dev)
+{
+    MST12MLoadState *s = MST12_MLOAD(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    s->active = false;
+    s->dma_address = 0;
+    s->depth = 0;
+    s->fault = 0;
+    s->fault_value = 0;
+    s->fault_address = 0;
+    s->last_command = 0;
+    s->writes = 0;
+    s->loads = 0;
+    s->commands = 0;
+    s->register_commands = 0;
+    s->dma_bytes = 0;
+}
+
+static void mload_realize(DeviceState *dev, Error **errp)
+{
+    MST12MLoadState *s = MST12_MLOAD(dev);
+
+    if (s->command_ns > 1000000000) {
+        error_setg(errp, "MStar menu-load command delay must be at most 1 s");
+    }
+}
+
+static void mload_init(Object *obj)
+{
+    MST12MLoadState *s = MST12_MLOAD(obj);
+
+    memory_region_init_io(&s->iomem, obj, &mload_ops, s,
+                          TYPE_MST12_MLOAD, ML_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mload_execute, s);
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "load-count", &s->loads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "command-count", &s->commands,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-command-count",
+                                   &s->register_commands, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "dma-bytes", &s->dma_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "dma-address", &s->dma_address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "fault-address", &s->fault_address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "command-depth", &s->depth,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault-value", &s->fault_value,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-command", &s->last_command,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void mload_finalize(Object *obj)
+{
+    MST12MLoadState *s = MST12_MLOAD(obj);
+
+    timer_free(s->timer);
+}
+
+static const VMStateDescription vmstate_mload = {
+    .name = TYPE_MST12_MLOAD,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12MLoadState, ML_REGS),
+        VMSTATE_UINT64(dma_address, MST12MLoadState),
+        VMSTATE_UINT32(depth, MST12MLoadState),
+        VMSTATE_UINT32(fault, MST12MLoadState),
+        VMSTATE_UINT32(fault_value, MST12MLoadState),
+        VMSTATE_UINT64(fault_address, MST12MLoadState),
+        VMSTATE_UINT32(last_command, MST12MLoadState),
+        VMSTATE_UINT64(writes, MST12MLoadState),
+        VMSTATE_UINT64(loads, MST12MLoadState),
+        VMSTATE_UINT64(commands, MST12MLoadState),
+        VMSTATE_UINT64(register_commands, MST12MLoadState),
+        VMSTATE_UINT64(dma_bytes, MST12MLoadState),
+        VMSTATE_BOOL(active, MST12MLoadState),
+        VMSTATE_TIMER_PTR(timer, MST12MLoadState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property mload_properties[] = {
+    DEFINE_PROP_UINT64("miu0-base", MST12MLoadState, miu0_base, 0x40000000),
+    DEFINE_PROP_UINT64("miu1-base", MST12MLoadState, miu1_base, 0xa0000000),
+    DEFINE_PROP_UINT64("command-ns", MST12MLoadState, command_ns, 1000),
+    DEFINE_PROP_BOOL("trace", MST12MLoadState, trace, false),
+};
+
+static void mload_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = mload_realize;
+    device_class_set_legacy_reset(dc, mload_reset);
+    device_class_set_props(dc, mload_properties);
+    dc->vmsd = &vmstate_mload;
+    dc->desc = "MStar MST12 scaler menu-load DMA";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo mload_type = {
+    .name = TYPE_MST12_MLOAD,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12MLoadState),
+    .instance_init = mload_init,
+    .instance_finalize = mload_finalize,
+    .class_init = mload_class_init,
+};
+
+static void mload_register_types(void)
+{
+    type_register_static(&mload_type);
+}
+
+type_init(mload_register_types)
diff --git a/hw/display/mst12_mvd.c b/hw/display/mst12_mvd.c
new file mode 100644
index 0000000000000000000000000000000000000000..9b878840bfc132b7bc9772fc9b30c113b9c29d75
--- /dev/null
+++ b/hw/display/mst12_mvd.c
@@ -0,0 +1,272 @@
+/*
+ * MStar MST12 MVD reset/register bank.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2 HAL_MVD_RstHW pulses logical byte register 0x1100
+ * bits 6 and 0, then polls 0x1101 bit 1. The original byte accessor and
+ * stopped guest page tables establish physical 0x1f202200 / 0x1f202201.
+ * Halfword registers occupy the low two bytes of four-byte RIU slots.
+ *
+ * Completion follows release of an asserted core reset, after both reset
+ * bits are clear. The virtual delay and power-on state are emulator choices.
+ * The bit-6 scope and programming-register retention are provisional.
+ * Programming registers survive an engine reset; SoC reset clears the bank.
+ * This does not execute the VDEC20R2 MCU firmware or decode video, and it
+ * does not invent mailbox replies, frame-ready status or decoder IRQs.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/display/mst12_mvd.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/bitops.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+
+#define MVD_REGS                 128
+#define MVD_CORE_RESET           0x0001
+#define MVD_PIPELINE_RESET       0x0040
+#define MVD_RESET_MASK           (MVD_CORE_RESET | MVD_PIPELINE_RESET)
+#define MVD_RESET_DONE           0x0200
+
+struct MST12MVDState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[MVD_REGS];
+    uint64_t reset_ns;
+    uint64_t reads;
+    uint64_t writes;
+    uint64_t status_reads;
+    uint64_t resets_started;
+    uint64_t resets_completed;
+    uint64_t resets_cancelled;
+    uint32_t last_read_offset;
+    uint32_t last_read_value;
+    bool core_asserted;
+    bool pending;
+    bool trace;
+};
+
+static void mvd_complete_reset(void *opaque)
+{
+    MST12MVDState *s = opaque;
+
+    if (!s->pending || (s->registers[0] & MVD_RESET_MASK)) {
+        return;
+    }
+    s->pending = false;
+    s->registers[0] |= MVD_RESET_DONE;
+    s->resets_completed++;
+    if (s->trace) {
+        qemu_log("MST12 MVD reset complete: control=0x%04x count=%" PRIu64
+                 "\n", s->registers[0], s->resets_completed);
+    }
+}
+
+static void mvd_control_changed(MST12MVDState *s, uint16_t previous)
+{
+    uint16_t control = s->registers[0];
+
+    if (control & MVD_RESET_MASK) {
+        if ((control & MVD_CORE_RESET) && !(previous & MVD_CORE_RESET)) {
+            s->core_asserted = true;
+            s->resets_started++;
+        }
+        s->registers[0] &= ~MVD_RESET_DONE;
+        if (s->pending) {
+            s->resets_cancelled++;
+        }
+        s->pending = false;
+        timer_del(s->timer);
+    } else if ((previous & MVD_RESET_MASK) && s->core_asserted) {
+        s->core_asserted = false;
+        s->pending = true;
+        if (s->reset_ns) {
+            timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                      s->reset_ns);
+        } else {
+            mvd_complete_reset(s);
+        }
+    }
+}
+
+static uint64_t mvd_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12MVDState *s = opaque;
+    uint16_t value;
+
+    if (offset & 2) {
+        return 0;
+    }
+    value = extract32(s->registers[offset / 4], (offset & 1) * 8,
+                      MIN(size * 8, 16 - (offset & 1) * 8));
+    s->reads++;
+    if (offset / 4 == 0 && ((offset & 1) || size > 1)) {
+        s->status_reads++;
+    }
+    s->last_read_offset = offset;
+    s->last_read_value = value;
+    return value;
+}
+
+static void mvd_write(void *opaque, hwaddr offset,
+                      uint64_t value, unsigned size)
+{
+    MST12MVDState *s = opaque;
+    unsigned index = offset / 4;
+    uint16_t previous, replacement;
+
+    if (offset & 2) {
+        return;
+    }
+    previous = s->registers[index];
+    replacement = deposit32(previous, (offset & 1) * 8,
+                             MIN(size * 8, 16 - (offset & 1) * 8), value);
+    if (index == 0) {
+        replacement = (replacement & ~MVD_RESET_DONE) |
+                      (previous & MVD_RESET_DONE);
+    }
+    s->registers[index] = replacement;
+    s->writes++;
+    if (s->trace) {
+        qemu_log("MST12 MVD write: offset=0x%03" HWADDR_PRIx
+                 " size=%u value=0x%04x\n", offset, size, replacement);
+    }
+    if (index == 0 && ((replacement ^ previous) & MVD_RESET_MASK)) {
+        mvd_control_changed(s, previous);
+    }
+}
+
+static const MemoryRegionOps mvd_ops = {
+    .read = mvd_read,
+    .write = mvd_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void mvd_reset(DeviceState *dev)
+{
+    MST12MVDState *s = MST12_MVD(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    s->core_asserted = false;
+    s->pending = false;
+    s->reads = 0;
+    s->writes = 0;
+    s->status_reads = 0;
+    s->resets_started = 0;
+    s->resets_completed = 0;
+    s->resets_cancelled = 0;
+    s->last_read_offset = 0;
+    s->last_read_value = 0;
+}
+
+static void mvd_realize(DeviceState *dev, Error **errp)
+{
+    MST12MVDState *s = MST12_MVD(dev);
+
+    if (s->reset_ns > 1000000000) {
+        error_setg(errp, "MStar MVD reset delay must be at most 1 s");
+    }
+}
+
+static bool mvd_get_pending(Object *obj, Error **errp)
+{
+    return MST12_MVD(obj)->pending;
+}
+
+static bool mvd_get_ready(Object *obj, Error **errp)
+{
+    return MST12_MVD(obj)->registers[0] & MVD_RESET_DONE;
+}
+
+static void mvd_init(Object *obj)
+{
+    MST12MVDState *s = MST12_MVD(obj);
+
+    memory_region_init_io(&s->iomem, obj, &mvd_ops, s,
+                          TYPE_MST12_MVD, MVD_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, mvd_complete_reset, s);
+    object_property_add_uint64_ptr(obj, "register-reads", &s->reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "status-reads", &s->status_reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "resets-started", &s->resets_started,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "resets-completed",
+                                   &s->resets_completed, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "resets-cancelled",
+                                   &s->resets_cancelled, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-read-offset",
+                                   &s->last_read_offset, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-read-value", &s->last_read_value,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "reset-pending", mvd_get_pending, NULL);
+    object_property_add_bool(obj, "reset-ready", mvd_get_ready, NULL);
+}
+
+static void mvd_finalize(Object *obj)
+{
+    timer_free(MST12_MVD(obj)->timer);
+}
+
+static const VMStateDescription vmstate_mvd = {
+    .name = TYPE_MST12_MVD,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12MVDState, MVD_REGS),
+        VMSTATE_UINT64(reads, MST12MVDState),
+        VMSTATE_UINT64(writes, MST12MVDState),
+        VMSTATE_UINT64(status_reads, MST12MVDState),
+        VMSTATE_UINT64(resets_started, MST12MVDState),
+        VMSTATE_UINT64(resets_completed, MST12MVDState),
+        VMSTATE_UINT64(resets_cancelled, MST12MVDState),
+        VMSTATE_UINT32(last_read_offset, MST12MVDState),
+        VMSTATE_UINT32(last_read_value, MST12MVDState),
+        VMSTATE_BOOL(core_asserted, MST12MVDState),
+        VMSTATE_BOOL(pending, MST12MVDState),
+        VMSTATE_TIMER_PTR(timer, MST12MVDState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property mvd_properties[] = {
+    DEFINE_PROP_UINT64("reset-ns", MST12MVDState, reset_ns, 100000),
+    DEFINE_PROP_BOOL("trace", MST12MVDState, trace, false),
+};
+
+static void mvd_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = mvd_realize;
+    device_class_set_legacy_reset(dc, mvd_reset);
+    device_class_set_props(dc, mvd_properties);
+    dc->vmsd = &vmstate_mvd;
+    dc->desc = "MStar MST12 MVD reset/register bank";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo mvd_type = {
+    .name = TYPE_MST12_MVD,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12MVDState),
+    .instance_init = mvd_init,
+    .instance_finalize = mvd_finalize,
+    .class_init = mvd_class_init,
+};
+
+static void mvd_register_types(void)
+{
+    type_register_static(&mvd_type);
+}
+
+type_init(mvd_register_types)
diff --git a/hw/display/mst12_pq_sram.c b/hw/display/mst12_pq_sram.c
new file mode 100644
index 0000000000000000000000000000000000000000..cf04c356424f32d43535350a71e1779e12243fc0
--- /dev/null
+++ b/hw/display/mst12_pq_sram.c
@@ -0,0 +1,426 @@
+/*
+ * MStar MST12 scaler Y/C coefficient SRAM interface.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2's Hal_PQ_{set,get}_{y,c}_sram_table establish
+ * the register spacing, triggers, bank selectors and coefficient packing.
+ * Writes transfer ten bytes for Y or five bytes for C into separate SRAMs.
+ * Reads return the stored bytes; polling does not advance the engine.
+ *
+ * The transfer delay, selector latching at the trigger, zeroed SRAM reset
+ * contents and explicit software cancellation are emulator assumptions.
+ * In particular, the original C debug getter triggers before setting its
+ * selector; the hardware's read-address latch point remains unmeasured.
+ * The unobserved C selector hole is rejected. Coefficient application to
+ * video pixels, scaler clocks and interrupts are separate work.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/display/mst12_pq_sram.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+
+#define PQ_REGS                 16
+#define PQ_CONTROL              1
+#define PQ_SELECTOR             2
+#define PQ_Y                    1
+#define PQ_C                    2
+#define PQ_ENABLE_MASK          0x7f
+#define PQ_WRITE                0x100
+#define PQ_READ                 0x200
+#define PQ_BUSY                 (PQ_WRITE | PQ_READ)
+#define PQ_SELECTOR_MASK        0x1ff
+#define PQ_Y_BYTES              (4 * 128 * 10)
+#define PQ_C_BYTES              (4 * 64 * 5)
+
+enum {
+    PQ_FAULT_OPERATION = 1,
+    PQ_FAULT_COMPONENT,
+    PQ_FAULT_SELECTOR,
+    PQ_FAULT_OVERLAP,
+};
+
+static const unsigned pq_write_regs[] = {3, 4, 5, 9, 10};
+static const unsigned pq_read_regs[] = {6, 7, 8, 11, 12};
+
+struct MST12PQSRAMState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[PQ_REGS];
+    uint8_t y_sram[PQ_Y_BYTES];
+    uint8_t c_sram[PQ_C_BYTES];
+    uint8_t pending_data[10];
+    uint64_t transfer_ns;
+    uint64_t requests;
+    uint64_t completions;
+    uint64_t cancellations;
+    uint64_t y_writes;
+    uint64_t c_writes;
+    uint64_t y_reads;
+    uint64_t c_reads;
+    uint64_t faults;
+    uint32_t pending_selector;
+    uint32_t pending_component;
+    uint32_t pending_operation;
+    uint32_t fault;
+    bool active;
+    bool trace;
+};
+
+static int pq_sram_offset(unsigned component, unsigned selector)
+{
+    if (selector > PQ_SELECTOR_MASK) {
+        return -1;
+    }
+    if (component == PQ_Y) {
+        return selector * 10;
+    }
+    if (component == PQ_C) {
+        if (selector < 0x80) {
+            return selector * 5;
+        }
+        if (selector >= 0x180) {
+            return (selector - 0x100) * 5;
+        }
+    }
+    return -1;
+}
+
+static void pq_fault(MST12PQSRAMState *s, unsigned fault)
+{
+    s->fault = fault;
+    s->faults++;
+    timer_del(s->timer);
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 PQ SRAM fault=%u control=0x%04x selector=0x%03x\n",
+                  fault, s->registers[PQ_CONTROL], s->pending_selector);
+}
+
+static void pq_complete(void *opaque)
+{
+    MST12PQSRAMState *s = opaque;
+    uint8_t data[10] = {0};
+    uint8_t *table;
+    unsigned bytes, i;
+    int offset;
+
+    if (!s->active || s->fault) {
+        return;
+    }
+    offset = pq_sram_offset(s->pending_component, s->pending_selector);
+    assert(offset >= 0);
+    table = s->pending_component == PQ_Y ? s->y_sram : s->c_sram;
+    bytes = s->pending_component == PQ_Y ? 10 : 5;
+    if (s->pending_operation == PQ_WRITE) {
+        memcpy(table + offset, s->pending_data, bytes);
+        if (s->pending_component == PQ_Y) {
+            s->y_writes++;
+        } else {
+            s->c_writes++;
+        }
+    } else {
+        memcpy(data, table + offset, bytes);
+        for (i = 0; i < ARRAY_SIZE(pq_read_regs); i++) {
+            s->registers[pq_read_regs[i]] = lduw_le_p(data + i * 2);
+        }
+        if (s->pending_component == PQ_Y) {
+            s->y_reads++;
+        } else {
+            s->c_reads++;
+        }
+    }
+    s->registers[PQ_CONTROL] &= ~s->pending_operation;
+    s->active = false;
+    s->completions++;
+    if (s->trace) {
+        qemu_log("MST12 PQ SRAM complete: component=%u selector=0x%03x "
+                 "operation=0x%x bytes=%u\n", s->pending_component,
+                 s->pending_selector, s->pending_operation, bytes);
+    }
+}
+
+static void pq_start(MST12PQSRAMState *s)
+{
+    unsigned i;
+
+    s->active = true;
+    s->fault = 0;
+    s->requests++;
+    s->pending_operation = s->registers[PQ_CONTROL] & PQ_BUSY;
+    s->pending_component = s->registers[PQ_CONTROL] & PQ_ENABLE_MASK;
+    s->pending_selector = s->registers[PQ_SELECTOR] & PQ_SELECTOR_MASK;
+    for (i = 0; i < ARRAY_SIZE(pq_write_regs); i++) {
+        stw_le_p(s->pending_data + i * 2, s->registers[pq_write_regs[i]]);
+    }
+    if (s->pending_operation != PQ_WRITE && s->pending_operation != PQ_READ) {
+        pq_fault(s, PQ_FAULT_OPERATION);
+        return;
+    }
+    if (s->pending_component != PQ_Y && s->pending_component != PQ_C) {
+        pq_fault(s, PQ_FAULT_COMPONENT);
+        return;
+    }
+    if (pq_sram_offset(s->pending_component, s->pending_selector) < 0) {
+        pq_fault(s, PQ_FAULT_SELECTOR);
+        return;
+    }
+    timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + s->transfer_ns);
+    if (s->trace) {
+        qemu_log("MST12 PQ SRAM start: component=%u selector=0x%03x "
+                 "operation=0x%x\n", s->pending_component,
+                 s->pending_selector, s->pending_operation);
+    }
+}
+
+static bool pq_writable(unsigned index)
+{
+    return index == PQ_CONTROL || index == PQ_SELECTOR ||
+           index == 3 || index == 4 || index == 5 || index == 9 || index == 10;
+}
+
+static uint64_t pq_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12PQSRAMState *s = opaque;
+    uint64_t value = 0;
+    unsigned i;
+
+    for (i = 0; i < size && offset + i < PQ_REGS * 4; i++) {
+        unsigned index = (offset + i) / 4;
+        unsigned lane = (offset + i) & 3;
+
+        if (lane < 2) {
+            value |= (uint64_t)extract32(s->registers[index], lane * 8, 8) <<
+                     (i * 8);
+        }
+    }
+    return value;
+}
+
+static void pq_write(void *opaque, hwaddr offset, uint64_t value,
+                     unsigned size)
+{
+    MST12PQSRAMState *s = opaque;
+    uint16_t previous = s->registers[PQ_CONTROL];
+    unsigned i, requests;
+    bool control_written = false;
+
+    for (i = 0; i < size && offset + i < PQ_REGS * 4; i++) {
+        unsigned index = (offset + i) / 4;
+        unsigned lane = (offset + i) & 3;
+
+        if (lane < 2 && pq_writable(index)) {
+            s->registers[index] = deposit32(s->registers[index], lane * 8, 8,
+                                           value >> (i * 8));
+            control_written |= index == PQ_CONTROL;
+        }
+    }
+    if (!control_written) {
+        return;
+    }
+    requests = s->registers[PQ_CONTROL] & ~previous & PQ_BUSY;
+    if (s->active && !(s->registers[PQ_CONTROL] & PQ_BUSY)) {
+        timer_del(s->timer);
+        s->active = false;
+        s->cancellations++;
+    } else if (s->active && requests) {
+        pq_fault(s, PQ_FAULT_OVERLAP);
+    } else if (requests) {
+        pq_start(s);
+    }
+}
+
+static const MemoryRegionOps pq_ops = {
+    .read = pq_read,
+    .write = pq_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void pq_reset(DeviceState *dev)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->y_sram, 0, sizeof(s->y_sram));
+    memset(s->c_sram, 0, sizeof(s->c_sram));
+    memset(s->pending_data, 0, sizeof(s->pending_data));
+    s->active = false;
+    s->pending_selector = 0;
+    s->pending_component = 0;
+    s->pending_operation = 0;
+    s->fault = 0;
+    s->requests = 0;
+    s->completions = 0;
+    s->cancellations = 0;
+    s->y_writes = 0;
+    s->c_writes = 0;
+    s->y_reads = 0;
+    s->c_reads = 0;
+    s->faults = 0;
+}
+
+static void pq_realize(DeviceState *dev, Error **errp)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(dev);
+
+    if (!s->transfer_ns || s->transfer_ns > 1000000000) {
+        error_setg(errp, "MStar PQ SRAM transfer delay must be 1 ns to 1 s");
+    }
+}
+
+static char *pq_hex(const uint8_t *data, unsigned size)
+{
+    static const char digits[] = "0123456789abcdef";
+    char *hex = g_malloc(size * 2 + 1);
+    unsigned i;
+
+    for (i = 0; i < size; i++) {
+        hex[i * 2] = digits[data[i] >> 4];
+        hex[i * 2 + 1] = digits[data[i] & 15];
+    }
+    hex[size * 2] = 0;
+    return hex;
+}
+
+static char *pq_get_y_sram(Object *obj, Error **errp)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(obj);
+
+    return pq_hex(s->y_sram, sizeof(s->y_sram));
+}
+
+static char *pq_get_c_sram(Object *obj, Error **errp)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(obj);
+
+    return pq_hex(s->c_sram, sizeof(s->c_sram));
+}
+
+static void pq_init(Object *obj)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &pq_ops, s, TYPE_MST12_PQ_SRAM,
+                          PQ_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, pq_complete, s);
+    object_property_add_uint64_ptr(obj, "request-count", &s->requests,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "completion-count", &s->completions,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "cancellation-count", &s->cancellations,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "y-write-count", &s->y_writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "c-write-count", &s->c_writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "y-read-count", &s->y_reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "c-read-count", &s->c_reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "fault-count", &s->faults,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "pending-selector",
+                                   &s->pending_selector, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "pending-component",
+                                   &s->pending_component, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "pending-operation",
+                                   &s->pending_operation, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault, OBJ_PROP_FLAG_READ);
+    object_property_add_str(obj, "y-sram", pq_get_y_sram, NULL);
+    object_property_add_str(obj, "c-sram", pq_get_c_sram, NULL);
+}
+
+static void pq_finalize(Object *obj)
+{
+    MST12PQSRAMState *s = MST12_PQ_SRAM(obj);
+
+    timer_free(s->timer);
+}
+
+static int pq_post_load(void *opaque, int version)
+{
+    MST12PQSRAMState *s = opaque;
+
+    if (s->fault > PQ_FAULT_OVERLAP ||
+        (timer_pending(s->timer) && (!s->active || s->fault))) {
+        return -EINVAL;
+    }
+    if (s->active && !s->fault &&
+        ((s->pending_operation != PQ_WRITE &&
+          s->pending_operation != PQ_READ) ||
+         pq_sram_offset(s->pending_component, s->pending_selector) < 0 ||
+         !(s->registers[PQ_CONTROL] & s->pending_operation) ||
+         !timer_pending(s->timer))) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_pq = {
+    .name = TYPE_MST12_PQ_SRAM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pq_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12PQSRAMState, PQ_REGS),
+        VMSTATE_BUFFER(y_sram, MST12PQSRAMState),
+        VMSTATE_BUFFER(c_sram, MST12PQSRAMState),
+        VMSTATE_BUFFER(pending_data, MST12PQSRAMState),
+        VMSTATE_UINT32(pending_selector, MST12PQSRAMState),
+        VMSTATE_UINT32(pending_component, MST12PQSRAMState),
+        VMSTATE_UINT32(pending_operation, MST12PQSRAMState),
+        VMSTATE_UINT32(fault, MST12PQSRAMState),
+        VMSTATE_UINT64(requests, MST12PQSRAMState),
+        VMSTATE_UINT64(completions, MST12PQSRAMState),
+        VMSTATE_UINT64(cancellations, MST12PQSRAMState),
+        VMSTATE_UINT64(y_writes, MST12PQSRAMState),
+        VMSTATE_UINT64(c_writes, MST12PQSRAMState),
+        VMSTATE_UINT64(y_reads, MST12PQSRAMState),
+        VMSTATE_UINT64(c_reads, MST12PQSRAMState),
+        VMSTATE_UINT64(faults, MST12PQSRAMState),
+        VMSTATE_BOOL(active, MST12PQSRAMState),
+        VMSTATE_TIMER_PTR(timer, MST12PQSRAMState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property pq_properties[] = {
+    DEFINE_PROP_UINT64("transfer-ns", MST12PQSRAMState, transfer_ns, 500),
+    DEFINE_PROP_BOOL("trace", MST12PQSRAMState, trace, false),
+};
+
+static void pq_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pq_realize;
+    device_class_set_legacy_reset(dc, pq_reset);
+    device_class_set_props(dc, pq_properties);
+    dc->vmsd = &vmstate_pq;
+    dc->desc = "MStar MST12 scaler coefficient SRAM";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pq_type = {
+    .name = TYPE_MST12_PQ_SRAM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12PQSRAMState),
+    .instance_init = pq_init,
+    .instance_finalize = pq_finalize,
+    .class_init = pq_class_init,
+};
+
+static void pq_register_types(void)
+{
+    type_register_static(&pq_type);
+}
+
+type_init(pq_register_types)
