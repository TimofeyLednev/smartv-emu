+    },
+};
+
+static const VMStateDescription vmstate_mst12_mali = {
+    .name = TYPE_MST12_MALI,
+    .version_id = 3,
+    .minimum_version_id = 3,
+    .post_load = mst12_mali_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_2DARRAY(registers, MST12MALIState,
+                             MALI_CORE_COUNT, MALI_REGISTER_COUNT),
+        VMSTATE_UINT32(gp_pending, MST12MALIState),
+        VMSTATE_BOOL_ARRAY(pp_pending, MST12MALIState, 4),
+        VMSTATE_STRUCT_ARRAY(tile_batches, MST12MALIState, MALI_TILE_BATCHES,
+                             2, vmstate_mali_tile_batch, MALITileBatch),
+        VMSTATE_UINT32_V(next_batch, MST12MALIState, 2),
+        VMSTATE_UINT64_V(gp_setups, MST12MALIState, 2),
+        VMSTATE_UINT64_V(gp_commands, MST12MALIState, 2),
+        VMSTATE_UINT64_V(pp_tiles, MST12MALIState, 2),
+        VMSTATE_UINT64_V(pp_pixels, MST12MALIState, 2),
+        VMSTATE_UINT64(gp_vertices, MST12MALIState),
+        VMSTATE_UINT64(gp_draws, MST12MALIState),
+        VMSTATE_END_OF_LIST()
