+static void mst12_mali_init(Object *obj)
+{
+    MST12MALIState *s = MST12_MALI(obj);
+    SysBusDevice *dev = SYS_BUS_DEVICE(obj);
+
+    object_property_add_uint64_ptr(obj, "gp-setups", &s->gp_setups,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "gp-commands", &s->gp_commands,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "pp-tiles", &s->pp_tiles,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "pp-pixels", &s->pp_pixels,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "gp-vertices", &s->gp_vertices,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "gp-draws", &s->gp_draws,
+                                   OBJ_PROP_FLAG_READ);
+
+    memory_region_init_io(&s->iomem, obj, &mst12_mali_ops, s,
+                          "mst12.mali", MALI_APERTURE);
+    sysbus_init_mmio(dev, &s->iomem);
+    sysbus_init_irq(dev, &s->irq);
+}
+
+static void mst12_mali_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = mst12_mali_realize;
+    device_class_set_legacy_reset(dc, mst12_mali_reset);
+    device_class_set_props(dc, mst12_mali_properties);
+    dc->vmsd = &vmstate_mst12_mali;
+    dc->desc = "MStar Mali Utgard registers, MMU and interrupts";
+}
+
+static const TypeInfo mst12_mali_type = {
+    .name = TYPE_MST12_MALI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12MALIState),
+    .instance_init = mst12_mali_init,
+    .class_init = mst12_mali_class_init,
+};
