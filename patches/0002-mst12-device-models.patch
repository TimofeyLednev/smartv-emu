@@ -0,0 +1,65 @@
+/*
+ * Functional Utgard GP batches and PP rasterization.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_DISPLAY_MST12_MALI_RENDER_H
+#define HW_DISPLAY_MST12_MALI_RENDER_H
+
+#define MALI_MAX_BLOCKS       512
+#define MALI_TILE_BATCHES      32
+#define MALI_MAX_DRAWS        256
+#define MALI_MAX_VERTICES   16384
+
+typedef struct MALIDraw {
+    uint32_t render_state;
+    uint32_t positions;
+    uint32_t indices;
+    uint32_t first;
+    uint32_t count;
+    uint32_t mode;
+    uint32_t index_size;
+    uint32_t cull;
+    uint32_t clip[4];
+} MALIDraw;
+
+typedef struct MALITileBatch {
+    uint32_t directory;
+    uint32_t array;
+    uint32_t count;
+    uint32_t tiles_x;
+    uint32_t tiles_y;
+    uint32_t shift_x;
+    uint32_t shift_y;
+    uint32_t stride;
+    uint32_t blocks[MALI_MAX_BLOCKS];
+    uint32_t draw_count;
+    MALIDraw draws[MALI_MAX_DRAWS];
+    bool paging;
+    bool valid;
+} MALITileBatch;
+
+typedef struct MALIRenderIO {
+    void *opaque;
+    bool trace;
+    bool (*read)(void *opaque, uint32_t address, void *data, uint32_t size);
+    bool (*write)(void *opaque, uint32_t address, const void *data,
+                  uint32_t size);
+    bool (*validate)(void *opaque, uint32_t address, uint32_t size, bool write);
+} MALIRenderIO;
+
+typedef struct MALIRenderResult {
+    uint64_t pixels;
+    uint64_t fragments;
+    uint64_t colored_pixels;
+    uint32_t tiles;
+    uint32_t triangles;
+    uint32_t list;
+} MALIRenderResult;
+
+bool mst12_mali_pp_render(const MALITileBatch batches[MALI_TILE_BATCHES],
+                          unsigned next_batch, uint32_t directory, bool paging,
+                          const uint32_t frame[24],
+                          const uint32_t writeback[3][12],
+                          const MALIRenderIO *io, MALIRenderResult *result);
+
+#endif
diff --git a/include/hw/display/mst12_mali_shader.h b/include/hw/display/mst12_mali_shader.h
new file mode 100644
index 0000000000000000000000000000000000000000..3c757d590c7c51def6e6f73078a78f50a5d6790a
--- /dev/null
+++ b/include/hw/display/mst12_mali_shader.h
@@ -0,0 +1,89 @@
+/*
+ * Functional ARM Utgard shader execution.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_DISPLAY_MST12_MALI_SHADER_H
+#define HW_DISPLAY_MST12_MALI_SHADER_H
+
+#define MALI_GP_MAX_INSTRUCTIONS 1024
+#define MALI_GP_MAX_UNIFORMS     512
+#define MALI_SHADER_REGISTERS    16
+#define MALI_PP_MAX_INSTRUCTIONS 256
+#define MALI_PP_MAX_WORDS       4096
+#define MALI_PP_MAX_NODES        256
+
+typedef struct MALIGPOutput {
+    float value[MALI_SHADER_REGISTERS][4];
+    uint8_t mask[MALI_SHADER_REGISTERS];
+} MALIGPOutput;
+
+bool mst12_mali_gp_execute(const uint8_t *code, unsigned instructions,
+                           const float attributes[MALI_SHADER_REGISTERS][4],
+                           const float *uniforms, unsigned uniform_count,
+                           MALIGPOutput *output, unsigned *fault_instruction);
+
+typedef struct MALIPPInstruction {
+    uint64_t field[12];
+    float constant[2][4];
+    unsigned fields;
+    unsigned offset;
+    int branch_target;
+    bool stop;
+    bool discard;
+    bool parallel_alu;
+} MALIPPInstruction;
+
+typedef enum MALIPPNodeOp {
+    MALI_PP_CONSTANT,
+    MALI_PP_VARYING,
+    MALI_PP_MULTIPLY,
+    MALI_PP_ADD,
+    MALI_PP_ABSOLUTE,
+    MALI_PP_NEGATE,
+    MALI_PP_SAMPLE,
+    MALI_PP_SAMPLE_RESULT,
+} MALIPPNodeOp;
+
+typedef struct MALIPPNode {
+    uint16_t input[4];
+    uint16_t index;
+    uint16_t offset;
+    MALIPPNodeOp op;
+    float constant;
+} MALIPPNode;
+
+typedef struct MALIPPProgram {
+    MALIPPInstruction instruction[MALI_PP_MAX_INSTRUCTIONS];
+    unsigned count;
+    uint64_t varying_mask;
+    bool constant_only;
+    MALIPPNode node[MALI_PP_MAX_NODES];
+    uint16_t output[4];
+    unsigned lowered_count;
+    unsigned lowered_register;
+} MALIPPProgram;
+
+typedef struct MALIPPEnvironment {
+    float varying[MALI_SHADER_REGISTERS * 4];
+    float fragcoord[4];
+    float framebuffer[4];
+    float depth;
+    unsigned color_register;
+    bool frontface;
+    void *opaque;
+    bool (*sample)(void *opaque, unsigned index, const float coordinates[4],
+                   float result[4]);
+    bool (*uniform)(void *opaque, unsigned alignment, int index,
+                    float result[4]);
+} MALIPPEnvironment;
+
+bool mst12_mali_pp_decode(const uint8_t *code, unsigned words,
+                          MALIPPProgram *program, unsigned *fault_instruction);
+/* Optional straight-line lowering; other programs use the general executor. */
+bool mst12_mali_pp_prepare(MALIPPProgram *program, unsigned color_register);
+bool mst12_mali_pp_execute(const MALIPPProgram *program,
+                           const MALIPPEnvironment *environment,
+                           float color[4], bool *discard,
+                           unsigned *fault_instruction);
+
+#endif
