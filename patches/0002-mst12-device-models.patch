index 0000000000000000000000000000000000000000..204f78a99d39646fab86273b793d0a25c07fa87b
--- /dev/null
+++ b/hw/nvram/mst12_factory_eeprom.c
@@ -0,0 +1,330 @@
+/*
+ * Samsung MST12's factory/settings I2C EEPROM, with recovered 24C256 geometry.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Original exeTV's TDaStore object specifies 0x8000 bytes, 64-byte pages,
+ * slave byte 0xa0 and two address bytes. GetMacAddress reads six bytes at
+ * 0x1e04. The update has no factory dump. Only a synthetic NIC-matching MAC
+ * is seeded; other bytes start erased, with no claim of valid factory data.
+ *
+ * Unlike QEMU 10.1's generic AT24C, this device stages page writes until
+ * STOP, wraps within a 64-byte page, NACKs while programming, and migrates
+ * cells and in-flight state. A 5 ms write cycle is a configurable 24C256
+ * convention, not a measured timing or a confirmed chip part number.
+ * Repeated START discards uncommitted data. System reset clears the address
+ * protocol but retains cells and any programming cycle already begun.
+ * Contents live for this VM and migrate with it; no host file is modified.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/nvram/mst12_factory_eeprom.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "hw/resettable.h"
+#include "migration/vmstate.h"
+#include "net/net.h"
+
+#define EEPROM_SIZE        0x8000
+#define EEPROM_PAGE_SIZE   64
+#define EEPROM_MAC_OFFSET  0x1e04
+
+struct MST12FactoryEEPROMState {
+    I2CSlave parent_obj;
+    uint8_t cells[EEPROM_SIZE];
+    uint8_t page[EEPROM_PAGE_SIZE];
+    uint8_t pending_page[EEPROM_PAGE_SIZE];
+    uint16_t address;
+    uint16_t address_latch;
+    uint16_t page_base;
+    uint16_t pending_base;
+    uint8_t address_bytes;
+    uint64_t page_mask;
+    uint64_t pending_mask;
+    QEMUTimer *write_timer;
+    uint64_t write_cycle_ns;
+    MACAddr initial_mac;
+    uint8_t erased_value;
+    bool seed_mac;
+    bool writable;
+    bool busy;
+    bool trace;
+    uint64_t read_bytes;
+    uint64_t write_bytes;
+    uint64_t write_cycles;
+    uint64_t completed_cycles;
+    uint64_t busy_nacks;
+    uint32_t last_read_address;
+    uint32_t last_write_address;
+};
+
+static void factory_eeprom_program(void *opaque)
+{
+    MST12FactoryEEPROMState *s = opaque;
+    unsigned i;
+
+    for (i = 0; i < EEPROM_PAGE_SIZE; i++) {
+        if (s->pending_mask & (UINT64_C(1) << i)) {
+            s->cells[s->pending_base + i] = s->pending_page[i];
+        }
+    }
+    s->pending_mask = 0;
+    s->busy = false;
+    s->completed_cycles++;
+    if (s->trace) {
+        qemu_log("MST12 EEPROM write complete: page=0x%04x cycles=%" PRIu64
+                 "\n", s->pending_base, s->completed_cycles);
+    }
+}
+
+static int factory_eeprom_event(I2CSlave *slave, enum i2c_event event)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(slave);
+
+    switch (event) {
+    case I2C_START_SEND:
+    case I2C_START_RECV:
+        if (s->busy) {
+            s->busy_nacks++;
+            return -1;
+        }
+        /* Only STOP programs a page; a repeated START abandons its data. */
+        s->page_mask = 0;
+        s->address_bytes = 0;
+        s->address_latch = 0;
+        if (s->trace) {
+            qemu_log("MST12 EEPROM start: %s pointer=0x%04x\n",
+                     event == I2C_START_SEND ? "write" : "read", s->address);
+        }
+        return 0;
+    case I2C_FINISH:
+        if (s->page_mask && !s->busy) {
+            memcpy(s->pending_page, s->page, sizeof(s->page));
+            s->pending_mask = s->page_mask;
+            s->pending_base = s->page_base;
+            s->busy = true;
+            s->write_cycles++;
+            timer_mod_ns(s->write_timer,
+                         qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                         s->write_cycle_ns);
+            if (s->trace) {
+                qemu_log("MST12 EEPROM write start: page=0x%04x "
+                         "mask=0x%016" PRIx64 "\n",
+                         s->pending_base, s->pending_mask);
+            }
+        }
+        s->page_mask = 0;
+        s->address_bytes = 0;
+        return 0;
+    case I2C_NACK:
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+static int factory_eeprom_send(I2CSlave *slave, uint8_t data)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(slave);
+    unsigned offset;
+
+    if (s->address_bytes < 2) {
+        s->address_latch = (s->address_latch << 8) | data;
+        if (++s->address_bytes == 2) {
+            s->address = s->address_latch & (EEPROM_SIZE - 1);
+            s->page_base = s->address & ~(EEPROM_PAGE_SIZE - 1);
+            if (s->trace) {
+                qemu_log("MST12 EEPROM pointer: address=0x%04x\n", s->address);
+            }
+        }
+        return 0;
+    }
+    offset = s->address & (EEPROM_PAGE_SIZE - 1);
+    if (s->writable) {
+        s->page[offset] = data;
+        s->page_mask |= UINT64_C(1) << offset;
+    }
+    s->last_write_address = s->address;
+    s->write_bytes++;
+    s->address = s->page_base | ((offset + 1) & (EEPROM_PAGE_SIZE - 1));
+    return 0;
+}
+
+static uint8_t factory_eeprom_recv(I2CSlave *slave)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(slave);
+    uint8_t data = s->cells[s->address];
+
+    if (s->trace && s->address >= EEPROM_MAC_OFFSET &&
+        s->address < EEPROM_MAC_OFFSET + 6) {
+        qemu_log("MST12 EEPROM MAC read: address=0x%04x data=0x%02x\n",
+                 s->address, data);
+    }
+    s->last_read_address = s->address;
+    s->read_bytes++;
+    s->address = (s->address + 1) & (EEPROM_SIZE - 1);
+    return data;
+}
+
+static void factory_eeprom_reset_enter(Object *obj, ResetType type)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(obj);
+
+    s->address = 0;
+    s->address_latch = 0;
+    s->address_bytes = 0;
+    s->page_mask = 0;
+    /* Cells, completed statistics and a STOP-triggered cycle survive reset. */
+}
+
+static void factory_eeprom_realize(DeviceState *dev, Error **errp)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(dev);
+
+    if (!s->write_cycle_ns || s->write_cycle_ns > NANOSECONDS_PER_SECOND) {
+        error_setg(errp, "MST12 EEPROM write-cycle-ns must be between "
+                   "1 and 1000000000");
+        return;
+    }
+    memset(s->cells, s->erased_value, sizeof(s->cells));
+    if (s->seed_mac) {
+        memcpy(s->cells + EEPROM_MAC_OFFSET, s->initial_mac.a, 6);
+    }
+}
+
+static char *factory_eeprom_stored_mac(Object *obj, Error **errp)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(obj);
+    const uint8_t *mac = s->cells + EEPROM_MAC_OFFSET;
+
+    return g_strdup_printf("%02x:%02x:%02x:%02x:%02x:%02x",
+                           mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+}
+
+static bool factory_eeprom_busy(Object *obj, Error **errp)
+{
+    return MST12_FACTORY_EEPROM(obj)->busy;
+}
+
+static void factory_eeprom_init(Object *obj)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(obj);
+
+    s->write_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                  factory_eeprom_program, s);
+    object_property_add_str(obj, "stored-mac", factory_eeprom_stored_mac,
+                            NULL);
+    object_property_add_bool(obj, "busy", factory_eeprom_busy, NULL);
+    object_property_add_uint64_ptr(obj, "read-bytes", &s->read_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "write-bytes", &s->write_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "write-cycles", &s->write_cycles,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "completed-cycles",
+                                   &s->completed_cycles, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "busy-nacks", &s->busy_nacks,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-read-address",
+                                   &s->last_read_address, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-write-address",
+                                   &s->last_write_address, OBJ_PROP_FLAG_READ);
+}
+
+static void factory_eeprom_finalize(Object *obj)
+{
+    MST12FactoryEEPROMState *s = MST12_FACTORY_EEPROM(obj);
+
+    timer_free(s->write_timer);
+}
+
+static int factory_eeprom_post_load(void *opaque, int version_id)
+{
+    MST12FactoryEEPROMState *s = opaque;
+
+    if (s->address >= EEPROM_SIZE || s->address_bytes > 2 ||
+        s->page_base >= EEPROM_SIZE || s->pending_base >= EEPROM_SIZE ||
+        (s->page_base & (EEPROM_PAGE_SIZE - 1)) ||
+        (s->pending_base & (EEPROM_PAGE_SIZE - 1)) ||
+        s->busy != !!s->pending_mask ||
+        s->busy != timer_pending(s->write_timer)) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_factory_eeprom = {
+    .name = TYPE_MST12_FACTORY_EEPROM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = factory_eeprom_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MST12FactoryEEPROMState),
+        VMSTATE_UINT8_ARRAY(cells, MST12FactoryEEPROMState, EEPROM_SIZE),
+        VMSTATE_UINT8_ARRAY(page, MST12FactoryEEPROMState, EEPROM_PAGE_SIZE),
+        VMSTATE_UINT8_ARRAY(pending_page, MST12FactoryEEPROMState,
+                           EEPROM_PAGE_SIZE),
+        VMSTATE_UINT16(address, MST12FactoryEEPROMState),
+        VMSTATE_UINT16(address_latch, MST12FactoryEEPROMState),
+        VMSTATE_UINT16(page_base, MST12FactoryEEPROMState),
+        VMSTATE_UINT16(pending_base, MST12FactoryEEPROMState),
+        VMSTATE_UINT8(address_bytes, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(page_mask, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(pending_mask, MST12FactoryEEPROMState),
+        VMSTATE_TIMER_PTR(write_timer, MST12FactoryEEPROMState),
+        VMSTATE_BOOL(busy, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(read_bytes, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(write_bytes, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(write_cycles, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(completed_cycles, MST12FactoryEEPROMState),
+        VMSTATE_UINT64(busy_nacks, MST12FactoryEEPROMState),
+        VMSTATE_UINT32(last_read_address, MST12FactoryEEPROMState),
+        VMSTATE_UINT32(last_write_address, MST12FactoryEEPROMState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property factory_eeprom_properties[] = {
+    DEFINE_PROP_MACADDR("initial-mac", MST12FactoryEEPROMState, initial_mac),
+    DEFINE_PROP_BOOL("seed-mac", MST12FactoryEEPROMState, seed_mac, true),
+    DEFINE_PROP_BOOL("writable", MST12FactoryEEPROMState, writable, true),
+    DEFINE_PROP_BOOL("trace", MST12FactoryEEPROMState, trace, false),
+    DEFINE_PROP_UINT8("erased-value", MST12FactoryEEPROMState,
+                      erased_value, 0xff),
+    DEFINE_PROP_UINT64("write-cycle-ns", MST12FactoryEEPROMState,
+                       write_cycle_ns, 5000000),
+};
+
+static void factory_eeprom_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *ic = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = factory_eeprom_realize;
+    dc->vmsd = &vmstate_factory_eeprom;
+    dc->desc = "Samsung MST12 32 KiB factory/settings EEPROM";
+    device_class_set_props(dc, factory_eeprom_properties);
+    rc->phases.enter = factory_eeprom_reset_enter;
+    ic->event = factory_eeprom_event;
+    ic->send = factory_eeprom_send;
+    ic->recv = factory_eeprom_recv;
+}
+
+static const TypeInfo factory_eeprom_type = {
+    .name = TYPE_MST12_FACTORY_EEPROM,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(MST12FactoryEEPROMState),
+    .instance_init = factory_eeprom_init,
+    .instance_finalize = factory_eeprom_finalize,
+    .class_init = factory_eeprom_class_init,
+};
+
+static void factory_eeprom_register_types(void)
+{
+    type_register_static(&factory_eeprom_type);
+}
+
+type_init(factory_eeprom_register_types)
