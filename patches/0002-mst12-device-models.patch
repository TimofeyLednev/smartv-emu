diff --git a/hw/usb/mst12_ehci.c b/hw/usb/mst12_ehci.c
new file mode 100644
index 0000000000000000000000000000000000000000..8e735daae5e82c4f8723f562f30f8231e4bcf8c1
--- /dev/null
+++ b/hw/usb/mst12_ehci.c
@@ -0,0 +1,337 @@
+/*
+ * MStar EHCI adapter for the original T-MST12DEUC USB host driver.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register accesses and MIU DMA address conversion are derived from the
+ * original ehci-hcd.ko. Transactions, scheduling and root-hub behavior use
+ * QEMU's existing EHCI implementation. See NOTES.md for the evidence.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/usb/ehci-regs.h"
+#include "hw/usb/hcd-ehci.h"
+#include "hw/usb/mst12_ehci.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+
+#define MST_EHCI_APERTURE    0x200
+#define MST_EHCI_OP_BASE     0x10
+#define MST_EHCI_CONFIG      (MST_EHCI_OP_BASE + 0x3c)
+#define MST_EHCI_PORTSC      (MST_EHCI_OP_BASE + 0x20)
+#define MST_EHCI_USBSTS      (MST_EHCI_OP_BASE + 4)
+#define MST_EHCI_USBINTR     (MST_EHCI_OP_BASE + 8)
+#define MST_EHCI_PORT_RWC    0x2a
+#define MST_EHCI_VENDOR      (MST_EHCI_PORTSC + 4)
+
+struct MST12EHCIState {
+    SysBusDevice parent_obj;
+    EHCIState ehci;
+    MemoryRegion adapter;
+    AddressSpace registers_as;
+    MemoryRegion dma_root;
+    MemoryRegion dma_fault;
+    MemoryRegion dma_miu[2];
+    AddressSpace dma_as;
+    uint32_t vendor[64];
+    uint64_t miu0_base;
+    uint64_t miu1_base;
+    bool trace_registers;
+};
+
+static bool mst_ehci_decode(hwaddr offset, unsigned *reg, unsigned *shift)
+{
+    /*
+     * ehci_readl/writel double the logical address's low eight bits.
+     * The one-port EHCI register set fits below logical offset 0x100.
+     * Each physical word carries 16 bits, with +2/+6 padding.
+     */
+    if (offset & 2) {
+        return false;
+    }
+    *reg = (offset & ~7u) / 2;
+    *shift = (offset & 4 ? 16 : 0) + (offset & 1) * 8;
+    return true;
+}
+
+static uint32_t mst_ehci_read_word(MST12EHCIState *s, unsigned reg)
+{
+    if (reg >= MST_EHCI_VENDOR && reg != MST_EHCI_CONFIG) {
+        return s->vendor[reg / 4];
+    }
+    /* Samsung's compact register structure has different tail offsets. */
+    if (reg == MST_EHCI_CONFIG) {
+        reg += 4;
+    } else if (reg == MST_EHCI_PORTSC) {
+        reg = MST_EHCI_OP_BASE + 0x44;
+    }
+    return address_space_ldl_le(&s->registers_as, reg,
+                                MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static uint64_t mst_ehci_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12EHCIState *s = opaque;
+    unsigned reg, shift;
+    uint32_t value;
+
+    if (!mst_ehci_decode(offset, &reg, &shift)) {
+        return 0;
+    }
+    value = mst_ehci_read_word(s, reg);
+    if (s->trace_registers) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 EHCI read: reg=0x%x value=0x%08x\n",
+                      reg, value);
+    }
+    return (value >> shift) & (size == 1 ? 0xff : 0xffff);
+}
+
+static void mst_ehci_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    MST12EHCIState *s = opaque;
+    unsigned reg, shift;
+    uint32_t mask, bits, old;
+
+    if (!mst_ehci_decode(offset, &reg, &shift)) {
+        return;
+    }
+    mask = (size == 1 ? 0xffu : 0xffffu) << shift;
+    bits = (value << shift) & mask;
+    old = mst_ehci_read_word(s, reg);
+    if (reg == MST_EHCI_USBSTS) {
+        /* Do not acknowledge IRQs from the halfword not being written. */
+        old = 0;
+    } else if (reg == MST_EHCI_PORTSC) {
+        /* PORTSC mixes writable control with write-one-to-clear events. */
+        old &= ~MST_EHCI_PORT_RWC;
+    }
+    value = (old & ~mask) | bits;
+    if (s->trace_registers) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 EHCI write: reg=0x%x bits=0x%08x mask=0x%08x\n",
+                      reg, bits, mask);
+    }
+    if (reg >= MST_EHCI_VENDOR && reg != MST_EHCI_CONFIG) {
+        /* Undecoded vendor registers retain values for further analysis. */
+        s->vendor[reg / 4] = value;
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 EHCI vendor register unimplemented: "
+                      "reg=0x%x value=0x%08x\n", reg, (uint32_t)value);
+        return;
+    }
+    if (reg == MST_EHCI_CONFIG) {
+        reg += 4;
+    } else if (reg == MST_EHCI_PORTSC) {
+        reg = MST_EHCI_OP_BASE + 0x44;
+    }
+    address_space_stl_le(&s->registers_as, reg, value,
+                         MEMTXATTRS_UNSPECIFIED, NULL);
+    if (reg == MST_EHCI_USBINTR) {
+        /*
+         * QEMU 10.1's core stores USBINTR without refreshing the IRQ.
+         * A latched status must assert when enabled, including while
+         * halted; masking it must also lower the level immediately.
+         */
+        qemu_set_irq(s->ehci.irq, (s->ehci.usbsts & s->ehci.usbintr &
+                                  USBINTR_MASK) != 0);
+    }
+}
+
+static const MemoryRegionOps mst_ehci_ops = {
+    .read = mst_ehci_read,
+    .write = mst_ehci_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+static void mst_ehci_dma_error(MST12EHCIState *s, hwaddr address)
+{
+    if (!(s->ehci.usbsts & USBSTS_HSE)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 EHCI unmapped DMA address: 0x%" HWADDR_PRIx "\n",
+                      address);
+    }
+    s->ehci.usbcmd &= ~USBCMD_RUNSTOP;
+    s->ehci.usbsts |= USBSTS_HSE | USBSTS_HALT;
+    qemu_set_irq(s->ehci.irq, (s->ehci.usbsts & s->ehci.usbintr &
+                              USBINTR_MASK) != 0);
+}
+
+static MemTxResult mst_ehci_dma_read(void *opaque, hwaddr address,
+                                    uint64_t *value, unsigned size,
+                                    MemTxAttrs attrs)
+{
+    MST12EHCIState *s = opaque;
+
+    mst_ehci_dma_error(s, address);
+    *value = UINT64_MAX;
+    return MEMTX_DECODE_ERROR;
+}
+
+static MemTxResult mst_ehci_dma_write(void *opaque, hwaddr address,
+                                     uint64_t value, unsigned size,
+                                     MemTxAttrs attrs)
+{
+    MST12EHCIState *s = opaque;
+
+    mst_ehci_dma_error(s, address);
+    return MEMTX_DECODE_ERROR;
+}
+
+static const MemoryRegionOps mst_ehci_dma_fault_ops = {
+    .read_with_attrs = mst_ehci_dma_read,
+    .write_with_attrs = mst_ehci_dma_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 8,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 8,
+    },
+};
+
+static void mst_ehci_reset(DeviceState *dev)
+{
+    MST12EHCIState *s = MST12_EHCI(dev);
+
+    memset(s->vendor, 0, sizeof(s->vendor));
+    ehci_reset(&s->ehci);
+}
+
+static void mst_ehci_realize(DeviceState *dev, Error **errp)
+{
+    MST12EHCIState *s = MST12_EHCI(dev);
+    Error *local_err = NULL;
+
+    usb_ehci_realize(&s->ehci, dev, &local_err);
+    if (local_err) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    /*
+     * Original ehci_init/ehci_qh_alloc convert physical MIU0 addresses
+     * by -0x40000000, and MIU1 by -0x20000000. Unmapped gaps remain
+     * inaccessible to DMA. Each alias still uses QEMU's memory dispatch.
+     */
+    memory_region_init_alias(&s->dma_miu[0], OBJECT(s), "mst12.ehci.miu0",
+                             get_system_memory(), s->miu0_base, 0x60000000);
+    memory_region_add_subregion(&s->dma_root, 0, &s->dma_miu[0]);
+    memory_region_init_alias(&s->dma_miu[1], OBJECT(s), "mst12.ehci.miu1",
+                             get_system_memory(), s->miu1_base, 0x40000000);
+    memory_region_add_subregion(&s->dma_root, 0x80000000, &s->dma_miu[1]);
+}
+
+static void mst_ehci_unrealize(DeviceState *dev)
+{
+    MST12EHCIState *s = MST12_EHCI(dev);
+
+    usb_ehci_unrealize(&s->ehci, dev);
+    memory_region_del_subregion(&s->dma_root, &s->dma_miu[0]);
+    memory_region_del_subregion(&s->dma_root, &s->dma_miu[1]);
+}
+
+static const VMStateDescription vmstate_mst_ehci = {
+    .name = TYPE_MST12_EHCI,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(ehci, MST12EHCIState, 1, vmstate_ehci, EHCIState),
+        VMSTATE_UINT32_ARRAY(vendor, MST12EHCIState, 64),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property mst_ehci_properties[] = {
+    DEFINE_PROP_UINT32("maxframes", MST12EHCIState, ehci.maxframes, 128),
+    DEFINE_PROP_UINT64("miu0-base", MST12EHCIState, miu0_base, 0x40000000),
+    DEFINE_PROP_UINT64("miu1-base", MST12EHCIState, miu1_base, 0xa0000000),
+    DEFINE_PROP_BOOL("trace-registers", MST12EHCIState, trace_registers, false),
+};
+
+static void mst_ehci_init(Object *obj)
+{
+    MST12EHCIState *s = MST12_EHCI(obj);
+    SysBusDevice *dev = SYS_BUS_DEVICE(obj);
+
+    s->ehci.capsbase = 0;
+    s->ehci.opregbase = MST_EHCI_OP_BASE;
+    s->ehci.portscbase = 0x44;
+    s->ehci.portnr = 1;
+    s->ehci.as = &s->dma_as;
+    memory_region_init(&s->dma_root, obj, "mst12.ehci.dma", UINT64_MAX);
+    /*
+     * QEMU 10.1's EHCI descriptor helpers ignore transaction errors.
+     * Catch unmapped MIU accesses and latch a host-system error here.
+     */
+    memory_region_init_io(&s->dma_fault, obj, &mst_ehci_dma_fault_ops, s,
+                          "mst12.ehci.dma-fault", 0x100000000ULL);
+    s->dma_fault.disable_reentrancy_guard = true;
+    memory_region_add_subregion_overlap(&s->dma_root, 0, &s->dma_fault, -1);
+    address_space_init(&s->dma_as, &s->dma_root, "mst12.ehci.dma");
+    usb_ehci_init(&s->ehci, DEVICE(obj));
+    /*
+     * The public adapter remains guarded. Its private register dispatch
+     * deliberately forwards to these regions on the same device; no DMA
+     * alias can reach the public RIU registers below physical 0x40000000.
+     */
+    s->ehci.mem_caps.disable_reentrancy_guard = true;
+    s->ehci.mem_opreg.disable_reentrancy_guard = true;
+    s->ehci.mem_ports.disable_reentrancy_guard = true;
+    address_space_init(&s->registers_as, &s->ehci.mem, "mst12.ehci.registers");
+    memory_region_init_io(&s->adapter, obj, &mst_ehci_ops, s,
+                          "mst12.ehci.adapter", MST_EHCI_APERTURE);
+    sysbus_init_mmio(dev, &s->adapter);
+    sysbus_init_irq(dev, &s->ehci.irq);
+}
+
+static void mst_ehci_finalize(Object *obj)
+{
+    MST12EHCIState *s = MST12_EHCI(obj);
+
+    address_space_destroy(&s->registers_as);
+    address_space_destroy(&s->dma_as);
+    usb_ehci_finalize(&s->ehci);
+}
+
+static void mst_ehci_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = mst_ehci_realize;
+    dc->unrealize = mst_ehci_unrealize;
+    device_class_set_legacy_reset(dc, mst_ehci_reset);
+    device_class_set_props(dc, mst_ehci_properties);
+    dc->vmsd = &vmstate_mst_ehci;
+    dc->desc = "MStar EHCI host with split registers and MIU DMA";
+    set_bit(DEVICE_CATEGORY_USB, dc->categories);
+}
+
+static const TypeInfo mst_ehci_type = {
+    .name = TYPE_MST12_EHCI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12EHCIState),
+    .instance_init = mst_ehci_init,
+    .instance_finalize = mst_ehci_finalize,
+    .class_init = mst_ehci_class_init,
+};
+
+static void mst_ehci_register_types(void)
+{
+    type_register_static(&mst_ehci_type);
+}
+
+type_init(mst_ehci_register_types)
