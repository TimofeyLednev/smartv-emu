+};
+
+static const Property mst12_mali_properties[] = {
+    DEFINE_PROP_UINT32("pp-count", MST12MALIState, pp_count, 4),
+    DEFINE_PROP_UINT32("gp-version", MST12MALIState, gp_version, 0x0b070100),
+    DEFINE_PROP_UINT32("pp-version", MST12MALIState, pp_version, 0xcd070100),
+    DEFINE_PROP_UINT32("l2-size", MST12MALIState, l2_size, 0x06100206),
+    DEFINE_PROP_UINT64("miu-base", MST12MALIState, miu_base, 0x40000000),
+    DEFINE_PROP_BOOL("trace-registers", MST12MALIState, trace_registers, false),
+    DEFINE_PROP_BOOL("trace-jobs", MST12MALIState, trace_jobs, false),
+};
