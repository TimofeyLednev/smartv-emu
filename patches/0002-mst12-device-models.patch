diff --git a/hw/misc/mst12_efuse.c b/hw/misc/mst12_efuse.c
new file mode 100644
index 0000000000000000000000000000000000000000..424a7f752a0c38b9568e0b7b33c102f56202caee
--- /dev/null
+++ b/hw/misc/mst12_efuse.c
@@ -0,0 +1,222 @@
+/*
+ * MStar MST12 PM eFuse read controller.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The original libUTOPIA.so MApi_XC_HDCP_Key_Read uses PM bank + 0x4000,
+ * read address/control + 0xa0, start/busy bit 13, and two spaced halfwords
+ * at + 0xb0/+ 0xb4. HAL_MMIO_GetBase identifies the PM bank as 0x1f000000.
+ *
+ * Only the observed read protocol is implemented. The default image contains
+ * unprogrammed zero bits; it supplies no TV identity or production keys.
+ * An optional private image uses the byte order reconstructed by the original
+ * read routine. The 512-byte image capacity and read latency are emulator
+ * choices, not measurements of this board. Programming is unsupported.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/loader.h"
+#include "hw/misc/mst12_efuse.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+
+#define EFUSE_APERTURE       0x200
+#define EFUSE_REGS           (EFUSE_APERTURE / 4)
+#define EFUSE_IMAGE_BYTES    512
+#define EFUSE_ADDRESS        0xa0
+#define EFUSE_DATA_LO        0xb0
+#define EFUSE_DATA_HI        0xb4
+#define EFUSE_READ           (1u << 13)
+
+struct MST12EFuseState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[EFUSE_REGS];
+    uint8_t image[EFUSE_IMAGE_BYTES];
+    uint32_t address;
+    uint32_t fault;
+    uint64_t reads;
+    uint64_t read_delay_ns;
+    char *data_file;
+    bool busy;
+};
+
+static void efuse_complete(void *opaque)
+{
+    MST12EFuseState *s = opaque;
+
+    if (!s->busy) {
+        return;
+    }
+    s->registers[EFUSE_DATA_LO / 4] = lduw_be_p(s->image + s->address);
+    s->registers[EFUSE_DATA_HI / 4] = lduw_be_p(s->image + s->address + 2);
+    s->registers[EFUSE_ADDRESS / 4] &= ~EFUSE_READ;
+    s->busy = false;
+    s->reads++;
+}
+
+static uint64_t efuse_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12EFuseState *s = opaque;
+
+    if (offset & 2) {
+        return 0;
+    }
+    return extract32(s->registers[offset / 4], (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void efuse_write(void *opaque, hwaddr offset,
+                         uint64_t value, unsigned size)
+{
+    MST12EFuseState *s = opaque;
+    unsigned index = offset / 4;
+    uint16_t updated;
+
+    if (offset & 2 || index == EFUSE_DATA_LO / 4 ||
+        index == EFUSE_DATA_HI / 4) {
+        return;
+    }
+    updated = deposit32(s->registers[index], (offset & 1) * 8,
+                        size == 1 ? 8 : 16, value);
+    if (index != EFUSE_ADDRESS / 4) {
+        s->registers[index] = updated;
+        return;
+    }
+    if (s->busy) {
+        /* A transfer has latched its address; software cannot clear busy. */
+        s->registers[index] = updated | EFUSE_READ;
+        return;
+    }
+    s->registers[index] = updated;
+    if (!(updated & EFUSE_READ)) {
+        return;
+    }
+    s->address = updated & ~EFUSE_READ;
+    s->busy = true;
+    if ((s->address & 3) || s->address > EFUSE_IMAGE_BYTES - 4) {
+        s->fault = 1;
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 eFuse unsupported read address: 0x%04x\n",
+                      s->address);
+        return;
+    }
+    s->fault = 0;
+    timer_mod(s->timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + s->read_delay_ns);
+}
+
+static const MemoryRegionOps efuse_ops = {
+    .read = efuse_read,
+    .write = efuse_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void efuse_reset(DeviceState *dev)
+{
+    MST12EFuseState *s = MST12_EFUSE(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    s->address = 0;
+    s->fault = 0;
+    s->reads = 0;
+    s->busy = false;
+}
+
+static void efuse_realize(DeviceState *dev, Error **errp)
+{
+    MST12EFuseState *s = MST12_EFUSE(dev);
+
+    if (s->read_delay_ns > 1000000000) {
+        error_setg(errp, "MStar eFuse read delay must be at most one second");
+        return;
+    }
+    memset(s->image, 0, sizeof(s->image));
+    if (s->data_file) {
+        int64_t length = get_image_size(s->data_file);
+
+        if (length <= 0 || length > sizeof(s->image) || (length & 3) ||
+            load_image_size(s->data_file, s->image, sizeof(s->image)) !=
+            length) {
+            error_setg(errp, "MStar eFuse image must contain 4 to %u bytes "
+                       "in complete four-byte rows", EFUSE_IMAGE_BYTES);
+        }
+    }
+}
+
+static void efuse_init(Object *obj)
+{
+    MST12EFuseState *s = MST12_EFUSE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &efuse_ops, s,
+                          "mst12-efuse", EFUSE_APERTURE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, efuse_complete, s);
+    object_property_add_uint64_ptr(obj, "read-count", &s->reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "read-address", &s->address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "read-fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void efuse_finalize(Object *obj)
+{
+    timer_free(MST12_EFUSE(obj)->timer);
+}
+
+static const VMStateDescription vmstate_efuse = {
+    .name = TYPE_MST12_EFUSE,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12EFuseState, EFUSE_REGS),
+        VMSTATE_UINT8_ARRAY(image, MST12EFuseState, EFUSE_IMAGE_BYTES),
+        VMSTATE_UINT32(address, MST12EFuseState),
+        VMSTATE_UINT32(fault, MST12EFuseState),
+        VMSTATE_UINT64(reads, MST12EFuseState),
+        VMSTATE_BOOL(busy, MST12EFuseState),
+        VMSTATE_TIMER_PTR(timer, MST12EFuseState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property efuse_properties[] = {
+    DEFINE_PROP_STRING("data-file", MST12EFuseState, data_file),
+    DEFINE_PROP_UINT64("read-delay-ns", MST12EFuseState, read_delay_ns, 1000),
+};
+
+static void efuse_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = efuse_realize;
+    device_class_set_legacy_reset(dc, efuse_reset);
+    device_class_set_props(dc, efuse_properties);
+    dc->vmsd = &vmstate_efuse;
+    dc->desc = "MStar PM eFuse read controller";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo efuse_type = {
+    .name = TYPE_MST12_EFUSE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12EFuseState),
+    .instance_init = efuse_init,
+    .instance_finalize = efuse_finalize,
+    .class_init = efuse_class_init,
+};
+
+static void efuse_register_types(void)
+{
+    type_register_static(&efuse_type);
+}
+
+type_init(efuse_register_types)
diff --git a/hw/misc/mst12_micom.c b/hw/misc/mst12_micom.c
new file mode 100644
index 0000000000000000000000000000000000000000..37138983edbb388e089e8c81e45fe1ee8ccfc1b3
--- /dev/null
+++ b/hw/misc/mst12_micom.c
@@ -0,0 +1,608 @@
+/*
+ * Samsung MST12 MICOM serial protocol, recovered from T-MST12DEUC 1112.2.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * TDcPrimeMicomInterface sends and parses nine-byte normal packets:
+ * ff ff command data[5] sum(command, data[5]). The receiver's six-byte
+ * acknowledgment buffer includes the checksum. TDaSystem establishes
+ * boot partition command/ACK 0x35/0x35 (mode 1 read, mode 0 write), and
+ * RTC read 0x60/0x50 and write 0x61/0x51. AutoClockMonitor establishes
+ * year 2000 as the packed RTC epoch.
+ *
+ * The original parser routes normal command 0x10 to remote-control input;
+ * the first data byte is its key code. Command 0x1e becomes input type 5,
+ * which releases the current key through KeyCommon::SendKeyReleaseInput.
+ * QOM remote-key submits a tap through this UART path, including a timed
+ * release. Unknown commands receive no fabricated ACK.
+ * No real MICOM firmware, panel power, hotel
+ * protocol, factory data or persistent board identity is modeled. Initial
+ * partition, response latency and queue capacity are emulator choices.
+ * The existing 16550 model still handles MMIO, FIFO and interrupt delivery.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "chardev/char-fe.h"
+#include "chardev/char-serial.h"
+#include "hw/misc/mst12_micom.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/cutils.h"
+#include "qemu/timer.h"
+#include "system/rtc.h"
+#include "system/system.h"
+
+#define MICOM_PACKET_BYTES 9
+#define MICOM_QUEUE_BYTES (16 * MICOM_PACKET_BYTES)
+#define TYPE_MICOM_BACKEND "chardev-mst12-micom"
+OBJECT_DECLARE_SIMPLE_TYPE(MicomBackend, MICOM_BACKEND)
+
+struct MST12MicomState {
+    SysBusDevice parent_obj;
+    Chardev *chr;
+    CharBackend tx_monitor;
+    QEMUTimer *timer;
+    QEMUTimer *remote_timer;
+    uint8_t input[MICOM_PACKET_BYTES];
+    uint8_t replies[MICOM_QUEUE_BYTES];
+    uint32_t input_length;
+    uint32_t reply_head;
+    uint32_t reply_count;
+    uint32_t last_command;
+    uint32_t last_reply;
+    uint8_t initial_partition;
+    uint32_t partition;
+    uint64_t byte_ns;
+    uint64_t response_ns;
+    int64_t rtc_epoch;
+    int64_t rtc_reference_ns;
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t packets;
+    uint64_t responses;
+    uint64_t bad_checksums;
+    uint64_t unsupported;
+    uint64_t discarded;
+    uint64_t overflows;
+    uint64_t invalid_parameters;
+    uint32_t remote_key;
+    uint64_t remote_events;
+    uint64_t remote_releases;
+    uint64_t remote_hold_ns;
+    bool remote_down;
+    bool trace;
+};
+
+struct MicomBackend {
+    Chardev parent_obj;
+    MST12MicomState *owner;
+};
+
+static uint8_t micom_checksum(const uint8_t *packet)
+{
+    unsigned i;
+    uint8_t sum = 0;
+
+    for (i = 2; i < MICOM_PACKET_BYTES - 1; i++) {
+        sum += packet[i];
+    }
+    return sum;
+}
+
+static void micom_trace(MST12MicomState *s, const char *direction,
+                        const uint8_t *packet)
+{
+    if (s->trace) {
+        qemu_log("MST12 MICOM %s: cmd=0x%02x data=%02x %02x %02x %02x "
+                 "%02x checksum=0x%02x\n", direction, packet[2],
+                 packet[3], packet[4], packet[5], packet[6], packet[7],
+                 packet[8]);
+    }
+}
+
+static void micom_transmit(void *opaque)
+{
+    MST12MicomState *s = opaque;
+    uint8_t byte;
+
+    if (!s->reply_count) {
+        return;
+    }
+    if (qemu_chr_be_can_write(s->chr) > 0) {
+        byte = s->replies[s->reply_head];
+        s->reply_head = (s->reply_head + 1) % MICOM_QUEUE_BYTES;
+        s->reply_count--;
+        s->rx_bytes++;
+        /* Update queue state before the UART can call accept_input. */
+        qemu_chr_be_write(s->chr, &byte, 1);
+    }
+    if (s->reply_count) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                             s->byte_ns);
+    }
+}
+
+static bool micom_reply(MST12MicomState *s, uint8_t *packet)
+{
+    unsigned i;
+
+    if (s->reply_count > MICOM_QUEUE_BYTES - MICOM_PACKET_BYTES) {
+        s->overflows++;
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 MICOM response queue full: cmd=0x%02x\n",
+                      packet[2]);
+        return false;
+    }
+    packet[8] = micom_checksum(packet);
+    micom_trace(s, "to guest", packet);
+    for (i = 0; i < MICOM_PACKET_BYTES; i++) {
+        s->replies[(s->reply_head + s->reply_count) % MICOM_QUEUE_BYTES] =
+            packet[i];
+        s->reply_count++;
+    }
+    s->last_reply = packet[2];
+    s->responses++;
+    if (!timer_pending(s->timer)) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                             s->response_ns);
+    }
+    return true;
+}
+
+static void micom_release_remote(void *opaque)
+{
+    MST12MicomState *s = opaque;
+    uint8_t packet[MICOM_PACKET_BYTES] = { 0xff, 0xff, 0x1e };
+
+    if (!s->remote_down) {
+        return;
+    }
+    /* Backpressure must delay a release rather than leave a stuck key. */
+    if (s->reply_count > MICOM_QUEUE_BYTES - MICOM_PACKET_BYTES) {
+        timer_mod(s->remote_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000);
+        return;
+    }
+    micom_reply(s, packet);
+    s->remote_down = false;
+    s->remote_releases++;
+}
+
+static bool micom_get_rtc(MST12MicomState *s, uint8_t *data)
+{
+    struct tm now;
+    int year;
+
+    time_t epoch = s->rtc_epoch +
+                   (qemu_clock_get_ns(rtc_clock) - s->rtc_reference_ns) /
+                   NANOSECONDS_PER_SECOND;
+
+    gmtime_r(&epoch, &now);
+    year = now.tm_year + 1900 - 2000;
+    if (year < 0 || year > 127) {
+        return false;
+    }
+    data[0] = (year << 1) | ((now.tm_mon + 1) >> 3);
+    data[1] = ((now.tm_mon + 1) << 5) | now.tm_mday;
+    data[2] = now.tm_hour;
+    data[3] = now.tm_min;
+    data[4] = now.tm_sec;
+    return true;
+}
+
+static bool micom_set_rtc(MST12MicomState *s, const uint8_t *data)
+{
+    struct tm date = {
+        .tm_year = (data[0] >> 1) + 100,
+        .tm_mon = (((data[0] & 1) << 3) | (data[1] >> 5)) - 1,
+        .tm_mday = data[1] & 31,
+        .tm_hour = data[2] & 31,
+        .tm_min = data[3] & 63,
+        .tm_sec = data[4] & 63,
+        .tm_isdst = -1,
+    };
+    if (date.tm_mon < 0 || date.tm_mon > 11 || !date.tm_mday ||
+        date.tm_mday > 31 || date.tm_hour > 23 || date.tm_min > 59 ||
+        date.tm_sec > 59 || (data[2] & 0xe0) || (data[3] & 0xc0) ||
+        (data[4] & 0xc0) ||
+        !g_date_valid_dmy(date.tm_mday, date.tm_mon + 1,
+                          date.tm_year + 1900)) {
+        return false;
+    }
+    s->rtc_epoch = mktimegm(&date);
+    s->rtc_reference_ns = qemu_clock_get_ns(rtc_clock);
+    return true;
+}
+
+static void micom_process(MST12MicomState *s)
+{
+    uint8_t packet[MICOM_PACKET_BYTES] = {0xff, 0xff};
+    const uint8_t *data = s->input + 3;
+
+    s->last_command = s->input[2];
+    s->packets++;
+    micom_trace(s, "from guest", s->input);
+    switch (s->last_command) {
+    case 0x35:
+        if (data[0] == 0) {
+            s->partition = data[1];
+        } else if (data[0] != 1) {
+            goto invalid;
+        }
+        packet[2] = 0x35;
+        packet[3] = s->partition;
+        break;
+    case 0x60:
+        packet[2] = 0x50;
+        if (!micom_get_rtc(s, packet + 3)) {
+            goto invalid;
+        }
+        break;
+    case 0x61:
+        if (!micom_set_rtc(s, data)) {
+            goto invalid;
+        }
+        packet[2] = 0x51;
+        break;
+    default:
+        s->unsupported++;
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 MICOM unsupported command=0x%02x\n",
+                      s->last_command);
+        return;
+    }
+    micom_reply(s, packet);
+    return;
+
+invalid:
+    s->invalid_parameters++;
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 MICOM invalid parameters: cmd=0x%02x\n",
+                  s->last_command);
+}
+
+static void micom_resync(MST12MicomState *s)
+{
+    unsigned i;
+
+    for (i = 1; i < MICOM_PACKET_BYTES - 1; i++) {
+        if (s->input[i] == 0xff && s->input[i + 1] == 0xff) {
+            s->input_length = MICOM_PACKET_BYTES - i;
+            memmove(s->input, s->input + i, s->input_length);
+            s->discarded += i;
+            return;
+        }
+    }
+    s->input_length = s->input[MICOM_PACKET_BYTES - 1] == 0xff ? 1 : 0;
+    s->input[0] = 0xff;
+    s->discarded += MICOM_PACKET_BYTES - s->input_length;
+}
+
+static int micom_backend_write(Chardev *chr, const uint8_t *bytes, int len)
+{
+    MST12MicomState *s = MICOM_BACKEND(chr)->owner;
+    int i;
+
+    if (!s) {
+        return len;
+    }
+    if (qemu_chr_fe_backend_connected(&s->tx_monitor)) {
+        qemu_chr_fe_write(&s->tx_monitor, bytes, len);
+    }
+    s->tx_bytes += len;
+    for (i = 0; i < len; i++) {
+        if (s->input_length < 2 && bytes[i] != 0xff) {
+            s->discarded += s->input_length + 1;
+            s->input_length = 0;
+            continue;
+        }
+        s->input[s->input_length++] = bytes[i];
+        if (s->input_length == MICOM_PACKET_BYTES) {
+            if (micom_checksum(s->input) == s->input[8]) {
+                micom_process(s);
+                s->input_length = 0;
+            } else {
+                s->bad_checksums++;
+                micom_resync(s);
+            }
+        }
+    }
+    return len;
+}
+
+static int micom_backend_ioctl(Chardev *chr, int command, void *arg)
+{
+    MST12MicomState *s = MICOM_BACKEND(chr)->owner;
+
+    if (s && command == CHR_IOCTL_SERIAL_SET_PARAMS) {
+        QEMUSerialSetParams *params = arg;
+        unsigned bits = 1 + params->data_bits + params->stop_bits +
+                        (params->parity != 'N');
+
+        if (params->speed > 0 && params->speed <= 100000000 &&
+            params->data_bits >= 5 && params->data_bits <= 8 &&
+            params->stop_bits >= 1 && params->stop_bits <= 2) {
+            s->byte_ns = DIV_ROUND_UP(bits * NANOSECONDS_PER_SECOND,
+                                      params->speed);
+            return 0;
+        }
+    }
+    return -ENOTSUP;
+}
+
+static void micom_backend_open(Chardev *chr, ChardevBackend *backend,
+                               bool *be_opened, Error **errp)
+{
+    *be_opened = true;
+}
+
+static void micom_backend_class_init(ObjectClass *klass, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(klass);
+
+    cc->internal = true;
+    cc->open = micom_backend_open;
+    cc->chr_write = micom_backend_write;
+    cc->chr_ioctl = micom_backend_ioctl;
+}
+
+static void micom_backend_finalize(Object *obj)
+{
+    MicomBackend *backend = MICOM_BACKEND(obj);
+
+    if (backend->owner) {
+        backend->owner->chr = NULL;
+    }
+}
+
+Chardev *mst12_micom_chardev(DeviceState *dev)
+{
+    return MST12_MICOM(dev)->chr;
+}
+
+static void micom_reset(DeviceState *dev)
+{
+    MST12MicomState *s = MST12_MICOM(dev);
+
+    timer_del(s->timer);
+    timer_del(s->remote_timer);
+    s->input_length = s->reply_head = s->reply_count = 0;
+    s->last_command = s->last_reply = 0;
+    s->tx_bytes = s->rx_bytes = s->packets = s->responses = 0;
+    s->bad_checksums = s->unsupported = s->discarded = s->overflows = 0;
+    s->invalid_parameters = 0;
+    s->remote_key = 0;
+    s->remote_events = 0;
+    s->remote_releases = 0;
+    s->remote_down = false;
+    /* RTC and the selected partition survive a SoC reset within this VM. */
+}
+
+static void micom_realize(DeviceState *dev, Error **errp)
+{
+    MST12MicomState *s = MST12_MICOM(dev);
+    ChardevCommon common = {};
+    ChardevBackend backend = {
+        .type = CHARDEV_BACKEND_KIND_NULL,
+        .u.null.data = &common,
+    };
+    struct tm initial_date;
+
+    if (s->response_ns > NANOSECONDS_PER_SECOND) {
+        error_setg(errp, "MST12 MICOM response delay must be at most 1 second");
+        return;
+    }
+    if (!s->remote_hold_ns ||
+        s->remote_hold_ns > 10ULL * NANOSECONDS_PER_SECOND) {
+        error_setg(errp, "MST12 MICOM remote hold must be positive and "
+                        "at most 10 seconds");
+        return;
+    }
+    s->chr = qemu_chardev_new("mst12-micom", TYPE_MICOM_BACKEND, &backend,
+                              NULL, errp);
+    if (!s->chr) {
+        return;
+    }
+    MICOM_BACKEND(s->chr)->owner = s;
+    s->partition = s->initial_partition;
+    qemu_get_timedate(&initial_date, 0);
+    s->rtc_epoch = mktimegm(&initial_date);
+    s->rtc_reference_ns = qemu_clock_get_ns(rtc_clock);
+}
+
+static void micom_get_remote_key(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    uint32_t key = MST12_MICOM(obj)->remote_key;
+
+    visit_type_uint32(v, name, &key, errp);
+}
+
+static void micom_set_remote_key(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    MST12MicomState *s = MST12_MICOM(obj);
+    uint32_t key;
+    uint8_t packet[MICOM_PACKET_BYTES] = { 0xff, 0xff, 0x10 };
+
+    if (!visit_type_uint32(v, name, &key, errp)) {
+        return;
+    }
+    if (key > 255) {
+        error_setg(errp, "MICOM remote key must fit in one byte");
+        return;
+    }
+    /* A new tap first releases any earlier held key. Enqueue atomically. */
+    if (s->reply_count > MICOM_QUEUE_BYTES -
+                         MICOM_PACKET_BYTES * (s->remote_down ? 2 : 1)) {
+        error_setg(errp, "MICOM notification queue is full");
+        return;
+    }
+    timer_del(s->remote_timer);
+    micom_release_remote(s);
+    packet[3] = key;
+    if (!micom_reply(s, packet)) {
+        error_setg(errp, "MICOM notification queue is full");
+        return;
+    }
+    s->remote_key = key;
+    s->remote_events++;
+    s->remote_down = true;
+    timer_mod(s->remote_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                              s->remote_hold_ns);
+}
+
+static bool micom_get_remote_down(Object *obj, Error **errp)
+{
+    return MST12_MICOM(obj)->remote_down;
+}
+
+static void micom_init(Object *obj)
+{
+    MST12MicomState *s = MST12_MICOM(obj);
+
+    s->byte_ns = DIV_ROUND_UP(10ULL * NANOSECONDS_PER_SECOND, 115200);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, micom_transmit, s);
+    s->remote_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                 micom_release_remote, s);
+    object_property_add_uint32_ptr(obj, "input-length", &s->input_length,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "pending-bytes", &s->reply_count,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-command", &s->last_command,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-reply", &s->last_reply,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "byte-ns", &s->byte_ns,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-bytes", &s->tx_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-bytes", &s->rx_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "packet-count", &s->packets,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "reply-count", &s->responses,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "bad-checksums", &s->bad_checksums,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "unsupported-commands", &s->unsupported,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "discarded-bytes", &s->discarded,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "queue-overflows", &s->overflows,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "invalid-parameters",
+                                   &s->invalid_parameters, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "current-boot-partition", &s->partition,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add(obj, "remote-key", "uint32", micom_get_remote_key,
+                        micom_set_remote_key, NULL, NULL);
+    object_property_add_uint64_ptr(obj, "remote-events", &s->remote_events,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "remote-releases", &s->remote_releases,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "remote-down", micom_get_remote_down, NULL);
+}
+
+static void micom_finalize(Object *obj)
+{
+    MST12MicomState *s = MST12_MICOM(obj);
+
+    if (s->chr) {
+        MICOM_BACKEND(s->chr)->owner = NULL;
+    }
+    timer_free(s->timer);
+    timer_free(s->remote_timer);
+}
+
+static int micom_post_load(void *opaque, int version_id)
+{
+    MST12MicomState *s = opaque;
+
+    if (s->input_length >= MICOM_PACKET_BYTES ||
+        s->reply_head >= MICOM_QUEUE_BYTES ||
+        s->reply_count > MICOM_QUEUE_BYTES || !s->byte_ns ||
+        s->byte_ns > NANOSECONDS_PER_SECOND || s->partition > 255) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_micom = {
+    .name = TYPE_MST12_MICOM,
+    .version_id = 3,
+    .minimum_version_id = 1,
+    .post_load = micom_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_ARRAY(input, MST12MicomState, MICOM_PACKET_BYTES),
+        VMSTATE_UINT8_ARRAY(replies, MST12MicomState, MICOM_QUEUE_BYTES),
+        VMSTATE_UINT32(input_length, MST12MicomState),
+        VMSTATE_UINT32(reply_head, MST12MicomState),
+        VMSTATE_UINT32(reply_count, MST12MicomState),
+        VMSTATE_UINT32(last_command, MST12MicomState),
+        VMSTATE_UINT32(last_reply, MST12MicomState),
+        VMSTATE_UINT32(partition, MST12MicomState),
+        VMSTATE_UINT64(byte_ns, MST12MicomState),
+        VMSTATE_INT64(rtc_epoch, MST12MicomState),
+        VMSTATE_INT64(rtc_reference_ns, MST12MicomState),
+        VMSTATE_UINT64(tx_bytes, MST12MicomState),
+        VMSTATE_UINT64(rx_bytes, MST12MicomState),
+        VMSTATE_UINT64(packets, MST12MicomState),
+        VMSTATE_UINT64(responses, MST12MicomState),
+        VMSTATE_UINT64(bad_checksums, MST12MicomState),
+        VMSTATE_UINT64(unsupported, MST12MicomState),
+        VMSTATE_UINT64(discarded, MST12MicomState),
+        VMSTATE_UINT64(overflows, MST12MicomState),
+        VMSTATE_UINT64(invalid_parameters, MST12MicomState),
+        VMSTATE_UINT32_V(remote_key, MST12MicomState, 2),
+        VMSTATE_UINT64_V(remote_events, MST12MicomState, 2),
+        VMSTATE_TIMER_PTR(timer, MST12MicomState),
+        VMSTATE_UINT64_V(remote_releases, MST12MicomState, 3),
+        VMSTATE_BOOL_V(remote_down, MST12MicomState, 3),
+        VMSTATE_TIMER_PTR_V(remote_timer, MST12MicomState, 3),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property micom_properties[] = {
+    DEFINE_PROP_UINT8("boot-partition", MST12MicomState, initial_partition, 0),
+    DEFINE_PROP_UINT64("response-ns", MST12MicomState, response_ns, 1000000),
+    DEFINE_PROP_UINT64("remote-hold-ns", MST12MicomState,
+                       remote_hold_ns, 100000000),
+    DEFINE_PROP_BOOL("trace", MST12MicomState, trace, false),
+    DEFINE_PROP_CHR("tx-monitor", MST12MicomState, tx_monitor),
+};
+
+static void micom_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = micom_realize;
+    device_class_set_legacy_reset(dc, micom_reset);
+    device_class_set_props(dc, micom_properties);
+    dc->vmsd = &vmstate_micom;
+    dc->desc = "Samsung MST12 verified MICOM normal serial exchanges";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo micom_types[] = {
+    {
+        .name = TYPE_MICOM_BACKEND,
+        .parent = TYPE_CHARDEV,
+        .instance_size = sizeof(MicomBackend),
+        .instance_finalize = micom_backend_finalize,
+        .class_init = micom_backend_class_init,
+    }, {
+        .name = TYPE_MST12_MICOM,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(MST12MicomState),
+        .instance_init = micom_init,
+        .instance_finalize = micom_finalize,
+        .class_init = micom_class_init,
+    },
+};
+
+DEFINE_TYPES(micom_types)
diff --git a/hw/misc/mst12_miu_pll.c b/hw/misc/mst12_miu_pll.c
new file mode 100644
index 0000000000000000000000000000000000000000..252888fa16c03a3d8c373c01e8bfd7711d13d87d
--- /dev/null
+++ b/hw/misc/mst12_miu_pll.c
@@ -0,0 +1,268 @@
+/*
+ * MStar MST12 MIU PLL coefficient and spread-spectrum programming banks.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * HAL_MIU_SetSsc reads a 24-bit LPF coefficient at logical 0x10d30/0x10d32
+ * and programs step, delta and enable at 0x10d2a/0x10d28/0x10d29. MIU1 uses
+ * logical base 0x10d80 instead of 0x10d00. HAL_MIU_Read4Byte combines two
+ * spaced 16-bit registers. The HAL mapping supplies the non-PM RIU base.
+ *
+ * Direct kernel boot has no original bootloader to initialize LPF. The
+ * configurable nonzero bootstrap coefficients are emulator choices, not
+ * recovered TV clock values. Zero/unsupported enabled SSC configurations
+ * remain visible, report a fault, and do not advertise active modulation.
+ *
+ * This models programming state. Analog modulation, oscillator/PLL lock,
+ * clock distribution and DRAM timing are not implemented.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bitops.h"
+#include "qemu/log.h"
+#include "hw/misc/mst12_miu_pll.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+
+#define MIU_PLL_BANKS       2
+#define MIU_PLL_REGS        64
+#define MIU_PLL_SSC         0x14
+#define MIU_PLL_STEP        0x15
+#define MIU_PLL_LPF_LOW     0x18
+#define MIU_PLL_LPF_HIGH    0x19
+#define MIU_PLL_DISABLE     0x8000
+
+enum {
+    MIU_PLL_FAULT_LPF = 1,
+    MIU_PLL_FAULT_STEP,
+    MIU_PLL_FAULT_MODE,
+};
+
+struct MST12MIUPLLState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    uint16_t registers[MIU_PLL_BANKS * MIU_PLL_REGS];
+    uint32_t bootstrap_lpf0;
+    uint32_t bootstrap_lpf1;
+    uint32_t lpf[MIU_PLL_BANKS];
+    uint32_t step[MIU_PLL_BANKS];
+    uint32_t delta[MIU_PLL_BANKS];
+    uint32_t control[MIU_PLL_BANKS];
+    uint32_t fault[MIU_PLL_BANKS];
+    uint32_t active[MIU_PLL_BANKS];
+    uint64_t writes;
+    uint64_t ssc_updates;
+    bool trace;
+};
+
+static void miu_pll_update(MST12MIUPLLState *s, unsigned bank, bool commit)
+{
+    uint16_t *registers = &s->registers[bank * MIU_PLL_REGS];
+    unsigned fault = 0;
+
+    s->lpf[bank] = (registers[MIU_PLL_LPF_LOW] |
+                    (uint32_t)registers[MIU_PLL_LPF_HIGH] << 16) & 0xffffff;
+    s->step[bank] = registers[MIU_PLL_STEP] & 0x3fff;
+    s->delta[bank] = registers[MIU_PLL_SSC] & 0x3ff;
+    s->control[bank] = registers[MIU_PLL_SSC] >> 14;
+    if (s->control[bank] == 1) {
+        fault = MIU_PLL_FAULT_MODE;
+    } else if (s->control[bank] == 0) {
+        if (!s->lpf[bank]) {
+            fault = MIU_PLL_FAULT_LPF;
+        } else if (!s->step[bank]) {
+            fault = MIU_PLL_FAULT_STEP;
+        }
+    }
+    s->fault[bank] = fault;
+    s->active[bank] = !s->control[bank] && !fault;
+    if (!commit) {
+        return;
+    }
+    if (fault) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 MIU PLL fault: bank=%u fault=%u lpf=0x%06x "
+                      "step=%u delta=%u mode=%u\n",
+                      bank, fault, s->lpf[bank], s->step[bank],
+                      s->delta[bank], s->control[bank]);
+    } else if (s->active[bank]) {
+        s->ssc_updates++;
+    }
+    if (s->trace) {
+        qemu_log("MST12 MIU PLL SSC: bank=%u lpf=0x%06x step=%u "
+                 "delta=%u mode=%u active=%u fault=%u\n",
+                 bank, s->lpf[bank], s->step[bank], s->delta[bank],
+                 s->control[bank], s->active[bank], s->fault[bank]);
+    }
+}
+
+static uint64_t miu_pll_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12MIUPLLState *s = opaque;
+
+    if (offset & 2) {
+        return 0;
+    }
+    return extract32(s->registers[offset / 4], (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void miu_pll_write(void *opaque, hwaddr offset,
+                          uint64_t value, unsigned size)
+{
+    MST12MIUPLLState *s = opaque;
+    unsigned bank = offset / (MIU_PLL_REGS * 4);
+    unsigned index = offset / 4;
+
+    if (offset & 2) {
+        return;
+    }
+    s->registers[index] = deposit32(s->registers[index], (offset & 1) * 8,
+                                   MIN(size * 8, 16 - (offset & 1) * 8),
+                                   value);
+    s->writes++;
+    if (s->trace) {
+        qemu_log("MST12 MIU PLL write: offset=0x%03" HWADDR_PRIx
+                 " size=%u value=0x%04x\n", offset, size,
+                 s->registers[index]);
+    }
+    miu_pll_update(s, bank, index % MIU_PLL_REGS == MIU_PLL_SSC &&
+                           ((offset & 1) || size >= 2));
+}
+
+static const MemoryRegionOps miu_pll_ops = {
+    .read = miu_pll_read,
+    .write = miu_pll_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void miu_pll_reset(DeviceState *dev)
+{
+    MST12MIUPLLState *s = MST12_MIU_PLL(dev);
+    unsigned bank;
+
+    memset(s->registers, 0, sizeof(s->registers));
+    s->writes = 0;
+    s->ssc_updates = 0;
+    for (bank = 0; bank < MIU_PLL_BANKS; bank++) {
+        uint16_t *registers = &s->registers[bank * MIU_PLL_REGS];
+        uint32_t lpf = bank ? s->bootstrap_lpf1 : s->bootstrap_lpf0;
+
+        registers[MIU_PLL_LPF_LOW] = lpf;
+        registers[MIU_PLL_LPF_HIGH] = lpf >> 16;
+        registers[MIU_PLL_SSC] = MIU_PLL_DISABLE;
+        miu_pll_update(s, bank, false);
+    }
+}
+
+static void miu_pll_realize(DeviceState *dev, Error **errp)
+{
+    MST12MIUPLLState *s = MST12_MIU_PLL(dev);
+
+    if (!s->bootstrap_lpf0 || s->bootstrap_lpf0 > 0xffffff ||
+        !s->bootstrap_lpf1 || s->bootstrap_lpf1 > 0xffffff) {
+        error_setg(errp, "MStar MIU PLL bootstrap LPF must be a nonzero "
+                   "24-bit coefficient");
+    }
+}
+
+static void miu_pll_init(Object *obj)
+{
+    MST12MIUPLLState *s = MST12_MIU_PLL(obj);
+    unsigned bank;
+
+    memory_region_init_io(&s->iomem, obj, &miu_pll_ops, s,
+                          TYPE_MST12_MIU_PLL,
+                          MIU_PLL_BANKS * MIU_PLL_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    for (bank = 0; bank < MIU_PLL_BANKS; bank++) {
+        static const struct {
+            const char *name;
+            size_t offset;
+        } properties[] = {
+            { "lpf", offsetof(MST12MIUPLLState, lpf) },
+            { "ssc-step", offsetof(MST12MIUPLLState, step) },
+            { "ssc-delta", offsetof(MST12MIUPLLState, delta) },
+            { "ssc-control", offsetof(MST12MIUPLLState, control) },
+            { "ssc-active", offsetof(MST12MIUPLLState, active) },
+            { "fault", offsetof(MST12MIUPLLState, fault) },
+        };
+        unsigned i;
+
+        for (i = 0; i < ARRAY_SIZE(properties); i++) {
+            g_autofree char *name = g_strdup_printf("miu%u-%s", bank,
+                                                    properties[i].name);
+            uint32_t *array = (uint32_t *)((uint8_t *)s +
+                                          properties[i].offset);
+
+            object_property_add_uint32_ptr(obj, name, &array[bank],
+                                           OBJ_PROP_FLAG_READ);
+        }
+    }
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "ssc-updates", &s->ssc_updates,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static int miu_pll_post_load(void *opaque, int version_id)
+{
+    MST12MIUPLLState *s = opaque;
+    unsigned bank;
+
+    for (bank = 0; bank < MIU_PLL_BANKS; bank++) {
+        miu_pll_update(s, bank, false);
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_miu_pll = {
+    .name = TYPE_MST12_MIU_PLL,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = miu_pll_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12MIUPLLState,
+                            MIU_PLL_BANKS * MIU_PLL_REGS),
+        VMSTATE_UINT64(writes, MST12MIUPLLState),
+        VMSTATE_UINT64(ssc_updates, MST12MIUPLLState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property miu_pll_properties[] = {
+    DEFINE_PROP_UINT32("bootstrap-lpf0", MST12MIUPLLState,
+                      bootstrap_lpf0, 0x100000),
+    DEFINE_PROP_UINT32("bootstrap-lpf1", MST12MIUPLLState,
+                      bootstrap_lpf1, 0x100000),
+    DEFINE_PROP_BOOL("trace", MST12MIUPLLState, trace, false),
+};
+
+static void miu_pll_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = miu_pll_realize;
+    device_class_set_legacy_reset(dc, miu_pll_reset);
+    device_class_set_props(dc, miu_pll_properties);
+    dc->vmsd = &vmstate_miu_pll;
+    dc->desc = "MStar MST12 MIU PLL/SSC programming banks";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo miu_pll_type = {
+    .name = TYPE_MST12_MIU_PLL,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12MIUPLLState),
+    .instance_init = miu_pll_init,
+    .class_init = miu_pll_class_init,
+};
+
+static void miu_pll_register_types(void)
+{
+    type_register_static(&miu_pll_type);
+}
+
+type_init(miu_pll_register_types)
diff --git a/hw/misc/mst12_pcmcia.c b/hw/misc/mst12_pcmcia.c
new file mode 100644
index 0000000000000000000000000000000000000000..ce8e3f2b74b2ffe315452da57441a478d479c03a
--- /dev/null
+++ b/hw/misc/mst12_pcmcia.c
@@ -0,0 +1,372 @@
+/*
+ * MStar MST12 polling PCMCIA controller and an optional memory-card fixture.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Original PreInit MDrv_SYS_PCMCIA_READ/WRITE and libUTOPIA HAL byte access
+ * establish the bank, command/address/data ports, start and acknowledge,
+ * read-ready/write-ready status and the doubled attribute-bus address.
+ * MDrv_PCMCIA_Detect uses status bit 10; low means inserted in this model.
+ * Active-low wiring, open-bus 0xff and cycle latency remain assumptions.
+ *
+ * There is no card by default. Supported reads sample an open bus; writes
+ * complete without changing card memory. A private, synthetic attribute
+ * image enables a generic memory fixture, not a CI/CI+ CAM or TV identity.
+ * Unsupported commands retain busy and never fabricate a successful read.
+ * Card interrupts, common memory, CAM protocols and DMA are not implemented.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/loader.h"
+#include "hw/misc/mst12_pcmcia.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+
+#define PCM_REGS             32
+#define PCM_ATTR_BYTES       32768
+#define PCM_IO_BYTES         65536
+#define PCM_COMMAND          0
+#define PCM_ADDRESS          1
+#define PCM_WRITE_DATA       2
+#define PCM_CONTROL          3
+#define PCM_READ_STATUS      4
+#define PCM_CONFIG           8
+#define PCM_START            1
+#define PCM_ACK              2
+#define PCM_READ_READY       0x100
+#define PCM_WRITE_READY      0x200
+#define PCM_CARD_DETECT      0x400
+#define PCM_CARD_RESET       4
+
+enum {
+    PCM_FAULT_COMMAND = 1,
+    PCM_FAULT_CONTROL,
+    PCM_FAULT_BUSY,
+};
+
+struct MST12PCMCIAState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[PCM_REGS];
+    uint8_t attribute[PCM_ATTR_BYTES];
+    uint8_t io[PCM_IO_BYTES];
+    char *attribute_file;
+    uint32_t image_bytes;
+    uint32_t address;
+    uint32_t command;
+    uint32_t write_data;
+    uint32_t read_data;
+    uint32_t fault;
+    uint64_t reads;
+    uint64_t writes;
+    uint64_t open_bus_reads;
+    uint64_t cycle_ns;
+    bool busy;
+    bool read_ready;
+    bool write_ready;
+    bool inserted;
+    bool inserted_configured;
+    bool trace;
+};
+
+static void pcmcia_fault(MST12PCMCIAState *s, unsigned fault)
+{
+    s->fault = fault;
+    timer_del(s->timer);
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 PCMCIA fault=%u cmd=0x%02x address=0x%04x\n",
+                  fault, s->command, s->address);
+}
+
+static void pcmcia_complete(void *opaque)
+{
+    MST12PCMCIAState *s = opaque;
+    bool responding = s->inserted &&
+                      !(s->registers[PCM_CONFIG] & PCM_CARD_RESET);
+    bool attribute = s->command == 3 || s->command == 4;
+    unsigned address = attribute ? s->address / 2 : s->address;
+    uint8_t *memory = attribute ? s->attribute : s->io;
+
+    if (!s->busy || s->fault) {
+        return;
+    }
+    if (s->command == 3 || s->command == 5) {
+        s->read_data = responding && (!attribute || !(s->address & 1)) ?
+                       memory[address] : 0xff;
+        s->read_ready = true;
+        s->write_ready = false;
+        s->reads++;
+        if (!responding) {
+            s->open_bus_reads++;
+        }
+    } else {
+        if (responding && (!attribute || (!(s->address & 1) &&
+                                          address >= s->image_bytes))) {
+            memory[address] = s->write_data;
+        }
+        s->writes++;
+        s->read_ready = false;
+        s->write_ready = true;
+    }
+    s->registers[PCM_CONTROL] &= ~PCM_START;
+    s->busy = false;
+    if (s->trace) {
+        qemu_log("MST12 PCMCIA cycle: cmd=0x%02x address=0x%04x "
+                 "write=0x%02x read=0x%02x inserted=%u responding=%u\n",
+                 s->command, s->address, s->write_data, s->read_data,
+                 s->inserted, responding);
+    }
+}
+
+static uint64_t pcmcia_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12PCMCIAState *s = opaque;
+    unsigned index = offset / 4;
+    uint16_t value = s->registers[index];
+
+    if (offset & 2) {
+        return 0;
+    }
+    if (index == PCM_READ_STATUS) {
+        value = s->read_data | (s->read_ready ? PCM_READ_READY : 0) |
+                (s->write_ready ? PCM_WRITE_READY : 0) |
+                (s->inserted ? 0 : PCM_CARD_DETECT);
+    }
+    return extract32(value, (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void pcmcia_write(void *opaque, hwaddr offset,
+                         uint64_t value, unsigned size)
+{
+    MST12PCMCIAState *s = opaque;
+    unsigned index = offset / 4;
+    uint16_t updated;
+
+    if (offset & 2 || index == PCM_READ_STATUS) {
+        return;
+    }
+    updated = deposit32(s->registers[index], (offset & 1) * 8,
+                        size == 1 ? 8 : 16, value);
+    if (s->trace) {
+        qemu_log("MST12 PCMCIA write: reg=0x%02x value=0x%04x\n",
+                 index, updated);
+    }
+    if (index != PCM_CONTROL) {
+        s->registers[index] = updated;
+        return;
+    }
+    if (s->busy) {
+        s->registers[index] = updated | PCM_START;
+        if (updated & PCM_START) {
+            pcmcia_fault(s, PCM_FAULT_BUSY);
+        }
+        return;
+    }
+    s->registers[index] = updated & ~PCM_ACK;
+    if ((updated & (PCM_START | PCM_ACK)) == (PCM_START | PCM_ACK)) {
+        s->busy = true;
+        s->read_ready = false;
+        s->write_ready = false;
+        pcmcia_fault(s, PCM_FAULT_CONTROL);
+        return;
+    }
+    if (updated & PCM_ACK) {
+        s->read_ready = false;
+        s->write_ready = true;
+    }
+    if (!(updated & PCM_START)) {
+        return;
+    }
+    s->busy = true;
+    s->read_ready = false;
+    s->write_ready = false;
+    s->command = s->registers[PCM_COMMAND] & 0xff;
+    s->address = s->registers[PCM_ADDRESS];
+    s->write_data = s->registers[PCM_WRITE_DATA] & 255;
+    if (s->fault) {
+        return;
+    }
+    if (s->command < 3 || s->command > 6) {
+        pcmcia_fault(s, PCM_FAULT_COMMAND);
+        return;
+    }
+    if (s->cycle_ns) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  s->cycle_ns);
+    } else {
+        pcmcia_complete(s);
+    }
+}
+
+static const MemoryRegionOps pcmcia_ops = {
+    .read = pcmcia_read,
+    .write = pcmcia_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void pcmcia_reset(DeviceState *dev)
+{
+    MST12PCMCIAState *s = MST12_PCMCIA(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->io, 0xff, sizeof(s->io));
+    s->address = 0;
+    s->command = 0;
+    s->write_data = 0;
+    s->read_data = 0xff;
+    s->fault = 0;
+    s->reads = 0;
+    s->writes = 0;
+    s->open_bus_reads = 0;
+    s->busy = false;
+    s->read_ready = false;
+    s->write_ready = true;
+}
+
+static bool pcmcia_get_inserted(Object *obj, Error **errp)
+{
+    return MST12_PCMCIA(obj)->inserted;
+}
+
+static void pcmcia_set_inserted(Object *obj, bool value, Error **errp)
+{
+    MST12PCMCIAState *s = MST12_PCMCIA(obj);
+
+    s->inserted = value;
+    s->inserted_configured = true;
+}
+
+static void pcmcia_realize(DeviceState *dev, Error **errp)
+{
+    MST12PCMCIAState *s = MST12_PCMCIA(dev);
+
+    if (s->cycle_ns > 1000000000) {
+        error_setg(errp, "MStar PCMCIA cycle delay must be at most one second");
+        return;
+    }
+    memset(s->attribute, 0xff, sizeof(s->attribute));
+    if (s->attribute_file) {
+        int64_t length = get_image_size(s->attribute_file);
+
+        if (length <= 0 || length > PCM_ATTR_BYTES ||
+            load_image_size(s->attribute_file, s->attribute,
+                            sizeof(s->attribute)) != length) {
+            error_setg(errp, "MStar PCMCIA attribute image must contain "
+                       "1 to %u logical attribute bytes", PCM_ATTR_BYTES);
+            return;
+        }
+        s->image_bytes = length;
+        if (!s->inserted_configured) {
+            s->inserted = true;
+        }
+    }
+}
+
+static void pcmcia_init(Object *obj)
+{
+    MST12PCMCIAState *s = MST12_PCMCIA(obj);
+
+    memory_region_init_io(&s->iomem, obj, &pcmcia_ops, s, TYPE_MST12_PCMCIA,
+                          PCM_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, pcmcia_complete, s);
+    object_property_add_bool(obj, "card-inserted", pcmcia_get_inserted,
+                             pcmcia_set_inserted);
+    object_property_add_uint32_ptr(obj, "cycle-command", &s->command,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "cycle-address", &s->address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "read-count", &s->reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "write-count", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "open-bus-reads", &s->open_bus_reads,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void pcmcia_finalize(Object *obj)
+{
+    timer_free(MST12_PCMCIA(obj)->timer);
+}
+
+static int pcmcia_post_load(void *opaque, int version_id)
+{
+    MST12PCMCIAState *s = opaque;
+
+    if (s->address > UINT16_MAX || s->read_data > UINT8_MAX ||
+        s->write_data > UINT8_MAX || s->image_bytes > PCM_ATTR_BYTES) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_pcmcia = {
+    .name = TYPE_MST12_PCMCIA,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = pcmcia_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12PCMCIAState, PCM_REGS),
+        VMSTATE_UINT8_ARRAY(attribute, MST12PCMCIAState, PCM_ATTR_BYTES),
+        VMSTATE_UINT8_ARRAY(io, MST12PCMCIAState, PCM_IO_BYTES),
+        VMSTATE_UINT32(image_bytes, MST12PCMCIAState),
+        VMSTATE_UINT32(address, MST12PCMCIAState),
+        VMSTATE_UINT32(command, MST12PCMCIAState),
+        VMSTATE_UINT32(write_data, MST12PCMCIAState),
+        VMSTATE_UINT32(read_data, MST12PCMCIAState),
+        VMSTATE_UINT32(fault, MST12PCMCIAState),
+        VMSTATE_UINT64(reads, MST12PCMCIAState),
+        VMSTATE_UINT64(writes, MST12PCMCIAState),
+        VMSTATE_UINT64(open_bus_reads, MST12PCMCIAState),
+        VMSTATE_BOOL(busy, MST12PCMCIAState),
+        VMSTATE_BOOL(read_ready, MST12PCMCIAState),
+        VMSTATE_BOOL(write_ready, MST12PCMCIAState),
+        VMSTATE_BOOL(inserted, MST12PCMCIAState),
+        VMSTATE_TIMER_PTR(timer, MST12PCMCIAState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property pcmcia_properties[] = {
+    DEFINE_PROP_STRING("attribute-file", MST12PCMCIAState, attribute_file),
+    DEFINE_PROP_UINT64("cycle-ns", MST12PCMCIAState, cycle_ns, 0),
+    DEFINE_PROP_BOOL("trace", MST12PCMCIAState, trace, false),
+};
+
+static void pcmcia_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = pcmcia_realize;
+    device_class_set_legacy_reset(dc, pcmcia_reset);
+    device_class_set_props(dc, pcmcia_properties);
+    dc->vmsd = &vmstate_pcmcia;
+    dc->desc = "MStar MST12 polling PCMCIA controller";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo pcmcia_type = {
+    .name = TYPE_MST12_PCMCIA,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12PCMCIAState),
+    .instance_init = pcmcia_init,
+    .instance_finalize = pcmcia_finalize,
+    .class_init = pcmcia_class_init,
+};
+
+static void pcmcia_register_types(void)
+{
+    type_register_static(&pcmcia_type);
+}
+
+type_init(pcmcia_register_types)
diff --git a/hw/misc/mst12_tsp.c b/hw/misc/mst12_tsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..da847b563296d1cf7d5c63ab8e31667ca8f2248d
--- /dev/null
+++ b/hw/misc/mst12_tsp.c
@@ -0,0 +1,806 @@
+/*
+ * MStar TSP firmware loader and integer OpenRISC coprocessor.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2 libUTOPIA.so supplies the host register layout.
+ * The original downloaded MCU image supplies the native mailbox endpoints.
+ * Integer instruction encodings follow QEMU target/openrisc/insns.decode.
+ *
+ * This executes guest MCU code, including its mailbox handlers. It does not
+ * synthesize ALIVE/version responses. Transport-stream ingestion, filtering,
+ * MCU exceptions, SPRs and external MCU DMA are not implemented. Unsupported
+ * instructions or memory accesses halt the MCU with an explicit diagnostic.
+ * The timer quantum is a scheduling choice, not a verified hardware clock.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/misc/mst12_tsp.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+
+#define TSP_APERTURE          0x400
+#define TSP_REGS              (TSP_APERTURE / 4)
+#define TSP_QMEM_SIZE         0x4000
+#define TSP_NATIVE_BASE       0x210000
+#define TSP_NATIVE_SIZE       0x10000
+#define TSP_NATIVE_WORDS      (TSP_NATIVE_SIZE / 4)
+#define TSP_NATIVE_COMMAND    0x210330
+#define TSP_NATIVE_RESPONSE   0x21033c
+#define TSP_COMMAND           0x100
+#define TSP_RESPONSE          0x200
+#define TSP_IND_CONTROL       0x120
+#define TSP_IND_ADDRESS       0x124
+#define TSP_IND_WRITE         0x12c
+#define TSP_IND_READ          0x134
+#define TSP_DOWNLOAD_ADDRESS  0x1e0
+#define TSP_DOWNLOAD_SIZE     0x1e4
+#define TSP_CONTROL           0x1e8
+#define TSP_DOWNLOAD_HIGH     0x228
+#define TSP_CPU_ENABLE        1
+#define TSP_RESET_RELEASE     2
+#define TSP_DOWNLOAD_START    4
+#define TSP_DOWNLOAD_DONE     8
+#define TSP_INSTRUCTION_BE    (1u << 12)
+#define TSP_DATA_BE           (1u << 13)
+#define TSP_QUANTUM_NS        100000
+#define TSP_QUANTUM_STEPS     4096
+#define TSP_LOOP_SLOTS        64
+#define R(offset)             (s->registers[(offset) / 4])
+
+typedef struct MST12TSPLoop {
+    uint32_t pc;
+    uint32_t next_pc;
+    uint32_t gpr[32];
+    uint64_t memory_epoch;
+    bool flag;
+    bool carry;
+    bool valid;
+} MST12TSPLoop;
+
+struct MST12TSPState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[TSP_REGS];
+    uint32_t native[TSP_NATIVE_WORDS];
+    uint8_t qmem[TSP_QMEM_SIZE];
+    uint32_t gpr[32];
+    uint32_t pc;
+    uint32_t next_pc;
+    uint32_t fault;
+    uint32_t fault_pc;
+    uint32_t fault_word;
+    uint32_t fault_address;
+    uint32_t download_bytes;
+    uint64_t instructions;
+    uint64_t memory_epoch;
+    MST12TSPLoop loops[TSP_LOOP_SLOTS];
+    bool flag;
+    bool carry;
+    bool idle;
+    bool trace;
+};
+
+static uint32_t tsp_pair(MST12TSPState *s, unsigned offset)
+{
+    return R(offset) | (uint32_t)R(offset + 4) << 16;
+}
+
+static void tsp_set_pair(MST12TSPState *s, unsigned offset, uint32_t value)
+{
+    if (tsp_pair(s, offset) != value) {
+        s->memory_epoch++;
+    }
+    R(offset) = value;
+    R(offset + 4) = value >> 16;
+}
+
+static void tsp_fault(MST12TSPState *s, unsigned reason,
+                      uint32_t word, uint32_t address)
+{
+    s->fault = reason;
+    s->fault_pc = s->pc;
+    s->fault_word = word;
+    s->fault_address = address;
+    timer_del(s->timer);
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 TSP MCU halted: reason=%u pc=0x%08x "
+                  "instruction=0x%08x address=0x%08x\n",
+                  reason, s->pc, word, address);
+}
+
+static bool tsp_running(MST12TSPState *s)
+{
+    return !s->fault && !s->idle && (R(TSP_CONTROL) & 3) == 3;
+}
+
+static void tsp_schedule(MST12TSPState *s)
+{
+    if (tsp_running(s)) {
+        timer_mod(s->timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + TSP_QUANTUM_NS);
+    } else {
+        timer_del(s->timer);
+    }
+}
+
+static bool tsp_native_read(MST12TSPState *s, uint32_t address,
+                            unsigned size, uint32_t *value)
+{
+    unsigned shift = (address & 3) * 8;
+
+    if (address >= TSP_NATIVE_BASE &&
+        (uint64_t)address + size <= TSP_NATIVE_BASE + TSP_NATIVE_SIZE &&
+        !(address & (size - 1))) {
+        uint32_t word;
+
+        switch (address & ~3u) {
+        case TSP_NATIVE_COMMAND:
+            word = tsp_pair(s, TSP_COMMAND);
+            break;
+        case TSP_NATIVE_RESPONSE:
+            word = tsp_pair(s, TSP_RESPONSE);
+            break;
+        default:
+            word = s->native[(address - TSP_NATIVE_BASE) / 4];
+            break;
+        }
+        *value = extract32(word, shift, size * 8);
+        return true;
+    }
+    return false;
+}
+
+static bool tsp_native_write(MST12TSPState *s, uint32_t address,
+                             unsigned size, uint32_t value)
+{
+    uint32_t previous;
+
+    if (!tsp_native_read(s, address & ~3u, 4, &previous) ||
+        (address & (size - 1))) {
+        return false;
+    }
+    value = deposit32(previous, (address & 3) * 8, size * 8, value);
+    switch (address & ~3u) {
+    case TSP_NATIVE_COMMAND:
+        tsp_set_pair(s, TSP_COMMAND, value);
+        break;
+    case TSP_NATIVE_RESPONSE:
+        tsp_set_pair(s, TSP_RESPONSE, value);
+        if (s->trace) {
+            qemu_log_mask(LOG_UNIMP,
+                          "MST12 TSP MCU response: pc=0x%08x value=0x%08x\n",
+                          s->pc, value);
+        }
+        break;
+    default:
+        if (previous != value) {
+            s->memory_epoch++;
+        }
+        s->native[(address - TSP_NATIVE_BASE) / 4] = value;
+        break;
+    }
+    return true;
+}
+
+static bool tsp_load(MST12TSPState *s, uint32_t address,
+                     unsigned size, bool instruction, uint32_t *value)
+{
+    bool big = R(TSP_CONTROL) &
+               (instruction ? TSP_INSTRUCTION_BE : TSP_DATA_BE);
+
+    if (address & (size - 1)) {
+        return false;
+    }
+    if ((uint64_t)address + size <= TSP_QMEM_SIZE) {
+        const uint8_t *source = s->qmem + address;
+
+        switch (size) {
+        case 1:
+            *value = *source;
+            break;
+        case 2:
+            *value = big ? lduw_be_p(source) : lduw_le_p(source);
+            break;
+        case 4:
+            *value = big ? ldl_be_p(source) : ldl_le_p(source);
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        return true;
+    }
+    return !instruction && tsp_native_read(s, address, size, value);
+}
+
+static bool tsp_store(MST12TSPState *s, uint32_t address,
+                      unsigned size, uint32_t value)
+{
+    bool big = R(TSP_CONTROL) & TSP_DATA_BE;
+
+    if (address & (size - 1)) {
+        return false;
+    }
+    if ((uint64_t)address + size <= TSP_QMEM_SIZE) {
+        uint8_t *destination = s->qmem + address;
+        uint32_t previous;
+
+        tsp_load(s, address, size, false, &previous);
+        if (previous != (size == 4 ? value :
+                         value & ((1u << (size * 8)) - 1))) {
+            s->memory_epoch++;
+        }
+
+        switch (size) {
+        case 1:
+            *destination = value;
+            break;
+        case 2:
+            if (big) {
+                stw_be_p(destination, value);
+            } else {
+                stw_le_p(destination, value);
+            }
+            break;
+        case 4:
+            if (big) {
+                stl_be_p(destination, value);
+            } else {
+                stl_le_p(destination, value);
+            }
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        return true;
+    }
+    return tsp_native_write(s, address, size, value);
+}
+
+static bool tsp_compare(unsigned condition, uint32_t a, uint32_t b,
+                        bool *flag)
+{
+    switch (condition) {
+    case 0:
+        *flag = a == b;
+        break;
+    case 1:
+        *flag = a != b;
+        break;
+    case 2:
+        *flag = a > b;
+        break;
+    case 3:
+        *flag = a >= b;
+        break;
+    case 4:
+        *flag = a < b;
+        break;
+    case 5:
+        *flag = a <= b;
+        break;
+    case 10:
+        *flag = (int32_t)a > (int32_t)b;
+        break;
+    case 11:
+        *flag = (int32_t)a >= (int32_t)b;
+        break;
+    case 12:
+        *flag = (int32_t)a < (int32_t)b;
+        break;
+    case 13:
+        *flag = (int32_t)a <= (int32_t)b;
+        break;
+    default:
+        return false;
+    }
+    return true;
+}
+
+/*
+ * A repeated complete CPU state, with no changed memory/register values in
+ * between, is a deterministic polling cycle. No modeled MCU timer/stream
+ * input can change that cycle independently. Sleep until a host register
+ * write or download changes its inputs. This does not alter guest code or
+ * infer idleness merely from a zero mailbox or one familiar PC.
+ */
+static void tsp_check_idle(MST12TSPState *s)
+{
+    MST12TSPLoop *loop = &s->loops[(s->pc >> 2) % TSP_LOOP_SLOTS];
+
+    if (loop->valid && loop->pc == s->pc && loop->next_pc == s->next_pc &&
+        loop->memory_epoch == s->memory_epoch && loop->flag == s->flag &&
+        loop->carry == s->carry &&
+        !memcmp(loop->gpr, s->gpr, sizeof(s->gpr))) {
+        s->idle = true;
+        return;
+    }
+    loop->pc = s->pc;
+    loop->next_pc = s->next_pc;
+    loop->memory_epoch = s->memory_epoch;
+    loop->flag = s->flag;
+    loop->carry = s->carry;
+    memcpy(loop->gpr, s->gpr, sizeof(s->gpr));
+    loop->valid = true;
+}
+
+/* Every taken branch executes its architectural delay-slot instruction. */
+static bool tsp_step(MST12TSPState *s)
+{
+    uint32_t word, result, address;
+    uint32_t following = s->next_pc + 4;
+    unsigned opcode, d, a, b, size;
+    int32_t immediate;
+    bool writeback = false;
+    bool backward = false;
+
+    if (!tsp_load(s, s->pc, 4, true, &word)) {
+        tsp_fault(s, 2, 0, s->pc);
+        return false;
+    }
+    opcode = word >> 26;
+    d = (word >> 21) & 31;
+    a = (word >> 16) & 31;
+    b = (word >> 11) & 31;
+    immediate = (int16_t)word;
+    result = 0;
+    switch (opcode) {
+    case 0: /* l.j */
+    case 1: /* l.jal */
+    case 3: /* l.bnf */
+    case 4: /* l.bf */
+        if (opcode == 1) {
+            s->gpr[9] = s->pc + 8;
+        }
+        if (opcode <= 1 || s->flag == (opcode == 4)) {
+            following = s->pc + (uint32_t)sextract32(word, 0, 26) * 4;
+            backward = following <= s->pc;
+        }
+        break;
+    case 5: /* l.nop */
+        if ((word & 0x03000000) != 0x01000000) {
+            goto unsupported;
+        }
+        break;
+    case 6: /* l.movhi */
+        if (word & (1u << 16)) {
+            goto unsupported;
+        }
+        result = word << 16;
+        writeback = true;
+        break;
+    case 0x11: /* l.jr */
+    case 0x12: /* l.jalr */
+        following = s->gpr[b];
+        backward = following <= s->pc;
+        if (opcode == 0x12) {
+            s->gpr[9] = s->pc + 8;
+        }
+        break;
+    case 0x21: /* l.lwz */
+    case 0x22: /* l.lws */
+    case 0x23: /* l.lbz */
+    case 0x24: /* l.lbs */
+    case 0x25: /* l.lhz */
+    case 0x26: /* l.lhs */
+        size = opcode <= 0x22 ? 4 : opcode <= 0x24 ? 1 : 2;
+        address = s->gpr[a] + (uint32_t)immediate;
+        if (!tsp_load(s, address, size, false, &result)) {
+            tsp_fault(s, 3, word, address);
+            return false;
+        }
+        if (opcode == 0x24) {
+            result = (int8_t)result;
+        } else if (opcode == 0x26) {
+            result = (int16_t)result;
+        }
+        writeback = true;
+        break;
+    case 0x27: /* l.addi */
+    case 0x28: /* l.addic */
+        {
+            uint64_t sum = (uint64_t)s->gpr[a] + (uint32_t)immediate;
+
+            sum += opcode == 0x28 && s->carry;
+            result = sum;
+            s->carry = sum >> 32;
+            writeback = true;
+        }
+        break;
+    case 0x29:
+        result = s->gpr[a] & (word & 0xffff);
+        goto writeback;
+    case 0x2a:
+        result = s->gpr[a] | (word & 0xffff);
+        goto writeback;
+    case 0x2b:
+        result = s->gpr[a] ^ (uint32_t)immediate;
+        goto writeback;
+    case 0x2c:
+        result = s->gpr[a] * (uint32_t)immediate;
+        goto writeback;
+    case 0x2e: /* immediate shifts */
+        size = word & 31;
+        switch ((word >> 6) & 3) {
+        case 0:
+            result = s->gpr[a] << size;
+            break;
+        case 1:
+            result = s->gpr[a] >> size;
+            break;
+        case 2:
+            result = (int32_t)s->gpr[a] >> size;
+            break;
+        case 3:
+            result = ror32(s->gpr[a], size);
+            break;
+        }
+        goto writeback;
+    case 0x2f: /* immediate comparisons */
+    case 0x39: /* register comparisons */
+        if (!tsp_compare(d, s->gpr[a],
+                         opcode == 0x2f ? immediate : s->gpr[b], &s->flag)) {
+            goto unsupported;
+        }
+        break;
+    case 0x35: /* l.sw */
+    case 0x36: /* l.sb */
+    case 0x37: /* l.sh */
+        immediate = (int16_t)(((word >> 10) & 0xf800) | (word & 0x7ff));
+        size = opcode == 0x35 ? 4 : opcode == 0x36 ? 1 : 2;
+        address = s->gpr[a] + (uint32_t)immediate;
+        if (!tsp_store(s, address, size, s->gpr[b])) {
+            tsp_fault(s, 4, word, address);
+            return false;
+        }
+        break;
+    case 0x38: /* integer register ALU */
+        size = s->gpr[b] & 31;
+        switch (word & 0x3ff) {
+        case 0:
+        case 1:
+            {
+                uint64_t sum = (uint64_t)s->gpr[a] + s->gpr[b];
+
+                sum += (word & 0x3ff) == 1 && s->carry;
+                result = sum;
+                s->carry = sum >> 32;
+            }
+            break;
+        case 2:
+            result = s->gpr[a] - s->gpr[b];
+            s->carry = s->gpr[a] < s->gpr[b];
+            break;
+        case 3:
+            result = s->gpr[a] & s->gpr[b];
+            break;
+        case 4:
+            result = s->gpr[a] | s->gpr[b];
+            break;
+        case 5:
+            result = s->gpr[a] ^ s->gpr[b];
+            break;
+        case 8:
+            result = s->gpr[a] << size;
+            break;
+        case 0x48:
+            result = s->gpr[a] >> size;
+            break;
+        case 0x88:
+            result = (int32_t)s->gpr[a] >> size;
+            break;
+        case 0xc8:
+            result = ror32(s->gpr[a], size);
+            break;
+        case 0xe:
+            result = s->gpr[s->flag ? a : b];
+            break;
+        case 0x306:
+        case 0x30b:
+            result = s->gpr[a] * s->gpr[b];
+            break;
+        default:
+            goto unsupported;
+        }
+        goto writeback;
+    default:
+        goto unsupported;
+    }
+    goto retire;
+writeback:
+    writeback = true;
+retire:
+    if (writeback && d) {
+        s->gpr[d] = result;
+    }
+    s->gpr[0] = 0;
+    s->pc = s->next_pc;
+    s->next_pc = following;
+    s->instructions++;
+    if (backward) {
+        tsp_check_idle(s);
+    }
+    return true;
+unsupported:
+    tsp_fault(s, 1, word, 0);
+    return false;
+}
+
+static void tsp_tick(void *opaque)
+{
+    MST12TSPState *s = opaque;
+    unsigned steps;
+
+    for (steps = 0; steps < TSP_QUANTUM_STEPS && tsp_running(s); steps++) {
+        if (!tsp_step(s)) {
+            break;
+        }
+    }
+    tsp_schedule(s);
+}
+
+static void tsp_cpu_reset(MST12TSPState *s)
+{
+    memset(s->gpr, 0, sizeof(s->gpr));
+    memset(s->loops, 0, sizeof(s->loops));
+    s->pc = 0x100;
+    s->next_pc = 0x104;
+    s->flag = false;
+    s->carry = false;
+    s->idle = false;
+    s->fault = 0;
+    s->fault_pc = 0;
+    s->fault_word = 0;
+    s->fault_address = 0;
+    s->instructions = 0;
+    timer_del(s->timer);
+}
+
+static void tsp_download(MST12TSPState *s)
+{
+    uint64_t bus = ((uint64_t)(R(TSP_DOWNLOAD_HIGH) & 0xff) << 24) |
+                   ((uint64_t)R(TSP_DOWNLOAD_ADDRESS) << 8);
+    uint64_t base;
+    unsigned length = (unsigned)R(TSP_DOWNLOAD_SIZE) * 4;
+    MemoryRegionSection section;
+
+    s->download_bytes = 0;
+    R(TSP_CONTROL) &= ~TSP_DOWNLOAD_DONE;
+    if (!length || length > TSP_QMEM_SIZE) {
+        goto invalid;
+    }
+    if (bus < 0x60000000 && bus + length <= 0x60000000) {
+        base = 0x40000000 + bus;
+    } else if (bus >= 0x80000000 && bus + length <= 0xc0000000) {
+        base = 0xa0000000 + bus - 0x80000000;
+    } else {
+        goto invalid;
+    }
+    section = memory_region_find(get_system_memory(), base, length);
+    if (!section.mr) {
+        goto invalid;
+    }
+    if (!memory_region_is_ram(section.mr) ||
+        int128_get64(section.size) != length) {
+        memory_region_unref(section.mr);
+        goto invalid;
+    }
+    memcpy(s->qmem, memory_region_get_ram_ptr(section.mr) +
+           section.offset_within_region, length);
+    s->memory_epoch++;
+    s->idle = false;
+    memory_region_unref(section.mr);
+    s->download_bytes = length;
+    R(TSP_CONTROL) |= TSP_DOWNLOAD_DONE;
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 TSP download: bus=0x%08" PRIx64
+                      " cpu=0x%08" PRIx64 " bytes=%u\n", bus, base, length);
+    }
+    return;
+invalid:
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 TSP rejected download: bus=0x%08" PRIx64
+                  " bytes=%u\n", bus, length);
+}
+
+static uint64_t tsp_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12TSPState *s = opaque;
+
+    if (offset & 2) {
+        return 0;
+    }
+    return extract32(R(offset), (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void tsp_write(void *opaque, hwaddr offset,
+                      uint64_t value, unsigned size)
+{
+    MST12TSPState *s = opaque;
+    unsigned index = offset & ~3u;
+    uint16_t previous, updated;
+    uint32_t address, data;
+
+    if (offset & 2) {
+        return;
+    }
+    previous = R(offset);
+    updated = deposit32(previous, (offset & 1) * 8,
+                        size == 1 ? 8 : 16, value);
+    if (index == TSP_CONTROL) {
+        /* Completion is produced by the transfer, not guest-written bit 3. */
+        updated = (updated & ~TSP_DOWNLOAD_DONE) |
+                  (previous & TSP_DOWNLOAD_DONE);
+        R(offset) = updated;
+        if (previous != updated) {
+            s->memory_epoch++;
+            s->idle = false;
+        }
+        if (!(updated & TSP_RESET_RELEASE)) {
+            tsp_cpu_reset(s);
+        }
+        if ((updated & TSP_DOWNLOAD_START) &&
+            !(previous & TSP_DOWNLOAD_START)) {
+            tsp_download(s);
+        }
+        if (!(updated & TSP_DOWNLOAD_START)) {
+            R(offset) &= ~TSP_DOWNLOAD_DONE;
+        }
+        tsp_schedule(s);
+        return;
+    }
+    R(offset) = updated;
+    if (previous != updated) {
+        s->memory_epoch++;
+        s->idle = false;
+    }
+    if (index == TSP_IND_CONTROL && (updated & 1) && !(previous & 1)) {
+        /* HAL's REG32 address / 2 is the native MCU byte address. */
+        address = tsp_pair(s, TSP_IND_ADDRESS);
+        if (updated & 2) {
+            data = tsp_pair(s, TSP_IND_WRITE);
+            if (!tsp_native_write(s, address, 4, data)) {
+                goto invalid;
+            }
+        } else {
+            if (!tsp_native_read(s, address, 4, &data)) {
+                goto invalid;
+            }
+            tsp_set_pair(s, TSP_IND_READ, data);
+        }
+    }
+    if (index == TSP_COMMAND + 4 && tsp_pair(s, TSP_COMMAND) && s->trace) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 TSP host command: value=0x%08x\n",
+                      tsp_pair(s, TSP_COMMAND));
+    }
+    tsp_schedule(s);
+    return;
+invalid:
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 TSP unsupported indirect address: 0x%08x\n",
+                  address);
+}
+
+static const MemoryRegionOps tsp_ops = {
+    .read = tsp_read,
+    .write = tsp_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void tsp_reset(DeviceState *dev)
+{
+    MST12TSPState *s = MST12_TSP(dev);
+
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->native, 0, sizeof(s->native));
+    memset(s->qmem, 0, sizeof(s->qmem));
+    s->download_bytes = 0;
+    s->memory_epoch++;
+    tsp_cpu_reset(s);
+}
+
+static bool tsp_get_idle(Object *obj, Error **errp)
+{
+    return MST12_TSP(obj)->idle;
+}
+
+static void tsp_init(Object *obj)
+{
+    MST12TSPState *s = MST12_TSP(obj);
+
+    memory_region_init_io(&s->iomem, obj, &tsp_ops, s,
+                          "mst12-tsp", TSP_APERTURE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, tsp_tick, s);
+    object_property_add_uint32_ptr(obj, "mcu-pc", &s->pc, OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "mcu-fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "mcu-fault-address", &s->fault_address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "download-bytes", &s->download_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "mcu-instructions", &s->instructions,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "mcu-idle", tsp_get_idle, NULL);
+}
+
+static void tsp_finalize(Object *obj)
+{
+    timer_free(MST12_TSP(obj)->timer);
+}
+
+static int tsp_post_load(void *opaque, int version_id)
+{
+    MST12TSPState *s = opaque;
+
+    memset(s->loops, 0, sizeof(s->loops));
+    return 0;
+}
+
+static const VMStateDescription vmstate_tsp = {
+    .name = TYPE_MST12_TSP,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = tsp_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12TSPState, TSP_REGS),
+        VMSTATE_UINT32_ARRAY(native, MST12TSPState, TSP_NATIVE_WORDS),
+        VMSTATE_UINT8_ARRAY(qmem, MST12TSPState, TSP_QMEM_SIZE),
+        VMSTATE_UINT32_ARRAY(gpr, MST12TSPState, 32),
+        VMSTATE_UINT32(pc, MST12TSPState),
+        VMSTATE_UINT32(next_pc, MST12TSPState),
+        VMSTATE_UINT32(fault, MST12TSPState),
+        VMSTATE_UINT32(fault_pc, MST12TSPState),
+        VMSTATE_UINT32(fault_word, MST12TSPState),
+        VMSTATE_UINT32(fault_address, MST12TSPState),
+        VMSTATE_UINT32(download_bytes, MST12TSPState),
+        VMSTATE_UINT64(instructions, MST12TSPState),
+        VMSTATE_UINT64(memory_epoch, MST12TSPState),
+        VMSTATE_BOOL(flag, MST12TSPState),
+        VMSTATE_BOOL(carry, MST12TSPState),
+        VMSTATE_BOOL(idle, MST12TSPState),
+        VMSTATE_TIMER_PTR(timer, MST12TSPState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property tsp_properties[] = {
+    DEFINE_PROP_BOOL("trace", MST12TSPState, trace, false),
+};
+
+static void tsp_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, tsp_reset);
+    device_class_set_props(dc, tsp_properties);
+    dc->vmsd = &vmstate_tsp;
+    dc->desc = "MStar TSP firmware loader and integer OpenRISC MCU";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo tsp_type = {
+    .name = TYPE_MST12_TSP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12TSPState),
+    .instance_init = tsp_init,
+    .instance_finalize = tsp_finalize,
+    .class_init = tsp_class_init,
+};
+
+static void tsp_register_types(void)
+{
+    type_register_static(&tsp_type);
+}
+
+type_init(tsp_register_types)
