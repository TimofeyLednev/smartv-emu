diff --git a/hw/i2c/mst12_gpio_i2c.c b/hw/i2c/mst12_gpio_i2c.c
new file mode 100644
index 0000000000000000000000000000000000000000..f8ebd881c7464e949faeb486c0c81c0941bab440
--- /dev/null
+++ b/hw/i2c/mst12_gpio_i2c.c
@@ -0,0 +1,251 @@
+/*
+ * MStar MST12 software IIC bus 2 GPIOs.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Original T-MST12DEUC 1112.2 PreInit.ko supplies GPIO66 (SCL) and GPIO67
+ * (SDA), RIU byte indices 0x102b11 and 0x102b12. Each uses OEN=2, OUT=1
+ * and IN=4. RIU's spaced byte map puts them at 0x1f205621 / 0x1f205624.
+ * The eight-byte aperture starts at 0x1f205620. Only these two pins are
+ * wired; this is not an implementation of the entire MStar GPIO block.
+ *
+ * Reuse QEMU's single-master bitbang engine. An input/released output is
+ * pulled high; SDA reads the wired AND of the master and slave levels.
+ * There is no clock stretching, analog timing or other bus master.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/i2c/bitbang_i2c.h"
+#include "hw/i2c/mst12_gpio_i2c.h"
+#include "hw/qdev-properties.h"
+#include "hw/resettable.h"
+#include "migration/vmstate.h"
+
+#define IIC2_REGS       8
+#define IIC2_SCL        1
+#define IIC2_SDA        4
+#define GPIO_OUT        1
+#define GPIO_OEN        2
+#define GPIO_IN         4
+
+struct MST12GPIOI2CState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    bitbang_i2c_interface bitbang;
+    uint8_t registers[IIC2_REGS];
+    uint32_t saved_state;
+    uint32_t scl_level;
+    uint32_t sda_level;
+    uint64_t reads;
+    uint64_t writes;
+    uint64_t clock_edges;
+    bool trace;
+};
+
+static int gpio_i2c_master_level(MST12GPIOI2CState *s, unsigned pin)
+{
+    return !!(s->registers[pin] & (GPIO_OEN | GPIO_OUT));
+}
+
+static void gpio_i2c_update(MST12GPIOI2CState *s, unsigned pin)
+{
+    int clock = s->bitbang.last_clock;
+    int data = s->bitbang.last_data;
+
+    s->sda_level = bitbang_i2c_set(&s->bitbang,
+                                  pin == IIC2_SCL ? BITBANG_I2C_SCL :
+                                  BITBANG_I2C_SDA,
+                                  gpio_i2c_master_level(s, pin));
+    s->scl_level = s->bitbang.last_clock;
+    s->clock_edges += clock != s->bitbang.last_clock;
+    if (s->trace && (clock != s->bitbang.last_clock ||
+                     data != s->bitbang.last_data)) {
+        qemu_log("MST12 IIC2 GPIO: pin=%s reg=0x%02x SCL=%u SDA=%u "
+                 "master-SDA=%d state=%u\n",
+                 pin == IIC2_SCL ? "SCL" : "SDA", s->registers[pin],
+                 s->scl_level, s->sda_level, s->bitbang.last_data,
+                 s->bitbang.state);
+    }
+}
+
+static uint64_t gpio_i2c_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12GPIOI2CState *s = opaque;
+    uint64_t value = 0;
+    unsigned i;
+
+    s->reads++;
+    for (i = 0; i < size; i++) {
+        unsigned pin = offset + i;
+        uint8_t byte = s->registers[pin];
+
+        if (pin == IIC2_SCL || pin == IIC2_SDA) {
+            unsigned level = pin == IIC2_SCL ? s->scl_level : s->sda_level;
+
+            byte = (byte & ~GPIO_IN) | (level ? GPIO_IN : 0);
+        }
+        value |= (uint64_t)byte << (8 * i);
+    }
+    return value;
+}
+
+static void gpio_i2c_write(void *opaque, hwaddr offset,
+                           uint64_t value, unsigned size)
+{
+    MST12GPIOI2CState *s = opaque;
+    unsigned i;
+
+    s->writes++;
+    for (i = 0; i < size; i++) {
+        unsigned pin = offset + i;
+        uint8_t byte = value >> (8 * i);
+
+        if (pin == IIC2_SCL || pin == IIC2_SDA) {
+            /* IN is physical feedback, never a guest-writable latch. */
+            s->registers[pin] = byte & ~GPIO_IN;
+            gpio_i2c_update(s, pin);
+        } else {
+            s->registers[pin] = byte;
+        }
+    }
+}
+
+static const MemoryRegionOps gpio_i2c_ops = {
+    .read = gpio_i2c_read,
+    .write = gpio_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4,
+               .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 4,
+              .unaligned = true },
+};
+
+static void gpio_i2c_reset_enter(Object *obj, ResetType type)
+{
+    MST12GPIOI2CState *s = MST12_GPIO_I2C(obj);
+
+    memset(s->registers, 0, sizeof(s->registers));
+    s->registers[IIC2_SCL] = GPIO_OEN;
+    s->registers[IIC2_SDA] = GPIO_OEN;
+    s->bitbang.state = STOPPED;
+    s->bitbang.current_addr = -1;
+    s->bitbang.buffer = 0;
+    s->bitbang.last_clock = 1;
+    s->bitbang.last_data = 1;
+    s->bitbang.device_out = 1;
+    s->scl_level = s->sda_level = 1;
+    s->reads = s->writes = s->clock_edges = 0;
+}
+
+static void gpio_i2c_reset_hold(Object *obj, ResetType type)
+{
+    MST12GPIOI2CState *s = MST12_GPIO_I2C(obj);
+
+    /*
+     * The EEPROM's enter phase has already discarded uncommitted bytes.
+     * Releasing the bus here must not turn reset into a page-write STOP.
+     */
+    i2c_end_transfer(s->bitbang.bus);
+}
+
+static void gpio_i2c_init(Object *obj)
+{
+    MST12GPIOI2CState *s = MST12_GPIO_I2C(obj);
+    I2CBus *bus = i2c_init_bus(DEVICE(obj), "iic2");
+
+    bitbang_i2c_init(&s->bitbang, bus);
+    gpio_i2c_reset_enter(obj, RESET_TYPE_COLD);
+    memory_region_init_io(&s->iomem, obj, &gpio_i2c_ops, s,
+                          TYPE_MST12_GPIO_I2C, IIC2_REGS);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    object_property_add_uint32_ptr(obj, "scl-level", &s->scl_level,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "sda-level", &s->sda_level,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-reads", &s->reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "clock-edges", &s->clock_edges,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static int gpio_i2c_pre_save(void *opaque)
+{
+    MST12GPIOI2CState *s = opaque;
+
+    s->saved_state = s->bitbang.state;
+    return 0;
+}
+
+static int gpio_i2c_post_load(void *opaque, int version_id)
+{
+    MST12GPIOI2CState *s = opaque;
+
+    if (s->saved_state > SENT_NACK ||
+        (unsigned)s->bitbang.last_clock > 1 ||
+        (unsigned)s->bitbang.last_data > 1 ||
+        (unsigned)s->bitbang.device_out > 1 ||
+        s->bitbang.current_addr < -1 || s->bitbang.current_addr > 255 ||
+        gpio_i2c_master_level(s, IIC2_SCL) != s->bitbang.last_clock ||
+        gpio_i2c_master_level(s, IIC2_SDA) != s->bitbang.last_data) {
+        return -EINVAL;
+    }
+    s->bitbang.state = s->saved_state;
+    s->scl_level = s->bitbang.last_clock;
+    s->sda_level = s->bitbang.last_data & s->bitbang.device_out;
+    return 0;
+}
+
+static const VMStateDescription vmstate_gpio_i2c = {
+    .name = TYPE_MST12_GPIO_I2C,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = gpio_i2c_pre_save,
+    .post_load = gpio_i2c_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_ARRAY(registers, MST12GPIOI2CState, IIC2_REGS),
+        VMSTATE_UINT32(saved_state, MST12GPIOI2CState),
+        VMSTATE_INT32(bitbang.last_clock, MST12GPIOI2CState),
+        VMSTATE_INT32(bitbang.last_data, MST12GPIOI2CState),
+        VMSTATE_INT32(bitbang.device_out, MST12GPIOI2CState),
+        VMSTATE_UINT8(bitbang.buffer, MST12GPIOI2CState),
+        VMSTATE_INT32(bitbang.current_addr, MST12GPIOI2CState),
+        VMSTATE_UINT64(reads, MST12GPIOI2CState),
+        VMSTATE_UINT64(writes, MST12GPIOI2CState),
+        VMSTATE_UINT64(clock_edges, MST12GPIOI2CState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property gpio_i2c_properties[] = {
+    DEFINE_PROP_BOOL("trace", MST12GPIOI2CState, trace, false),
+};
+
+static void gpio_i2c_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    device_class_set_props(dc, gpio_i2c_properties);
+    dc->vmsd = &vmstate_gpio_i2c;
+    dc->desc = "MStar MST12 software IIC2 GPIO pins";
+    dc->user_creatable = false;
+    rc->phases.enter = gpio_i2c_reset_enter;
+    rc->phases.hold = gpio_i2c_reset_hold;
+}
+
+static const TypeInfo gpio_i2c_type = {
+    .name = TYPE_MST12_GPIO_I2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12GPIOI2CState),
+    .instance_init = gpio_i2c_init,
+    .class_init = gpio_i2c_class_init,
+};
+
+static void gpio_i2c_register_types(void)
+{
+    type_register_static(&gpio_i2c_type);
+}
+
+type_init(gpio_i2c_register_types)
diff --git a/hw/i2c/mst12_hwiic.c b/hw/i2c/mst12_hwiic.c
new file mode 100644
index 0000000000000000000000000000000000000000..886b89a9550fbef1eaa340876599e1083ea7429c
--- /dev/null
+++ b/hw/i2c/mst12_hwiic.c
@@ -0,0 +1,718 @@
+/*
+ * MStar MST12 hardware IIC master.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2 PreInit.ko's HAL_HWI2C routines use RIU byte index
+ * 0x11800 relative to the non-PM window, with four 0x100-byte banks.
+ * Spaced RIU bytes map these to 0x1f223000 + port * 0x200. Application
+ * buses 0/1/2 select hardware ports 3/1/0, respectively; bus 2 does not
+ * use the driver's software GPIO path. Its EEPROM is on port 0.
+ *
+ * PIO start/stop, byte transfers, real slave ACK/NACK, interrupt W1C,
+ * programmed clock counts and the recovered MIU0 DMA protocol are modeled.
+ * Each operation completes on virtual time, never merely on a status read.
+ * A configurable 12 MHz input clock is inferred from the original count
+ * table. Analog filtering, stretching, multi-master arbitration, MIU1 and
+ * ten-bit slave addressing are not established by this firmware evidence.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/i2c/mst12_hwiic.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/resettable.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define HWIIC_APERTURE       0x200
+#define HWIIC_REGS           (HWIIC_APERTURE / 2)
+#define REG_CTRL             0x00
+#define REG_START            0x02
+#define REG_STOP             0x03
+#define REG_TX               0x04
+#define REG_TX_NACK          0x05
+#define REG_RX               0x06
+#define REG_RX_CTRL          0x07
+#define REG_INT              0x08
+#define REG_STATE            0x0a
+#define REG_STOP_COUNT       0x10
+#define REG_HIGH_COUNT       0x12
+#define REG_LOW_COUNT        0x14
+#define REG_START_COUNT      0x18
+#define REG_DMA_CTRL         0x40
+#define REG_DMA_ADDR         0x42
+#define REG_DMA_CFG          0x46
+#define REG_DMA_DONE         0x48
+#define REG_DMA_CMD          0x4a
+#define REG_DMA_CMD_LEN      0x52
+#define REG_DMA_LEN          0x54
+#define REG_DMA_TRANSFERRED  0x58
+#define REG_DMA_SLAVE        0x5c
+#define REG_DMA_TRIGGER      0x5e
+
+#define CTRL_RESET          0x01
+#define CTRL_DMA            0x02
+#define CTRL_IRQ            0x04
+#define DMA_RESET           0x0a
+#define DMA_IRQ             0x04
+#define DMA_MIU1            0x10
+#define DMA_NO_STOP         0x20
+#define DMA_READ            0x40
+#define DMA_TEN_BIT         0x04
+
+enum HWIICOperation {
+    OP_NONE,
+    OP_START,
+    OP_STOP,
+    OP_SEND,
+    OP_RECV,
+    OP_DMA_ADDRESS,
+    OP_DMA_COMMAND,
+    OP_DMA_DATA,
+    OP_DMA_STOP,
+};
+
+struct MST12HWIICState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    I2CBus *bus;
+    QEMUTimer *timer;
+    qemu_irq irq;
+    uint8_t registers[HWIIC_REGS];
+    uint32_t operation;
+    uint32_t irq_level;
+    uint32_t port;
+    uint32_t fault;
+    uint32_t input_clock_hz;
+    uint8_t tx_byte;
+    uint8_t slave_address;
+    bool started;
+    bool selected;
+    bool address_pending;
+    bool receiving;
+    bool read_ended;
+    bool recv_nack;
+    uint8_t dma_command[7];
+    uint8_t dma_command_size;
+    uint8_t dma_command_index;
+    uint8_t dma_slave;
+    bool dma_read;
+    bool dma_no_stop;
+    bool dma_failed;
+    uint64_t dma_address;
+    uint32_t dma_length;
+    uint32_t dma_transferred;
+    uint64_t reads;
+    uint64_t writes;
+    uint64_t starts;
+    uint64_t stops;
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t nacks;
+    uint64_t dma_transfers;
+    bool trace;
+};
+
+static void hwiic_update_irq(MST12HWIICState *s)
+{
+    s->irq_level = !!(((s->registers[REG_INT] & 1) &&
+                      (s->registers[REG_CTRL] & CTRL_IRQ)) ||
+                     ((s->registers[REG_DMA_DONE] & 1) &&
+                      (s->registers[REG_DMA_CTRL] & DMA_IRQ)));
+    qemu_set_irq(s->irq, s->irq_level);
+}
+
+static uint64_t hwiic_cycle_ns(MST12HWIICState *s, unsigned cycles)
+{
+    uint64_t counts = lduw_le_p(s->registers + REG_HIGH_COUNT) +
+                      lduw_le_p(s->registers + REG_LOW_COUNT);
+
+    /* A zero count still consumes at least one input-clock cycle. */
+    return MAX(1, DIV_ROUND_UP(MAX(counts, 1) * cycles * 1000000000ULL,
+                              s->input_clock_hz));
+}
+
+static void hwiic_schedule(MST12HWIICState *s, unsigned operation,
+                           unsigned cycles)
+{
+    s->operation = operation;
+    timer_mod_ns(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                 hwiic_cycle_ns(s, cycles));
+}
+
+static void hwiic_pio_done(MST12HWIICState *s)
+{
+    s->operation = OP_NONE;
+    s->registers[REG_STATE] = s->started ? 0x0b : 0;
+    s->registers[REG_INT] |= 1;
+    hwiic_update_irq(s);
+}
+
+static void hwiic_end(MST12HWIICState *s)
+{
+    if (s->selected) {
+        i2c_end_transfer(s->bus);
+    }
+    s->started = s->selected = s->address_pending = false;
+    s->receiving = s->read_ended = false;
+    s->stops++;
+}
+
+static void hwiic_abort(MST12HWIICState *s)
+{
+    timer_del(s->timer);
+    if (s->selected) {
+        /* Repeated START discards uncommitted data before releasing wires. */
+        i2c_start_transfer(s->bus, s->slave_address, s->receiving);
+        i2c_end_transfer(s->bus);
+    }
+    s->operation = OP_NONE;
+    s->started = s->selected = s->address_pending = false;
+    s->receiving = s->read_ended = false;
+    s->registers[REG_STATE] = 0;
+    s->registers[REG_INT] = 0;
+    s->registers[REG_DMA_DONE] = 0;
+    s->registers[REG_RX_CTRL] &= ~1;
+    hwiic_update_irq(s);
+}
+
+static bool hwiic_address(MST12HWIICState *s, uint8_t address, bool read)
+{
+    int result;
+
+    if (!s->selected && i2c_bus_busy(s->bus)) {
+        s->fault = 1;
+        return false;
+    }
+    result = i2c_start_transfer(s->bus, address, read);
+    s->slave_address = address;
+    s->receiving = read;
+    s->read_ended = false;
+    s->selected = result == 0;
+    return s->selected;
+}
+
+static bool hwiic_send(MST12HWIICState *s, uint8_t byte)
+{
+    bool ack;
+
+    if (s->address_pending) {
+        s->address_pending = false;
+        ack = hwiic_address(s, byte >> 1, byte & 1);
+    } else {
+        ack = s->selected && !s->receiving && i2c_send(s->bus, byte) == 0;
+    }
+    s->registers[REG_TX_NACK] = !ack;
+    s->tx_bytes++;
+    s->nacks += !ack;
+    if (s->trace) {
+        qemu_log("MST12 HWIIC%u TX: byte=0x%02x %s\n",
+                 s->port, byte, ack ? "ACK" : "NACK");
+    }
+    return ack;
+}
+
+static void hwiic_dma_done(MST12HWIICState *s)
+{
+    s->operation = OP_NONE;
+    stl_le_p(s->registers + REG_DMA_TRANSFERRED, s->dma_transferred);
+    s->registers[REG_DMA_DONE] |= 1;
+    s->registers[REG_STATE] = s->started ? 0x0b : 0;
+    hwiic_update_irq(s);
+    if (s->trace) {
+        qemu_log("MST12 HWIIC%u DMA complete: %s count=%u/%u fault=%u\n",
+                 s->port, s->dma_read ? "read" : "write",
+                 s->dma_transferred, s->dma_length, s->fault);
+    }
+}
+
+static void hwiic_dma_finish(MST12HWIICState *s, bool failed)
+{
+    s->dma_failed |= failed;
+    if (!s->dma_no_stop || s->dma_failed) {
+        hwiic_schedule(s, OP_DMA_STOP, 1);
+    } else {
+        hwiic_dma_done(s);
+    }
+}
+
+static void hwiic_dma_data(MST12HWIICState *s)
+{
+    uint8_t byte;
+    uint64_t address = s->dma_address + s->dma_transferred;
+    MemTxResult result;
+
+    if (s->dma_read) {
+        byte = i2c_recv(s->bus);
+        result = dma_memory_write(&address_space_memory, address, &byte, 1,
+                                  MEMTXATTRS_UNSPECIFIED);
+        s->rx_bytes++;
+    } else {
+        result = dma_memory_read(&address_space_memory, address, &byte, 1,
+                                 MEMTXATTRS_UNSPECIFIED);
+        if (result == MEMTX_OK && i2c_send(s->bus, byte) != 0) {
+            s->nacks++;
+            hwiic_dma_finish(s, true);
+            return;
+        }
+        s->tx_bytes++;
+    }
+    if (result != MEMTX_OK) {
+        s->fault = 2;
+        hwiic_dma_finish(s, true);
+        return;
+    }
+    s->dma_transferred++;
+    stl_le_p(s->registers + REG_DMA_TRANSFERRED, s->dma_transferred);
+    if (s->dma_transferred == s->dma_length) {
+        if (s->dma_read) {
+            i2c_nack(s->bus);
+            s->read_ended = true;
+        }
+        hwiic_dma_finish(s, false);
+    } else {
+        hwiic_schedule(s, OP_DMA_DATA, 9);
+    }
+}
+
+static void hwiic_dma_next(MST12HWIICState *s)
+{
+    if (s->dma_command_index < s->dma_command_size) {
+        hwiic_schedule(s, OP_DMA_COMMAND, 9);
+    } else if (s->dma_length) {
+        if (s->dma_read && !s->receiving &&
+            !hwiic_address(s, s->dma_slave, true)) {
+            s->nacks++;
+            hwiic_dma_finish(s, true);
+            return;
+        }
+        hwiic_schedule(s, OP_DMA_DATA, 9);
+    } else {
+        hwiic_dma_finish(s, false);
+    }
+}
+
+static void hwiic_complete(void *opaque)
+{
+    MST12HWIICState *s = opaque;
+
+    switch (s->operation) {
+    case OP_START:
+        s->started = s->address_pending = true;
+        s->read_ended = false;
+        s->starts++;
+        hwiic_pio_done(s);
+        break;
+    case OP_STOP:
+        hwiic_end(s);
+        hwiic_pio_done(s);
+        break;
+    case OP_SEND:
+        hwiic_send(s, s->tx_byte);
+        hwiic_pio_done(s);
+        break;
+    case OP_RECV:
+        if (s->selected && s->receiving && !s->read_ended) {
+            s->registers[REG_RX] = i2c_recv(s->bus);
+            s->rx_bytes++;
+            if (s->recv_nack) {
+                i2c_nack(s->bus);
+                s->read_ended = true;
+            }
+            if (s->trace) {
+                qemu_log("MST12 HWIIC%u RX: byte=0x%02x master-%s\n",
+                         s->port, s->registers[REG_RX],
+                         s->recv_nack ? "NACK" : "ACK");
+            }
+        } else {
+            s->registers[REG_RX] = 0xff;
+            s->fault = 3;
+        }
+        hwiic_pio_done(s);
+        break;
+    case OP_DMA_ADDRESS:
+        s->started = true;
+        s->starts++;
+        if (!hwiic_address(s, s->dma_slave,
+                           s->dma_read && !s->dma_command_size)) {
+            s->nacks++;
+            hwiic_dma_finish(s, true);
+        } else {
+            hwiic_dma_next(s);
+        }
+        break;
+    case OP_DMA_COMMAND:
+        if (i2c_send(s->bus,
+                     s->dma_command[s->dma_command_index++]) != 0) {
+            s->nacks++;
+            hwiic_dma_finish(s, true);
+        } else {
+            s->tx_bytes++;
+            hwiic_dma_next(s);
+        }
+        break;
+    case OP_DMA_DATA:
+        hwiic_dma_data(s);
+        break;
+    case OP_DMA_STOP:
+        hwiic_end(s);
+        hwiic_dma_done(s);
+        break;
+    default:
+        break;
+    }
+}
+
+static bool hwiic_dma_memory_valid(MST12HWIICState *s)
+{
+    MemoryRegionSection section;
+    bool valid;
+
+    if (!s->dma_length) {
+        return true;
+    }
+    if (s->dma_address + s->dma_length > 0x100000000ULL) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), s->dma_address,
+                                  s->dma_length);
+    valid = section.mr && memory_region_is_ram(section.mr) &&
+            int128_ge(section.size, int128_make64(s->dma_length)) &&
+            (!s->dma_read || !memory_region_is_rom(section.mr));
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static void hwiic_dma_start(MST12HWIICState *s)
+{
+    if (s->operation != OP_NONE ||
+        !(s->registers[REG_CTRL] & CTRL_DMA)) {
+        s->fault = 4;
+        return;
+    }
+    s->fault = 0;
+    s->dma_failed = false;
+    s->dma_address = 0x40000000ULL +
+                     ldl_le_p(s->registers + REG_DMA_ADDR);
+    s->dma_length = ldl_le_p(s->registers + REG_DMA_LEN);
+    s->dma_transferred = 0;
+    s->dma_command_size = s->registers[REG_DMA_CMD_LEN] & 7;
+    s->dma_command_index = 0;
+    memcpy(s->dma_command, s->registers + REG_DMA_CMD,
+           sizeof(s->dma_command));
+    s->dma_slave = s->registers[REG_DMA_SLAVE] & 0x7f;
+    s->dma_read = s->registers[REG_DMA_CFG] & DMA_READ;
+    s->dma_no_stop = s->registers[REG_DMA_CFG] & DMA_NO_STOP;
+    s->registers[REG_DMA_DONE] = 0;
+    stl_le_p(s->registers + REG_DMA_TRANSFERRED, 0);
+    s->dma_transfers++;
+    hwiic_update_irq(s);
+    if ((s->registers[REG_DMA_SLAVE + 1] & DMA_TEN_BIT) ||
+        (s->registers[REG_DMA_CTRL] & DMA_MIU1) ||
+        !hwiic_dma_memory_valid(s)) {
+        s->fault = 5;
+        hwiic_dma_finish(s, true);
+        return;
+    }
+    s->registers[REG_STATE] = 1;
+    hwiic_schedule(s, OP_DMA_ADDRESS, 10);
+}
+
+static uint64_t hwiic_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12HWIICState *s = opaque;
+    uint64_t value = 0;
+    unsigned i;
+
+    s->reads++;
+    for (i = 0; i < size; i++) {
+        unsigned position = offset + i;
+
+        if (!(position & 2)) {
+            unsigned index = (position / 4) * 2 + (position & 1);
+
+            value |= (uint64_t)s->registers[index] << (8 * i);
+        }
+    }
+    return value;
+}
+
+static void hwiic_write_byte(MST12HWIICState *s, unsigned index, uint8_t byte)
+{
+    if (index == REG_TX_NACK || index == REG_RX || index == REG_STATE ||
+        (index >= REG_DMA_TRANSFERRED && index < REG_DMA_TRANSFERRED + 4)) {
+        return;
+    }
+    if (index == REG_INT || index == REG_DMA_DONE) {
+        s->registers[index] &= ~(byte & 1);
+        hwiic_update_irq(s);
+        return;
+    }
+    s->registers[index] = byte;
+    if (index == REG_CTRL) {
+        if (byte & CTRL_RESET) {
+            hwiic_abort(s);
+        }
+        hwiic_update_irq(s);
+        return;
+    }
+    if (index == REG_DMA_CTRL) {
+        if (byte & DMA_RESET) {
+            hwiic_abort(s);
+        }
+        hwiic_update_irq(s);
+        return;
+    }
+    if (index == REG_START || index == REG_STOP || index == REG_RX_CTRL ||
+        index == REG_DMA_TRIGGER) {
+        s->registers[index] &= ~1;
+    }
+    if (s->registers[REG_CTRL] & CTRL_RESET) {
+        return;
+    }
+    if (index == REG_DMA_TRIGGER && (byte & 1)) {
+        hwiic_dma_start(s);
+        return;
+    }
+    if (index != REG_TX && !((byte & 1) &&
+        (index == REG_START || index == REG_STOP || index == REG_RX_CTRL))) {
+        return;
+    }
+    if (s->operation != OP_NONE) {
+        s->fault = 4;
+        return;
+    }
+    switch (index) {
+    case REG_START:
+        s->registers[REG_STATE] = 1;
+        hwiic_schedule(s, OP_START, 1);
+        break;
+    case REG_STOP:
+        s->registers[REG_STATE] = 0x0c;
+        hwiic_schedule(s, OP_STOP, 1);
+        break;
+    case REG_TX:
+        s->tx_byte = byte;
+        s->registers[REG_STATE] = 3;
+        hwiic_schedule(s, OP_SEND, 9);
+        break;
+    case REG_RX_CTRL:
+        s->recv_nack = byte & 2;
+        s->registers[REG_STATE] = 7;
+        hwiic_schedule(s, OP_RECV, 9);
+        break;
+    }
+}
+
+static void hwiic_write(void *opaque, hwaddr offset,
+                         uint64_t value, unsigned size)
+{
+    MST12HWIICState *s = opaque;
+    unsigned i;
+
+    s->writes++;
+    for (i = 0; i < size; i++) {
+        unsigned position = offset + i;
+
+        if (!(position & 2)) {
+            hwiic_write_byte(s, (position / 4) * 2 + (position & 1),
+                             value >> (8 * i));
+        }
+    }
+}
+
+static const MemoryRegionOps hwiic_ops = {
+    .read = hwiic_read,
+    .write = hwiic_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4,
+               .unaligned = true },
+    .impl = { .min_access_size = 1, .max_access_size = 4,
+              .unaligned = true },
+};
+
+static void hwiic_reset_enter(Object *obj, ResetType type)
+{
+    MST12HWIICState *s = MST12_HWIIC(obj);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    s->operation = OP_NONE;
+    s->irq_level = s->fault = 0;
+    s->tx_byte = s->slave_address = 0;
+    s->started = s->selected = s->address_pending = false;
+    s->receiving = s->read_ended = s->recv_nack = false;
+    memset(s->dma_command, 0, sizeof(s->dma_command));
+    s->dma_command_size = s->dma_command_index = s->dma_slave = 0;
+    s->dma_read = s->dma_no_stop = s->dma_failed = false;
+    s->dma_address = s->dma_length = s->dma_transferred = 0;
+    s->reads = s->writes = s->starts = s->stops = 0;
+    s->tx_bytes = s->rx_bytes = s->nacks = s->dma_transfers = 0;
+}
+
+static void hwiic_reset_hold(Object *obj, ResetType type)
+{
+    MST12HWIICState *s = MST12_HWIIC(obj);
+
+    /* Slave reset-enter has discarded staged data before bus release. */
+    i2c_end_transfer(s->bus);
+    hwiic_update_irq(s);
+}
+
+static void hwiic_realize(DeviceState *dev, Error **errp)
+{
+    MST12HWIICState *s = MST12_HWIIC(dev);
+
+    if (!s->input_clock_hz || s->input_clock_hz > 1000000000) {
+        error_setg(errp, "MST12 HWIIC input clock must be 1..1000000000 Hz");
+        return;
+    }
+    if (s->port > 3) {
+        error_setg(errp, "MST12 HWIIC port must be 0..3");
+        return;
+    }
+    if (!s->bus) {
+        s->bus = i2c_init_bus(dev, "i2c");
+    }
+}
+
+static void hwiic_init(Object *obj)
+{
+    MST12HWIICState *s = MST12_HWIIC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &hwiic_ops, s,
+                          TYPE_MST12_HWIIC, HWIIC_APERTURE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, hwiic_complete, s);
+    object_property_add_uint32_ptr(obj, "irq-level", &s->irq_level,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "operation", &s->operation,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-reads", &s->reads,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "starts", &s->starts,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "stops", &s->stops,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "tx-bytes", &s->tx_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "rx-bytes", &s->rx_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "nacks", &s->nacks,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "dma-transfers", &s->dma_transfers,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void hwiic_finalize(Object *obj)
+{
+    timer_free(MST12_HWIIC(obj)->timer);
+}
+
+static int hwiic_post_load(void *opaque, int version_id)
+{
+    MST12HWIICState *s = opaque;
+
+    if (s->operation > OP_DMA_STOP ||
+        (s->operation != OP_NONE) != timer_pending(s->timer) ||
+        s->slave_address > 127 || s->dma_slave > 127 ||
+        s->dma_command_size > sizeof(s->dma_command) ||
+        s->dma_command_index > s->dma_command_size ||
+        s->dma_transferred > s->dma_length ||
+        (s->selected && !s->started)) {
+        return -EINVAL;
+    }
+    hwiic_update_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_hwiic = {
+    .name = TYPE_MST12_HWIIC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = hwiic_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8_ARRAY(registers, MST12HWIICState, HWIIC_REGS),
+        VMSTATE_UINT32(operation, MST12HWIICState),
+        VMSTATE_UINT32(irq_level, MST12HWIICState),
+        VMSTATE_UINT32(fault, MST12HWIICState),
+        VMSTATE_UINT8(tx_byte, MST12HWIICState),
+        VMSTATE_UINT8(slave_address, MST12HWIICState),
+        VMSTATE_BOOL(started, MST12HWIICState),
+        VMSTATE_BOOL(selected, MST12HWIICState),
+        VMSTATE_BOOL(address_pending, MST12HWIICState),
+        VMSTATE_BOOL(receiving, MST12HWIICState),
+        VMSTATE_BOOL(read_ended, MST12HWIICState),
+        VMSTATE_BOOL(recv_nack, MST12HWIICState),
+        VMSTATE_UINT8_ARRAY(dma_command, MST12HWIICState, 7),
+        VMSTATE_UINT8(dma_command_size, MST12HWIICState),
+        VMSTATE_UINT8(dma_command_index, MST12HWIICState),
+        VMSTATE_UINT8(dma_slave, MST12HWIICState),
+        VMSTATE_BOOL(dma_read, MST12HWIICState),
+        VMSTATE_BOOL(dma_no_stop, MST12HWIICState),
+        VMSTATE_BOOL(dma_failed, MST12HWIICState),
+        VMSTATE_UINT64(dma_address, MST12HWIICState),
+        VMSTATE_UINT32(dma_length, MST12HWIICState),
+        VMSTATE_UINT32(dma_transferred, MST12HWIICState),
+        VMSTATE_UINT64(reads, MST12HWIICState),
+        VMSTATE_UINT64(writes, MST12HWIICState),
+        VMSTATE_UINT64(starts, MST12HWIICState),
+        VMSTATE_UINT64(stops, MST12HWIICState),
+        VMSTATE_UINT64(tx_bytes, MST12HWIICState),
+        VMSTATE_UINT64(rx_bytes, MST12HWIICState),
+        VMSTATE_UINT64(nacks, MST12HWIICState),
+        VMSTATE_UINT64(dma_transfers, MST12HWIICState),
+        VMSTATE_TIMER_PTR(timer, MST12HWIICState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property hwiic_properties[] = {
+    DEFINE_PROP_LINK("bus", MST12HWIICState, bus, TYPE_I2C_BUS, I2CBus *),
+    DEFINE_PROP_UINT32("port", MST12HWIICState, port, 0),
+    DEFINE_PROP_UINT32("input-clock-hz", MST12HWIICState, input_clock_hz,
+                       12000000),
+    DEFINE_PROP_BOOL("trace", MST12HWIICState, trace, false),
+};
+
+static void hwiic_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    device_class_set_props(dc, hwiic_properties);
+    dc->realize = hwiic_realize;
+    dc->vmsd = &vmstate_hwiic;
+    dc->desc = "MStar MST12 hardware IIC master";
+    dc->user_creatable = false;
+    rc->phases.enter = hwiic_reset_enter;
+    rc->phases.hold = hwiic_reset_hold;
+}
+
+static const TypeInfo hwiic_type = {
+    .name = TYPE_MST12_HWIIC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12HWIICState),
+    .instance_init = hwiic_init,
+    .instance_finalize = hwiic_finalize,
+    .class_init = hwiic_class_init,
+};
+
+static void hwiic_register_types(void)
+{
+    type_register_static(&hwiic_type);
+}
+
+type_init(hwiic_register_types)
diff --git a/hw/i2c/mst12_si2176.c b/hw/i2c/mst12_si2176.c
new file mode 100644
index 0000000000000000000000000000000000000000..24ab95d51c2a8d439e0ede8379273d003ae62b15
--- /dev/null
+++ b/hw/i2c/mst12_si2176.c
@@ -0,0 +1,622 @@
+/*
+ * Silicon Labs tuner control paths in Samsung T-MST12DEUC 1112.2.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Original TunerAutoDetect probes logical IIC1, slave byte 0xc0. Detection
+ * selects TDsSi21XXPrime. Its L1 routines use 15-byte POWER_UP and ROM 0x32.
+ * The separate Si2176 API uses nine-byte POWER_UP and ROM 0x12. Both original
+ * APIs specify command/reply sizes, CTS/ERR, properties and tuning.
+ * This is a compatible emulator configuration, not identification of the
+ * owner's physical tuner. There is no RF source, demodulation or audio.
+ *
+ * Commands latch at STOP/repeated START and complete on virtual time.
+ * Download records are retained as transport statistics, not executed as
+ * tuner MCU firmware. The command API itself supplies the modeled behavior.
+ * Unrecognized commands and malformed requests return CTS with ERR set.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/i2c/mst12_si2176.h"
+#include "hw/qdev-properties.h"
+#include "hw/resettable.h"
+#include "migration/vmstate.h"
+
+#define COMMAND_SIZE   32
+#define RESPONSE_SIZE  16
+#define PROPERTY_COUNT 0x1000
+#define STATUS_CTS     0x80
+#define STATUS_ERR     0x40
+#define MIN_FREQUENCY  43000000
+#define MAX_FREQUENCY  1002000000
+
+struct MST12Si2176State {
+    I2CSlave parent_obj;
+    uint8_t command[COMMAND_SIZE];
+    uint8_t pending[COMMAND_SIZE];
+    uint8_t response[RESPONSE_SIZE];
+    uint16_t properties[PROPERTY_COUNT];
+    uint16_t ssvd_registers[256];
+    uint8_t clock_control[2];
+    uint8_t ssvd_hdiv[5];
+    uint8_t ssvd_debug[2];
+    uint8_t pins[5];
+    uint8_t command_length;
+    uint8_t pending_length;
+    uint8_t response_length;
+    uint8_t response_index;
+    uint8_t last_command;
+    uint8_t mode;
+    uint8_t agc_override;
+    bool busy;
+    bool powered;
+    bool standby;
+    bool bootloader;
+    bool tuned;
+    bool tune_interrupt;
+    bool present;
+    bool si21xx_mode;
+    bool ssvd_powered;
+    bool trace;
+    uint32_t frequency;
+    uint64_t command_time_ns;
+    uint64_t commands;
+    uint64_t errors;
+    uint64_t read_bytes;
+    uint64_t write_bytes;
+    uint64_t patch_packets;
+    uint64_t patch_bytes;
+    QEMUTimer *timer;
+};
+
+static bool si2176_patch_record(uint8_t opcode)
+{
+    /* Prefixes in the original ROM 0x12 eight-byte download stream. */
+    return opcode == 0x04 || opcode == 0x05 || opcode == 0x07 ||
+           opcode == 0x0f || (opcode >= 0x21 && opcode <= 0x2f &&
+                              opcode != 0x28);
+}
+
+static bool si2176_property(uint16_t property)
+{
+    /* The original property API addresses tuner/common/ATV/DTV banks. */
+    return property >= 0x0400 && property < PROPERTY_COUNT;
+}
+
+static void si2176_complete(void *opaque)
+{
+    MST12Si2176State *s = opaque;
+    const uint8_t *c = s->pending;
+    unsigned n = s->pending_length;
+    uint16_t property, value;
+    int64_t frequency;
+    bool error = false;
+    unsigned i, index;
+
+    memset(s->response, 0, sizeof(s->response));
+    s->response_length = 1;
+    if (s->bootloader && si2176_patch_record(c[0])) {
+        if (n == 8 && s->powered) {
+            s->patch_packets++;
+            s->patch_bytes += n;
+        } else {
+            error = true;
+        }
+        goto done;
+    }
+    switch (c[0]) {
+    case 0xc0: /* POWER_UP / CONFIG_CLOCKS / POWER_DOWN_HW */
+        if (s->si21xx_mode) {
+            if (n == 3) {
+                memcpy(s->clock_control, c + 1, sizeof(s->clock_control));
+                break;
+            }
+            if (n == 10) {
+                s->powered = false;
+                s->tuned = false;
+                s->frequency = 0;
+                break;
+            }
+            if (n != 15 || c[1] || c[14] != 1 || (c[13] & 0x7e)) {
+                error = true;
+                break;
+            }
+            s->bootloader = !(c[13] & 1);
+        } else {
+            if (n != 9 || c[1] != 5 || c[2] != 1 || c[3] || c[4] ||
+                c[8] != 1 || (c[7] & 0x7e)) {
+                error = true;
+                break;
+            }
+            s->bootloader = !(c[7] & 1);
+        }
+        s->powered = true;
+        s->standby = false;
+        s->tuned = false;
+        s->tune_interrupt = false;
+        s->frequency = 0;
+        break;
+    case 0x01: /* EXIT_BOOTLOADER */
+        if (n != 2 || !s->powered || (c[1] & 0x7e)) {
+            error = true;
+            break;
+        }
+        s->bootloader = !(c[1] & 1);
+        break;
+    case 0x02: /* PART_INFO, ROM compatible with the recovered patch loader. */
+        if (n != 1) {
+            error = true;
+            break;
+        }
+        s->response_length = 13;
+        s->response[1] = 2;    /* chip revision */
+        s->response[2] = s->si21xx_mode ? 90 : 76;
+        s->response[3] = s->si21xx_mode ? '3' : '1';
+        s->response[4] = s->si21xx_mode ? '0' : 'A';
+        s->response[12] = s->si21xx_mode ? 0x32 : 0x12;
+        break;
+    case 0x11: /* GET_REV; provisional revision of the command implementation. */
+        if (n != 1) {
+            error = true;
+            break;
+        }
+        s->response_length = 10;
+        s->response[1] = s->si21xx_mode ? 90 : 76;
+        s->response[2] = 2;
+        s->response[6] = 2;
+        s->response[9] = 2;
+        break;
+    case 0x12: /* CONFIG_PINS: mode zero keeps the previous configuration. */
+        if (n != 6) {
+            error = true;
+            break;
+        }
+        s->response_length = 6;
+        for (i = 0; i < ARRAY_SIZE(s->pins); i++) {
+            if (c[i + 1] & 0x7f) {
+                s->pins[i] = c[i + 1] & 0x7f;
+            }
+            s->response[i + 1] = s->pins[i];
+        }
+        break;
+    case 0x13: /* POWER_DOWN */
+        if (n != 1) {
+            error = true;
+            break;
+        }
+        s->powered = false;
+        s->standby = false;
+        s->tuned = false;
+        s->tune_interrupt = false;
+        s->frequency = 0;
+        break;
+    case 0x14: /* SET_PROPERTY */
+    case 0x15: /* GET_PROPERTY */
+        if (n != (c[0] == 0x14 ? 6 : 4) || c[1]) {
+            error = true;
+            break;
+        }
+        property = lduw_le_p(c + 2);
+        if (!si2176_property(property)) {
+            error = true;
+            break;
+        }
+        if (c[0] == 0x14) {
+            s->properties[property] = lduw_le_p(c + 4);
+        }
+        value = s->properties[property];
+        s->response_length = 4;
+        stw_le_p(s->response + 2, value);
+        break;
+    case 0x16: /* STANDBY */
+        if (n != (s->si21xx_mode ? 2 : 1) || !s->powered ||
+            (s->si21xx_mode && c[1] > 1)) {
+            error = true;
+            break;
+        }
+        s->standby = true;
+        s->tuned = false;
+        s->tune_interrupt = false;
+        break;
+    case 0x41: /* TUNER_TUNE_FREQ: crystal/PLL state, with no RF source. */
+        if (n != 8 || c[1] > 1 || c[2] || c[3] || !s->powered ||
+            s->standby || s->bootloader) {
+            error = true;
+            break;
+        }
+        frequency = ldl_le_p(c + 4);
+        if (frequency < MIN_FREQUENCY || frequency > MAX_FREQUENCY) {
+            error = true;
+            break;
+        }
+        s->frequency = frequency;
+        s->mode = c[1];
+        s->tuned = true;
+        s->tune_interrupt = true;
+        break;
+    case 0x42: /* TUNER_STATUS */
+        if (n != 2 || c[1] > 1) {
+            error = true;
+            break;
+        }
+        s->response_length = 12;
+        s->response[1] = s->tune_interrupt;
+        s->response[2] = s->tuned;
+        s->response[3] = 0x80; /* -128 dBm, no modeled RF input */
+        stl_le_p(s->response + 4, s->frequency);
+        s->response[8] = s->mode;
+        if (c[1]) {
+            s->tune_interrupt = false;
+        }
+        break;
+    case 0x44: /* AGC_OVERRIDE */
+        if (n != 2 || c[1] > 3) {
+            error = true;
+            break;
+        }
+        s->agc_override = c[1];
+        break;
+    case 0x45: /* FINE_TUNE: signed offset in 500 Hz units. */
+        if (n != 4 || c[1] > (s->si21xx_mode ? 3 : 0) || !s->tuned) {
+            error = true;
+            break;
+        }
+        frequency = s->frequency + (int16_t)lduw_le_p(c + 2) * INT64_C(500);
+        if (frequency < MIN_FREQUENCY || frequency > MAX_FREQUENCY) {
+            error = true;
+            break;
+        }
+        s->frequency = frequency;
+        s->tune_interrupt = true;
+        break;
+    case 0x51: /* ATV_RESTART */
+        error = n != 2 || c[1] > 1;
+        break;
+    case 0x52: /* ATV_STATUS: neither video nor audio carrier is present. */
+        if (n != 2 || c[1] > 1) {
+            error = true;
+            break;
+        }
+        s->response_length = s->si21xx_mode ? 12 : 11;
+        break;
+    case 0x61: /* DTV_RESTART */
+        error = n != 1;
+        break;
+    case 0x62: /* DTV_STATUS: no received channel. */
+        if (n != 2 || c[1] > 1) {
+            error = true;
+            break;
+        }
+        s->response_length = 4;
+        break;
+    case 0x81: /* Si2190 SSVD_POWER_UP */
+    case 0x82: /* Si2190 SSVD_POWER_DOWN */
+        if (!s->si21xx_mode || n != 1) {
+            error = true;
+            break;
+        }
+        s->ssvd_powered = c[0] == 0x81;
+        break;
+    case 0x83: /* SSVD_MULTI_REG_RD: status byte followed by seven words. */
+        index = c[1] & 0x1f;
+        if (!s->si21xx_mode || n != 2 || index > 25) {
+            error = true;
+            break;
+        }
+        s->response_length = 16;
+        index |= c[1] & 0xe0;
+        for (i = 0; i < 7; i++) {
+            stw_le_p(s->response + 2 + i * 2, s->ssvd_registers[index + i]);
+        }
+        break;
+    case 0x84: /* SSVD_MULTI_REG_WR: selector and seven little-endian words. */
+        if (!s->si21xx_mode || n != 16) {
+            error = true;
+            break;
+        }
+        index = (c[1] & 0x0f) | (c[1] & 0xe0);
+        for (i = 0; i < 7; i++) {
+            s->ssvd_registers[index + i] = lduw_le_p(c + 2 + i * 2);
+        }
+        break;
+    case 0x85: /* SSVD_REG_RD */
+        if (!s->si21xx_mode || n != 2) {
+            error = true;
+            break;
+        }
+        s->response_length = 4;
+        stw_le_p(s->response + 2, s->ssvd_registers[c[1]]);
+        break;
+    case 0x86: /* SSVD_REG_WR */
+        if (!s->si21xx_mode || n != 4) {
+            error = true;
+            break;
+        }
+        s->ssvd_registers[c[1]] = lduw_le_p(c + 2);
+        break;
+    case 0x87: /* SSVD_HDIV: retain the programmed divider parameters. */
+        if (!s->si21xx_mode || n != 6) {
+            error = true;
+            break;
+        }
+        memcpy(s->ssvd_hdiv, c + 1, sizeof(s->ssvd_hdiv));
+        break;
+    case 0x88: /* SSVD_DEBUG_CONFIG */
+        if (!s->si21xx_mode || n != 3) {
+            error = true;
+            break;
+        }
+        memcpy(s->ssvd_debug, c + 1, sizeof(s->ssvd_debug));
+        break;
+    default:
+        error = true;
+        break;
+    }
+done:
+    s->response[0] = STATUS_CTS | (error ? STATUS_ERR : 0);
+    s->errors += error;
+    s->busy = false;
+    s->pending_length = 0;
+    if (s->trace) {
+        qemu_log("MST12 Si2176 complete: command=0x%02x status=0x%02x "
+                 "response=%u frequency=%u\n", s->last_command,
+                 s->response[0], s->response_length, s->frequency);
+    }
+}
+
+static void si2176_submit(MST12Si2176State *s)
+{
+    unsigned i;
+
+    if (!s->command_length) {
+        return;
+    }
+    memcpy(s->pending, s->command, s->command_length);
+    s->pending_length = s->command_length;
+    s->last_command = s->command[0];
+    s->commands++;
+    s->command_length = 0;
+    s->busy = true;
+    s->response_index = 0;
+    timer_mod_ns(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                 s->command_time_ns);
+    if (s->trace) {
+        qemu_log("MST12 Si2176 request:");
+        for (i = 0; i < s->pending_length; i++) {
+            qemu_log(" %02x", s->pending[i]);
+        }
+        qemu_log("\n");
+    }
+}
+
+static int si2176_event(I2CSlave *slave, enum i2c_event event)
+{
+    MST12Si2176State *s = MST12_SI2176(slave);
+
+    switch (event) {
+    case I2C_START_SEND:
+        if (!s->present || s->busy) {
+            return -1;
+        }
+        s->command_length = 0;
+        return 0;
+    case I2C_START_RECV:
+        if (!s->present) {
+            return -1;
+        }
+        si2176_submit(s);
+        s->response_index = 0;
+        return 0;
+    case I2C_FINISH:
+        si2176_submit(s);
+        return 0;
+    case I2C_NACK:
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+static int si2176_send(I2CSlave *slave, uint8_t data)
+{
+    MST12Si2176State *s = MST12_SI2176(slave);
+
+    if (!s->present || s->busy || s->command_length == COMMAND_SIZE) {
+        return -1;
+    }
+    s->command[s->command_length++] = data;
+    s->write_bytes++;
+    return 0;
+}
+
+static uint8_t si2176_recv(I2CSlave *slave)
+{
+    MST12Si2176State *s = MST12_SI2176(slave);
+    uint8_t data = 0xff;
+
+    if (s->busy) {
+        data = 0;
+    } else if (s->response_index < s->response_length) {
+        data = s->response[s->response_index];
+    }
+    if (s->response_index < RESPONSE_SIZE) {
+        s->response_index++;
+    }
+    s->read_bytes++;
+    return data;
+}
+
+static void si2176_reset_enter(Object *obj, ResetType type)
+{
+    MST12Si2176State *s = MST12_SI2176(obj);
+
+    timer_del(s->timer);
+    memset(s->properties, 0, sizeof(s->properties));
+    memset(s->ssvd_registers, 0, sizeof(s->ssvd_registers));
+    memset(s->clock_control, 0, sizeof(s->clock_control));
+    memset(s->ssvd_hdiv, 0, sizeof(s->ssvd_hdiv));
+    memset(s->ssvd_debug, 0, sizeof(s->ssvd_debug));
+    memset(s->pins, 0, sizeof(s->pins));
+    memset(s->response, 0, sizeof(s->response));
+    s->response[0] = STATUS_CTS;
+    s->response_length = 1;
+    s->command_length = 0;
+    s->pending_length = 0;
+    s->response_index = 0;
+    s->busy = false;
+    s->powered = true;
+    s->standby = false;
+    s->bootloader = true;
+    s->tuned = false;
+    s->tune_interrupt = false;
+    s->frequency = 0;
+    s->mode = 0;
+    s->agc_override = 0;
+    s->ssvd_powered = false;
+}
+
+static void si2176_realize(DeviceState *dev, Error **errp)
+{
+    MST12Si2176State *s = MST12_SI2176(dev);
+
+    if (!s->command_time_ns || s->command_time_ns > NANOSECONDS_PER_SECOND) {
+        error_setg(errp, "Si2176 command-time-ns must be 1..1000000000");
+    }
+}
+
+static bool si2176_busy(Object *obj, Error **errp)
+{
+    return MST12_SI2176(obj)->busy;
+}
+
+static bool si2176_bootloader(Object *obj, Error **errp)
+{
+    return MST12_SI2176(obj)->bootloader;
+}
+
+static void si2176_init(Object *obj)
+{
+    MST12Si2176State *s = MST12_SI2176(obj);
+
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, si2176_complete, s);
+    object_property_add_bool(obj, "busy", si2176_busy, NULL);
+    object_property_add_bool(obj, "bootloader", si2176_bootloader, NULL);
+    object_property_add_uint64_ptr(obj, "commands", &s->commands,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "errors", &s->errors,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "read-bytes", &s->read_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "write-bytes", &s->write_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "patch-packets", &s->patch_packets,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "patch-bytes", &s->patch_bytes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "frequency", &s->frequency,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void si2176_finalize(Object *obj)
+{
+    timer_free(MST12_SI2176(obj)->timer);
+}
+
+static int si2176_post_load(void *opaque, int version_id)
+{
+    MST12Si2176State *s = opaque;
+
+    if (s->command_length > COMMAND_SIZE || s->pending_length > COMMAND_SIZE ||
+        !s->response_length || s->response_length > RESPONSE_SIZE ||
+        s->response_index > RESPONSE_SIZE || s->mode > 1 ||
+        s->busy != !!s->pending_length || s->busy != timer_pending(s->timer)) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_si2176 = {
+    .name = TYPE_MST12_SI2176,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = si2176_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, MST12Si2176State),
+        VMSTATE_UINT8_ARRAY(command, MST12Si2176State, COMMAND_SIZE),
+        VMSTATE_UINT8_ARRAY(pending, MST12Si2176State, COMMAND_SIZE),
+        VMSTATE_UINT8_ARRAY(response, MST12Si2176State, RESPONSE_SIZE),
+        VMSTATE_UINT16_ARRAY(properties, MST12Si2176State, PROPERTY_COUNT),
+        VMSTATE_UINT16_ARRAY(ssvd_registers, MST12Si2176State, 256),
+        VMSTATE_UINT8_ARRAY(clock_control, MST12Si2176State, 2),
+        VMSTATE_UINT8_ARRAY(ssvd_hdiv, MST12Si2176State, 5),
+        VMSTATE_UINT8_ARRAY(ssvd_debug, MST12Si2176State, 2),
+        VMSTATE_UINT8_ARRAY(pins, MST12Si2176State, 5),
+        VMSTATE_UINT8(command_length, MST12Si2176State),
+        VMSTATE_UINT8(pending_length, MST12Si2176State),
+        VMSTATE_UINT8(response_length, MST12Si2176State),
+        VMSTATE_UINT8(response_index, MST12Si2176State),
+        VMSTATE_UINT8(last_command, MST12Si2176State),
+        VMSTATE_UINT8(mode, MST12Si2176State),
+        VMSTATE_UINT8(agc_override, MST12Si2176State),
+        VMSTATE_BOOL(busy, MST12Si2176State),
+        VMSTATE_BOOL(powered, MST12Si2176State),
+        VMSTATE_BOOL(standby, MST12Si2176State),
+        VMSTATE_BOOL(bootloader, MST12Si2176State),
+        VMSTATE_BOOL(tuned, MST12Si2176State),
+        VMSTATE_BOOL(tune_interrupt, MST12Si2176State),
+        VMSTATE_BOOL(si21xx_mode, MST12Si2176State),
+        VMSTATE_BOOL(ssvd_powered, MST12Si2176State),
+        VMSTATE_UINT32(frequency, MST12Si2176State),
+        VMSTATE_UINT64(commands, MST12Si2176State),
+        VMSTATE_UINT64(errors, MST12Si2176State),
+        VMSTATE_UINT64(read_bytes, MST12Si2176State),
+        VMSTATE_UINT64(write_bytes, MST12Si2176State),
+        VMSTATE_UINT64(patch_packets, MST12Si2176State),
+        VMSTATE_UINT64(patch_bytes, MST12Si2176State),
+        VMSTATE_TIMER_PTR(timer, MST12Si2176State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property si2176_properties[] = {
+    DEFINE_PROP_BOOL("present", MST12Si2176State, present, true),
+    DEFINE_PROP_BOOL("si21xx-mode", MST12Si2176State, si21xx_mode, true),
+    DEFINE_PROP_BOOL("trace", MST12Si2176State, trace, false),
+    DEFINE_PROP_UINT64("command-time-ns", MST12Si2176State,
+                       command_time_ns, 50000),
+};
+
+static void si2176_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *ic = I2C_SLAVE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = si2176_realize;
+    dc->vmsd = &vmstate_si2176;
+    dc->desc = "MST12 Si21XX/Si2176 tuner control, without RF input";
+    device_class_set_props(dc, si2176_properties);
+    rc->phases.enter = si2176_reset_enter;
+    ic->event = si2176_event;
+    ic->send = si2176_send;
+    ic->recv = si2176_recv;
+}
+
+static const TypeInfo si2176_type = {
+    .name = TYPE_MST12_SI2176,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(MST12Si2176State),
+    .instance_init = si2176_init,
+    .instance_finalize = si2176_finalize,
+    .class_init = si2176_class_init,
+};
+
+static void si2176_register_types(void)
+{
+    type_register_static(&si2176_type);
+}
+
+type_init(si2176_register_types)
