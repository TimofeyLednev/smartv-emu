diff --git a/hw/display/mst12_ge.c b/hw/display/mst12_ge.c
new file mode 100644
index 0000000000000000000000000000000000000000..9c0e6bf7939d6e8e593e78fde1b4ad92620dd032
--- /dev/null
+++ b/hw/display/mst12_ge.c
@@ -0,0 +1,870 @@
+/*
+ * MStar MST12 graphics engine: register FIFO and basic 2D raster operations.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Original libUTOPIA.so GE_WriteReg, GE_WaitCmdQAvail, GE_WaitIdle,
+ * MDrv_GE_FillRect and MDrv_GE_BitBltEX establish the spaced halfwords,
+ * status, inclusive vertices, address encoding and command submission.
+ * The public linux-chenxing GE reference corroborates the color registers.
+ *
+ * Supported work changes guest RAM before retiring its FIFO entry or tag.
+ * Unsupported work stops the queue, retaining busy and the previous tag.
+ * FIFO latency and the correspondence of the two status counts are model
+ * assumptions; no measured timing or external VCMQ DMA is claimed.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/display/mst12_ge.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "system/address-spaces.h"
+
+#define GE_REGS             128
+#define GE_FIFO_SIZE        16
+#define GE_MAX_PIXELS       (3840 * 2160)
+#define GE_ENABLE           0x00
+#define GE_QUEUE_ENABLE     0x01
+#define GE_VQUEUE_LO        0x04
+#define GE_VQUEUE_HI        0x05
+#define GE_STATUS           0x07
+#define GE_ROP              0x10
+#define GE_BLEND            0x11
+#define GE_ALPHA            0x12
+#define GE_ALPHA_CONST      0x13
+#define GE_SCK_HI           0x14
+#define GE_SCK_LO           0x16
+#define GE_CK_MODE          0x1c
+#define GE_SRC_BASE         0x20
+#define GE_DST_BASE         0x26
+#define GE_PALETTE_COLOR    0x2d
+#define GE_PALETTE_INDEX    0x2f
+#define GE_SRC_PITCH        0x30
+#define GE_TAG              0x32
+#define GE_DST_PITCH        0x33
+#define GE_FORMAT           0x34
+#define GE_CLIP_LEFT        0x55
+#define GE_CLIP_RIGHT       0x56
+#define GE_CLIP_TOP         0x57
+#define GE_CLIP_BOTTOM      0x58
+#define GE_ROTATE           0x59
+#define GE_COMMAND          0x60
+#define GE_X0               0x68
+#define GE_Y0               0x69
+#define GE_X1               0x6a
+#define GE_Y1               0x6b
+#define GE_X2               0x6c
+#define GE_Y2               0x6d
+#define GE_COLOR            0x70
+
+#define GE_EN               (1u << 0)
+#define GE_DITHER           (1u << 1)
+#define GE_ABL              (1u << 2)
+#define GE_ROP_EN           (1u << 5)
+#define GE_SCK              (1u << 6)
+#define GE_DCK              (1u << 7)
+#define GE_DFB              (1u << 10)
+#define GE_STRETCH          (1u << 4)
+#define GE_ITALIC           (1u << 6)
+#define GE_SRC_INV_X        (1u << 7)
+#define GE_SRC_INV_Y        (1u << 8)
+#define GE_DST_INV_X        (1u << 9)
+#define GE_DST_INV_Y        (1u << 10)
+
+enum {
+    GE_FAULT_DISABLED = 1,
+    GE_FAULT_COMMAND,
+    GE_FAULT_FORMAT,
+    GE_FAULT_FEATURE,
+    GE_FAULT_GEOMETRY,
+    GE_FAULT_MEMORY,
+    GE_FAULT_OVERFLOW,
+};
+
+typedef struct GEQueueEntry {
+    uint16_t index;
+    uint16_t value;
+} GEQueueEntry;
+
+typedef struct GESurface {
+    MemoryRegionSection section;
+    uint8_t *data;
+    uint64_t physical;
+    uint64_t length;
+    unsigned pitch;
+    unsigned bpp;
+    unsigned format;
+    unsigned left;
+    unsigned top;
+} GESurface;
+
+struct MST12GEState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    uint16_t registers[GE_REGS];
+    uint16_t written[GE_REGS];
+    uint32_t palette[256];
+    GEQueueEntry fifo[GE_FIFO_SIZE];
+    uint32_t head;
+    uint32_t count;
+    uint32_t fault;
+    uint32_t fault_register;
+    uint32_t fault_value;
+    uint32_t last_command;
+    uint32_t completed_tag;
+    uint64_t writes;
+    uint64_t draws;
+    uint64_t pixels;
+    uint64_t step_ns;
+    uint64_t miu0_base;
+    uint64_t miu1_base;
+    bool trace;
+};
+
+static uint32_t ge_pair(MST12GEState *s, unsigned index)
+{
+    return s->registers[index] | (uint32_t)s->registers[index + 1] << 16;
+}
+
+static bool ge_fault(MST12GEState *s, unsigned fault,
+                     unsigned index, uint32_t value)
+{
+    if (!s->fault) {
+        s->fault = fault;
+        s->fault_register = index;
+        s->fault_value = value;
+        timer_del(s->timer);
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "MST12 GE fault=%u reg=0x%02x value=0x%08x "
+                      "command=0x%04x tag=0x%04x\n", fault, index,
+                      value, s->last_command, s->completed_tag);
+    }
+    return false;
+}
+
+static unsigned ge_bpp(unsigned format)
+{
+    switch (format) {
+    case 4: /* I8; original GE_GetFmtCaps supports this in both directions */
+        return 1;
+    case 8: /* RGB565 */
+    case 9: /* ARGB1555 */
+    case 10: /* ARGB4444 */
+    case 12: /* ARGB1555, nonzero destination alpha */
+        return 2;
+    case 15: /* ARGB8888 */
+        return 4;
+    default:
+        return 0;
+    }
+}
+
+static bool ge_surface(MST12GEState *s, GESurface *surface,
+                       unsigned base_index, unsigned pitch_index,
+                       unsigned format, unsigned left, unsigned right,
+                       unsigned top, unsigned bottom, bool write)
+{
+    uint32_t encoded = ge_pair(s, base_index);
+    uint64_t base = encoded & 0x80000000 ? s->miu1_base : s->miu0_base;
+    uint64_t start, length;
+    unsigned bpp = ge_bpp(format);
+    unsigned pitch = s->registers[pitch_index];
+    MemoryRegionSection section;
+
+    if (!bpp) {
+        return ge_fault(s, GE_FAULT_FORMAT, GE_FORMAT, format);
+    }
+    /*
+     * X is a byte offset within a row, not a bound imposed by the pitch.
+     * Original startup clears 21,504 ARGB pixels with a 20,480-byte pitch.
+     * Rows may overlap and a single row may extend beyond that pitch.
+     */
+    if (left > right || top > bottom) {
+        return ge_fault(s, GE_FAULT_GEOMETRY, pitch_index, pitch);
+    }
+    start = base + (encoded & 0x7fffffff) +
+            (uint64_t)top * pitch + (uint64_t)left * bpp;
+    length = (uint64_t)(bottom - top) * pitch +
+             (uint64_t)(right - left + 1) * bpp;
+    if (start > UINT32_MAX || length > UINT32_MAX + 1ULL - start) {
+        return ge_fault(s, GE_FAULT_MEMORY, base_index, encoded);
+    }
+    section = memory_region_find(get_system_memory(), start, length);
+    if (!section.mr) {
+        return ge_fault(s, GE_FAULT_MEMORY, base_index, encoded);
+    }
+    if (!memory_region_is_ram(section.mr) ||
+        (write && memory_region_is_rom(section.mr)) ||
+        int128_get64(section.size) != length) {
+        memory_region_unref(section.mr);
+        return ge_fault(s, GE_FAULT_MEMORY, base_index, encoded);
+    }
+    surface->section = section;
+    surface->physical = start;
+    surface->length = length;
+    surface->data = memory_region_get_ram_ptr(section.mr) +
+                    section.offset_within_region;
+    surface->pitch = pitch;
+    surface->bpp = bpp;
+    surface->format = format;
+    surface->left = left;
+    surface->top = top;
+    return true;
+}
+
+static uint8_t *ge_pixel(GESurface *surface, unsigned x, unsigned y)
+{
+    return surface->data + (uint64_t)(y - surface->top) * surface->pitch +
+           (uint64_t)(x - surface->left) * surface->bpp;
+}
+
+static uint32_t ge_unpack(MST12GEState *s, const uint8_t *p,
+                          unsigned format)
+{
+    unsigned packed, red, green, blue, alpha;
+
+    if (format == 15) {
+        return ldl_le_p(p);
+    }
+    if (format == 4) {
+        return s->palette[*p];
+    }
+    packed = lduw_le_p(p);
+    if (format == 10) {
+        blue = (packed & 15) * 17;
+        green = ((packed >> 4) & 15) * 17;
+        red = ((packed >> 8) & 15) * 17;
+        alpha = (packed >> 12) * 17;
+    } else {
+        blue = packed & 31;
+        blue = (blue << 3) | (blue >> 2);
+        red = (packed >> (format == 8 ? 11 : 10)) & 31;
+        red = (red << 3) | (red >> 2);
+        if (format == 8) {
+            green = (packed >> 5) & 63;
+            green = (green << 2) | (green >> 4);
+            alpha = 255;
+        } else {
+            green = (packed >> 5) & 31;
+            green = (green << 3) | (green >> 2);
+            alpha = packed & 0x8000 ? 255 : 0;
+        }
+    }
+    return blue | green << 8 | red << 16 | alpha << 24;
+}
+
+static void ge_pack(uint8_t *p, unsigned format, uint32_t color)
+{
+    unsigned blue = color & 255;
+    unsigned green = (color >> 8) & 255;
+    unsigned red = (color >> 16) & 255;
+    unsigned alpha = color >> 24;
+    unsigned packed;
+
+    if (format == 4) {
+        *p = color;
+        return;
+    }
+    if (format == 15) {
+        stl_le_p(p, color);
+        return;
+    }
+    if (format == 8) {
+        packed = (red >> 3) << 11 | (green >> 2) << 5 | blue >> 3;
+    } else if (format == 10) {
+        packed = (alpha >> 4) << 12 | (red >> 4) << 8 |
+                 (green >> 4) << 4 | blue >> 4;
+    } else {
+        packed = (format == 12 ? alpha != 0 : alpha >= 128) << 15 |
+                 (red >> 3) << 10 | (green >> 3) << 5 | blue >> 3;
+    }
+    stw_le_p(p, packed);
+}
+
+static uint32_t ge_rop(unsigned operation, uint32_t src, uint32_t dst)
+{
+    uint32_t result = 0;
+
+    if (operation & 1) {
+        result |= ~src & ~dst;
+    }
+    if (operation & 2) {
+        result |= ~src & dst;
+    }
+    if (operation & 4) {
+        result |= src & ~dst;
+    }
+    if (operation & 8) {
+        result |= src & dst;
+    }
+    return result;
+}
+
+static unsigned ge_mul_alpha(unsigned a, unsigned b)
+{
+    return (a * b + 127) / 255;
+}
+
+static unsigned ge_blend_color(unsigned operation, unsigned src, unsigned dst,
+                               unsigned sa, unsigned da, unsigned constant)
+{
+    unsigned product = ge_mul_alpha(sa, constant);
+    unsigned factor, source_weight, dest_weight, total;
+
+    /*
+     * The original API converter at 0x42bc867c maps GFX_BlendCoef values to
+     * MST12 register values. These differ from the public API enumeration:
+     * hardware 5 is source-over, 8 is destination and 9 is inverse constant.
+     */
+    switch (operation) {
+    case 0:
+        return src;
+    case 1:
+        factor = constant;
+        break;
+    case 2:
+        factor = sa;
+        break;
+    case 3:
+        factor = da;
+        break;
+    case 4:
+        factor = product;
+        break;
+    case 5:
+    case 6:
+        source_weight = product * (operation == 5 ? 255 : 255 - da);
+        dest_weight = da * (operation == 5 ? 255 - product : 255);
+        total = source_weight + dest_weight;
+        return total ? (src * source_weight + dst * dest_weight + total / 2) /
+                       total : 0;
+    case 7:
+        return ge_mul_alpha(src, constant);
+    case 8:
+        return dst;
+    case 9:
+        factor = 255 - constant;
+        break;
+    case 10:
+        factor = 255 - sa;
+        break;
+    case 11:
+        factor = 255 - da;
+        break;
+    case 15:
+        return ge_mul_alpha(src, 255 - constant);
+    default:
+        g_assert_not_reached();
+    }
+    return (src * factor + dst * (255 - factor) + 127) / 255;
+}
+
+static uint32_t ge_blend(MST12GEState *s, uint32_t src, uint32_t dst)
+{
+    unsigned constant = s->registers[GE_ALPHA_CONST] & 255;
+    unsigned sa = src >> 24, da = dst >> 24;
+    unsigned alpha;
+    unsigned product = ge_mul_alpha(sa, constant);
+    unsigned operation = s->registers[GE_BLEND] & 15;
+    uint32_t result = 0;
+    unsigned shift;
+
+    for (shift = 0; shift < 24; shift += 8) {
+        unsigned a = (src >> shift) & 255;
+        unsigned b = (dst >> shift) & 255;
+
+        result |= ge_blend_color(operation, a, b, sa, da, constant) << shift;
+    }
+    switch ((s->registers[GE_ALPHA] >> 8) & 15) {
+    case 0:
+        alpha = constant;
+        break;
+    case 1:
+        alpha = sa;
+        break;
+    case 2:
+        alpha = da;
+        break;
+    case 3:
+        alpha = product;
+        break;
+    case 4:
+        alpha = ge_mul_alpha(product, da);
+        break;
+    case 5:
+        alpha = ge_mul_alpha(da, 255 - product);
+        break;
+    case 6:
+        alpha = ge_mul_alpha(product, 255 - da);
+        break;
+    case 7:
+        alpha = ge_mul_alpha(product, 255 - da) + da;
+        break;
+    case 8:
+        alpha = 255 - constant;
+        break;
+    case 9:
+        alpha = 255 - sa;
+        break;
+    default:
+        alpha = 255 - da;
+        break;
+    }
+    return result | MIN(alpha, 255) << 24;
+}
+
+static bool ge_key_match(uint32_t color, uint32_t low, uint32_t high)
+{
+    unsigned shift;
+
+    for (shift = 0; shift < 32; shift += 8) {
+        unsigned value = (color >> shift) & 255;
+
+        if (value < ((low >> shift) & 255) ||
+            value > ((high >> shift) & 255)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ge_draw(MST12GEState *s, uint16_t command)
+{
+    unsigned operation = (command >> 4) & 7;
+    unsigned enable = s->registers[GE_ENABLE];
+    unsigned format = s->registers[GE_FORMAT];
+    unsigned src_format = format & 31;
+    unsigned dst_format = (format >> 8) & 31;
+    bool indexed_dst = dst_format == 4;
+    unsigned x0 = s->registers[GE_X0], x1 = s->registers[GE_X1];
+    unsigned y0 = s->registers[GE_Y0], y1 = s->registers[GE_Y1];
+    unsigned sx0 = s->registers[GE_X2], sy0 = s->registers[GE_Y2];
+    unsigned left = MIN(x0, x1), right = MAX(x0, x1);
+    unsigned top = MIN(y0, y1), bottom = MAX(y0, y1);
+    unsigned visible_left, visible_right, visible_top, visible_bottom;
+    unsigned first_i, last_i, first_j, last_j;
+    int dx = command & GE_DST_INV_X ? -1 : 1;
+    int dy = command & GE_DST_INV_Y ? -1 : 1;
+    int sx = command & GE_SRC_INV_X ? -1 : 1;
+    int sy = command & GE_SRC_INV_Y ? -1 : 1;
+    int src_x0, src_x1, src_y0, src_y1;
+    GESurface src = { 0 }, dst = { 0 };
+    unsigned i, j;
+    uint32_t color = ge_pair(s, GE_COLOR);
+    uint32_t key_low = ge_pair(s, GE_SCK_LO);
+    uint32_t key_high = ge_pair(s, GE_SCK_HI);
+    uint64_t pixels = 0;
+
+    s->last_command = command;
+    if (s->trace) {
+        qemu_log("MST12 GE draw: cmd=0x%04x en=0x%04x fmt=0x%04x "
+                 "dst=0x%08x pitch=%u xy=%u,%u:%u,%u "
+                 "src=0x%08x pitch=%u xy=%u,%u color=0x%08x "
+                 "rop=0x%04x blend=0x%04x alpha=0x%04x constant=0x%04x\n",
+                 command, enable,
+                 format, ge_pair(s, GE_DST_BASE),
+                 s->registers[GE_DST_PITCH], x0, y0, x1, y1,
+                 ge_pair(s, GE_SRC_BASE), s->registers[GE_SRC_PITCH],
+                 sx0, sy0, color, s->registers[GE_ROP],
+                 s->registers[GE_BLEND], s->registers[GE_ALPHA],
+                 s->registers[GE_ALPHA_CONST]);
+    }
+    if (!(enable & GE_EN)) {
+        return ge_fault(s, GE_FAULT_DISABLED, GE_ENABLE, enable);
+    }
+    if (operation != 3 && operation != 4) {
+        return ge_fault(s, GE_FAULT_COMMAND, GE_COMMAND, command);
+    }
+    if ((enable & (GE_DCK | GE_DFB)) ||
+        ((enable & GE_DITHER) && dst_format != 15) ||
+        ((enable & GE_ABL) && (enable & GE_ROP_EN)) ||
+        (s->registers[GE_QUEUE_ENABLE] & (GE_STRETCH | GE_ITALIC)) ||
+        (s->registers[GE_ROTATE] & 3) || (command & 0x3800)) {
+        return ge_fault(s, GE_FAULT_FEATURE, GE_COMMAND, command);
+    }
+    if ((enable & GE_ABL) && (((s->registers[GE_BLEND] & 15) >= 12 &&
+                             (s->registers[GE_BLEND] & 15) <= 14) ||
+        ((s->registers[GE_ALPHA] >> 8) & 15) > 10)) {
+        return ge_fault(s, GE_FAULT_FEATURE, GE_BLEND,
+                        s->registers[GE_BLEND]);
+    }
+    if ((x1 != x0 && ((x1 < x0) != (dx < 0))) ||
+        (y1 != y0 && ((y1 < y0) != (dy < 0)))) {
+        return ge_fault(s, GE_FAULT_GEOMETRY, GE_X1, x1);
+    }
+    if (!ge_bpp(dst_format) ||
+        (operation == 4 && !ge_bpp(src_format))) {
+        return ge_fault(s, GE_FAULT_FORMAT, GE_FORMAT, format);
+    }
+    if (indexed_dst && operation == 4 && src_format != 4) {
+        return ge_fault(s, GE_FAULT_FORMAT, GE_FORMAT, format);
+    }
+    if (indexed_dst && (enable & (GE_ABL | GE_SCK))) {
+        return ge_fault(s, GE_FAULT_FEATURE, GE_ENABLE, enable);
+    }
+    visible_left = MAX(left, s->registers[GE_CLIP_LEFT]);
+    visible_right = MIN(right, s->registers[GE_CLIP_RIGHT]);
+    visible_top = MAX(top, s->registers[GE_CLIP_TOP]);
+    visible_bottom = MIN(bottom, s->registers[GE_CLIP_BOTTOM]);
+    if (visible_left > visible_right || visible_top > visible_bottom) {
+        s->draws++;
+        return true;
+    }
+    if ((uint64_t)(visible_right - visible_left + 1) *
+        (visible_bottom - visible_top + 1) > GE_MAX_PIXELS) {
+        return ge_fault(s, GE_FAULT_GEOMETRY, GE_X1, x1);
+    }
+    first_i = dx < 0 ? x0 - visible_right : visible_left - x0;
+    last_i = dx < 0 ? x0 - visible_left : visible_right - x0;
+    first_j = dy < 0 ? y0 - visible_bottom : visible_top - y0;
+    last_j = dy < 0 ? y0 - visible_top : visible_bottom - y0;
+    if (operation == 4) {
+        src_x0 = (int)sx0 + sx * (int)first_i;
+        src_x1 = (int)sx0 + sx * (int)last_i;
+        src_y0 = (int)sy0 + sy * (int)first_j;
+        src_y1 = (int)sy0 + sy * (int)last_j;
+        if (MIN(src_x0, src_x1) < 0 || MIN(src_y0, src_y1) < 0 ||
+            MAX(src_x0, src_x1) > UINT16_MAX ||
+            MAX(src_y0, src_y1) > UINT16_MAX) {
+            return ge_fault(s, GE_FAULT_GEOMETRY, GE_X2, sx0);
+        }
+        if (!ge_surface(s, &src, GE_SRC_BASE, GE_SRC_PITCH, src_format,
+                        MIN(src_x0, src_x1), MAX(src_x0, src_x1),
+                        MIN(src_y0, src_y1), MAX(src_y0, src_y1), false)) {
+            return false;
+        }
+    }
+    if (!ge_surface(s, &dst, GE_DST_BASE, GE_DST_PITCH, dst_format,
+                    visible_left, visible_right, visible_top,
+                    visible_bottom, true)) {
+        if (src.section.mr) {
+            memory_region_unref(src.section.mr);
+        }
+        return false;
+    }
+    for (j = first_j; j <= last_j; j++) {
+        unsigned y = y0 + dy * (int)j;
+
+        for (i = first_i; i <= last_i; i++) {
+            unsigned x = x0 + dx * (int)i;
+            uint32_t input = color, previous;
+            uint8_t *p;
+
+            if (operation == 4) {
+                uint8_t *source = ge_pixel(&src, sx0 + sx * (int)i,
+                                           sy0 + sy * (int)j);
+
+                input = indexed_dst ? *source :
+                        ge_unpack(s, source, src_format);
+                if ((enable & GE_SCK) &&
+                    (ge_key_match(input, key_low, key_high) !=
+                     !!(s->registers[GE_CK_MODE] & 1))) {
+                    continue;
+                }
+            }
+            p = ge_pixel(&dst, x, y);
+            previous = indexed_dst ? *p : ge_unpack(s, p, dst_format);
+            if (enable & GE_ROP_EN) {
+                input = ge_rop(s->registers[GE_ROP] & 15, input, previous);
+            } else if (enable & GE_ABL) {
+                input = ge_blend(s, input, previous);
+            }
+            ge_pack(p, dst_format, input);
+            if (s->trace && i == first_i && j == first_j) {
+                qemu_log("MST12 GE pixel: source=0x%08x destination=0x%08x "
+                         "output=0x%08x\n",
+                         operation == 4 ? ge_unpack(s,
+                             ge_pixel(&src, sx0 + sx * (int)i,
+                                      sy0 + sy * (int)j), src_format) : color,
+                         previous, input);
+            }
+            pixels++;
+        }
+    }
+    if (pixels) {
+        memory_region_set_dirty(dst.section.mr,
+                                dst.section.offset_within_region, dst.length);
+    }
+    memory_region_unref(dst.section.mr);
+    if (src.section.mr) {
+        memory_region_unref(src.section.mr);
+    }
+    s->draws++;
+    s->pixels += pixels;
+    return true;
+}
+
+static bool ge_apply(MST12GEState *s, unsigned index, uint16_t value)
+{
+    s->registers[index] = value;
+    if (index == GE_COMMAND) {
+        return ge_draw(s, value);
+    }
+    if (index == GE_TAG) {
+        s->completed_tag = value;
+    } else if (index == GE_PALETTE_INDEX) {
+        if (value & 0x100) {
+            s->palette[value & 255] = ge_pair(s, GE_PALETTE_COLOR);
+        } else {
+            uint32_t color = s->palette[value & 255];
+
+            s->registers[GE_PALETTE_COLOR] = color;
+            s->registers[GE_PALETTE_COLOR + 1] = color >> 16;
+        }
+    }
+    return true;
+}
+
+static void ge_step(void *opaque)
+{
+    MST12GEState *s = opaque;
+    GEQueueEntry *entry;
+
+    if (!s->count || s->fault) {
+        return;
+    }
+    entry = &s->fifo[s->head];
+    if (!ge_apply(s, entry->index, entry->value)) {
+        return;
+    }
+    s->head = (s->head + 1) % GE_FIFO_SIZE;
+    s->count--;
+    if (s->count) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  s->step_ns);
+    }
+}
+
+static uint64_t ge_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12GEState *s = opaque;
+    unsigned index = offset / 4;
+    unsigned free = GE_FIFO_SIZE - s->count;
+    uint16_t value = s->registers[index];
+
+    if (offset & 2) {
+        return 0;
+    }
+    if (index == GE_STATUS) {
+        value = free << 11 | free << 3 | !!(s->count || s->fault);
+    } else if (index == GE_VQUEUE_LO || index == GE_VQUEUE_HI) {
+        value = index == GE_VQUEUE_LO &&
+                (s->registers[GE_QUEUE_ENABLE] & 2) ? s->count : 0;
+    } else if (index == GE_TAG) {
+        value = s->completed_tag;
+    }
+    return extract32(value, (offset & 1) * 8,
+                     MIN(size * 8, 16 - (offset & 1) * 8));
+}
+
+static void ge_write(void *opaque, hwaddr offset,
+                     uint64_t value, unsigned size)
+{
+    MST12GEState *s = opaque;
+    unsigned index = offset / 4;
+    unsigned tail;
+    uint16_t updated;
+
+    if (offset & 2 || index == GE_STATUS || index == GE_VQUEUE_LO ||
+        index == GE_VQUEUE_HI) {
+        return;
+    }
+    /* The firmware uses full halfwords; byte writes are register accesses. */
+    updated = deposit32(s->written[index], (offset & 1) * 8,
+                        size == 1 ? 8 : 16, value);
+    if (s->trace) {
+        qemu_log("MST12 GE write: reg=0x%02x value=0x%04x depth=%u\n",
+                 index, updated, s->count);
+    }
+    s->writes++;
+    if (index == GE_ENABLE || index == GE_QUEUE_ENABLE) {
+        s->written[index] = updated;
+        s->registers[index] = updated;
+        return;
+    }
+    if (s->fault) {
+        return;
+    }
+    if (!(s->registers[GE_QUEUE_ENABLE] & 1) && !s->count &&
+        index != GE_COMMAND) {
+        s->written[index] = updated;
+        ge_apply(s, index, updated);
+        return;
+    }
+    if (s->count == GE_FIFO_SIZE) {
+        ge_fault(s, GE_FAULT_OVERFLOW, index, updated);
+        return;
+    }
+    s->written[index] = updated;
+    tail = (s->head + s->count) % GE_FIFO_SIZE;
+    s->fifo[tail].index = index;
+    s->fifo[tail].value = updated;
+    if (!s->count++) {
+        timer_mod(s->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  s->step_ns);
+    }
+}
+
+static const MemoryRegionOps ge_ops = {
+    .read = ge_read,
+    .write = ge_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void ge_reset(DeviceState *dev)
+{
+    MST12GEState *s = MST12_GE(dev);
+
+    timer_del(s->timer);
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->written, 0, sizeof(s->written));
+    memset(s->palette, 0, sizeof(s->palette));
+    memset(s->fifo, 0, sizeof(s->fifo));
+    s->head = 0;
+    s->count = 0;
+    s->fault = 0;
+    s->fault_register = 0;
+    s->fault_value = 0;
+    s->last_command = 0;
+    s->completed_tag = 0;
+    s->writes = 0;
+    s->draws = 0;
+    s->pixels = 0;
+}
+
+static void ge_realize(DeviceState *dev, Error **errp)
+{
+    MST12GEState *s = MST12_GE(dev);
+
+    if (!s->step_ns || s->step_ns > 1000000000) {
+        error_setg(errp, "MStar GE FIFO step must be between 1 ns and 1 s");
+    }
+}
+
+static void ge_init(Object *obj)
+{
+    MST12GEState *s = MST12_GE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &ge_ops, s, TYPE_MST12_GE,
+                          GE_REGS * 4);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    s->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, ge_step, s);
+    object_property_add_uint32_ptr(obj, "queue-depth", &s->count,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault-register", &s->fault_register,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault-value", &s->fault_value,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "last-command", &s->last_command,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "completed-tag", &s->completed_tag,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "register-writes", &s->writes,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "draw-count", &s->draws,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "pixels-written", &s->pixels,
+                                   OBJ_PROP_FLAG_READ);
+}
+
+static void ge_finalize(Object *obj)
+{
+    timer_free(MST12_GE(obj)->timer);
+}
+
+static const VMStateDescription vmstate_ge_entry = {
+    .name = "mst12-ge/fifo-entry",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16(index, GEQueueEntry),
+        VMSTATE_UINT16(value, GEQueueEntry),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static int ge_post_load(void *opaque, int version_id)
+{
+    MST12GEState *s = opaque;
+    unsigned i;
+
+    if (s->head >= GE_FIFO_SIZE || s->count > GE_FIFO_SIZE ||
+        s->completed_tag > UINT16_MAX) {
+        return -EINVAL;
+    }
+    for (i = 0; i < s->count; i++) {
+        if (s->fifo[(s->head + i) % GE_FIFO_SIZE].index >= GE_REGS) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_ge = {
+    .name = TYPE_MST12_GE,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = ge_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT16_ARRAY(registers, MST12GEState, GE_REGS),
+        VMSTATE_UINT16_ARRAY(written, MST12GEState, GE_REGS),
+        VMSTATE_UINT32_ARRAY(palette, MST12GEState, 256),
+        VMSTATE_STRUCT_ARRAY(fifo, MST12GEState, GE_FIFO_SIZE, 1,
+                             vmstate_ge_entry, GEQueueEntry),
+        VMSTATE_UINT32(head, MST12GEState),
+        VMSTATE_UINT32(count, MST12GEState),
+        VMSTATE_UINT32(fault, MST12GEState),
+        VMSTATE_UINT32(fault_register, MST12GEState),
+        VMSTATE_UINT32(fault_value, MST12GEState),
+        VMSTATE_UINT32(last_command, MST12GEState),
+        VMSTATE_UINT32(completed_tag, MST12GEState),
+        VMSTATE_UINT64(writes, MST12GEState),
+        VMSTATE_UINT64(draws, MST12GEState),
+        VMSTATE_UINT64(pixels, MST12GEState),
+        VMSTATE_TIMER_PTR(timer, MST12GEState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property ge_properties[] = {
+    DEFINE_PROP_UINT64("fifo-step-ns", MST12GEState, step_ns, 1000),
+    DEFINE_PROP_UINT64("miu0-base", MST12GEState, miu0_base, 0x40000000),
+    DEFINE_PROP_UINT64("miu1-base", MST12GEState, miu1_base, 0xa0000000),
+    DEFINE_PROP_BOOL("trace", MST12GEState, trace, false),
+};
+
+static void ge_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ge_realize;
+    device_class_set_legacy_reset(dc, ge_reset);
+    device_class_set_props(dc, ge_properties);
+    dc->vmsd = &vmstate_ge;
+    dc->desc = "MStar MST12 GE register FIFO and basic 2D rasterizer";
+    dc->user_creatable = false;
+}
+
+static const TypeInfo ge_type = {
+    .name = TYPE_MST12_GE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12GEState),
+    .instance_init = ge_init,
+    .instance_finalize = ge_finalize,
+    .class_init = ge_class_init,
+};
+
+static void ge_register_types(void)
+{
+    type_register_static(&ge_type);
+}
+
+type_init(ge_register_types)
diff --git a/hw/display/mst12_gop.c b/hw/display/mst12_gop.c
new file mode 100644
index 0000000000000000000000000000000000000000..f946086f8a3643ce771e5e38d3b8112dda6d52ac
--- /dev/null
+++ b/hw/display/mst12_gop.c
@@ -0,0 +1,552 @@
+/*
+ * Minimal MStar Edison GOP scanout for Samsung T-MST12DEUC 1112.2.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Register layout comes from the original samsung_mstar.ko functions
+ * _MHal_GOP_Select, _MHal_GOP_UpdateReg, _MHal_GOP_GWIN_WinInfo_Set,
+ * MHal_GOP_GWIN_SetRblk and _MHal_GOP_GWIN_Enable. Original libUTOPIA
+ * supplies the direct aperture, GOP mux, alpha and 12-bit stretch ratios.
+ * Scanout composes the selected graphics layers on the configured panel.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/display/mst12_gop.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "system/address-spaces.h"
+#ifdef CONFIG_PIXMAN
+#include "ui/console.h"
+#endif
+
+#define GOP_BANKS             16
+#define GOP_REGS              128
+#define GOP_BANK_SELECT       0x1fc
+#define GOP_UPDATE            0x100
+#define GOP_FORCE_WRITE       0x200
+#define GOP_BANK_UPDATE       0x400
+#define GOP_BUSY              0xf000
+#define GOP_MAX_WIDTH         3840
+#define GOP_MAX_HEIGHT        2160
+#define GOP_RGB565            0
+#define GOP_ARGB8888          5
+#define GOP_PIXEL_ALPHA       0x4000
+#define GOP_ALPHA_INVERSE     0x8000
+#define GOP_HMIRROR           0x1000
+#define GOP_VMIRROR           0x2000
+#define GOP_SCALE_ONE         0x1000
+
+struct MST12GOPState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion direct_iomem;
+    uint32_t registers[GOP_BANKS][GOP_REGS];
+    uint32_t active[GOP_BANKS][GOP_REGS];
+    uint32_t bank_select;
+    uint64_t miu_base;
+    uint32_t panel_width;
+    uint32_t panel_height;
+    bool panel_rotate_180;
+    bool trace;
+#ifdef CONFIG_PIXMAN
+    QemuConsole *console;
+    bool invalidated;
+#endif
+};
+
+static uint64_t mst12_gop_reg_read(MST12GOPState *s, unsigned bank,
+                                   hwaddr offset, unsigned size, bool selector)
+{
+    uint32_t value;
+
+    if (selector && (offset & ~3) == GOP_BANK_SELECT) {
+        value = s->bank_select;
+    } else {
+        value = s->registers[bank][offset >> 2];
+    }
+    return extract32(value, (offset & 3) * 8, size * 8);
+}
+
+static void mst12_gop_reg_write(MST12GOPState *s, unsigned bank, hwaddr offset,
+                                uint64_t value, unsigned size, bool selector)
+{
+    unsigned index = offset >> 2;
+
+    if (selector && (offset & ~3) == GOP_BANK_SELECT) {
+        uint32_t previous = s->bank_select;
+
+        s->bank_select = deposit32(previous, (offset & 3) * 8,
+                                   size * 8, value) & ~GOP_BUSY;
+        /* Acknowledge update requests synchronously, without a vblank IRQ. */
+        if ((s->bank_select & GOP_FORCE_WRITE) ||
+            (!(previous & GOP_UPDATE) && (s->bank_select & GOP_UPDATE))) {
+            memcpy(s->active, s->registers, sizeof(s->active));
+        } else if (!(previous & GOP_BANK_UPDATE) &&
+                   (s->bank_select & GOP_BANK_UPDATE)) {
+            /* Orsay pulses bit 10 with the GOP's general bank in bits 0..3. */
+            unsigned first = s->bank_select & 15;
+            unsigned count = MIN(3, GOP_BANKS - first);
+
+            memcpy(&s->active[first], &s->registers[first],
+                   count * sizeof(s->active[0]));
+        }
+        if (s->trace) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "mst12-gop selector 0x%04x -> 0x%04x\n",
+                          previous, s->bank_select);
+        }
+    } else {
+        s->registers[bank][index] = deposit32(s->registers[bank][index],
+                                             (offset & 3) * 8,
+                                             size * 8, value);
+        if (s->bank_select & GOP_FORCE_WRITE) {
+            s->active[bank][index] = s->registers[bank][index];
+        }
+        if (s->trace) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "mst12-gop write bank=%u reg=0x%02x value=0x%08x\n",
+                          bank, index, s->registers[bank][index]);
+        }
+    }
+#ifdef CONFIG_PIXMAN
+    s->invalidated = true;
+#endif
+}
+
+static uint64_t mst12_gop_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12GOPState *s = opaque;
+
+    return mst12_gop_reg_read(s, s->bank_select & 15, offset, size, true);
+}
+
+static void mst12_gop_write(void *opaque, hwaddr offset,
+                            uint64_t value, unsigned size)
+{
+    MST12GOPState *s = opaque;
+
+    mst12_gop_reg_write(s, s->bank_select & 15, offset, value, size, true);
+}
+
+static uint64_t mst12_gop_direct_read(void *opaque, hwaddr offset,
+                                     unsigned size)
+{
+    MST12GOPState *s = opaque;
+    unsigned bank = offset >> 9;
+
+    return mst12_gop_reg_read(s, bank, offset & 0x1ff, size, bank == 0);
+}
+
+static void mst12_gop_direct_write(void *opaque, hwaddr offset,
+                                   uint64_t value, unsigned size)
+{
+    MST12GOPState *s = opaque;
+    unsigned bank = offset >> 9;
+
+    mst12_gop_reg_write(s, bank, offset & 0x1ff, value, size, bank == 0);
+}
+
+static const MemoryRegionOps mst12_gop_ops = {
+    .read = mst12_gop_read,
+    .write = mst12_gop_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+static const MemoryRegionOps mst12_gop_direct_ops = {
+    .read = mst12_gop_direct_read,
+    .write = mst12_gop_direct_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+#ifdef CONFIG_PIXMAN
+typedef struct MST12GOPWindow {
+    MemoryRegionSection section;
+    const uint8_t *source;
+    unsigned format;
+    unsigned bpp;
+    unsigned width;
+    unsigned height;
+    unsigned pitch;
+    unsigned left;
+    unsigned top;
+    unsigned right;
+    unsigned bottom;
+    unsigned hscale;
+    unsigned vscale;
+    unsigned alpha;
+    bool pixel_alpha;
+    bool alpha_inverse;
+    bool progressive;
+    bool hmirror;
+    bool vmirror;
+} MST12GOPWindow;
+
+static void mst12_gop_invalidate(void *opaque)
+{
+    MST12GOPState *s = opaque;
+
+    s->invalidated = true;
+}
+
+static bool mst12_gop_window(MST12GOPState *s, unsigned gop, unsigned n,
+                             MST12GOPWindow *w)
+{
+    const uint32_t *general = s->active[gop * 3];
+    const uint32_t *window = &s->active[gop * 3 + 1][n * 32];
+    unsigned control = general[0], rows;
+    unsigned hstart, hend, vstart, vend;
+    uint64_t base, row_span, length;
+
+    memset(w, 0, sizeof(*w));
+    if (!(window[0] & 1)) {
+        return false;
+    }
+    w->format = (window[0] >> 4) & 15;
+    if (w->format != GOP_ARGB8888 && w->format != GOP_RGB565) {
+        return false;
+    }
+    w->bpp = w->format == GOP_ARGB8888 ? 4 : 2;
+    /* HAL divides byte addresses, horizontal bounds and pitch by 32. */
+    hstart = window[4] & 0xffff;
+    hend = window[5] & 0xffff;
+    vstart = window[6] & 0xffff;
+    vend = window[8] & 0xffff;
+    if (hend <= hstart || vend <= vstart) {
+        return false;
+    }
+    w->width = (hend - hstart) * 32 / w->bpp;
+    rows = vend - vstart;
+    w->progressive = control & 8;
+    w->height = rows * (w->progressive ? 1 : 2);
+    w->pitch = (window[9] & 0xffff) * 32;
+    if (!w->width || w->width > GOP_MAX_WIDTH || !w->height ||
+        w->height > GOP_MAX_HEIGHT || w->pitch < w->width * w->bpp) {
+        return false;
+    }
+    base = s->miu_base + (((uint64_t)(window[2] & 0x1ff) << 16 |
+                           (window[1] & 0xffff)) << 5);
+    if (gop < 2) {
+        /* GOP0/1 add a word-addressed RBLK start within their buffer. */
+        base += ((uint64_t)(window[0x0d] & 0xffff) << 16 |
+                 (window[0x0c] & 0xffff)) << 5;
+    }
+    w->hmirror = control & GOP_HMIRROR;
+    w->vmirror = control & GOP_VMIRROR;
+    row_span = (uint64_t)(rows - 1) * w->pitch;
+    if (w->vmirror) {
+        /* The HAL points at the last row; vertical scan steps backward. */
+        if (base < row_span) {
+            return false;
+        }
+        base -= row_span;
+    }
+    length = row_span + w->width * w->bpp;
+    w->section = memory_region_find(get_system_memory(), base, length);
+    if (!w->section.mr) {
+        return false;
+    }
+    if (!memory_region_is_ram(w->section.mr) ||
+        int128_get64(w->section.size) != length) {
+        memory_region_unref(w->section.mr);
+        return false;
+    }
+    w->source = memory_region_get_ram_ptr(w->section.mr) +
+                w->section.offset_within_region;
+    w->hscale = general[0x35] & 0xffff;
+    w->vscale = general[0x36] & 0xffff;
+    if (!w->hscale || !s->panel_width) {
+        w->hscale = GOP_SCALE_ONE;
+    }
+    if (!w->vscale || !s->panel_height) {
+        w->vscale = GOP_SCALE_ONE;
+    }
+    hstart = s->panel_width ? hstart * 32 / w->bpp : 0;
+    vstart = s->panel_height ? vstart * (w->progressive ? 1 : 2) : 0;
+    w->left = (uint64_t)hstart * GOP_SCALE_ONE / w->hscale;
+    w->top = (uint64_t)vstart * GOP_SCALE_ONE / w->vscale;
+    w->right = DIV_ROUND_UP((uint64_t)(hstart + w->width) * GOP_SCALE_ONE,
+                            w->hscale);
+    w->bottom = DIV_ROUND_UP((uint64_t)(vstart + w->height) * GOP_SCALE_ONE,
+                             w->vscale);
+    if (s->panel_width) {
+        w->left += general[0x32] & 0xffff;
+        w->right += general[0x32] & 0xffff;
+        w->top += general[0x34] & 0xffff;
+        w->bottom += general[0x34] & 0xffff;
+    }
+    w->pixel_alpha = window[0] & GOP_PIXEL_ALPHA;
+    w->alpha_inverse = control & GOP_ALPHA_INVERSE;
+    w->alpha = window[0x0a] & 255;
+    if (gop < 2) {
+        /* HAL programs six-bit constant alpha shifted left by two. */
+        w->alpha = ((w->alpha >> 2) * 255 + 31) / 63;
+    }
+    return true;
+}
+
+static void mst12_gop_paint(DisplaySurface *surface, const MST12GOPWindow *w,
+                            bool diagnostic, bool rotate_180)
+{
+    unsigned x, y, right = MIN(w->right, surface_width(surface));
+    unsigned bottom = MIN(w->bottom, surface_height(surface));
+    uint8_t *destination = surface_data(surface);
+
+    for (y = w->top; y < bottom; y++) {
+        unsigned sy = MIN((uint64_t)(y - w->top) * w->vscale / GOP_SCALE_ONE,
+                           w->height - 1);
+        unsigned dy = rotate_180 ? surface_height(surface) - 1 - y : y;
+        const uint8_t *row;
+        uint8_t *out = destination + dy * surface_stride(surface);
+
+        if (w->vmirror) {
+            sy = w->height - 1 - sy;
+        }
+        row = w->source + (w->progressive ? sy : sy / 2) * w->pitch;
+        for (x = w->left; x < right; x++) {
+            unsigned sx = MIN((uint64_t)(x - w->left) * w->hscale /
+                               GOP_SCALE_ONE, w->width - 1);
+            unsigned dx = rotate_180 ? surface_width(surface) - 1 - x : x;
+            unsigned alpha = diagnostic ? 255 : w->alpha;
+            uint32_t pixel;
+
+            if (w->hmirror) {
+                sx = w->width - 1 - sx;
+            }
+            if (w->format == GOP_ARGB8888) {
+                pixel = ldl_le_p(row + sx * 4);
+                if (w->pixel_alpha && !diagnostic) {
+                    /* Native GOP alpha is transparency; bit 15 inverts it. */
+                    alpha = w->alpha_inverse ? pixel >> 24 :
+                                               255 - (pixel >> 24);
+                }
+            } else {
+                unsigned packed = lduw_le_p(row + sx * 2);
+                unsigned red = (packed >> 11) & 31;
+                unsigned green = (packed >> 5) & 63;
+                unsigned blue = packed & 31;
+
+                pixel = ((red * 255 / 31) << 16) |
+                        ((green * 255 / 63) << 8) | (blue * 255 / 31);
+            }
+            pixel &= 0xffffff;
+            if (alpha != 255) {
+                uint32_t under = ldl_he_p(out + dx * 4);
+                unsigned shift, blended = 0;
+
+                for (shift = 0; shift < 24; shift += 8) {
+                    unsigned fg = (pixel >> shift) & 255;
+                    unsigned bg = (under >> shift) & 255;
+
+                    blended |= ((fg * alpha + bg * (255 - alpha) + 127) /
+                                 255) << shift;
+                }
+                pixel = blended;
+            }
+            stl_he_p(out + dx * 4, pixel);
+        }
+    }
+}
+
+static void mst12_gop_update(void *opaque)
+{
+    MST12GOPState *s = opaque;
+    DisplaySurface *surface = qemu_console_surface(s->console);
+    unsigned canvas_width = s->panel_width, canvas_height = s->panel_height;
+    unsigned stage, gop = 4, n;
+    MST12GOPWindow diagnostic;
+    bool native = !s->panel_width;
+
+    if (native) {
+        for (gop = 0; gop < 4; gop++) {
+            for (n = 0; n < (gop < 2 ? 2 : 1); n++) {
+                if (mst12_gop_window(s, gop, n, &diagnostic)) {
+                    canvas_width = diagnostic.width;
+                    canvas_height = diagnostic.height;
+                    goto canvas;
+                }
+            }
+        }
+        canvas_width = surface_width(surface);
+        canvas_height = surface_height(surface);
+    }
+canvas:
+    if (surface_width(surface) != canvas_width ||
+        surface_height(surface) != canvas_height) {
+        qemu_console_resize(s->console, canvas_width, canvas_height);
+        surface = qemu_console_surface(s->console);
+    }
+    memset(surface_data(surface), 0, surface_stride(surface) * canvas_height);
+    if (native) {
+        if (gop < 4) {
+            mst12_gop_paint(surface, &diagnostic, true, false);
+            memory_region_unref(diagnostic.section.mr);
+        }
+    } else {
+        /* HAL_GOP_GWIN_SetMUX packs four back-to-front, three-bit selectors. */
+        unsigned mux = s->active[0][0x7e];
+
+        for (stage = 0; stage < 4; stage++) {
+            gop = (mux >> (stage * 3)) & 7;
+            if (gop >= 4) {
+                continue;
+            }
+            for (n = 0; n < (gop < 2 ? 2 : 1); n++) {
+                MST12GOPWindow window;
+
+                if (mst12_gop_window(s, gop, n, &window)) {
+                    mst12_gop_paint(surface, &window, false,
+                                    s->panel_rotate_180);
+                    memory_region_unref(window.section.mr);
+                }
+            }
+        }
+    }
+    dpy_gfx_update(s->console, 0, 0, canvas_width, canvas_height);
+    s->invalidated = false;
+}
+
+static const GraphicHwOps mst12_gop_graphics_ops = {
+    .invalidate = mst12_gop_invalidate,
+    .gfx_update = mst12_gop_update,
+};
+#endif
+
+static void mst12_gop_reset(DeviceState *dev)
+{
+    MST12GOPState *s = MST12_GOP(dev);
+
+    memset(s->registers, 0, sizeof(s->registers));
+    memset(s->active, 0, sizeof(s->active));
+    s->bank_select = 0;
+#ifdef CONFIG_PIXMAN
+    s->invalidated = true;
+#endif
+}
+
+static void mst12_gop_realize(DeviceState *dev, Error **errp)
+{
+    MST12GOPState *s = MST12_GOP(dev);
+
+    if ((!s->panel_width != !s->panel_height) ||
+        s->panel_width > GOP_MAX_WIDTH || s->panel_height > GOP_MAX_HEIGHT) {
+        error_setg(errp, "MStar GOP panel dimensions must both be zero or "
+                   "at most %ux%u", GOP_MAX_WIDTH, GOP_MAX_HEIGHT);
+        return;
+    }
+#ifdef CONFIG_PIXMAN
+    s->console = graphic_console_init(dev, 0, &mst12_gop_graphics_ops, s);
+    /* Zero dimensions select a diagnostic view of the first framebuffer. */
+    qemu_console_resize(s->console, s->panel_width ? s->panel_width : 800,
+                        s->panel_height ? s->panel_height : 1080);
+    s->invalidated = true;
+#endif
+}
+
+static void mst12_gop_init(Object *obj)
+{
+    MST12GOPState *s = MST12_GOP(obj);
+
+    memory_region_init_io(&s->iomem, obj, &mst12_gop_ops, s,
+                          "mst12-gop", 0x200);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    /* HAL_GOP_{Read,Write}16Reg directly addresses 16 banks at 0x1f240400. */
+    memory_region_init_io(&s->direct_iomem, obj, &mst12_gop_direct_ops, s,
+                          "mst12-gop-direct", GOP_BANKS * 0x200);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->direct_iomem);
+}
+
+static const VMStateDescription vmstate_mst12_gop = {
+    .name = TYPE_MST12_GOP,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(bank_select, MST12GOPState),
+        VMSTATE_UINT32_2DARRAY(registers, MST12GOPState, GOP_BANKS, GOP_REGS),
+        VMSTATE_UINT32_2DARRAY(active, MST12GOPState, GOP_BANKS, GOP_REGS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property mst12_gop_properties[] = {
+    DEFINE_PROP_UINT64("miu-base", MST12GOPState, miu_base, 0x40000000),
+    DEFINE_PROP_UINT32("panel-width", MST12GOPState, panel_width, 0),
+    DEFINE_PROP_UINT32("panel-height", MST12GOPState, panel_height, 0),
+    DEFINE_PROP_BOOL("panel-rotate-180", MST12GOPState, panel_rotate_180,
+                     false),
+    DEFINE_PROP_BOOL("trace", MST12GOPState, trace, false),
+};
+
+static char *mst12_gop_dump_registers(
+    const uint32_t registers[GOP_BANKS][GOP_REGS])
+{
+    GString *text = g_string_new(NULL);
+    unsigned bank, index;
+
+    for (bank = 0; bank < GOP_BANKS; bank++) {
+        g_string_append_printf(text, "bank %u\n", bank);
+        for (index = 0; index < GOP_REGS; index++) {
+            g_string_append_printf(text, "%08x%c", registers[bank][index],
+                                   (index & 7) == 7 ? '\n' : ' ');
+        }
+    }
+    return g_string_free(text, false);
+}
+
+static char *mst12_gop_get_registers(Object *obj, Error **errp)
+{
+    return mst12_gop_dump_registers(MST12_GOP(obj)->registers);
+}
+
+static char *mst12_gop_get_active(Object *obj, Error **errp)
+{
+    return mst12_gop_dump_registers(MST12_GOP(obj)->active);
+}
+
+static void mst12_gop_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = mst12_gop_realize;
+    device_class_set_legacy_reset(dc, mst12_gop_reset);
+    dc->vmsd = &vmstate_mst12_gop;
+    device_class_set_props(dc, mst12_gop_properties);
+    dc->desc = "MStar Edison GOP experimental framebuffer scanout";
+    dc->user_creatable = false;
+    object_class_property_add_str(OBJECT_CLASS(klass), "registers",
+                                   mst12_gop_get_registers, NULL);
+    object_class_property_add_str(OBJECT_CLASS(klass), "active-registers",
+                                   mst12_gop_get_active, NULL);
+}
+
+static const TypeInfo mst12_gop_type = {
+    .name = TYPE_MST12_GOP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12GOPState),
+    .instance_init = mst12_gop_init,
+    .class_init = mst12_gop_class_init,
+};
+
+static void mst12_gop_register_types(void)
+{
+    type_register_static(&mst12_gop_type);
+}
+
+type_init(mst12_gop_register_types)
diff --git a/hw/display/mst12_mali.c b/hw/display/mst12_mali.c
new file mode 100644
index 0000000000000000000000000000000000000000..95bf41b12ead3d70c382fbf5de4187a7a2d61edf
--- /dev/null
+++ b/hw/display/mst12_mali.c
@@ -0,0 +1,1401 @@
+/*
+ * MStar Mali Utgard register, interrupt and memory-management model.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The original samsung_mali.ko supplies the MStar halfword adapter and
+ * resource map. ARM Utgard register semantics are cross-checked against
+ * Linux v6.12 drivers/gpu/drm/lima; provenance is recorded in NOTES.md.
+ * Functional geometry batches retain internal GP-to-PP state; the raw
+ * polygon-block encoding is not exposed as guessed records in guest RAM.
+ */
+
+#include "qemu/osdep.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "hw/display/mst12_mali.h"
+#include "hw/display/mst12_mali_shader.h"
+#include "hw/display/mst12_mali_render.h"
+#include "fpu/softfloat.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+
+#define MALI_CORE_COUNT        11
+#define MALI_REGISTER_COUNT   2048
+#define MALI_GP               0
+#define MALI_L2               1
+#define MALI_MMU              2
+#define MALI_PP               7
+#define MALI_APERTURE         0x20000
+#define R(core, reg)          (s->registers[core][(reg) / 4])
+
+#define GP_CMD                0x20
+#define GP_RAW                0x24
+#define GP_CLEAR              0x28
+#define GP_MASK               0x2c
+#define GP_IRQ                0x30
+#define GP_STATUS             0x68
+#define GP_VERSION            0x6c
+#define GP_RESET_DONE         (1u << 19)
+#define GP_BUS_ERROR          (1u << 11)
+#define GP_BUS_STOPPED        (1u << 12)
+
+#define PP_VERSION            0x1000
+#define PP_CURRENT_LIST       0x1004
+#define PP_STATUS             0x1008
+#define PP_CTRL               0x100c
+#define PP_RAW                0x1020
+#define PP_CLEAR              0x1024
+#define PP_MASK               0x1028
+#define PP_IRQ                0x102c
+#define PP_RESET_DONE         (1u << 12)
+#define PP_INVALID_LIST       (1u << 9)
+#define PP_BUS_ERROR          (1u << 4)
+
+#define MMU_DTE               0x00
+#define MMU_STATUS            0x04
+#define MMU_CMD               0x08
+#define MMU_FAULT_ADDRESS     0x0c
+#define MMU_RAW               0x14
+#define MMU_CLEAR             0x18
+#define MMU_MASK              0x1c
+#define MMU_IRQ               0x20
+#define MMU_PAGING            1
+#define MMU_FAULT             2
+#define MMU_STALL             4
+#define MMU_IDLE              8
+#define MMU_REPLAY_EMPTY       16
+#define MMU_FAULT_WRITE        32
+#define MMU_STALL_INACTIVE     (1u << 31)
+
+struct MST12MALIState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t registers[MALI_CORE_COUNT][MALI_REGISTER_COUNT];
+    uint32_t gp_pending;
+    bool pp_pending[4];
+    uint32_t pp_count;
+    uint32_t gp_version;
+    uint32_t pp_version;
+    uint32_t l2_size;
+    uint64_t miu_base;
+    bool trace_registers;
+    bool trace_jobs;
+    MALITileBatch tile_batches[MALI_TILE_BATCHES];
+    uint32_t next_batch;
+    uint64_t gp_setups;
+    uint64_t gp_commands;
+    uint64_t pp_tiles;
+    uint64_t pp_pixels;
+    uint64_t gp_vertices;
+    uint64_t gp_draws;
+};
+
+static const unsigned core_base[MALI_CORE_COUNT] = {
+    0, 0x2000, 0x6000, 0x8000, 0xa000, 0xc000, 0xe000,
+    0x10000, 0x14000, 0x18000, 0x1c000,
+};
+
+static bool mali_decode(MST12MALIState *s, hwaddr offset,
+                        unsigned *core, unsigned *reg, unsigned *shift)
+{
+    unsigned i;
+
+    for (i = 0; i < MALI_CORE_COUNT; i++) {
+        unsigned size = i >= MALI_PP ? 0x4000 : 0x2000;
+
+        if (i >= MALI_PP + s->pp_count) {
+            break;
+        }
+        if (offset >= core_base[i] && offset < core_base[i] + size) {
+            unsigned local = offset - core_base[i];
+
+            /* Adjacent 32-bit registers are 8 bytes apart; +2/+6 pad. */
+            if (local & 2) {
+                return false;
+            }
+            *core = i;
+            *reg = (local & ~7u) / 2;
+            *shift = (local & 4 ? 16 : 0) + (local & 1) * 8;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void mali_update_irq(MST12MALIState *s)
+{
+    unsigned i;
+    uint32_t pending = R(MALI_GP, GP_RAW) & R(MALI_GP, GP_MASK);
+
+    for (i = 0; i < 5; i++) {
+        pending |= R(MALI_MMU + i, MMU_RAW) & R(MALI_MMU + i, MMU_MASK);
+    }
+    for (i = 0; i < s->pp_count; i++) {
+        pending |= R(MALI_PP + i, PP_RAW) & R(MALI_PP + i, PP_MASK);
+    }
+    qemu_set_irq(s->irq, pending != 0);
+}
+
+static void mali_reset_core(MST12MALIState *s, unsigned core, bool soft)
+{
+    memset(s->registers[core], 0, sizeof(s->registers[core]));
+    if (core == MALI_GP) {
+        s->gp_pending = 0;
+        R(core, GP_RAW) = soft ? GP_RESET_DONE : 0;
+    } else if (core >= MALI_PP) {
+        s->pp_pending[core - MALI_PP] = false;
+        R(core, PP_RAW) = soft ? PP_RESET_DONE : 0;
+    } else if (core >= MALI_MMU) {
+        R(core, MMU_STATUS) = MMU_IDLE | MMU_REPLAY_EMPTY | MMU_STALL_INACTIVE;
+    }
+}
+
+static void mali_mmu_fault(MST12MALIState *s, unsigned mmu,
+                           uint32_t address, bool write, bool bus_error)
+{
+    if (!(R(mmu, MMU_STATUS) & MMU_FAULT)) {
+        R(mmu, MMU_FAULT_ADDRESS) = address;
+    }
+    R(mmu, MMU_STATUS) |= MMU_FAULT;
+    if (write) {
+        R(mmu, MMU_STATUS) |= MMU_FAULT_WRITE;
+    } else {
+        R(mmu, MMU_STATUS) &= ~MMU_FAULT_WRITE;
+    }
+    R(mmu, MMU_RAW) |= bus_error ? 2 : 1;
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 Mali MMU%u %s fault: va=0x%08x %s\n",
+                  mmu - MALI_MMU, bus_error ? "bus" : "page", address,
+                  write ? "write" : "read");
+}
+
+static bool mali_read_bus_word(MST12MALIState *s, uint32_t address,
+                               uint32_t *value)
+{
+    uint32_t word;
+
+    if (address_space_read(&address_space_memory, s->miu_base + address,
+                           MEMTXATTRS_UNSPECIFIED, &word, sizeof(word)) !=
+        MEMTX_OK) {
+        return false;
+    }
+    *value = le32_to_cpu(word);
+    return true;
+}
+
+static bool mali_translate(MST12MALIState *s, unsigned mmu, uint32_t address,
+                           bool write, hwaddr *physical)
+{
+    uint32_t dte, pte;
+
+    if (R(mmu, MMU_STATUS) & (MMU_STALL | MMU_FAULT)) {
+        return false;
+    }
+    if (!(R(mmu, MMU_STATUS) & MMU_PAGING)) {
+        *physical = s->miu_base + address;
+        return true;
+    }
+    if (!mali_read_bus_word(s, R(mmu, MMU_DTE) + (address >> 22) * 4,
+                            &dte)) {
+        mali_mmu_fault(s, mmu, address, write, true);
+        return false;
+    }
+    if (!(dte & 1)) {
+        mali_mmu_fault(s, mmu, address, write, false);
+        return false;
+    }
+    if (!mali_read_bus_word(s, (dte & ~0xfffu) +
+                            ((address >> 12) & 1023) * 4, &pte)) {
+        mali_mmu_fault(s, mmu, address, write, true);
+        return false;
+    }
+    if (!(pte & 1) || !(pte & (write ? 4 : 2))) {
+        mali_mmu_fault(s, mmu, address, write, false);
+        return false;
+    }
+    *physical = s->miu_base + (pte & ~0xfffu) + (address & 0xfff);
+    return true;
+}
+
+static bool mali_fetch_word(MST12MALIState *s, unsigned mmu,
+                            uint32_t address, uint32_t *value)
+{
+    hwaddr physical;
+    uint32_t word;
+
+    if (!mali_translate(s, mmu, address, false, &physical)) {
+        return false;
+    }
+    if (address_space_read(&address_space_memory, physical,
+                           MEMTXATTRS_UNSPECIFIED, &word, sizeof(word)) !=
+        MEMTX_OK) {
+        mali_mmu_fault(s, mmu, address, false, true);
+        return false;
+    }
+    *value = le32_to_cpu(word);
+    return true;
+}
+
+/* Debug reads are restricted to RAM and never change MMU fault/IRQ state. */
+static bool mali_debug_ram_word(hwaddr physical, uint32_t *word)
+{
+    hwaddr offset, length = sizeof(uint32_t);
+    MemoryRegion *region = address_space_translate(&address_space_memory,
+        physical, &offset, &length, false, MEMTXATTRS_UNSPECIFIED);
+
+    if (!memory_region_is_ram(region) || length < sizeof(uint32_t)) {
+        return false;
+    }
+    *word = ldl_le_p(memory_region_get_ram_ptr(region) + offset);
+    return true;
+}
+
+static bool mali_debug_translate(MST12MALIState *s, unsigned mmu,
+                                uint32_t address,
+                                hwaddr *physical)
+{
+    uint32_t dte, pte;
+
+    if (!(R(mmu, MMU_STATUS) & MMU_PAGING)) {
+        *physical = s->miu_base + address;
+        return true;
+    }
+    if (!mali_debug_ram_word(s->miu_base + R(mmu, MMU_DTE) +
+                            (address >> 22) * 4, &dte) || !(dte & 1) ||
+        !mali_debug_ram_word(s->miu_base + (dte & ~0xfffu) +
+                            ((address >> 12) & 1023) * 4, &pte) ||
+        (pte & 3) != 3) {
+        return false;
+    }
+    *physical = s->miu_base + (pte & ~0xfffu) + (address & 0xfff);
+    return true;
+}
+
+static void mali_trace_gp_list(MST12MALIState *s, unsigned pipeline,
+                              uint32_t start, uint32_t end)
+{
+    const char *name = pipeline ? "PLBU" : "VS";
+    uint32_t address = start;
+    unsigned count = 0;
+
+    if (!s->trace_jobs) {
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP,
+        "MST12 Mali GP %s capture: start=0x%08x end=0x%08x "
+        "dte=0x%08x mmu=0x%08x heap=0x%08x:0x%08x\n",
+        name, start, end, R(MALI_MMU, MMU_DTE), R(MALI_MMU, MMU_STATUS),
+        R(MALI_GP, 0x10), R(MALI_GP, 0x14));
+    while (end >= address && end - address >= 4 && count++ < 64) {
+        hwaddr physical;
+        uint32_t word;
+
+        if ((address & 3) ||
+            !mali_debug_translate(s, MALI_MMU, address, &physical) ||
+            !mali_debug_ram_word(physical, &word)) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali GP %s capture unavailable: va=0x%08x\n",
+                name, address);
+            return;
+        }
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali GP %s word: va=0x%08x phys=0x%" HWADDR_PRIx
+            " value=0x%08x\n", name, address, physical, word);
+        address += 4;
+    }
+    if (address != end) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali GP %s capture truncated: next=0x%08x\n",
+            name, address);
+    }
+}
+
+static bool mali_validate_ram(MST12MALIState *s, unsigned mmu,
+                              uint32_t address, uint32_t size, bool write)
+{
+    if ((uint64_t)address + size > (1ULL << 32)) {
+        return false;
+    }
+    while (size) {
+        hwaddr physical, offset, length;
+        MemoryRegion *region;
+
+        if (!mali_translate(s, mmu, address, write, &physical)) {
+            return false;
+        }
+        length = MIN(size, 4096 - (address & 4095));
+        region = address_space_translate(&address_space_memory, physical,
+                                         &offset, &length, write,
+                                         MEMTXATTRS_UNSPECIFIED);
+        if (!memory_region_is_ram(region) || !length) {
+            mali_mmu_fault(s, mmu, address, write, true);
+            return false;
+        }
+        address += length;
+        size -= length;
+    }
+    return true;
+}
+
+static bool mali_dma(MST12MALIState *s, unsigned mmu, uint32_t address,
+                     void *buffer, uint32_t size, bool write)
+{
+    uint8_t *data = buffer;
+
+    if ((uint64_t)address + size > (1ULL << 32)) {
+        return false;
+    }
+    while (size) {
+        hwaddr physical;
+        unsigned count = MIN(size, 4096 - (address & 4095));
+        MemTxResult result;
+
+        if (!mali_validate_ram(s, mmu, address, count, write) ||
+            !mali_translate(s, mmu, address, write, &physical)) {
+            return false;
+        }
+        result = write ?
+            address_space_write(&address_space_memory, physical,
+                                MEMTXATTRS_UNSPECIFIED, data, count) :
+            address_space_read(&address_space_memory, physical,
+                               MEMTXATTRS_UNSPECIFIED, data, count);
+        if (result != MEMTX_OK) {
+            mali_mmu_fault(s, mmu, address, write, true);
+            return false;
+        }
+        address += count;
+        data += count;
+        size -= count;
+    }
+    return true;
+}
+
+static float mali_float(uint32_t bits)
+{
+    float value;
+
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+static uint32_t mali_float_bits(float value)
+{
+    uint32_t bits;
+
+    memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+static float mali_half(uint16_t value)
+{
+    float_status status = { 0 };
+
+    return mali_float(float16_to_float32(value, true, &status));
+}
+
+static uint16_t mali_to_half(float value)
+{
+    float_status status = { .float_rounding_mode = float_round_nearest_even };
+
+    return float32_to_float16(mali_float_bits(value), true, &status);
+}
+
+static bool mali_load_attribute(MST12MALIState *s, uint32_t pointer,
+                                uint32_t descriptor, unsigned vertex,
+                                float value[4])
+{
+    unsigned format = (descriptor >> 2) & 0x1ff;
+    unsigned components = (descriptor & 3) + 1;
+    unsigned size = format == 0 || format == 1 || format == 2 ||
+                    format == 13 || format == 14 || format == 0x101 ? 4 :
+                    ((format >= 3 && format <= 5) ||
+                     format == 10 || format == 11) ? 2 : 1;
+    uint64_t address = (uint64_t)pointer + (descriptor >> 11) * vertex;
+    uint8_t data[16];
+    unsigned i;
+
+    if (address + components * size > (1ULL << 32) ||
+        !mali_dma(s, MALI_MMU, address, data, components * size, false)) {
+        return false;
+    }
+    value[0] = value[1] = value[2] = 0;
+    value[3] = 1;
+    for (i = 0; i < components; i++) {
+        switch (format) {
+        case 0:
+            value[i] = mali_float(ldl_le_p(data + i * 4));
+            break;
+        case 1:
+            value[i] = (int32_t)ldl_le_p(data + i * 4);
+            break;
+        case 2:
+            value[i] = ldl_le_p(data + i * 4);
+            break;
+        case 3:
+            value[i] = mali_half(lduw_le_p(data + i * 2));
+            break;
+        case 4:
+            value[i] = (int16_t)lduw_le_p(data + i * 2);
+            break;
+        case 5:
+            value[i] = lduw_le_p(data + i * 2);
+            break;
+        case 6:
+            value[i] = (int8_t)data[i];
+            break;
+        case 7:
+            value[i] = data[i];
+            break;
+        case 8:
+            value[i] = MAX(-1.0f, (int8_t)data[i] / 127.0f);
+            break;
+        case 9:
+            value[i] = data[i] / 255.0f;
+            break;
+        case 10:
+            value[i] = MAX(-1.0f,
+                            (int16_t)lduw_le_p(data + i * 2) / 32767.0f);
+            break;
+        case 11:
+            value[i] = lduw_le_p(data + i * 2) / 65535.0f;
+            break;
+        case 13:
+            value[i] = MAX(-1.0f,
+                            (int32_t)ldl_le_p(data + i * 4) / 2147483647.0f);
+            break;
+        case 14:
+            value[i] = ldl_le_p(data + i * 4) / 4294967295.0f;
+            break;
+        case 0x101:
+            value[i] = (int32_t)ldl_le_p(data + i * 4) / 65536.0f;
+            break;
+        default:
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool mali_execute_vs_draw(MST12MALIState *s, uint32_t shader,
+                                 uint32_t shader_size, uint32_t uniforms,
+                                 uint32_t uniform_size, uint32_t attributes,
+                                 unsigned attribute_count, uint32_t varyings,
+                                 unsigned varying_count, unsigned count)
+{
+    uint8_t code[MALI_GP_MAX_INSTRUCTIONS * 16];
+    uint32_t raw_uniforms[MALI_GP_MAX_UNIFORMS * 4];
+    float uniform_values[MALI_GP_MAX_UNIFORMS * 4];
+    uint32_t attribute_info[32], varying_info[32];
+    unsigned vertex, i;
+
+    if (!shader_size || shader_size % 16 ||
+        shader_size > sizeof(code) || uniform_size > sizeof(raw_uniforms) ||
+        uniform_size % 4 || !count || count > MALI_MAX_VERTICES ||
+        !attribute_count || attribute_count > MALI_SHADER_REGISTERS ||
+        !varying_count || varying_count > MALI_SHADER_REGISTERS ||
+        !mali_dma(s, MALI_MMU, shader, code, shader_size, false) ||
+        !mali_dma(s, MALI_MMU, uniforms, raw_uniforms, uniform_size, false) ||
+        !mali_dma(s, MALI_MMU, attributes, attribute_info,
+                   attribute_count * 8, false) ||
+        !mali_dma(s, MALI_MMU, varyings, varying_info,
+                   varying_count * 8, false)) {
+        return false;
+    }
+    for (i = 0; i < uniform_size / 4; i++) {
+        uniform_values[i] = mali_float(le32_to_cpu(raw_uniforms[i]));
+    }
+    for (vertex = 0; vertex < count; vertex++) {
+        float input[MALI_SHADER_REGISTERS][4] = { 0 };
+        MALIGPOutput output;
+        unsigned fault;
+
+        for (i = 0; i < attribute_count; i++) {
+            if (!mali_load_attribute(s, le32_to_cpu(attribute_info[i * 2]),
+                                     le32_to_cpu(attribute_info[i * 2 + 1]),
+                                     vertex, input[i])) {
+                return false;
+            }
+        }
+        if (!mst12_mali_gp_execute(code, shader_size / 16, input,
+                                    uniform_values, uniform_size / 4,
+                                    &output, &fault)) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali vertex shader unsupported: shader=0x%08x "
+                "vertex=%u instruction=%u\n", shader, vertex, fault);
+            return false;
+        }
+        if (s->trace_jobs && vertex == 0) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali VS inputs: shader=0x%08x uniforms=0x%08x "
+                "attributes=0x%08x varyings=0x%08x "
+                "a0=%g,%g,%g,%g a1=%g,%g,%g,%g\n",
+                shader, uniforms, attributes, varyings,
+                input[0][0], input[0][1], input[0][2], input[0][3],
+                input[1][0], input[1][1], input[1][2], input[1][3]);
+        }
+        for (i = 0; i < varying_count; i++) {
+            uint32_t descriptor = le32_to_cpu(varying_info[i * 2 + 1]);
+            uint64_t address = le32_to_cpu(varying_info[i * 2]) +
+                               (uint64_t)(descriptor >> 11) * vertex;
+            unsigned components = descriptor & 0x20 ?
+                                  (descriptor & 1 ? 1 : 4) :
+                                  (descriptor & 3) + 1;
+            unsigned size = (descriptor & 0xc) == 0xc ? 2 : 4;
+            unsigned component;
+
+            if (address + components * size > (1ULL << 32)) {
+                return false;
+            }
+            if (s->trace_jobs && vertex == 0) {
+                qemu_log_mask(LOG_UNIMP,
+                    "MST12 Mali VS output: varying=%u address=0x%08" PRIx64
+                    " descriptor=0x%08x components=%u size=%u mask=0x%x "
+                    "value=%g,%g,%g,%g\n",
+                    i, address, descriptor, components, size, output.mask[i],
+                    output.value[i][0], output.value[i][1],
+                    output.value[i][2], output.value[i][3]);
+            }
+            for (component = 0; component < components; component++) {
+                uint8_t data[4];
+
+                /* Preserve components that the shader did not store. */
+                if (!(output.mask[i] & (1u << component))) {
+                    continue;
+                }
+                if (size == 2) {
+                    stw_le_p(data, mali_to_half(output.value[i][component]));
+                } else {
+                    stl_le_p(data, mali_float_bits(output.value[i][component]));
+                }
+                if (!mali_dma(s, MALI_MMU, address + component * size,
+                               data, size, true)) {
+                    return false;
+                }
+            }
+        }
+        s->gp_vertices++;
+    }
+    if (s->trace_jobs) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali VS draw complete: shader=0x%08x "
+            "instructions=%u vertices=%u attributes=%u varyings=%u\n",
+            shader, shader_size / 16, count, attribute_count, varying_count);
+    }
+    return true;
+}
+
+static bool mali_execute_vs(MST12MALIState *s, uint32_t start, uint32_t end)
+{
+    uint32_t shader = 0, shader_size = 0, uniforms = 0, uniform_size = 0;
+    uint32_t attributes = 0, varyings = 0, address;
+    unsigned attribute_count = 0, varying_count = 0;
+
+    if ((start & 7) || (end & 7) || end < start ||
+        end - start > 256 * 1024) {
+        return false;
+    }
+    for (address = start; address < end; address += 8) {
+        uint32_t argument, command;
+
+        R(MALI_GP, 0x80) = address;
+        if (!mali_fetch_word(s, MALI_MMU, address, &argument) ||
+            !mali_fetch_word(s, MALI_MMU, address + 4, &command)) {
+            return false;
+        }
+        if ((command & 0xf0000000) == 0x40000000) {
+            shader = argument;
+            shader_size = (command & 0x0ffff000) >> 12;
+        } else if ((command & 0xf0000000) == 0x30000000) {
+            uniforms = argument;
+            uniform_size = (command & 0x0ffff000) >> 12;
+        } else if ((command & 0xf0000000) == 0x20000000) {
+            if (command & 8) {
+                varyings = argument;
+            } else {
+                attributes = argument;
+            }
+        } else if (command == 0x10000042) {
+            attribute_count = (argument >> 24) + 1;
+            varying_count = ((argument >> 8) & 255) + 1;
+        } else if ((command & 0xffff0000) == 0) {
+            unsigned count = (argument >> 24) | ((command & 65535) << 8);
+
+            if (!mali_execute_vs_draw(s, shader, shader_size, uniforms,
+                                      uniform_size, attributes,
+                                      attribute_count, varyings,
+                                      varying_count, count)) {
+                return false;
+            }
+        } else if (command != 0x10000040 && command != 0x10000041 &&
+                   command != 0x50000000 && command != 0x60000000) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali VS command unsupported: va=0x%08x "
+                "argument=0x%08x command=0x%08x\n", address, argument, command);
+            return false;
+        }
+    }
+    R(MALI_GP, 0x80) = end;
+    return true;
+}
+
+static bool mali_execute_plbu(MST12MALIState *s, uint32_t start,
+                              uint32_t end)
+{
+    MALITileBatch batch = { 0 };
+    uint32_t address, seen = 0, array = 0, heap_start = 0, heap_end = 0;
+    bool ended = false;
+    MALIDraw draw = { 0 };
+    unsigned i;
+
+    batch.directory = R(MALI_MMU, MMU_DTE);
+    batch.paging = R(MALI_MMU, MMU_STATUS) & MMU_PAGING;
+
+    if ((start & 7) || (end & 7) || end < start ||
+        end - start > 256 * 1024) {
+        return false;
+    }
+    for (address = start; address < end; address += 8) {
+        uint32_t argument, command;
+
+        R(MALI_GP, 0x84) = address;
+        if (!mali_fetch_word(s, MALI_MMU, address, &argument) ||
+            !mali_fetch_word(s, MALI_MMU, address + 4, &command)) {
+            return false;
+        }
+        s->gp_commands++;
+        if ((command & 0xf0000000) == 0x80000000) {
+            draw.render_state = argument;
+            draw.positions = (command & 0x0fffffff) << 4;
+            continue;
+        }
+        if ((command & 0xf0000000) == 0x70000000) {
+            draw.clip[0] = ((command & 8191) << 2) | (argument >> 30);
+            draw.clip[1] = argument & 32767;
+            draw.clip[2] = ((command >> 13) & 32767) + 1;
+            draw.clip[3] = ((argument >> 15) & 32767) + 1;
+            continue;
+        }
+        if ((command & 0xffc00000) == 0) {
+            draw.first = argument & 0xffffff;
+            draw.count = (argument >> 24) | ((command & 65535) << 8);
+            draw.mode = (command >> 16) & 31;
+            if (draw.mode < 4 || draw.mode > 6 ||
+                !draw.count || draw.count > MALI_MAX_VERTICES ||
+                !draw.positions || !draw.render_state ||
+                batch.draw_count >= MALI_MAX_DRAWS) {
+                return false;
+            }
+            if (!(command & 0x200000)) {
+                draw.index_size = 0;
+            }
+            batch.draws[batch.draw_count++] = draw;
+            continue;
+        }
+        if ((command & ~0x1ffu) == 0x28000000) {
+            array = argument;
+            batch.array = array;
+            batch.count = (command & 0x1ff) + 1;
+            seen |= 16;
+            for (i = 0; i < MALI_TILE_BATCHES; i++) {
+                MALITileBatch *old = &s->tile_batches[i];
+
+                if (old->directory == batch.directory &&
+                    old->paging == batch.paging && old->array == array) {
+                    old->valid = false;
+                }
+            }
+            continue;
+        }
+        switch (command) {
+        case 0x1000010b:
+            /* The observed empty batch uses 512-byte polygon blocks. */
+            if (!(seen & 1) && argument != 0x200) {
+                return false;
+            }
+            seen |= 1;
+            draw.index_size = 1u << ((argument >> 10) & 3);
+            if (draw.index_size > 4) {
+                return false;
+            }
+            draw.cull = (argument >> 17) & 3;
+            break;
+        case 0x1000010c:
+            batch.shift_x = argument & 0xffff;
+            batch.shift_y = (argument >> 16) & 0xfff;
+            seen |= 2;
+            break;
+        case 0x10000109:
+            batch.tiles_x = (argument >> 24) + 1;
+            batch.tiles_y = ((argument >> 8) & 0xffff) + 1;
+            seen |= 4;
+            break;
+        case 0x30000000:
+            batch.stride = argument;
+            seen |= 8;
+            break;
+        case 0x10000105:
+        case 0x10000106:
+        case 0x10000107:
+        case 0x10000108:
+            seen |= 32u << (command - 0x10000105);
+            if (!isfinite(mali_float(argument)) || mali_float(argument) < 0 ||
+                mali_float(argument) > 16384) {
+                return false;
+            }
+            if (!batch.draw_count) {
+                unsigned component = command == 0x10000107 ? 0 :
+                                     command == 0x10000105 ? 1 :
+                                     command == 0x10000108 ? 2 : 3;
+
+                draw.clip[component] = mali_float(argument);
+            }
+            break;
+        case 0x10000100:
+            draw.positions = argument;
+            break;
+        case 0x10000101:
+            draw.indices = argument;
+            break;
+        case 0x1000010a:
+        case 0x1000010e:
+        case 0x1000010f:
+        case 0x60000000:
+            break;
+        case 0x10000103:
+            heap_start = argument;
+            seen |= 512;
+            break;
+        case 0x10000104:
+            heap_end = argument;
+            seen |= 1024;
+            break;
+        case 0x50000000:
+            if (argument || address + 8 != end) {
+                return false;
+            }
+            ended = true;
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali PLBU command unsupported: va=0x%08x "
+                "argument=0x%08x command=0x%08x\n",
+                address, argument, command);
+            return false;
+        }
+    }
+    if (!ended || seen != 2047 || batch.shift_x > 8 || batch.shift_y > 8 ||
+        batch.tiles_y > 256 || (array & 3) || heap_end < heap_start) {
+        return false;
+    }
+    {
+        unsigned columns = (batch.tiles_x + (1u << batch.shift_x) - 1) >>
+                           batch.shift_x;
+        unsigned rows = (batch.tiles_y + (1u << batch.shift_y) - 1) >>
+                        batch.shift_y;
+        unsigned blocks = columns * rows;
+
+        /* Mali-400 can round the pointer-array capacity up to an even count. */
+        if (columns != batch.stride || batch.count < blocks ||
+            batch.count > blocks + (blocks & 1)) {
+            return false;
+        }
+    }
+    if ((uint64_t)array + batch.count * 4 > (1ULL << 32) ||
+        !mali_validate_ram(s, MALI_MMU, heap_start,
+                           heap_end - heap_start, true)) {
+        return false;
+    }
+    for (i = 0; i < batch.count; i++) {
+        if (!mali_fetch_word(s, MALI_MMU, array + i * 4, &batch.blocks[i]) ||
+            (batch.blocks[i] & 31) ||
+            !mali_validate_ram(s, MALI_MMU, batch.blocks[i], 512, true)) {
+            return false;
+        }
+    }
+    /*
+     * Preserve geometry batches for the functional PP consumer. Their
+     * undocumented raw GP output encoding is not substituted with guessed
+     * RAM records. Unsupported geometry never creates a completed batch.
+     */
+    batch.valid = true;
+    s->tile_batches[s->next_batch++ % MALI_TILE_BATCHES] = batch;
+    s->gp_setups++;
+    s->gp_draws += batch.draw_count;
+    R(MALI_GP, 0x84) = end;
+    qemu_log_mask(LOG_UNIMP,
+        "MST12 Mali PLBU batch complete: dte=0x%08x "
+        "tiles=%ux%u blocks=%u first=0x%08x last=0x%08x draws=%u\n",
+        batch.directory, batch.tiles_x, batch.tiles_y, batch.count,
+        batch.blocks[0], batch.blocks[batch.count - 1], batch.draw_count);
+    return true;
+}
+
+static void mali_trace_pp_words(MST12MALIState *s, unsigned mmu,
+                                unsigned pp, const char *name,
+                                uint32_t address, unsigned count)
+{
+    unsigned i;
+
+    for (i = 0; i < count; i++) {
+        hwaddr physical;
+        uint32_t word;
+
+        if ((address & 3) ||
+            !mali_debug_translate(s, mmu, address, &physical) ||
+            !mali_debug_ram_word(physical, &word)) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali PP%u %s unavailable: va=0x%08x\n",
+                pp, name, address);
+            return;
+        }
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali PP%u %s word: va=0x%08x phys=0x%" HWADDR_PRIx
+            " value=0x%08x\n", pp, name, address, physical, word);
+        address += 4;
+    }
+}
+
+static void mali_trace_pp_job(MST12MALIState *s, unsigned index)
+{
+    unsigned pp = MALI_PP + index, mmu = MALI_MMU + index + 1;
+    unsigned reg;
+    hwaddr physical;
+    uint32_t shader;
+
+    if (!s->trace_jobs) {
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP,
+        "MST12 Mali PP%u capture: list=0x%08x rsw=0x%08x "
+        "dte=0x%08x mmu=0x%08x\n", index, R(pp, 0), R(pp, 4),
+        R(mmu, MMU_DTE), R(mmu, MMU_STATUS));
+    for (reg = 0; reg < 24; reg++) {
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali PP%u frame: reg=0x%04x value=0x%08x\n",
+            index, reg * 4, R(pp, reg * 4));
+    }
+    for (reg = 0x100; reg < 0x330; reg += 4) {
+        if ((reg & 255) < 48) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali PP%u wb: reg=0x%04x value=0x%08x\n",
+                index, reg, R(pp, reg));
+        }
+    }
+    mali_trace_pp_words(s, mmu, index, "PLB", R(pp, 0), 64);
+    mali_trace_pp_words(s, mmu, index, "RSW", R(pp, 4), 16);
+    if (mali_debug_translate(s, mmu, R(pp, 4) + 0x24, &physical) &&
+        mali_debug_ram_word(physical, &shader)) {
+        mali_trace_pp_words(s, mmu, index, "shader", shader & ~31u, 64);
+    }
+}
+
+static void mali_run_gp(MST12MALIState *s)
+{
+    unsigned pipeline;
+
+    for (pipeline = 0; pipeline < 2; pipeline++) {
+        uint32_t bit = 1u << pipeline;
+        uint32_t start = R(MALI_GP, pipeline * 8);
+        uint32_t end = R(MALI_GP, pipeline * 8 + 4);
+        uint32_t word;
+
+        if (!(s->gp_pending & bit) ||
+            (R(MALI_MMU, MMU_STATUS) & (MMU_STALL | MMU_FAULT))) {
+            continue;
+        }
+        if (start == end) {
+            /* A genuinely empty command list performs no rendering or DMA. */
+            R(MALI_GP, GP_RAW) |= bit;
+        } else {
+            R(MALI_GP, 0x80 + pipeline * 4) = start;
+            if (!mali_fetch_word(s, MALI_MMU, start, &word)) {
+                continue;
+            }
+            mali_trace_gp_list(s, pipeline, start, end);
+            if (pipeline ? mali_execute_plbu(s, start, end) :
+                           mali_execute_vs(s, start, end)) {
+                R(MALI_GP, GP_RAW) |= bit;
+                s->gp_pending &= ~bit;
+                continue;
+            }
+            if (R(MALI_MMU, MMU_STATUS) & MMU_FAULT) {
+                continue;
+            }
+            qemu_log_mask(LOG_UNIMP,
+                          "MST12 Mali %s list unsupported: addr=0x%08x "
+                          "word=0x%08x end=0x%08x\n",
+                          pipeline ? "PLBU" : "VS", start, word, end);
+            R(MALI_GP, GP_RAW) |= 1u << (pipeline ? 14 : 13);
+        }
+        s->gp_pending &= ~bit;
+    }
+    R(MALI_GP, GP_STATUS) &= ~0xa;
+    R(MALI_GP, GP_STATUS) |= (s->gp_pending & 1 ? 2 : 0) |
+                              (s->gp_pending & 2 ? 8 : 0);
+}
+
+typedef struct MALIPPAccess {
+    MST12MALIState *state;
+    unsigned mmu;
+} MALIPPAccess;
+
+static bool mali_pp_read(void *opaque, uint32_t address, void *data,
+                          uint32_t size)
+{
+    MALIPPAccess *access = opaque;
+
+    return mali_dma(access->state, access->mmu, address, data, size, false);
+}
+
+static bool mali_pp_write(void *opaque, uint32_t address, const void *data,
+                           uint32_t size)
+{
+    MALIPPAccess *access = opaque;
+
+    return mali_dma(access->state, access->mmu, address, (void *)data,
+                    size, true);
+}
+
+static bool mali_pp_validate(void *opaque, uint32_t address, uint32_t size,
+                              bool write)
+{
+    MALIPPAccess *access = opaque;
+
+    return mali_validate_ram(access->state, access->mmu, address, size, write);
+}
+
+static void mali_run_pp(MST12MALIState *s, unsigned index)
+{
+    unsigned pp = MALI_PP + index;
+    unsigned mmu = MALI_MMU + index + 1;
+    uint32_t list = R(pp, 0);
+    uint32_t frame[24], writeback[3][12];
+    MALIPPAccess access = { .state = s, .mmu = mmu };
+    MALIRenderIO io = {
+        .opaque = &access,
+        .trace = s->trace_jobs,
+        .read = mali_pp_read,
+        .write = mali_pp_write,
+        .validate = mali_pp_validate,
+    };
+    MALIRenderResult result;
+    unsigned i, j;
+
+    if (!s->pp_pending[index] ||
+        (R(mmu, MMU_STATUS) & (MMU_STALL | MMU_FAULT))) {
+        return;
+    }
+    R(pp, PP_CURRENT_LIST) = list;
+    mali_trace_pp_job(s, index);
+    memcpy(frame, s->registers[pp], sizeof(frame));
+    for (i = 0; i < 3; i++) {
+        for (j = 0; j < 12; j++) {
+            writeback[i][j] = R(pp, 0x100 + i * 0x100 + j * 4);
+        }
+    }
+    if (mst12_mali_pp_render(s->tile_batches, s->next_batch,
+                              R(mmu, MMU_DTE), R(mmu, MMU_STATUS) & MMU_PAGING,
+                              frame, writeback, &io, &result)) {
+        s->pp_tiles += result.tiles;
+        s->pp_pixels += result.pixels;
+        R(pp, PP_CURRENT_LIST) = result.list;
+        R(pp, PP_RAW) |= 1;
+        if (s->trace_jobs) {
+            qemu_log_mask(LOG_UNIMP,
+                "MST12 Mali PP%u render complete: list=0x%08x "
+                "tiles=%u pixels=%" PRIu64 " triangles=%u "
+                "fragments=%" PRIu64 " colored=%" PRIu64 "\n",
+                index, list, result.tiles, result.pixels, result.triangles,
+                result.fragments, result.colored_pixels);
+        }
+    } else {
+        R(pp, PP_CURRENT_LIST) = result.list;
+        if (R(mmu, MMU_STATUS) & MMU_FAULT) {
+            return;
+        }
+        qemu_log_mask(LOG_UNIMP,
+            "MST12 Mali PP%u render list unsupported: addr=0x%08x "
+            "next=0x%08x completed-tiles=%u\n",
+            index, list, result.list, result.tiles);
+        R(pp, PP_RAW) |= PP_INVALID_LIST;
+    }
+    R(pp, PP_STATUS) &= ~1;
+    s->pp_pending[index] = false;
+}
+
+static void mali_mmu_command(MST12MALIState *s, unsigned core, uint32_t value)
+{
+    switch (value) {
+    case 0:
+        R(core, MMU_STATUS) |= MMU_PAGING;
+        break;
+    case 1:
+        R(core, MMU_STATUS) &= ~MMU_PAGING;
+        break;
+    case 2:
+        R(core, MMU_STATUS) |= MMU_STALL;
+        R(core, MMU_STATUS) &= ~MMU_STALL_INACTIVE;
+        break;
+    case 3:
+        R(core, MMU_STATUS) &= ~MMU_STALL;
+        R(core, MMU_STATUS) |= MMU_STALL_INACTIVE;
+        break;
+    case 4: /* Page walks are uncached; the TLB is already coherent. */
+        break;
+    case 5:
+        R(core, MMU_STATUS) &= ~(MMU_FAULT | MMU_FAULT_WRITE);
+        break;
+    case 6:
+        mali_reset_core(s, core, false);
+        return;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "MST12 Mali invalid MMU command %u\n",
+                      value);
+        return;
+    }
+    if (value == 3 || value == 5) {
+        if (core == MALI_MMU) {
+            mali_run_gp(s);
+        } else {
+            mali_run_pp(s, core - MALI_MMU - 1);
+        }
+    }
+}
+
+static uint32_t mali_get_register(MST12MALIState *s, unsigned core,
+                                  unsigned reg)
+{
+    if (core == MALI_GP) {
+        if (reg == GP_VERSION) {
+            return s->gp_version;
+        }
+        if (reg == GP_IRQ) {
+            return R(core, GP_RAW) & R(core, GP_MASK);
+        }
+    } else if (core == MALI_L2) {
+        if (reg == 4) {
+            return s->l2_size;
+        }
+        if (reg == 8 || reg == 0x10 || reg == 0x14) {
+            return 0; /* Coherent synchronous cache operations are complete. */
+        }
+    } else if (core >= MALI_PP) {
+        if (reg == PP_VERSION) {
+            return s->pp_version;
+        }
+        if (reg == PP_IRQ) {
+            return R(core, PP_RAW) & R(core, PP_MASK);
+        }
+    } else if (reg == MMU_IRQ) {
+        return R(core, MMU_RAW) & R(core, MMU_MASK);
+    }
+    return R(core, reg);
+}
+
+static void mali_set_register(MST12MALIState *s, unsigned core, unsigned reg,
+                              uint32_t bits, uint32_t mask, unsigned shift)
+{
+    unsigned raw = core == MALI_GP ? GP_RAW :
+                   core >= MALI_PP ? PP_RAW : MMU_RAW;
+    unsigned clear = core == MALI_GP ? GP_CLEAR :
+                     core >= MALI_PP ? PP_CLEAR : MMU_CLEAR;
+    unsigned irq = core == MALI_GP ? GP_IRQ :
+                   core >= MALI_PP ? PP_IRQ : MMU_IRQ;
+    unsigned status = core == MALI_GP ? GP_STATUS :
+                      core >= MALI_PP ? PP_STATUS : MMU_STATUS;
+
+    if (core != MALI_L2) {
+        if (reg == raw) {
+            R(core, raw) |= bits;
+            return;
+        }
+        if (reg == clear) {
+            R(core, raw) &= ~bits;
+            return;
+        }
+        if (reg == irq || reg == status) {
+            return;
+        }
+    }
+    if (core == MALI_GP && reg == GP_CMD) {
+        if (bits & ((1u << 5) | (1u << 10))) {
+            mali_reset_core(s, core, bits & (1u << 10));
+            return;
+        }
+        if (bits & (1u << 9)) {
+            s->gp_pending = 0;
+            R(core, GP_STATUS) = 4;
+            R(core, GP_RAW) |= GP_BUS_STOPPED;
+        }
+        if (bits & (1u << 6)) {
+            R(core, GP_RAW) |= 1u << 6;
+        }
+        s->gp_pending |= bits & 3;
+        mali_run_gp(s);
+        return;
+    }
+    if (core >= MALI_PP && reg == PP_CTRL) {
+        unsigned index = core - MALI_PP;
+
+        if (bits & ((1u << 5) | (1u << 7))) {
+            mali_reset_core(s, core, bits & (1u << 7));
+            return;
+        }
+        if (bits & 1) {
+            s->pp_pending[index] = false;
+            R(core, PP_STATUS) = 0x10;
+            R(core, PP_RAW) |= 0x20;
+        }
+        if (bits & (1u << 6)) {
+            s->pp_pending[index] = true;
+            R(core, PP_STATUS) |= 1;
+            mali_run_pp(s, index);
+        }
+        return;
+    }
+    if (core >= MALI_MMU && core < MALI_PP && reg == MMU_CMD) {
+        /*
+         * Commands fit in the low byte; the following high-half write is
+         * padding for this purpose, not another ENABLE_PAGING command.
+         */
+        if (shift == 0) {
+            mali_mmu_command(s, core, bits);
+        }
+        return;
+    }
+    if ((core == MALI_GP && reg == GP_VERSION) ||
+        (core >= MALI_PP && reg == PP_VERSION) ||
+        (core == MALI_L2 && (reg == 4 || reg == 8))) {
+        return;
+    }
+    R(core, reg) = (R(core, reg) & ~mask) | bits;
+    if (core >= MALI_MMU && core < MALI_PP && reg == MMU_DTE) {
+        R(core, reg) &= ~0xfff;
+    }
+}
+
+static uint64_t mst12_mali_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12MALIState *s = opaque;
+    unsigned core, reg, shift;
+    uint32_t value;
+
+    if (!mali_decode(s, offset, &core, &reg, &shift)) {
+        return 0;
+    }
+    value = mali_get_register(s, core, reg);
+    if (s->trace_registers) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 Mali read: core=%u reg=0x%x value=0x%08x\n",
+                      core, reg, value);
+    }
+    return (value >> shift) & (size == 1 ? 0xff : 0xffff);
+}
+
+static void mst12_mali_write(void *opaque, hwaddr offset, uint64_t value,
+                             unsigned size)
+{
+    MST12MALIState *s = opaque;
+    unsigned core, reg, shift;
+    uint32_t mask, bits;
+
+    if (!mali_decode(s, offset, &core, &reg, &shift)) {
+        return;
+    }
+    mask = (size == 1 ? 0xffu : 0xffffu) << shift;
+    bits = (value << shift) & mask;
+    if (s->trace_registers) {
+        qemu_log_mask(LOG_UNIMP,
+                      "MST12 Mali write: core=%u reg=0x%x bits=0x%08x\n",
+                      core, reg, bits);
+    }
+    mali_set_register(s, core, reg, bits, mask, shift);
+    mali_update_irq(s);
+}
+
+static const MemoryRegionOps mst12_mali_ops = {
+    .read = mst12_mali_read,
+    .write = mst12_mali_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+static void mst12_mali_reset(DeviceState *dev)
+{
+    MST12MALIState *s = MST12_MALI(dev);
+    unsigned core;
+
+    for (core = 0; core < MALI_CORE_COUNT; core++) {
+        mali_reset_core(s, core, false);
+    }
+    memset(s->tile_batches, 0, sizeof(s->tile_batches));
+    s->next_batch = 0;
+    s->gp_setups = s->gp_commands = s->pp_tiles = s->pp_pixels = 0;
+    s->gp_vertices = s->gp_draws = 0;
+    mali_update_irq(s);
+}
+
+static void mst12_mali_realize(DeviceState *dev, Error **errp)
+{
+    MST12MALIState *s = MST12_MALI(dev);
+
+    if (s->pp_count < 1 || s->pp_count > 4) {
+        error_setg(errp, "MStar Mali pp-count must be from 1 to 4");
+    }
+}
+
+static int mst12_mali_post_load(void *opaque, int version)
+{
+    MST12MALIState *s = opaque;
+    unsigned i;
+
+    for (i = 0; i < MALI_TILE_BATCHES; i++) {
+        MALITileBatch *batch = &s->tile_batches[i];
+
+        if (batch->valid && (!batch->count || batch->count > MALI_MAX_BLOCKS ||
+            !batch->tiles_x || batch->tiles_x > 256 || !batch->tiles_y ||
+            batch->tiles_y > 256 || batch->shift_x > 8 || batch->shift_y > 8 ||
+            !batch->stride || (batch->directory & 4095) ||
+            batch->draw_count > MALI_MAX_DRAWS)) {
+            return -EINVAL;
+        }
+    }
+    mali_update_irq(s);
+    return 0;
+}
+
+static const VMStateDescription vmstate_mali_draw = {
+    .name = "mst12-mali/draw",
