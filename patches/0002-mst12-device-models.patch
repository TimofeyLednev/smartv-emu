index 0000000000000000000000000000000000000000..74806cdcef0fabfcc48cc79963ef78034bacab11
--- /dev/null
+++ b/hw/net/mst12_emac.c
@@ -0,0 +1,775 @@
+/*
+ * Samsung MST12 100 Mbit Ethernet MAC and directly accessible PHY.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * T-MST12DEUC 1112.2 mdrv-emac.ko supplies the split RIU register layout,
+ * MIU0 address bias, TAR/TCR transmit path and eight-byte receive descriptors.
+ * The MAC derives from the Cadence/AT91RM9200 EMAC, rather than the newer GEM.
+ * PHY identity, negotiation latency and JULIAN receive-interrupt timing are
+ * emulator defaults. No physical motherboard or PHY firmware was available.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/irq.h"
+#include "hw/net/mst12_emac.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "net/net.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "system/address-spaces.h"
+#include "system/dma.h"
+
+#define EMAC_REGS       256
+#define EMAC_FIFO       4
+#define EMAC_MAX_FRAME  1536
+#define EMAC_MIU0_BASE  0x40000000ULL
+
+#define REG_CTL        (0x00 / 4)
+#define REG_CFG        (0x04 / 4)
+#define REG_SR         (0x08 / 4)
+#define REG_TAR        (0x0c / 4)
+#define REG_TCR        (0x10 / 4)
+#define REG_TSR        (0x14 / 4)
+#define REG_RBQP       (0x18 / 4)
+#define REG_RSR        (0x20 / 4)
+#define REG_ISR        (0x24 / 4)
+#define REG_IER        (0x28 / 4)
+#define REG_IDR        (0x2c / 4)
+#define REG_IMR        (0x30 / 4)
+#define REG_MAN        (0x34 / 4)
+#define REG_FRA        (0x40 / 4)
+#define REG_OK         (0x50 / 4)
+#define REG_HSL        (0x90 / 4)
+#define REG_HSH        (0x94 / 4)
+#define REG_SA1L       (0x98 / 4)
+#define REG_J100       (0x100 / 4)
+#define REG_J104       (0x104 / 4)
+#define REG_J108       (0x108 / 4)
+
+#define CTL_LB         (1u << 1)
+#define CTL_RE         (1u << 2)
+#define CTL_TE         (1u << 3)
+#define CTL_CLEAR      (1u << 5)
+#define CFG_CAF        (1u << 4)
+#define CFG_NBC        (1u << 5)
+#define CFG_MTI        (1u << 6)
+#define CFG_UNI        (1u << 7)
+#define INT_DONE       (1u << 0)
+#define INT_RCOM       (1u << 1)
+#define INT_RBNA       (1u << 2)
+#define INT_TOVR       (1u << 3)
+#define INT_TCOM       (1u << 7)
+#define INT_LINK       (1u << 9)
+#define INT_ROVR       (1u << 10)
+#define INT_HRESP      (1u << 11)
+#define DESC_DONE      1u
+#define DESC_WRAP      2u
+
+enum {
+    EMAC_FAULT_NONE,
+    EMAC_FAULT_TX_LENGTH,
+    EMAC_FAULT_TX_DMA,
+    EMAC_FAULT_RX_DESCRIPTOR,
+    EMAC_FAULT_RX_DMA,
+    EMAC_FAULT_RX_MODE,
+};
+
+struct MST12EmacState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    MemoryRegion phy_mmio;
+    NICState *nic;
+    NICConf conf;
+    qemu_irq irq;
+    QEMUTimer *tx_timer;
+    QEMUTimer *phy_timer;
+    uint32_t regs[EMAC_REGS];
+    uint16_t phy[32];
+    uint32_t tx_address[EMAC_FIFO];
+    uint32_t tx_length[EMAC_FIFO];
+    uint32_t tx_head;
+    uint32_t tx_depth;
+    uint32_t rx_index;
+    uint32_t rx_pending;
+    uint32_t read_latch;
+    uint32_t latch_register;
+    uint32_t phy_id;
+    uint32_t fault;
+    uint64_t fault_address;
+    uint64_t tx_packets;
+    uint64_t rx_packets;
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t rx_dropped;
+    uint64_t tx_overflows;
+    uint64_t dma_faults;
+    uint64_t phy_reads;
+    uint64_t register_reads;
+    uint64_t register_writes;
+    bool phy_ready;
+    bool link_latched_low;
+    bool trace;
+};
+
+static bool emac_link(MST12EmacState *s)
+{
+    NetClientState *nc = qemu_get_queue(s->nic);
+
+    return s->phy_ready && !(s->phy[0] & 0x0c00) &&
+           ((s->regs[REG_CTL] & CTL_LB) || (s->phy[0] & 0x4000) ||
+            (nc->peer && !nc->link_down && !nc->peer->link_down));
+}
+
+static void emac_irq(MST12EmacState *s)
+{
+    bool receive = s->rx_pending && (s->regs[REG_CTL] & CTL_RE) &&
+                   (s->regs[REG_J104] & 0x80);
+
+    /* The Samsung driver masks legacy RCOM and reads JULIAN's packet count. */
+    qemu_set_irq(s->irq, receive ||
+                 (s->regs[REG_ISR] & ~s->regs[REG_IMR]));
+}
+
+static void emac_dma_fault(MST12EmacState *s, uint32_t fault, hwaddr address)
+{
+    s->fault = fault;
+    s->fault_address = address;
+    s->dma_faults++;
+    s->regs[REG_ISR] |= INT_HRESP;
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "MST12 EMAC DMA fault %u at 0x%" HWADDR_PRIx "\n",
+                  fault, address);
+    emac_irq(s);
+}
+
+static bool emac_ram(hwaddr address, size_t size)
+{
+    MemoryRegionSection section;
+    bool valid;
+
+    if (address + size < address || address + size > (1ULL << 32)) {
+        return false;
+    }
+    section = memory_region_find(get_system_memory(), address, size);
+    valid = section.mr && memory_region_is_ram(section.mr) &&
+            !memory_region_is_rom(section.mr) &&
+            int128_ge(section.size, int128_make64(size));
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static bool emac_dma_read(hwaddr address, void *data, size_t size)
+{
+    return emac_ram(address, size) &&
+           address_space_read(&address_space_memory, address,
+                              MEMTXATTRS_UNSPECIFIED, data, size) == MEMTX_OK;
+}
+
+static bool emac_dma_write(hwaddr address, const void *data, size_t size)
+{
+    return emac_ram(address, size) &&
+           address_space_write(&address_space_memory, address,
+                               MEMTXATTRS_UNSPECIFIED, data, size) == MEMTX_OK;
+}
+
+static unsigned emac_hash(const uint8_t *mac)
+{
+    unsigned result = 0, bit;
+
+    for (bit = 0; bit < 48; bit++) {
+        result ^= ((mac[bit / 8] >> (bit % 8)) & 1) << (bit % 6);
+    }
+    return result;
+}
+
+static bool emac_accept(MST12EmacState *s, const uint8_t *data, size_t size)
+{
+    unsigned i, hash;
+
+    if (size < 14) {
+        return false;
+    }
+    if (s->regs[REG_CFG] & CFG_CAF) {
+        return true;
+    }
+    if (!memcmp(data, "\xff\xff\xff\xff\xff\xff", 6)) {
+        return !(s->regs[REG_CFG] & CFG_NBC);
+    }
+    for (i = 0; i < 4; i++) {
+        uint8_t mac[6];
+
+        stl_le_p(mac, s->regs[REG_SA1L + 2 * i]);
+        stw_le_p(mac + 4, s->regs[REG_SA1L + 2 * i + 1]);
+        if (!memcmp(data, mac, 6)) {
+            return true;
+        }
+    }
+    if (!(s->regs[REG_CFG] & ((data[0] & 1) ? CFG_MTI : CFG_UNI))) {
+        return false;
+    }
+    hash = emac_hash(data);
+    return s->regs[hash < 32 ? REG_HSL : REG_HSH] & (1u << (hash % 32));
+}
+
+static ssize_t emac_receive(NetClientState *nc, const uint8_t *data,
+                            size_t size)
+{
+    MST12EmacState *s = qemu_get_nic_opaque(nc);
+    uint8_t descriptor[8];
+    uint32_t address, status;
+    hwaddr pointer, buffer;
+
+    if (!(s->regs[REG_CTL] & CTL_RE) || !emac_link(s)) {
+        return 0;
+    }
+    if (!emac_accept(s, data, size)) {
+        s->rx_dropped++;
+        return size;
+    }
+    if (size > EMAC_MAX_FRAME || !(s->regs[REG_J104] & 1)) {
+        s->fault = EMAC_FAULT_RX_MODE;
+        s->rx_dropped++;
+        s->regs[REG_RSR] |= 4;
+        s->regs[REG_ISR] |= INT_ROVR;
+        emac_irq(s);
+        return size;
+    }
+    pointer = EMAC_MIU0_BASE + (s->regs[REG_RBQP] & ~3u) +
+              s->rx_index * 8;
+    if (!emac_dma_read(pointer, descriptor, sizeof(descriptor))) {
+        emac_dma_fault(s, EMAC_FAULT_RX_DESCRIPTOR, pointer);
+        s->rx_dropped++;
+        return size;
+    }
+    address = ldl_le_p(descriptor);
+    if (address & DESC_DONE) {
+        s->rx_dropped++;
+        s->regs[REG_RSR] |= 8;
+        s->regs[REG_ISR] |= INT_RBNA;
+        emac_irq(s);
+        return size;
+    }
+    buffer = EMAC_MIU0_BASE + (address & ~3u);
+    if (!emac_dma_write(buffer, data, size)) {
+        emac_dma_fault(s, EMAC_FAULT_RX_DMA, buffer);
+        s->rx_dropped++;
+        return size;
+    }
+    status = size;
+    if (!memcmp(data, "\xff\xff\xff\xff\xff\xff", 6)) {
+        status |= 1u << 31;
+    } else if (data[0] & 1) {
+        status |= 1u << 30;
+    } else {
+        status |= 1u << 29;
+    }
+    stl_le_p(descriptor + 4, status);
+    stl_le_p(descriptor, address | DESC_DONE);
+    if (!emac_dma_write(pointer, descriptor, sizeof(descriptor))) {
+        emac_dma_fault(s, EMAC_FAULT_RX_DESCRIPTOR, pointer);
+        s->rx_dropped++;
+        return size;
+    }
+    s->rx_index = (address & DESC_WRAP) ? 0 : (s->rx_index + 1) % 1024;
+    s->rx_pending = MIN(s->rx_pending + 1, 255);
+    s->rx_packets++;
+    s->rx_bytes += size;
+    s->regs[REG_OK]++;
+    s->regs[REG_RSR] |= 2;
+    s->regs[REG_ISR] |= INT_RCOM;
+    if (s->trace) {
+        qemu_log("MST12 EMAC RX: bytes=%zu desc=0x%" HWADDR_PRIx
+                 " buffer=0x%" HWADDR_PRIx " type=0x%04x\n",
+                 size, pointer, buffer, lduw_be_p(data + 12));
+    }
+    emac_irq(s);
+    return size;
+}
+
+static bool emac_can_receive(NetClientState *nc)
+{
+    MST12EmacState *s = qemu_get_nic_opaque(nc);
+
+    return (s->regs[REG_CTL] & CTL_RE) && emac_link(s);
+}
+
+static void emac_tx_schedule(MST12EmacState *s)
+{
+    if (s->tx_depth && !timer_pending(s->tx_timer)) {
+        unsigned speed = (s->regs[REG_CFG] & 1) ? 100 : 10;
+        uint64_t ns = (s->tx_length[s->tx_head] + 24ULL) * 8000 / speed;
+
+        timer_mod(s->tx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+    }
+}
+
+static void emac_transmit(void *opaque)
+{
+    MST12EmacState *s = opaque;
+    uint8_t data[EMAC_MAX_FRAME];
+    size_t size;
+    hwaddr address;
+
+    if (!s->tx_depth || !(s->regs[REG_CTL] & CTL_TE)) {
+        return;
+    }
+    size = s->tx_length[s->tx_head];
+    address = EMAC_MIU0_BASE + s->tx_address[s->tx_head];
+    s->tx_head = (s->tx_head + 1) % EMAC_FIFO;
+    s->tx_depth--;
+    if (!emac_dma_read(address, data, size)) {
+        emac_dma_fault(s, EMAC_FAULT_TX_DMA, address);
+    } else if (emac_link(s)) {
+        if (s->regs[REG_CTL] & CTL_LB || s->phy[0] & 0x4000) {
+            emac_receive(qemu_get_queue(s->nic), data, size);
+        } else {
+            qemu_send_packet(qemu_get_queue(s->nic), data, size);
+        }
+        s->tx_packets++;
+        s->tx_bytes += size;
+        s->regs[REG_FRA]++;
+        s->regs[REG_TSR] |= 1u << 5;
+        s->regs[REG_ISR] |= INT_TCOM;
+        if (s->trace) {
+            qemu_log("MST12 EMAC TX: bytes=%zu buffer=0x%" HWADDR_PRIx
+                     " type=0x%04x\n", size, address,
+                     size >= 14 ? lduw_be_p(data + 12) : 0);
+        }
+    }
+    emac_irq(s);
+    emac_tx_schedule(s);
+}
+
+static void emac_tx_start(MST12EmacState *s, uint32_t value)
+{
+    unsigned tail;
+    uint32_t size = value & 0x7ff;
+
+    if (!(s->regs[REG_CTL] & CTL_TE) || !size) {
+        return;
+    }
+    if (size > EMAC_MAX_FRAME || value & ~0x7ffu) {
+        s->fault = EMAC_FAULT_TX_LENGTH;
+        s->regs[REG_ISR] |= INT_TOVR;
+        emac_irq(s);
+        return;
+    }
+    if (s->tx_depth == EMAC_FIFO) {
+        s->tx_overflows++;
+        s->regs[REG_ISR] |= INT_TOVR;
+        emac_irq(s);
+        return;
+    }
+    tail = (s->tx_head + s->tx_depth) % EMAC_FIFO;
+    s->tx_address[tail] = s->regs[REG_TAR];
+    s->tx_length[tail] = size;
+    s->tx_depth++;
+    emac_tx_schedule(s);
+}
+
+static uint16_t emac_phy_read(MST12EmacState *s, unsigned reg)
+{
+    bool link = emac_link(s);
+    uint16_t value = s->phy[reg];
+
+    if (reg == 1) {
+        value &= ~0x24;
+        if (link) {
+            value |= 4;
+            if (s->phy[0] & 0x1000) {
+                value |= 0x20;
+            }
+        }
+        if (s->link_latched_low) {
+            value &= ~4;
+            s->link_latched_low = false;
+        }
+    } else if (reg == 5 && !link) {
+        value = 0;
+    }
+    s->phy_reads++;
+    if (s->trace) {
+        qemu_log("MST12 EMAC PHY read: reg=%u value=0x%04x\n", reg, value);
+    }
+    return value;
+}
+
+static void emac_phy_defaults(MST12EmacState *s)
+{
+    memset(s->phy, 0, sizeof(s->phy));
+    s->phy[0] = 0x1000;
+    s->phy[1] = 0x7809;
+    s->phy[2] = s->phy_id >> 16;
+    s->phy[3] = s->phy_id;
+    s->phy[4] = 0x01e1;
+    s->phy[5] = 0x01e1;
+    s->phy[6] = 1;
+    s->phy[16] = 0x0400;
+    s->phy_ready = false;
+    s->link_latched_low = true;
+}
+
+static void emac_phy_complete(void *opaque)
+{
+    MST12EmacState *s = opaque;
+
+    s->phy[0] &= ~0x8200;
+    s->phy_ready = true;
+    s->regs[REG_ISR] |= INT_LINK;
+    emac_irq(s);
+    qemu_flush_queued_packets(qemu_get_queue(s->nic));
+}
+
+static void emac_phy_write(MST12EmacState *s, unsigned reg, uint16_t value)
+{
+    if (s->trace) {
+        qemu_log("MST12 EMAC PHY write: reg=%u value=0x%04x\n", reg, value);
+    }
+    /* IEEE status, identity, partner advertisement and expansion are RO. */
+    if (reg == 1 || reg == 2 || reg == 3 || reg == 5 || reg == 6) {
+        return;
+    }
+    if (reg == 0 && (value & 0x8000)) {
+        emac_phy_defaults(s);
+    }
+    s->phy[reg] = value;
+    if (reg == 0 && (value & 0x8200 || !s->phy_ready)) {
+        s->phy_ready = false;
+        timer_mod(s->phy_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                               10 * SCALE_MS);
+    }
+    emac_irq(s);
+}
+
+static void emac_link_changed(NetClientState *nc)
+{
+    MST12EmacState *s = qemu_get_nic_opaque(nc);
+
+    s->link_latched_low = true;
+    if (nc->link_down || (nc->peer && nc->peer->link_down)) {
+        s->regs[REG_ISR] |= INT_LINK;
+        emac_irq(s);
+    } else {
+        s->phy_ready = false;
+        timer_mod(s->phy_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                               10 * SCALE_MS);
+    }
+}
+
+static uint32_t emac_tsr(MST12EmacState *s)
+{
+    unsigned free = EMAC_FIFO - s->tx_depth;
+
+    /* FIFO idle bits 9..12 and TBNQ/FBNQ 7..8 are MStar extensions. */
+    return s->regs[REG_TSR] | 0x18 | (free ? 0x180 : 0) |
+           (((1u << free) - 1) << 9);
+}
+
+static uint64_t emac_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12EmacState *s = opaque;
+    unsigned reg = offset / 8, lane = offset % 8;
+    bool clear = reg == REG_ISR || reg == REG_J108 ||
+                 (reg >= REG_FRA && reg < REG_HSL);
+    uint32_t value;
+
+    s->register_reads++;
+    if (reg == REG_TSR) {
+        value = emac_tsr(s);
+    } else if (reg == REG_SR) {
+        value = 4; /* MDIO maintenance port idle. */
+    } else if (reg == REG_J108) {
+        value = s->rx_pending;
+    } else {
+        value = s->regs[reg];
+    }
+    if (clear && lane == 0) {
+        s->read_latch = value;
+        s->latch_register = reg;
+        if (reg == REG_J108) {
+            s->rx_pending = 0;
+        } else {
+            s->regs[reg] = 0;
+        }
+        emac_irq(s);
+    } else if (clear && lane >= 4 && s->latch_register == reg) {
+        value = s->read_latch;
+    }
+    if ((lane & 3) >= 2) {
+        return 0;
+    }
+    value >>= (lane / 4) * 16 + (lane % 4) * 8;
+    return value & (size == 1 ? 255 : lane % 4 ? 255 : 65535);
+}
+
+static void emac_write(void *opaque, hwaddr offset, uint64_t value,
+                       unsigned size)
+{
+    MST12EmacState *s = opaque;
+    unsigned reg = offset / 8, lane = offset % 8, shift;
+    uint32_t mask, bits, old = s->regs[reg];
+
+    s->register_writes++;
+    if ((lane & 3) >= 2) {
+        return;
+    }
+    shift = (lane / 4) * 16 + (lane % 4) * 8;
+    mask = (size == 1 || lane % 4 ? 255u : 65535u) << shift;
+    bits = ((uint32_t)value << shift) & mask;
+    if (s->trace) {
+        qemu_log("MST12 EMAC write: reg=0x%x lane=%u value=0x%" PRIx64
+                 "\n", reg * 4, lane, value);
+    }
+    switch (reg) {
+    case REG_IER:
+        s->regs[REG_IMR] &= ~bits;
+        break;
+    case REG_IDR:
+        s->regs[REG_IMR] |= bits;
+        break;
+    case REG_IMR:
+    case REG_SR:
+        break;
+    case REG_ISR:
+    case REG_RSR:
+    case REG_TSR:
+        s->regs[reg] &= ~bits;
+        break;
+    default:
+        s->regs[reg] = (old & ~mask) | bits;
+        if (reg == REG_CTL) {
+            if (bits & CTL_CLEAR) {
+                memset(s->regs + REG_FRA, 0,
+                       (REG_HSL - REG_FRA) * sizeof(s->regs[0]));
+                s->regs[REG_CTL] &= ~CTL_CLEAR;
+            }
+            if (!(s->regs[REG_CTL] & CTL_TE)) {
+                timer_del(s->tx_timer);
+                s->tx_depth = s->tx_head = 0;
+            }
+            if (s->regs[REG_CTL] & CTL_RE) {
+                qemu_flush_queued_packets(qemu_get_queue(s->nic));
+            }
+        } else if (reg == REG_TCR && lane < 2) {
+            emac_tx_start(s, s->regs[REG_TCR]);
+        } else if (reg == REG_RBQP) {
+            s->rx_index = 0;
+            s->rx_pending = 0;
+        } else if (reg == REG_MAN && lane >= 4) {
+            uint32_t command = s->regs[REG_MAN];
+            unsigned phy = (command >> 23) & 31;
+            unsigned address = (command >> 18) & 31;
+            unsigned operation = (command >> 28) & 3;
+
+            if (operation == 2) {
+                s->regs[REG_MAN] = (command & 0xffff0000) |
+                                  (phy ? 0xffff : emac_phy_read(s, address));
+            } else if (operation == 1 && !phy) {
+                emac_phy_write(s, address, command);
+            }
+            s->regs[REG_ISR] |= INT_DONE;
+        }
+        break;
+    }
+    emac_irq(s);
+}
+
+static const MemoryRegionOps emac_ops = {
+    .read = emac_read,
+    .write = emac_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static uint64_t emac_phy_mmio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    MST12EmacState *s = opaque;
+
+    if (offset % 4 >= 2) {
+        return 0;
+    }
+    return (emac_phy_read(s, offset / 4) >> ((offset % 4) * 8)) &
+           (size == 1 || offset % 4 ? 255 : 65535);
+}
+
+static void emac_phy_mmio_write(void *opaque, hwaddr offset, uint64_t value,
+                                unsigned size)
+{
+    MST12EmacState *s = opaque;
+    unsigned reg = offset / 4, shift = (offset % 4) * 8;
+    uint16_t mask = size == 1 || offset % 4 ? 255 << shift : 65535;
+
+    if (offset % 4 >= 2) {
+        return;
+    }
+    emac_phy_write(s, reg, (s->phy[reg] & ~mask) | ((value << shift) & mask));
+}
+
+static const MemoryRegionOps emac_phy_ops = {
+    .read = emac_phy_mmio_read,
+    .write = emac_phy_mmio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void emac_reset(DeviceState *dev)
+{
+    MST12EmacState *s = MST12_EMAC(dev);
+
+    timer_del(s->tx_timer);
+    timer_del(s->phy_timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->tx_address, 0, sizeof(s->tx_address));
+    memset(s->tx_length, 0, sizeof(s->tx_length));
+    s->regs[REG_IMR] = UINT32_MAX;
+    s->regs[REG_SA1L] = ldl_le_p(s->conf.macaddr.a);
+    s->regs[REG_SA1L + 1] = lduw_le_p(s->conf.macaddr.a + 4);
+    s->tx_depth = s->tx_head = s->rx_index = s->rx_pending = 0;
+    s->read_latch = 0;
+    s->latch_register = UINT32_MAX;
+    s->fault = 0;
+    s->fault_address = 0;
+    s->tx_packets = s->rx_packets = s->tx_bytes = s->rx_bytes = 0;
+    s->rx_dropped = s->tx_overflows = s->dma_faults = s->phy_reads = 0;
+    s->register_reads = s->register_writes = 0;
+    emac_phy_defaults(s);
+    timer_mod(s->phy_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                           10 * SCALE_MS);
+    emac_irq(s);
+}
+
+static NetClientInfo emac_net_info = {
+    .type = NET_CLIENT_DRIVER_NIC,
+    .size = sizeof(NICState),
+    .receive = emac_receive,
+    .can_receive = emac_can_receive,
+    .link_status_changed = emac_link_changed,
+};
+
+static void emac_realize(DeviceState *dev, Error **errp)
+{
+    MST12EmacState *s = MST12_EMAC(dev);
+
+    qemu_macaddr_default_if_unset(&s->conf.macaddr);
+    s->nic = qemu_new_nic(&emac_net_info, &s->conf,
+                          object_get_typename(OBJECT(dev)), dev->id,
+                          &dev->mem_reentrancy_guard, s);
+    qemu_format_nic_info_str(qemu_get_queue(s->nic), s->conf.macaddr.a);
+}
+
+static bool emac_get_link(Object *obj, Error **errp)
+{
+    return emac_link(MST12_EMAC(obj));
+}
+
+static void emac_init(Object *obj)
+{
+    MST12EmacState *s = MST12_EMAC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &emac_ops, s, "mst12.emac", 0x800);
+    memory_region_init_io(&s->phy_mmio, obj, &emac_phy_ops, s,
+                          "mst12.emac-phy", 0x80);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_mmio(sbd, &s->phy_mmio);
+    sysbus_init_irq(sbd, &s->irq);
+    s->tx_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, emac_transmit, s);
+    s->phy_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, emac_phy_complete, s);
+#define EMAC_COUNTER(name, field) \
+    object_property_add_uint64_ptr(obj, name, &s->field, OBJ_PROP_FLAG_READ)
+    EMAC_COUNTER("tx-packets", tx_packets);
+    EMAC_COUNTER("rx-packets", rx_packets);
+    EMAC_COUNTER("tx-bytes", tx_bytes);
+    EMAC_COUNTER("rx-bytes", rx_bytes);
+    EMAC_COUNTER("rx-dropped", rx_dropped);
+    EMAC_COUNTER("tx-overflows", tx_overflows);
+    EMAC_COUNTER("dma-faults", dma_faults);
+    EMAC_COUNTER("phy-reads", phy_reads);
+    EMAC_COUNTER("register-reads", register_reads);
+    EMAC_COUNTER("register-writes", register_writes);
+#undef EMAC_COUNTER
+    object_property_add_uint32_ptr(obj, "tx-depth", &s->tx_depth,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "rx-index", &s->rx_index,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "rx-pending", &s->rx_pending,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "fault", &s->fault, OBJ_PROP_FLAG_READ);
+    object_property_add_uint64_ptr(obj, "fault-address", &s->fault_address,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "link-up", emac_get_link, NULL);
+}
+
+static const VMStateDescription vmstate_emac = {
+    .name = "mst12-emac",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, MST12EmacState, EMAC_REGS),
+        VMSTATE_UINT16_ARRAY(phy, MST12EmacState, 32),
+        VMSTATE_UINT32_ARRAY(tx_address, MST12EmacState, EMAC_FIFO),
+        VMSTATE_UINT32_ARRAY(tx_length, MST12EmacState, EMAC_FIFO),
+        VMSTATE_UINT32(tx_head, MST12EmacState),
+        VMSTATE_UINT32(tx_depth, MST12EmacState),
+        VMSTATE_UINT32(rx_index, MST12EmacState),
+        VMSTATE_UINT32(rx_pending, MST12EmacState),
+        VMSTATE_UINT32(read_latch, MST12EmacState),
+        VMSTATE_UINT32(latch_register, MST12EmacState),
+        VMSTATE_UINT32(fault, MST12EmacState),
+        VMSTATE_UINT64(fault_address, MST12EmacState),
+        VMSTATE_UINT64(tx_packets, MST12EmacState),
+        VMSTATE_UINT64(rx_packets, MST12EmacState),
+        VMSTATE_UINT64(tx_bytes, MST12EmacState),
+        VMSTATE_UINT64(rx_bytes, MST12EmacState),
+        VMSTATE_UINT64(rx_dropped, MST12EmacState),
+        VMSTATE_UINT64(tx_overflows, MST12EmacState),
+        VMSTATE_UINT64(dma_faults, MST12EmacState),
+        VMSTATE_UINT64(phy_reads, MST12EmacState),
+        VMSTATE_UINT64(register_reads, MST12EmacState),
+        VMSTATE_UINT64(register_writes, MST12EmacState),
+        VMSTATE_BOOL(phy_ready, MST12EmacState),
+        VMSTATE_BOOL(link_latched_low, MST12EmacState),
+        VMSTATE_TIMER_PTR(tx_timer, MST12EmacState),
+        VMSTATE_TIMER_PTR(phy_timer, MST12EmacState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const Property emac_properties[] = {
+    DEFINE_NIC_PROPERTIES(MST12EmacState, conf),
+    /* Generic 100 Mbit PHY identity; not a claim about the television's PHY. */
+    DEFINE_PROP_UINT32("phy-id", MST12EmacState, phy_id, 0x0007c0f1),
+    DEFINE_PROP_BOOL("trace", MST12EmacState, trace, false),
+};
+
+static void emac_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = emac_realize;
+    device_class_set_legacy_reset(dc, emac_reset);
+    device_class_set_props(dc, emac_properties);
+    dc->vmsd = &vmstate_emac;
+}
+
+static const TypeInfo emac_type_info = {
+    .name = TYPE_MST12_EMAC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MST12EmacState),
+    .instance_init = emac_init,
+    .class_init = emac_class_init,
+};
+
+static void emac_register_types(void)
+{
+    type_register_static(&emac_type_info);
+}
+
+type_init(emac_register_types)
